import Singularity.Invariant.OrderBlowup
import Mathlib.RingTheory.Ideal.Colon

/-!
# The order of an ideal does not go up under a point blowup

This file proves Volume 2, Corollary 2.2.8 of the handbook for one blowup of the origin of affine space, at the origin of one chart. Let `k` be a field and let `I` be an ideal of `k[x_i : i ∈ σ]` with `ord I = m` at the origin. This is the case of a blowup of order at least `m` of a marked ideal `(I, m)` with `max-ord I ≤ m`, at the center. Look at the `x_j`-chart of the blowup of the origin with translations `t` (`pointChart j t`). The controlled transform of `(I, m)` in this chart is the ideal of the polynomials `g` with `x_j^m g ∈ π^* I` (`chartTransformIdeal`). Its order at the origin of the chart is at most `m`.

* `Singularity.chartTransformIdeal`: the controlled transform of `(I, m)` in the `x_j`-chart.
* `Singularity.idealOrd_chartTransformIdeal_le`: the order of the controlled transform is at most `m`.

The proof takes `f ∈ I` with `ord f = m`. The chart sends `f` to `x_j^m f'` (`exists_pointChart_eq_X_pow_mul`), and `ord f' ≤ m` (`ord_le_of_pointChart`). The polynomial `f'` is in the controlled transform.

The handbook states Corollary 2.2.8 for blowup sequences with smooth centers, at all points of `X_i`. This file proves the case of one point blowup, at the origins of the charts. The general case needs Theorem 2.2.7 of the handbook, which is not in Lean.
-/

open MvPolynomial

namespace Singularity

variable {σ k : Type*} [Field k] [DecidableEq σ]

/-- The controlled transform of the marked ideal `(I, m)` in the `x_j`-chart of the blowup of the origin: the ideal of the polynomials `g` such that `x_j^m g` is in the ideal generated by the image of `I`. -/
noncomputable def chartTransformIdeal (j : σ) (t : σ → k) (m : ℕ) (I : Ideal (MvPolynomial σ k)) :
    Ideal (MvPolynomial σ k) :=
  (I.map (pointChart j t)).colon {X j ^ m}

theorem mem_chartTransformIdeal {j : σ} {t : σ → k} {m : ℕ} {I : Ideal (MvPolynomial σ k)}
    {g : MvPolynomial σ k} : g ∈ chartTransformIdeal j t m I ↔ X j ^ m * g ∈ I.map (pointChart j t) := by
  rw [chartTransformIdeal, Submodule.mem_colon_singleton, smul_eq_mul, mul_comm]

/-- Let `I` be an ideal of order `m` at the origin. Then the controlled transform of `(I, m)` in the `x_j`-chart of the blowup of the origin has order at most `m` at the origin of the chart (Volume 2, Corollary 2.2.8 of the handbook, for one point blowup). -/
theorem idealOrd_chartTransformIdeal_le (j : σ) (t : σ → k) {m : ℕ}
    {I : Ideal (MvPolynomial σ k)} (hI : idealOrd I = m) :
    idealOrd (chartTransformIdeal j t m I) ≤ m := by
  obtain ⟨f, hfI, hf⟩ := exists_mem_ord_eq_idealOrd I
  rw [hI] at hf
  obtain ⟨f', hf'⟩ := exists_pointChart_eq_X_pow_mul (j := j) (t := t) hf.ge
  have hmem : f' ∈ chartTransformIdeal j t m I := by
    rw [mem_chartTransformIdeal, ← hf']
    exact Ideal.mem_map_of_mem _ hfI
  exact (idealOrd_le_ord hmem).trans (ord_le_of_pointChart hf hf')

/-- Let `(I, m)` be a marked ideal with `ord I ≤ m` at the origin, and blow up the origin with order at least `m`, that is `m ≤ ord I`. Then the controlled transform of `(I, m)` in each chart has order at most `m` at the origin of the chart. -/
theorem idealOrd_chartTransformIdeal_le_of_le (j : σ) (t : σ → k) {m : ℕ}
    {I : Ideal (MvPolynomial σ k)} (hle : idealOrd I ≤ m) (hge : (m : ℕ∞) ≤ idealOrd I) :
    idealOrd (chartTransformIdeal j t m I) ≤ m :=
  idealOrd_chartTransformIdeal_le j t (le_antisymm hle hge)

end Singularity
