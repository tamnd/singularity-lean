import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.CharP.Two
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-!
# A wild involution of the plane

This file proves the algebraic part of Volume 8, Example 3.1.9 of the handbook. Let `k` be a field and let `B = k[s, t]`, with `s = X 0` and `t = X 1`. Let `σ` be the `k`-algebra map with `σ(s) = s` and `σ(t) = t + s` (`wildSigma`). Let `n = t (t + s)` (`wildNorm`) and let `A_0 = k[s, n]` be the subalgebra generated by `s` and `n` (`wildInvariants`).

* If `2 = 0` in `k`, then `σ ∘ σ = id` (`wildSigma_wildSigma`).
* `σ` fixes `s`, `n` and each element of `A_0` (`wildSigma_X_zero`, `wildSigma_wildNorm`, `wildSigma_of_mem`).
* `B = A_0 ⊕ A_0 t`: each `f ∈ B` is `a + b t` with `a, b ∈ A_0` (`exists_eq_add_mul_X_one`), and `a + b t = 0` with `a, b ∈ A_0` implies `a = b = 0` (`eq_zero_of_add_mul_X_one_eq_zero`).
* The invariants of `σ` are `A_0`: `σ(f) = f` if and only if `f ∈ A_0` (`wildSigma_eq_self_iff`).
* If `2 = 0` in `k`, the trace `f + σ(f)` of `a + b t` is `b s` (`add_wildSigma_add_mul`), so the image of the trace is `s A_0` (`exists_add_wildSigma_eq_iff`).

The claim that `s` and `n` are algebraically independent, so that `A_0` is a polynomial ring, and the claims on the ramification along `s = 0` are not proved.
-/

open MvPolynomial

namespace Singularity

variable {k : Type*} [Field k]

/-- The automorphism `σ` of `k[s, t]` with `σ(s) = s` and `σ(t) = t + s`, of Volume 8, Example 3.1.9 of the handbook. -/
noncomputable def wildSigma : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 2) k :=
  aeval ![X 0, X 1 + X 0]

/-- The norm `n = t (t + s)` of `t`. -/
noncomputable def wildNorm : MvPolynomial (Fin 2) k :=
  X 1 * (X 1 + X 0)

/-- The subalgebra `A_0 = k[s, n]` of `k[s, t]`. -/
noncomputable def wildInvariants : Subalgebra k (MvPolynomial (Fin 2) k) :=
  Algebra.adjoin k {X 0, wildNorm}

theorem wildSigma_X_zero : wildSigma (X 0 : MvPolynomial (Fin 2) k) = X 0 := by
  simp [wildSigma]

theorem wildSigma_X_one : wildSigma (X 1 : MvPolynomial (Fin 2) k) = X 1 + X 0 := by
  simp [wildSigma]

theorem wild_two_eq_zero [CharP k 2] : (2 : MvPolynomial (Fin 2) k) = 0 := by
  rw [← map_ofNat (C (σ := Fin 2) (R := k)) 2, CharTwo.two_eq_zero, map_zero]

theorem wild_add_self [CharP k 2] (f : MvPolynomial (Fin 2) k) : f + f = 0 := by
  rw [← two_mul, wild_two_eq_zero, zero_mul]

/-- Volume 8, Example 3.1.9 of the handbook: in characteristic `2`, `σ` is an involution. -/
theorem wildSigma_wildSigma [CharP k 2] (f : MvPolynomial (Fin 2) k) :
    wildSigma (wildSigma f) = f := by
  have h : (wildSigma.comp wildSigma : MvPolynomial (Fin 2) k →ₐ[k] _) = AlgHom.id k _ := by
    refine MvPolynomial.algHom_ext (Fin.forall_fin_two.mpr ⟨?_, ?_⟩)
    · rw [AlgHom.comp_apply, AlgHom.id_apply, wildSigma_X_zero, wildSigma_X_zero]
    · rw [AlgHom.comp_apply, AlgHom.id_apply, wildSigma_X_one, map_add, wildSigma_X_one,
        wildSigma_X_zero, add_assoc, wild_add_self, add_zero]
  exact congrArg (fun φ => φ f) h

/-- Volume 8, Example 3.1.9 of the handbook: `σ(n) = n`. -/
theorem wildSigma_wildNorm [CharP k 2] :
    wildSigma (wildNorm : MvPolynomial (Fin 2) k) = wildNorm := by
  rw [wildNorm, map_mul, map_add, wildSigma_X_one, wildSigma_X_zero, add_assoc,
    wild_add_self, add_zero, mul_comm]

theorem X_zero_mem_wildInvariants : (X 0 : MvPolynomial (Fin 2) k) ∈ wildInvariants :=
  Algebra.subset_adjoin (Set.mem_insert _ _)

theorem wildNorm_mem_wildInvariants : (wildNorm : MvPolynomial (Fin 2) k) ∈ wildInvariants :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl)

/-- Volume 8, Example 3.1.9 of the handbook: `σ` fixes each element of `A_0 = k[s, n]`. -/
theorem wildSigma_of_mem [CharP k 2] {a : MvPolynomial (Fin 2) k} (ha : a ∈ wildInvariants) :
    wildSigma a = a := by
  have h : (wildInvariants : Subalgebra k (MvPolynomial (Fin 2) k)) ≤
      AlgHom.equalizer wildSigma (AlgHom.id k _) := by
    rw [wildInvariants, Algebra.adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨?_, ?_⟩
    · rw [SetLike.mem_coe, AlgHom.mem_equalizer, AlgHom.id_apply]
      exact wildSigma_X_zero
    · rw [SetLike.mem_coe, AlgHom.mem_equalizer, AlgHom.id_apply]
      exact wildSigma_wildNorm
  have h' := h ha
  rwa [AlgHom.mem_equalizer, AlgHom.id_apply] at h'

/-- The subalgebra of the `a + b t` with `a, b ∈ k[s, n]`. It is all of `k[s, t]` by `exists_eq_add_mul_X_one`. -/
noncomputable def wildDecomp : Subalgebra k (MvPolynomial (Fin 2) k) where
  carrier := {f | ∃ a ∈ wildInvariants, ∃ b ∈ wildInvariants, f = a + b * X 1}
  mul_mem' := by
    rintro _ _ ⟨a, ha, b, hb, rfl⟩ ⟨c, hc, d, hd, rfl⟩
    refine ⟨a * c + b * d * wildNorm, ?_, a * d + b * c - b * d * X 0, ?_, ?_⟩
    · exact add_mem (mul_mem ha hc) (mul_mem (mul_mem hb hd) wildNorm_mem_wildInvariants)
    · exact sub_mem (add_mem (mul_mem ha hd) (mul_mem hb hc))
        (mul_mem (mul_mem hb hd) X_zero_mem_wildInvariants)
    · rw [wildNorm]
      ring
  add_mem' := by
    rintro _ _ ⟨a, ha, b, hb, rfl⟩ ⟨c, hc, d, hd, rfl⟩
    exact ⟨a + c, add_mem ha hc, b + d, add_mem hb hd, by ring⟩
  algebraMap_mem' := by
    intro r
    exact ⟨algebraMap k _ r, Subalgebra.algebraMap_mem _ r, 0, zero_mem _, by ring⟩

theorem mem_wildDecomp {f : MvPolynomial (Fin 2) k} :
    f ∈ wildDecomp ↔ ∃ a ∈ wildInvariants, ∃ b ∈ wildInvariants, f = a + b * X 1 :=
  Iff.rfl

/-- Volume 8, Example 3.1.9 of the handbook: each element of `k[s, t]` is `a + b t` with `a, b ∈ k[s, n]`. -/
theorem exists_eq_add_mul_X_one (f : MvPolynomial (Fin 2) k) :
    ∃ a ∈ wildInvariants, ∃ b ∈ wildInvariants, f = a + b * X 1 := by
  have hX : ∀ i : Fin 2, (X i : MvPolynomial (Fin 2) k) ∈ wildDecomp :=
    Fin.forall_fin_two.mpr
      ⟨mem_wildDecomp.mpr ⟨X 0, X_zero_mem_wildInvariants, 0, zero_mem _, by ring⟩,
        mem_wildDecomp.mpr ⟨0, zero_mem _, 1, one_mem _, by ring⟩⟩
  have h : (⊤ : Subalgebra k (MvPolynomial (Fin 2) k)) ≤ wildDecomp := by
    rw [← MvPolynomial.adjoin_range_X, Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    exact hX i
  exact mem_wildDecomp.mp (h (Algebra.mem_top (x := f)))

/-- Volume 8, Example 3.1.9 of the handbook: if `a + b t = 0` with `a, b ∈ k[s, n]`, then `a = b = 0`. -/
theorem eq_zero_of_add_mul_X_one_eq_zero [CharP k 2] {a b : MvPolynomial (Fin 2) k}
    (ha : a ∈ wildInvariants) (hb : b ∈ wildInvariants) (h : a + b * X 1 = 0) :
    a = 0 ∧ b = 0 := by
  have h2 : a + b * (X 1 + X 0) = 0 := by
    have := congrArg wildSigma h
    rwa [map_add, map_mul, wildSigma_of_mem ha, wildSigma_of_mem hb, wildSigma_X_one,
      map_zero] at this
  have h3 : b * X 0 = 0 := by linear_combination h2 - h
  have hb0 : b = 0 := (mul_eq_zero.mp h3).resolve_right (X_ne_zero 0)
  refine ⟨?_, hb0⟩
  rw [hb0, zero_mul, add_zero] at h
  exact h

/-- Volume 8, Example 3.1.9 of the handbook: the invariants of `σ` are `k[s, n]`. -/
theorem wildSigma_eq_self_iff [CharP k 2] (f : MvPolynomial (Fin 2) k) :
    wildSigma f = f ↔ f ∈ wildInvariants := by
  refine ⟨fun hf => ?_, wildSigma_of_mem⟩
  obtain ⟨a, ha, b, hb, rfl⟩ := exists_eq_add_mul_X_one f
  rw [map_add, map_mul, wildSigma_of_mem ha, wildSigma_of_mem hb, wildSigma_X_one] at hf
  have h3 : b * X 0 = 0 := by linear_combination hf
  have hb0 : b = 0 := (mul_eq_zero.mp h3).resolve_right (X_ne_zero 0)
  rw [hb0, zero_mul, add_zero]
  exact ha

/-- Volume 8, Example 3.1.9 of the handbook: in characteristic `2`, the trace of `a + b t` is `b s`. -/
theorem add_wildSigma_add_mul [CharP k 2] {a b : MvPolynomial (Fin 2) k}
    (ha : a ∈ wildInvariants) (hb : b ∈ wildInvariants) :
    (a + b * X 1) + wildSigma (a + b * X 1) = b * X 0 := by
  rw [map_add, map_mul, wildSigma_of_mem ha, wildSigma_of_mem hb, wildSigma_X_one]
  linear_combination (a + b * X 1) * wild_two_eq_zero (k := k)

/-- Volume 8, Example 3.1.9 of the handbook: in characteristic `2`, the image of the trace `f ↦ f + σ(f)` is `s A_0`. -/
theorem exists_add_wildSigma_eq_iff [CharP k 2] (g : MvPolynomial (Fin 2) k) :
    (∃ f, f + wildSigma f = g) ↔ ∃ b ∈ wildInvariants, g = b * X 0 := by
  constructor
  · rintro ⟨f, rfl⟩
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_eq_add_mul_X_one f
    exact ⟨b, hb, add_wildSigma_add_mul ha hb⟩
  · rintro ⟨b, hb, rfl⟩
    refine ⟨b * X 1, ?_⟩
    have h := add_wildSigma_add_mul (zero_mem wildInvariants) hb
    rwa [zero_add] at h

end Singularity
