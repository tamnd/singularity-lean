import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Algebra.MvPolynomial.Variables
import Mathlib.Algebra.CharP.Defs
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.BigOperators
import Singularity.Algebra.DerivationIdealPow

/-!
# The singular points of the surface `w^p = G(s, t)`

Let `k` be a field of characteristic `p > 0`, let `G ∈ k[s, t]`, and let `F = w^p - G`. Let `P = (a, b, c)` be a point with `c^p = G(a, b)`, and let `𝔪_P` be its maximal ideal. This file proves that `F ∈ 𝔪_P^2` if and only if `G_s(a, b) = G_t(a, b) = 0`. This is the algebraic core of Volume 4, Lemma 2.3.4 of the handbook. The handbook then uses Lemma 2.3.1 (a point of a hypersurface is singular if and only if the equation is in `𝔪_P^2`) to get the statement about singular points. This file does not prove that step.

The ideal `𝔪_P` is `pointIdeal P`, the ideal generated by the `X i - C (P i)`. The proof has two steps.

1. A criterion for each finite set of variables over a commutative ring: `f ∈ 𝔪_x^2` if and only if `f(x) = 0` and each partial derivative of `f` vanishes at `x` (`Singularity.mem_pointIdeal_sq_iff`). One direction is Volume 6, Lemma 1.2.4 (`Singularity.derivation_mem_pow_pred`). For the other direction, `f - f(x) - ∑ ∂_i f(x) (X i - x_i)` is in `𝔪_x^2` (`Singularity.sub_sub_linearPartAt_mem_sq`). This is the first order Taylor formula. The proof is by induction on `f`.
2. The variables of `F` are `Option σ`: `none` is `w`, and `some i` are the variables of `G`. The derivative of `w^p` is `p w^(p-1) = 0`, and `G` does not contain `w`. So `∂_w F = 0` and `∂_i F = -∂_i G`. Also `F(P) = c^p - G(a, b) = 0`.

The statement here differs from the handbook in some points. The variables of `G` are each finite type `σ`, and `Singularity.purelyInseparable_mem_pointIdeal_sq_iff_fin_two` is the case `σ = Fin 2` of the handbook. The ring `k` is each commutative ring in which `p = 0`. The proof does not use that `p > 0` or that `k` is a field.

## Main results

* `Singularity.mem_pointIdeal_sq_iff`: `f ∈ 𝔪_x^2` if and only if `f(x) = 0` and `∂_i f(x) = 0` for each `i`.
* `Singularity.purelyInseparable_mem_pointIdeal_sq_iff`: `w^p - G ∈ 𝔪_P^2` if and only if each `∂_i G` vanishes at `x`.
* `Singularity.purelyInseparable_mem_pointIdeal_sq_iff_fin_two`: the case of two variables `s, t`.
-/

open MvPolynomial

namespace Singularity

section Criterion

variable {ι R : Type*} [CommRing R]

/-- The ideal of the point `x` in `R[X_i : i ∈ ι]`: the ideal generated by the `X i - C (x i)`. Over a field it is the maximal ideal of the rational point `x`. -/
noncomputable def pointIdeal (x : ι → R) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun i => X i - C (x i))

theorem X_sub_C_mem_pointIdeal (x : ι → R) (i : ι) : X i - C (x i) ∈ pointIdeal x :=
  Ideal.subset_span ⟨i, rfl⟩

/-- Each element of the ideal of the point `x` vanishes at `x`. -/
theorem eval_eq_zero_of_mem_pointIdeal {x : ι → R} {f : MvPolynomial ι R}
    (hf : f ∈ pointIdeal x) : eval x f = 0 := by
  have h : pointIdeal x ≤ RingHom.ker (eval x) := by
    rw [pointIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp
  exact RingHom.mem_ker.mp (h hf)

variable [Fintype ι]

/-- The linear part `∑ ∂_i f(x) (X i - x_i)` of `f` at the point `x`. -/
noncomputable def linearPartAt (x : ι → R) (f : MvPolynomial ι R) : MvPolynomial ι R :=
  ∑ i, C (eval x (pderiv i f)) * (X i - C (x i))

theorem linearPartAt_mem (x : ι → R) (f : MvPolynomial ι R) :
    linearPartAt x f ∈ pointIdeal x :=
  Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (X_sub_C_mem_pointIdeal x i)

/-- The first order Taylor formula: `f - f(x) - ∑ ∂_i f(x) (X i - x_i)` is in the square of the ideal of the point `x`. -/
theorem sub_sub_linearPartAt_mem_sq (x : ι → R) (f : MvPolynomial ι R) :
    f - C (eval x f) - linearPartAt x f ∈ pointIdeal x ^ 2 := by
  classical
  induction f using MvPolynomial.induction_on with
  | C a => simp [linearPartAt]
  | add f g hf hg =>
    have h : f + g - C (eval x (f + g)) - linearPartAt x (f + g) =
        (f - C (eval x f) - linearPartAt x f) + (g - C (eval x g) - linearPartAt x g) := by
      simp only [linearPartAt, map_add, add_mul, Finset.sum_add_distrib]
      ring
    rw [h]
    exact add_mem hf hg
  | mul_X f j hf =>
    have hX : linearPartAt x (X j) = X j - C (x j) := by
      rw [linearPartAt, Finset.sum_eq_single j]
      · simp
      · intro i _ hi
        simp [pderiv_X_of_ne (Ne.symm hi)]
      · intro h
        exact absurd (Finset.mem_univ j) h
    have hmul : linearPartAt x (f * X j) =
        C (eval x f) * linearPartAt x (X j) + C (x j) * linearPartAt x f := by
      simp only [linearPartAt, Derivation.leibniz, smul_eq_mul, map_add, map_mul, eval_X,
        Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    have hf1 : f - C (eval x f) ∈ pointIdeal x := by
      have h : f - C (eval x f) = (f - C (eval x f) - linearPartAt x f) + linearPartAt x f := by
        ring
      rw [h]
      exact add_mem (Ideal.pow_le_self two_ne_zero hf) (linearPartAt_mem x f)
    have h : f * X j - C (eval x (f * X j)) - linearPartAt x (f * X j) =
        (f - C (eval x f)) * (X j - C (x j)) +
          C (x j) * (f - C (eval x f) - linearPartAt x f) := by
      rw [hmul, hX, eval_mul, eval_X, map_mul]
      ring
    rw [h]
    refine add_mem ?_ (Ideal.mul_mem_left _ _ hf)
    rw [sq]
    exact Ideal.mul_mem_mul hf1 (X_sub_C_mem_pointIdeal x j)

/-- A polynomial `f` is in the square of the ideal of the point `x` if and only if `f(x) = 0` and each partial derivative of `f` vanishes at `x`. The handbook uses this fact in the proof of Volume 4, Lemma 2.3.4. -/
theorem mem_pointIdeal_sq_iff (x : ι → R) (f : MvPolynomial ι R) :
    f ∈ pointIdeal x ^ 2 ↔ eval x f = 0 ∧ ∀ i, eval x (pderiv i f) = 0 := by
  constructor
  · intro hf
    refine ⟨eval_eq_zero_of_mem_pointIdeal (Ideal.pow_le_self two_ne_zero hf), fun i => ?_⟩
    apply eval_eq_zero_of_mem_pointIdeal
    simpa using derivation_mem_pow_pred (pderiv i) (pointIdeal x) 2 f hf
  · rintro ⟨h0, h1⟩
    simpa [linearPartAt, h0, h1] using sub_sub_linearPartAt_mem_sq x f

end Criterion

section Surface

variable {σ k : Type*} [CommRing k] [Fintype σ] (p : ℕ) [CharP k p]

/-- The algebraic core of Volume 4, Lemma 2.3.4 of the handbook. Let `p = 0` in `k`, let `G` be a polynomial in the variables `σ`, and let `F = w^p - G` with the new variable `w = X none`. Let `P = (x, c)` with `c^p = G(x)`. Then `F` is in the square of the ideal of `P` if and only if each partial derivative of `G` vanishes at `x`. -/
theorem purelyInseparable_mem_pointIdeal_sq_iff (G : MvPolynomial σ k) (x : σ → k) (c : k)
    (hc : c ^ p = eval x G) :
    X none ^ p - rename Option.some G ∈ pointIdeal (fun o : Option σ => o.elim c x) ^ 2 ↔
      ∀ i, eval x (pderiv i G) = 0 := by
  classical
  rw [mem_pointIdeal_sq_iff, Option.forall]
  have hev : eval (fun o : Option σ => o.elim c x) (rename Option.some G) = eval x G := by
    rw [eval_rename]
    rfl
  have hnone : pderiv none (rename Option.some G : MvPolynomial (Option σ) k) = 0 := by
    apply pderiv_eq_zero_of_notMem_vars
    intro h
    obtain ⟨i, -, hi⟩ := Finset.mem_image.mp (vars_rename Option.some G h)
    exact Option.some_ne_none i hi
  have hpow : ∀ o : Option σ, eval (fun o : Option σ => o.elim c x)
      (pderiv o (X none ^ p : MvPolynomial (Option σ) k)) = 0 := by
    intro o
    rw [pderiv_pow]
    simp
  simp only [map_sub, hpow, hev, map_pow, eval_X, Option.elim_none, hc, sub_self, zero_sub,
    hnone, map_zero, neg_eq_zero, true_and]
  refine forall_congr' fun i => ?_
  rw [pderiv_rename (Option.some_injective σ), eval_rename]
  rfl

/-- Volume 4, Lemma 2.3.4 of the handbook, the algebraic core, with the variables of the handbook. The variables of `k[s, t, w]` are `some 0 = s`, `some 1 = t` and `none = w`. Let `c^p = G(a, b)`. Then `w^p - G` is in the square of the maximal ideal of `(a, b, c)` if and only if `G_s(a, b) = G_t(a, b) = 0`. -/
theorem purelyInseparable_mem_pointIdeal_sq_iff_fin_two (G : MvPolynomial (Fin 2) k) (a b c : k)
    (hc : c ^ p = eval ![a, b] G) :
    X none ^ p - rename Option.some G ∈
        pointIdeal (fun o : Option (Fin 2) => o.elim c ![a, b]) ^ 2 ↔
      eval ![a, b] (pderiv 0 G) = 0 ∧ eval ![a, b] (pderiv 1 G) = 0 := by
  rw [purelyInseparable_mem_pointIdeal_sq_iff p G ![a, b] c hc, Fin.forall_fin_two]

end Surface

end Singularity
