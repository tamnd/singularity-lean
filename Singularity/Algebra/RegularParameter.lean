import Singularity.Algebra.Regular

/-!
# Parts of a regular system of parameters

This file proves Volume 8, Lemma 1.1.11 of the handbook. Let `(R, 𝔪)` be a regular local ring of dimension `d` and let `t₁, ..., t_r ∈ 𝔪`. Then `t₁, ..., t_r` are part of a regular system of parameters if and only if `R / (t₁, ..., t_r)` is regular of dimension `d - r`.

In Lean the elements `tᵢ` form a finite set `t`, and "part of a regular system of parameters" means that there is a finite set `s` with `|t| + |s| = d` such that `t ∪ s` generates `𝔪`.

* `Singularity.Algebra.isRegularLocalRing_quotient_of_span_union`: the forward direction.
* `Singularity.Algebra.exists_span_union_of_isRegularLocalRing_quotient`: the converse.
* `Singularity.Algebra.exists_span_union_iff_isRegularLocalRing_quotient`: Lemma 1.1.11 of the handbook.

For the forward direction, the maximal ideal of `R / (t)` is generated by the classes of `s`, and `(t)` has `|t|` generators, so `d ≤ dim R / (t) + |t|`. For the converse, lift a set of `d - r` generators of the maximal ideal of `R / (t)` to `R`. Together with `t` the lifts generate `𝔪`.
-/

open IsLocalRing Ideal

universe u

namespace Singularity.Algebra

variable {R : Type u} [CommRing R]

theorem comap_map_mk_span_eq_sup (t : Set R) (J : Ideal R) :
    (J.map (Ideal.Quotient.mk (span t))).comap (Ideal.Quotient.mk (span t)) = J ⊔ span t := by
  rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]

/-- Let `(R, 𝔪)` be a regular local ring of dimension `d`, and let `t` and `s` be finite sets with `|t| + |s| = d` such that `t ∪ s` generates `𝔪`. Then `R / (t)` is a regular local ring of dimension `d - |t|` (Volume 8, Lemma 1.1.11 of the handbook, forward direction). -/
theorem isRegularLocalRing_quotient_of_span_union [IsRegularLocalRing R] {d : ℕ}
    (hd : ringKrullDim R = d) (t s : Finset R) (hcard : t.card + s.card = d)
    (hts : span ((t : Set R) ∪ s) = maximalIdeal R) :
    IsRegularLocalRing (R ⧸ span (t : Set R)) ∧
      ringKrullDim (R ⧸ span (t : Set R)) = (d - t.card : ℕ) := by
  classical
  set I := span (t : Set R) with hI
  have hIm : I ≤ maximalIdeal R := by
    rw [← hts]
    exact span_mono Set.subset_union_left
  have : IsLocalRing (R ⧸ I) := isLocalRing_quotient_of_le_maximalIdeal hIm
  have hmQ : maximalIdeal (R ⧸ I) = span (Ideal.Quotient.mk I '' (s : Set R)) := by
    rw [maximalIdeal_quotient_eq_map, ← hts, Ideal.map_span]
    refine le_antisymm (span_le.mpr ?_) (span_mono (Set.image_mono Set.subset_union_right))
    rintro _ ⟨y, hy | hy, rfl⟩
    · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span hy)]
      exact zero_mem _
    · exact subset_span ⟨y, hy, rfl⟩
  have hedim : (maximalIdeal (R ⧸ I)).spanFinrank ≤ s.card := by
    rw [hmQ]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (s.finite_toSet.image _)).trans ?_
    exact (Set.ncard_image_le s.finite_toSet).trans_eq (Set.ncard_coe_finset s)
  have hIfin : I.spanFinrank ≤ t.card :=
    (Submodule.spanFinrank_span_le_ncard_of_finite t.finite_toSet).trans_eq
      (Set.ncard_coe_finset t)
  have hle : ringKrullDim R ≤ ringKrullDim (R ⧸ I) + I.spanFinrank := by
    refine ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I ?_
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal R]
    exact hIm
  have hQle : ringKrullDim (R ⧸ I) ≤ ((maximalIdeal (R ⧸ I)).spanFinrank : WithBot ℕ∞) :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  obtain ⟨m, hm⟩ := exists_ringKrullDim_eq_natCast (R ⧸ I)
  rw [hm, hd] at hle
  rw [hm] at hQle
  have h1 : d ≤ m + I.spanFinrank := by exact_mod_cast hle
  have h2 : m ≤ (maximalIdeal (R ⧸ I)).spanFinrank := by exact_mod_cast hQle
  have h3 : m = d - t.card := by omega
  have h4 : (maximalIdeal (R ⧸ I)).spanFinrank = d - t.card := by omega
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, ?_⟩
  · rw [hm, h4, h3]
  · rw [hm, h3]

/-- Let `(R, 𝔪)` be a local ring, let `t ⊆ 𝔪` be a finite set with `|t| ≤ d`, and assume that `R / (t)` is a regular local ring of dimension `d - |t|`. Then there is a finite set `s` with `|t| + |s| = d` such that `t ∪ s` generates `𝔪` (Volume 8, Lemma 1.1.11 of the handbook, converse). -/
theorem exists_span_union_of_isRegularLocalRing_quotient [IsLocalRing R] {d : ℕ} (t : Finset R)
    (ht : (t : Set R) ⊆ maximalIdeal R) (hle : t.card ≤ d)
    (hreg : IsRegularLocalRing (R ⧸ span (t : Set R)))
    (hdim : ringKrullDim (R ⧸ span (t : Set R)) = (d - t.card : ℕ)) :
    ∃ s : Finset R, t.card + s.card = d ∧ span ((t : Set R) ∪ s) = maximalIdeal R := by
  classical
  set I := span (t : Set R) with hI
  have hIm : I ≤ maximalIdeal R := span_le.mpr ht
  have hfg : (maximalIdeal (R ⧸ I)).FG := IsNoetherian.noetherian _
  obtain ⟨sb, hsbcard, hsbspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  have hsf : (maximalIdeal (R ⧸ I)).spanFinrank = d - t.card := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ I)
    rw [hdim] at h
    exact_mod_cast h
  let g := Function.surjInv (Ideal.Quotient.mk_surjective (I := I))
  have hg : ∀ y, Ideal.Quotient.mk I (g y) = y := Function.surjInv_eq _
  refine ⟨sb.image g, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ (Function.injective_surjInv _), hsbcard, hsf]
    omega
  · have himg : Ideal.Quotient.mk I '' ((sb.image g : Finset R) : Set R) = (sb : Set (R ⧸ I)) := by
      ext y
      simp [hg]
    apply le_antisymm
    · rw [span_le]
      rintro x (hx | hx)
      · exact ht hx
      · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hx)
        have hy' : y ∈ maximalIdeal (R ⧸ I) := hsbspan ▸ subset_span hy
        have h1 : Ideal.Quotient.mk I (g y) ∈ (maximalIdeal R).map (Ideal.Quotient.mk I) := by
          rw [hg y, ← maximalIdeal_quotient_eq_map]
          exact hy'
        have h2 := Ideal.mem_comap.mpr h1
        rw [comap_map_mk_span_eq_sup, sup_eq_left.mpr hIm] at h2
        exact h2
    · intro x hx
      have h1 : Ideal.Quotient.mk I x ∈ maximalIdeal (R ⧸ I) := by
        rw [maximalIdeal_quotient_eq_map]
        exact Ideal.mem_map_of_mem _ hx
      rw [← hsbspan, ← himg] at h1
      have h1' : Ideal.Quotient.mk I x ∈
          (span ((sb.image g : Finset R) : Set R)).map (Ideal.Quotient.mk I) := by
        rw [Ideal.map_span]
        exact h1
      have h2 := Ideal.mem_comap.mpr h1'
      rw [comap_map_mk_span_eq_sup] at h2
      exact (sup_le (span_mono Set.subset_union_right) (span_mono Set.subset_union_left) :
        _ ≤ span ((t : Set R) ∪ ((sb.image g : Finset R) : Set R))) h2

/-- Let `(R, 𝔪)` be a regular local ring of dimension `d` and let `t ⊆ 𝔪` be a finite set. Then `t` is part of a regular system of parameters if and only if `|t| ≤ d` and `R / (t)` is a regular local ring of dimension `d - |t|` (Volume 8, Lemma 1.1.11 of the handbook). -/
theorem exists_span_union_iff_isRegularLocalRing_quotient [IsRegularLocalRing R] {d : ℕ}
    (hd : ringKrullDim R = d) (t : Finset R) (ht : (t : Set R) ⊆ maximalIdeal R) :
    (∃ s : Finset R, t.card + s.card = d ∧ span ((t : Set R) ∪ s) = maximalIdeal R) ↔
      t.card ≤ d ∧ IsRegularLocalRing (R ⧸ span (t : Set R)) ∧
        ringKrullDim (R ⧸ span (t : Set R)) = (d - t.card : ℕ) := by
  constructor
  · rintro ⟨s, hcard, hts⟩
    exact ⟨by omega, isRegularLocalRing_quotient_of_span_union hd t s hcard hts⟩
  · rintro ⟨hle, hreg, hdim⟩
    exact exists_span_union_of_isRegularLocalRing_quotient t ht hle hreg hdim

end Singularity.Algebra
