import Singularity.Statements.Embedded
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.KrullDimension.Polynomial
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Polynomial.Basic

/-!
# The local ring of the polynomial ring at the origin

Let `k` be a field and let `σ` be a finite type. Let `𝔪₀` be the ideal of the origin of `k[x_i : i ∈ σ]`, that is the kernel of the constant term. Let `L` be the localization at `𝔪₀`. This file shows that `L` is a regular local ring of dimension `#σ`, and that the images `x_i` of the variables are a regular system of parameters. It also shows that a polynomial `G` with `G(0) = 0` and `∂_j G(0) ≠ 0` can replace the parameter `x_j`.

For `σ = Fin m`, the ring `L` is the ring `Singularity.Algebra.AffineOriginRing k m` of `Singularity/Algebra/SamuelExamples.lean`, because `𝔪₀` is the ideal `MvPolynomial.idealOfVars` of the variables (`originIdeal_eq_idealOfVars`). That file gets regularity from Mathlib and has only the index type `Fin m`. This file is for a general finite index type, and it gives the lemmas on regular systems of parameters that the end case of the log-Jacobian order uses.

## Main definitions

* `Singularity.Algebra.originIdeal`: the ideal `𝔪₀` of the origin.
* `Singularity.Algebra.OriginLocalRing`: the local ring `L` at the origin.

## Main results

* `Singularity.Algebra.originIdeal_eq_span`: `𝔪₀` is generated by the variables.
* `Singularity.Algebra.originIdeal_eq_idealOfVars`: `𝔪₀` is the ideal `MvPolynomial.idealOfVars`.
* `Singularity.Algebra.height_originIdeal`: the height of `𝔪₀` is `#σ`.
* `Singularity.Algebra.ringKrullDim_originLocalRing`: `dim L = #σ`.
* `Singularity.Algebra.isRegularSystemOfParameters_X`: the images of the variables are a regular system of parameters of `L`.
* `Singularity.Algebra.isRegularLocalRing_originLocalRing`: `L` is a regular local ring.
* `Singularity.Algebra.isRegularSystemOfParameters_insert`: the images of `x_i` for `i ≠ j` and the image of `G` are a regular system of parameters of `L`.

## The proof

For a finite set `s` of variables, let `P_s` be the kernel of the substitution `x_i ↦ 0` for `i ∈ s`. It is a prime ideal, because the target is a domain. If `i ∉ s`, then `P_s < P_{s ∪ {i}}`, because `x_i` is only in the second ideal. An induction on `s` gives `#s ≤ ht P_s`. For `s = σ` the ideal `P_s` is `𝔪₀`. So `#σ ≤ ht 𝔪₀`. The height of a prime ideal is at most `dim k[x] = #σ`. The localization gives `dim L = ht 𝔪₀`.

For the change of parameter, write `c = ∂_j G(0)`. This is the coefficient of `x_j` in `G`. Each other monomial of `G` contains a variable `x_i` with `i ≠ j`, or it contains `x_j ^ 2`. So `G = x_j (c + x_j B) + A`, where `A` is in the ideal of the variables `x_i`, `i ≠ j`. In `L` the element `c + x_j B` is a unit. So `x_j` is in the ideal generated by `G` and the `x_i`, `i ≠ j`.

## What is not proved

This file does not prove that `L` is the ring `AffineOriginRing k m` as a ring isomorphism. It only identifies the two ideals. The file treats only the origin. It does not treat the local ring at a different closed point.

## References

* [Mat89] H. Matsumura, *Commutative ring theory*, 1989, Section 14.
* Volume 7, Section 3.5 of the handbook: Proposition 3.5.1 and Theorem 3.5.3.
* Volume 5, Chapter 4 of the handbook.
-/

open MvPolynomial IsLocalRing

namespace Singularity.Algebra

variable (σ k : Type*) [Field k]

/-! ### The ideal of the origin -/

/-- The ideal `𝔪₀` of the origin of `k[x_i : i ∈ σ]`: the kernel of the constant term. -/
noncomputable def originIdeal : Ideal (MvPolynomial σ k) :=
  RingHom.ker (constantCoeff : MvPolynomial σ k →+* k)

variable {σ k}

/-- A polynomial is in `𝔪₀` if and only if its constant term is `0`. -/
theorem mem_originIdeal {f : MvPolynomial σ k} : f ∈ originIdeal σ k ↔ constantCoeff f = 0 :=
  RingHom.mem_ker

variable (σ k)

/-- The ideal of the origin is a maximal ideal. -/
instance originIdeal_isMaximal : (originIdeal σ k).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun c => ⟨C c, constantCoeff_C σ c⟩

/-- **The ideal of the origin is generated by the variables.** -/
theorem originIdeal_eq_span : originIdeal σ k = Ideal.span (Set.range X) := by
  apply le_antisymm
  · intro f hf
    rw [← Set.image_univ, mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) (by rwa [mem_originIdeal, constantCoeff_eq] at hf)
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ _, by simpa using hi⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [mem_originIdeal]

/-- The ideal of the origin is the ideal `MvPolynomial.idealOfVars` of the variables. For `σ = Fin m` this is the ideal of `AffineOriginRing k m` in `Singularity/Algebra/SamuelExamples.lean`. -/
theorem originIdeal_eq_idealOfVars : originIdeal σ k = idealOfVars σ k :=
  originIdeal_eq_span σ k

/-- The local ring `L` of `k[x_i : i ∈ σ]` at the origin. -/
abbrev OriginLocalRing : Type _ :=
  Localization.AtPrime (originIdeal σ k)

/-! ### A chain of prime ideals -/

section Chain

variable [DecidableEq σ]

/-- The substitution `x_i ↦ 0` for `i ∈ s`. It fixes the other variables. -/
noncomputable def killVars (s : Finset σ) : MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i => if i ∈ s then 0 else X i

/-- The prime ideal `P_s`: the kernel of the substitution `x_i ↦ 0` for `i ∈ s`. -/
noncomputable def varsIdeal (s : Finset σ) : Ideal (MvPolynomial σ k) :=
  RingHom.ker (killVars σ k s)

/-- The ideal `P_s` is prime, because the polynomial ring is a domain. -/
instance varsIdeal_isPrime (s : Finset σ) : (varsIdeal σ k s).IsPrime :=
  RingHom.ker_isPrime _

variable {σ k}

/-- If `t ⊆ s`, then the substitution for `s` after the substitution for `t` is the substitution for `s`. -/
theorem killVars_comp {s t : Finset σ} (h : t ⊆ s) :
    (killVars σ k s).comp (killVars σ k t) = killVars σ k s := by
  ext i
  simp only [killVars, AlgHom.comp_apply, aeval_X]
  by_cases hi : i ∈ t
  · simp [hi, h hi]
  · simp [hi, aeval_X]

/-- The variable `x_i` is in `P_s` if and only if `i ∈ s`. -/
theorem X_mem_varsIdeal_iff {s : Finset σ} {i : σ} : X i ∈ varsIdeal σ k s ↔ i ∈ s := by
  rw [varsIdeal, RingHom.mem_ker]
  simp only [killVars, aeval_X]
  split_ifs with hi
  · simp [hi]
  · simp [hi, X_ne_zero]

/-- The ideals `P_s` increase with `s`. -/
theorem varsIdeal_mono {s t : Finset σ} (h : t ⊆ s) : varsIdeal σ k t ≤ varsIdeal σ k s := by
  intro f hf
  rw [varsIdeal, RingHom.mem_ker] at hf ⊢
  have := congrArg (killVars σ k s) hf
  rw [map_zero] at this
  rw [← killVars_comp h]
  exact this

/-- The height of `P_s` is at least `#s`. -/
theorem card_le_height_varsIdeal (s : Finset σ) : (s.card : ℕ∞) ≤ (varsIdeal σ k s).height := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i t hi ih =>
    have hlt : varsIdeal σ k t < varsIdeal σ k (insert i t) := by
      refine lt_of_le_of_ne (varsIdeal_mono (Finset.subset_insert i t)) fun h => hi ?_
      have hX : X i ∈ varsIdeal σ k (insert i t) :=
        X_mem_varsIdeal_iff.mpr (Finset.mem_insert_self i t)
      rw [← h] at hX
      exact X_mem_varsIdeal_iff.mp hX
    rw [Finset.card_insert_of_notMem hi, Nat.cast_add, Nat.cast_one]
    exact (add_le_add_left ih 1).trans (Ideal.height_add_one_le_of_lt_of_isPrime hlt)

/-- For `s` the set of all variables, `P_s` is the ideal of the origin. -/
theorem varsIdeal_univ [Fintype σ] : varsIdeal σ k Finset.univ = originIdeal σ k := by
  ext f
  have h0 : (fun i : σ => if i ∈ (Finset.univ : Finset σ) then (0 : MvPolynomial σ k) else X i) =
      0 := by
    funext i
    simp
  rw [varsIdeal, RingHom.mem_ker, mem_originIdeal]
  simp only [killVars, h0, aeval_zero, algebraMap_eq, C_eq_zero]

end Chain

/-! ### The dimension -/

/-- **The height of the ideal of the origin.** The ideal `𝔪₀` has height `#σ`. -/
theorem height_originIdeal [Fintype σ] : (originIdeal σ k).height = Fintype.card σ := by
  classical
  apply le_antisymm
  · have h := Ideal.height_le_ringKrullDim_of_isPrime (I := originIdeal σ k)
    rw [ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field, zero_add,
      Nat.card_eq_fintype_card] at h
    exact_mod_cast h
  · have h := card_le_height_varsIdeal (k := k) (Finset.univ : Finset σ)
    rwa [varsIdeal_univ, Finset.card_univ] at h

/-- **The dimension of the local ring at the origin.** The local ring `L` has dimension `#σ`. -/
theorem ringKrullDim_originLocalRing [Fintype σ] :
    ringKrullDim (OriginLocalRing σ k) = Fintype.card σ := by
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (originIdeal σ k), height_originIdeal]
  rfl

/-- The map from the polynomial ring to `L` is injective. -/
theorem algebraMap_originLocalRing_injective :
    Function.Injective (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k)) :=
  IsLocalization.injective _ (originIdeal σ k).primeCompl_le_nonZeroDivisors

/-- The images `x_i` of the variables in `L` are pairwise distinct. -/
theorem algebraMap_X_injective :
    Function.Injective fun i : σ => algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) :=
  (algebraMap_originLocalRing_injective σ k).comp (X_injective (R := k))

/-- The maximal ideal of `L` is generated by the images of the variables. -/
theorem maximalIdeal_originLocalRing :
    maximalIdeal (OriginLocalRing σ k) =
      Ideal.span
        (Set.range fun i : σ => algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i)) := by
  have h := congrArg (Ideal.map (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k)))
    (originIdeal_eq_span σ k)
  rw [Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, ← Set.range_comp] at h
  exact h

/-- **The variables are a regular system of parameters.** The images `x_i` of the variables form a regular system of parameters of `L`. -/
theorem isRegularSystemOfParameters_X [Fintype σ] [DecidableEq (OriginLocalRing σ k)] :
    IsRegularSystemOfParameters
      (Finset.univ.image fun i : σ =>
        algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i)) := by
  refine ⟨?_, ?_⟩
  · rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, maximalIdeal_originLocalRing]
  · rw [Finset.card_image_of_injective _ (algebraMap_X_injective σ k), Finset.card_univ,
      ringKrullDim_originLocalRing]

/-- **The local ring at the origin is regular.** -/
theorem isRegularLocalRing_originLocalRing [Fintype σ] :
    IsRegularLocalRing (OriginLocalRing σ k) := by
  classical
  exact isRegularLocalRing_of_isRegularSystemOfParameters (isRegularSystemOfParameters_X σ k)

/-! ### The change of one parameter -/

variable {σ k}

/-- If `G(0) = 0`, then `G - c x_j` is in the ideal of the variables `x_i`, `i ≠ j`, plus the ideal `(x_j ^ 2)`. Here `c = ∂_j G(0)`. -/
theorem sub_C_mul_X_mem {G : MvPolynomial σ k} (h0 : constantCoeff G = 0) (j : σ) :
    G - C (constantCoeff (pderiv j G)) * X j ∈
      Ideal.span (X '' {i | i ≠ j}) ⊔ Ideal.span {X j ^ 2} := by
  classical
  set H := G - C (constantCoeff (pderiv j G)) * X j
  rw [H.as_sum]
  refine Ideal.sum_mem _ fun m hm => ?_
  have hc : H.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
  by_cases hex : ∃ i, i ≠ j ∧ m i ≠ 0
  · obtain ⟨i, hij, hi⟩ := hex
    refine Ideal.mem_sup_left ?_
    rw [mem_ideal_span_X_image]
    intro m' hm'
    simp only [support_monomial, hc, ite_false, Finset.mem_singleton] at hm'
    exact ⟨i, hij, hm' ▸ hi⟩
  · push Not at hex
    have hm_eq : m = Finsupp.single j (m j) := by
      ext i
      by_cases hij : i = j
      · subst hij
        simp
      · simp [Ne.symm hij, hex i hij]
    have h2 : 2 ≤ m j := by
      by_contra hlt
      push Not at hlt
      interval_cases hmj : m j
      · apply hc
        rw [hm_eq, Finsupp.single_zero]
        simp [H, ← constantCoeff_eq, h0]
      · apply hc
        rw [hm_eq]
        simp [H, coeff_X, constantCoeff_eq, coeff_pderiv]
    refine Ideal.mem_sup_right ?_
    rw [Ideal.mem_span_singleton]
    refine ⟨monomial (m - Finsupp.single j 2) (H.coeff m), ?_⟩
    rw [X_pow_eq_monomial, monomial_mul_monomial, one_mul, add_tsub_cancel_of_le]
    exact Finsupp.single_le_iff.mpr h2

variable [Fintype σ] [DecidableEq σ] [DecidableEq (OriginLocalRing σ k)]

/-- The image `γ` of `G` is not one of the images `x_i`, `i ≠ j`, if `∂_j G(0) ≠ 0`. -/
theorem algebraMap_notMem_image {G : MvPolynomial σ k} {j : σ}
    (hj : constantCoeff (pderiv j G) ≠ 0) :
    algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) G ∉
      (Finset.univ.erase j).image fun i =>
        algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) := by
  rw [Finset.mem_image]
  rintro ⟨i, hi, hiG⟩
  have hij : i ≠ j := Finset.ne_of_mem_erase hi
  have hG := algebraMap_originLocalRing_injective σ k hiG
  subst hG
  apply hj
  simp [pderiv_X, hij.symm]

/-- **The change of one parameter.** Let `G` be a polynomial with `G(0) = 0` and `∂_j G(0) ≠ 0`. Then the image of `G` and the images of `x_i`, `i ≠ j`, are a regular system of parameters of `L`. -/
theorem isRegularSystemOfParameters_insert {G : MvPolynomial σ k} (h0 : constantCoeff G = 0)
    {j : σ} (hj : constantCoeff (pderiv j G) ≠ 0) :
    IsRegularSystemOfParameters (insert (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) G)
      ((Finset.univ.erase j).image fun i =>
        algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i))) := by
  set φ := algebraMap (MvPolynomial σ k) (OriginLocalRing σ k)
  set I := Ideal.span ((insert (φ G) ((Finset.univ.erase j).image fun i => φ (X i)) :
    Finset (OriginLocalRing σ k)) : Set (OriginLocalRing σ k))
  have hXI : ∀ i, i ≠ j → φ (X i) ∈ I := fun i hi =>
    Ideal.subset_span (Finset.mem_insert_of_mem
      (Finset.mem_image_of_mem _ (Finset.mem_erase.mpr ⟨hi, Finset.mem_univ _⟩)))
  have hGI : φ G ∈ I := Ideal.subset_span (by simp)
  have hmem : ∀ f ∈ originIdeal σ k, φ f ∈ maximalIdeal (OriginLocalRing σ k) := fun f hf => by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ hf
  -- the variable `x_j` is in `I`
  have hjI : φ (X j) ∈ I := by
    set c := constantCoeff (pderiv j G)
    obtain ⟨A, hA, B', hB', hAB⟩ := Submodule.mem_sup.mp (sub_C_mul_X_mem h0 j)
    obtain ⟨B, rfl⟩ := Ideal.mem_span_singleton'.mp hB'
    have hAI : φ A ∈ I := by
      have : Ideal.map φ (Ideal.span (X '' {i | i ≠ j})) ≤ I := by
        rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
        exact hXI i hi
      exact this (Ideal.mem_map_of_mem _ hA)
    have hG : φ G = φ (X j) * (φ (C c) + φ (X j) * φ B) + φ A := by
      have : G = X j * (C c + X j * B) + A := by
        linear_combination -hAB
      rw [this]
      simp only [map_add, map_mul]
    have hu : IsUnit (φ (C c) + φ (X j) * φ B) := by
      by_contra hnu
      have hm : φ (C c) + φ (X j) * φ B ∈ maximalIdeal (OriginLocalRing σ k) := hnu
      have hXm : φ (X j) * φ B ∈ maximalIdeal (OriginLocalRing σ k) :=
        Ideal.mul_mem_right _ _ (hmem _ (by simp [mem_originIdeal]))
      have hCm : φ (C c) ∈ maximalIdeal (OriginLocalRing σ k) := by
        have := Ideal.sub_mem _ hm hXm
        rwa [add_sub_cancel_right] at this
      exact hCm (((Ne.isUnit hj).map C).map φ)
    have hprod : φ (X j) * (φ (C c) + φ (X j) * φ B) ∈ I := by
      have := Ideal.sub_mem _ hGI hAI
      rwa [hG, add_sub_cancel_right] at this
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have := Ideal.mul_mem_right v _ hprod
    rwa [mul_assoc, hv, mul_one] at this
  refine ⟨le_antisymm ?_ ?_, ?_⟩
  · rw [Ideal.span_le]
    intro y hy
    simp only [Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff, Set.mem_image] at hy
    rcases hy with rfl | ⟨i, -, rfl⟩
    · exact hmem G (mem_originIdeal.mpr h0)
    · exact hmem _ (by simp [mem_originIdeal])
  · rw [maximalIdeal_originLocalRing, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    by_cases hij : i = j
    · subst hij
      exact hjI
    · exact hXI i hij
  · rw [Finset.card_insert_of_notMem (algebraMap_notMem_image hj),
      Finset.card_image_of_injective _ (algebraMap_X_injective σ k),
      Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ,
      ringKrullDim_originLocalRing,
      Nat.sub_add_cancel (Fintype.card_pos_iff.mpr ⟨j⟩)]

end Singularity.Algebra
