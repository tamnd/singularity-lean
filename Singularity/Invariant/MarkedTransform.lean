import Singularity.Invariant.CenterChartDeriv
import Singularity.Invariant.CoefficientIdealTransform
import Singularity.Invariant.DerivativeOrder

/-!
# Formal properties of the transform of a marked ideal

This file proves Volume 2, Lemma 2.2.4 (1), (2) and (3) of the handbook in the charts of a
blowup of affine space. It also proves Lemma 3.2.2 (2) for a coordinate center of any
codimension, and the transform of the coefficient ideal in one such chart.

Let `φ` be a ring map and let `x` be a nonzero element of the target, which is a domain. The
transform of the marked ideal `(I, m)` is the ideal of the `g` with `x^m g` in the ideal
generated by `φ(I)` (`markedTransform`). We say that `(I, m)` is divisible if `φ(I)` lies in
`(x^m)`. This is the chart form of the condition `Z ⊆ cosupp(I, m)`.

* `Singularity.markedTransform`: the transform of `(I, m)` for `φ` and `x`.
* `Singularity.map_eq_span_mul_markedTransform`: if `(I, m)` is divisible, then
  `φ(I) = x^m · I'`.
* `Singularity.markedTransform_mul`, `markedTransform_pow`: Lemma 2.2.4 (1).
* `Singularity.markedTransform_sup`, `markedTransform_mono`: Lemma 2.2.4 (2).
* `Singularity.markedTransform_of_mark_le`, `markedTransform_le_of_mark_le`: Lemma 2.2.4 (3).
* `Singularity.markedTransform_iSup_pow`: Lemma 3.2.2 (2) in this setting.

Two charts are covered. The first is the chart `chartSubst S c` of the blowup of the
coordinate center `I_Z = (x_i : i ∈ S)` with `c ∈ S`, over a domain `R`
(`centerChartTransformIdeal`). Here the hypothesis is `I ⊆ I_Z^m`. The second is the chart
`pointChart j t` of the blowup of the origin over a field (`chartTransformIdeal`). Here the
hypothesis is `m ≤ ord I` at the origin.

* `Singularity.centerChartTransformIdeal_mul`, `_pow`, `_sup`, `_mono`, `_of_mark_le`,
  `_le_of_mark_le`, `_iSup_pow`: the results above for the center chart.
* `Singularity.chartTransformIdeal_mul`, `_pow`, `_sup`, `_mono`, `_of_mark_le`,
  `_le_of_mark_le`: the results above for the point chart.
* `Singularity.derivIdeal_iterate_le_chartCenterIdeal_pow`: if `I ⊆ I_Z^m`, then
  `D^l(I) ⊆ I_Z^(m-l)`.
* `Singularity.centerChartTransformIdeal_coeffIdeal`: if `1 ≤ m` and `I ⊆ I_Z^m`, then the
  transform of the coefficient ideal `(∑_l D^l(I)^(m!/(m-l)), m!)` (Definition 3.2.1) is
  `∑_l (J_l)^(m!/(m-l))`, where `J_l` is the transform of `(D^l(I), m - l)`. This is the first
  step of the proof of Proposition 3.2.3, for one blowup.

What is not proved. Lemma 2.2.4 (4) on cosupports is not in this file. The charts are the
algebraic charts of affine space; local coordinates on a smooth variety and the gluing of the
charts are not formalized. Proposition 3.2.3 itself, for sequences of blowups, is not proved.
-/

open MvPolynomial

namespace Singularity

section General

variable {P Q F : Type*} [CommRing P] [CommRing Q] [FunLike F P Q] [RingHomClass F P Q]

/-- The transform of the marked ideal `(I, m)` for the map `φ` and the element `x`: the ideal of
the `g` such that `x^m g` is in the ideal generated by `φ(I)`. -/
noncomputable def markedTransform (φ : F) (x : Q) (m : ℕ) (I : Ideal P) : Ideal Q :=
  (I.map φ).colon {x ^ m}

omit [RingHomClass F P Q] in
theorem mem_markedTransform {φ : F} {x : Q} {m : ℕ} {I : Ideal P} {g : Q} :
    g ∈ markedTransform φ x m I ↔ x ^ m * g ∈ I.map φ := by
  rw [markedTransform, Submodule.mem_colon_singleton, smul_eq_mul, mul_comm]

omit [RingHomClass F P Q] in
/-- If `φ(I)` lies in `(x^m)`, then `φ(I)` is `x^m` times the transform of `(I, m)`. -/
theorem map_eq_span_mul_markedTransform {φ : F} {x : Q} {m : ℕ} {I : Ideal P}
    (h : I.map φ ≤ Ideal.span {x ^ m}) :
    I.map φ = Ideal.span {x ^ m} * markedTransform φ x m I := by
  apply le_antisymm
  · intro g hg
    obtain ⟨g', hg'⟩ := Ideal.mem_span_singleton'.mp (h hg)
    refine Ideal.mem_span_singleton_mul.mpr ⟨g', ?_, ?_⟩
    · rw [mem_markedTransform, mul_comm, hg']
      exact hg
    · rw [mul_comm, hg']
  · intro g hg
    obtain ⟨g', hg', rfl⟩ := Ideal.mem_span_singleton_mul.mp hg
    exact mem_markedTransform.mp hg'

variable [IsDomain Q]

omit [RingHomClass F P Q] in
/-- If `φ(I) = x^m T` with `x ≠ 0`, then the transform of `(I, m)` is `T`. -/
theorem markedTransform_eq_of_map_eq {φ : F} {x : Q} (hx : x ≠ 0) {m : ℕ} {I : Ideal P}
    {T : Ideal Q} (h : I.map φ = Ideal.span {x ^ m} * T) : markedTransform φ x m I = T := by
  rw [markedTransform, h]
  exact colon_span_singleton_mul_eq (pow_ne_zero _ hx) T

/-- Lemma 2.2.4 (1), products: the transform of `(AB, a + b)` is the product of the
transforms of `(A, a)` and `(B, b)`. -/
theorem markedTransform_mul {φ : F} {x : Q} (hx : x ≠ 0) {a b : ℕ} {A B : Ideal P}
    (hA : A.map φ ≤ Ideal.span {x ^ a}) (hB : B.map φ ≤ Ideal.span {x ^ b}) :
    markedTransform φ x (a + b) (A * B) = markedTransform φ x a A * markedTransform φ x b B := by
  apply markedTransform_eq_of_map_eq hx
  rw [Ideal.map_mul, map_eq_span_mul_markedTransform hA, map_eq_span_mul_markedTransform hB,
    pow_add, ← Ideal.span_singleton_mul_span_singleton]
  ring

/-- Lemma 2.2.4 (1), powers: the transform of `(A^e, a e)` is the `e`th power of the transform
of `(A, a)`. -/
theorem markedTransform_pow {φ : F} {x : Q} (hx : x ≠ 0) {a : ℕ} {A : Ideal P}
    (hA : A.map φ ≤ Ideal.span {x ^ a}) (e : ℕ) :
    markedTransform φ x (a * e) (A ^ e) = markedTransform φ x a A ^ e := by
  apply markedTransform_eq_of_map_eq hx
  rw [Ideal.map_pow, map_eq_span_mul_markedTransform hA, mul_pow, Ideal.span_singleton_pow,
    pow_mul]

/-- Lemma 2.2.4 (2), sums: the transform of `(A + B, a)` is the sum of the transforms. -/
theorem markedTransform_sup {φ : F} {x : Q} (hx : x ≠ 0) {a : ℕ} {A B : Ideal P}
    (hA : A.map φ ≤ Ideal.span {x ^ a}) (hB : B.map φ ≤ Ideal.span {x ^ a}) :
    markedTransform φ x a (A ⊔ B) = markedTransform φ x a A ⊔ markedTransform φ x a B := by
  apply markedTransform_eq_of_map_eq hx
  rw [Ideal.map_sup, map_eq_span_mul_markedTransform hA, map_eq_span_mul_markedTransform hB,
    Submodule.mul_sup]

omit [IsDomain Q] [RingHomClass F P Q] in
/-- Lemma 2.2.4 (2), inclusions: `A ⊆ B` gives an inclusion of the transforms. -/
theorem markedTransform_mono (φ : F) (x : Q) (a : ℕ) {A B : Ideal P} (h : A ≤ B) :
    markedTransform φ x a A ≤ markedTransform φ x a B := fun _ hg =>
  mem_markedTransform.mpr (Ideal.map_mono h (mem_markedTransform.mp hg))

omit [RingHomClass F P Q] in
/-- Lemma 2.2.4 (3): for `a' ≤ a`, the transform of `(A, a')` is `x^(a - a')` times the
transform of `(A, a)`. -/
theorem markedTransform_of_mark_le {φ : F} {x : Q} (hx : x ≠ 0) {a a' : ℕ} (h : a' ≤ a)
    {A : Ideal P} (hA : A.map φ ≤ Ideal.span {x ^ a}) :
    markedTransform φ x a' A = Ideal.span {x ^ (a - a')} * markedTransform φ x a A := by
  apply markedTransform_eq_of_map_eq hx
  rw [map_eq_span_mul_markedTransform hA, ← mul_assoc, Ideal.span_singleton_mul_span_singleton,
    ← pow_add, Nat.add_sub_cancel' h]

omit [RingHomClass F P Q] in
/-- Lemma 2.2.4 (3): for `a' ≤ a`, the transform of `(A, a')` is contained in the transform of
`(A, a)`. -/
theorem markedTransform_le_of_mark_le {φ : F} {x : Q} (hx : x ≠ 0) {a a' : ℕ} (h : a' ≤ a)
    {A : Ideal P} (hA : A.map φ ≤ Ideal.span {x ^ a}) :
    markedTransform φ x a' A ≤ markedTransform φ x a A := by
  rw [markedTransform_of_mark_le hx h hA]
  exact Ideal.mul_le_right

/-- Lemma 3.2.2 (2): if `c_i` divides `N` and `(B_i, c_i)` is divisible, then the transform of
`(∑_i B_i^(N / c_i), N)` is `∑_i (B_i')^(N / c_i)`, with `B_i'` the transform of
`(B_i, c_i)`. -/
theorem markedTransform_iSup_pow {ι : Type*} {φ : F} {x : Q} (hx : x ≠ 0)
    (B : ι → Ideal P) (c : ι → ℕ) {N : ℕ} (hc : ∀ i, c i ∣ N)
    (hB : ∀ i, (B i).map φ ≤ Ideal.span {x ^ c i}) :
    markedTransform φ x N (⨆ i, B i ^ (N / c i)) =
      ⨆ i, markedTransform φ x (c i) (B i) ^ (N / c i) := by
  apply markedTransform_eq_of_map_eq hx
  rw [Ideal.map_iSup, Submodule.mul_iSup]
  refine iSup_congr fun i => ?_
  rw [Ideal.map_pow, map_eq_span_mul_markedTransform (hB i), mul_pow, Ideal.span_singleton_pow,
    ← pow_mul, Nat.mul_div_cancel' (hc i)]

end General

section Center

variable {σ R : Type*} [CommRing R] [DecidableEq σ]

/-- The transform of the marked ideal `(I, m)` in the `x_c`-chart of the blowup of the
coordinate center `(x_i : i ∈ S)`: the ideal of the `g` with `y_c^m g` in the ideal generated
by the image of `I` (Volume 2, Definition 2.2.3 (2) of the handbook, in one chart). -/
noncomputable abbrev centerChartTransformIdeal (S : Finset σ) (c : σ) (m : ℕ)
    (I : Ideal (MvPolynomial σ R)) : Ideal (MvPolynomial σ R) :=
  markedTransform (chartSubst S c) (X c) m I

/-- If `I ⊆ I_Z^m`, then the image of `I` in the `x_c`-chart lies in `(y_c^m)`. -/
theorem map_chartSubst_le_span {S : Finset σ} {c : σ} {m : ℕ} {I : Ideal (MvPolynomial σ R)}
    (h : I ≤ chartCenterIdeal S ^ m) :
    I.map (chartSubst S c) ≤ Ideal.span {(X c : MvPolynomial σ R) ^ m} := by
  rw [Ideal.map_le_iff_le_comap]
  intro f hf
  obtain ⟨g, hg⟩ := exists_chartSubst_eq_X_pow_mul (c := c) (h hf)
  rw [Ideal.mem_comap, hg, Ideal.mem_span_singleton]
  exact dvd_mul_right _ _

variable [IsDomain R]

/-- Lemma 2.2.4 (1), products, in the center chart. -/
theorem centerChartTransformIdeal_mul (S : Finset σ) (c : σ) {a b : ℕ}
    {A B : Ideal (MvPolynomial σ R)} (hA : A ≤ chartCenterIdeal S ^ a)
    (hB : B ≤ chartCenterIdeal S ^ b) :
    centerChartTransformIdeal S c (a + b) (A * B) =
      centerChartTransformIdeal S c a A * centerChartTransformIdeal S c b B :=
  markedTransform_mul (X_ne_zero c) (map_chartSubst_le_span hA) (map_chartSubst_le_span hB)

/-- Lemma 2.2.4 (1), powers, in the center chart. -/
theorem centerChartTransformIdeal_pow (S : Finset σ) (c : σ) {a : ℕ}
    {A : Ideal (MvPolynomial σ R)} (hA : A ≤ chartCenterIdeal S ^ a) (e : ℕ) :
    centerChartTransformIdeal S c (a * e) (A ^ e) = centerChartTransformIdeal S c a A ^ e :=
  markedTransform_pow (X_ne_zero c) (map_chartSubst_le_span hA) e

/-- Lemma 2.2.4 (2), sums, in the center chart. -/
theorem centerChartTransformIdeal_sup (S : Finset σ) (c : σ) {a : ℕ}
    {A B : Ideal (MvPolynomial σ R)} (hA : A ≤ chartCenterIdeal S ^ a)
    (hB : B ≤ chartCenterIdeal S ^ a) :
    centerChartTransformIdeal S c a (A ⊔ B) =
      centerChartTransformIdeal S c a A ⊔ centerChartTransformIdeal S c a B :=
  markedTransform_sup (X_ne_zero c) (map_chartSubst_le_span hA) (map_chartSubst_le_span hB)

omit [IsDomain R] in
/-- Lemma 2.2.4 (2), inclusions, in the center chart. -/
theorem centerChartTransformIdeal_mono (S : Finset σ) (c : σ) (a : ℕ)
    {A B : Ideal (MvPolynomial σ R)} (h : A ≤ B) :
    centerChartTransformIdeal S c a A ≤ centerChartTransformIdeal S c a B :=
  markedTransform_mono _ _ a h

/-- Lemma 2.2.4 (3), in the center chart: for `a' ≤ a` and `A ⊆ I_Z^a`, the transform of
`(A, a')` is `y_c^(a - a')` times the transform of `(A, a)`. -/
theorem centerChartTransformIdeal_of_mark_le (S : Finset σ) (c : σ) {a a' : ℕ} (h : a' ≤ a)
    {A : Ideal (MvPolynomial σ R)} (hA : A ≤ chartCenterIdeal S ^ a) :
    centerChartTransformIdeal S c a' A =
      Ideal.span {X c ^ (a - a')} * centerChartTransformIdeal S c a A :=
  markedTransform_of_mark_le (X_ne_zero c) h (map_chartSubst_le_span hA)

/-- Lemma 2.2.4 (3), the inclusion, in the center chart. -/
theorem centerChartTransformIdeal_le_of_mark_le (S : Finset σ) (c : σ) {a a' : ℕ}
    (h : a' ≤ a) {A : Ideal (MvPolynomial σ R)} (hA : A ≤ chartCenterIdeal S ^ a) :
    centerChartTransformIdeal S c a' A ≤ centerChartTransformIdeal S c a A :=
  markedTransform_le_of_mark_le (X_ne_zero c) h (map_chartSubst_le_span hA)

/-- **Volume 2, Lemma 3.2.2 (2) of the handbook**, in the `x_c`-chart of the blowup of the
coordinate center `(x_i : i ∈ S)`. If `c_i` divides `N` and `B_i ⊆ I_Z^(c_i)`, then the
transform of `(∑_i B_i^(N / c_i), N)` is `∑_i (B_i')^(N / c_i)`. -/
theorem centerChartTransformIdeal_iSup_pow {ι : Type*} (S : Finset σ) (c : σ)
    (B : ι → Ideal (MvPolynomial σ R)) (k : ι → ℕ) {N : ℕ} (hk : ∀ i, k i ∣ N)
    (hB : ∀ i, B i ≤ chartCenterIdeal S ^ k i) :
    centerChartTransformIdeal S c N (⨆ i, B i ^ (N / k i)) =
      ⨆ i, centerChartTransformIdeal S c (k i) (B i) ^ (N / k i) :=
  markedTransform_iSup_pow (X_ne_zero c) B k hk fun i => map_chartSubst_le_span (hB i)

omit [IsDomain R] [DecidableEq σ] in
/-- If `I ⊆ I_Z^n`, then `D(I) ⊆ I_Z^(n-1)`. -/
theorem derivIdeal_le_chartCenterIdeal_pow {S : Finset σ} {n : ℕ}
    {I : Ideal (MvPolynomial σ R)} (h : I ≤ chartCenterIdeal S ^ n) :
    derivIdeal I ≤ chartCenterIdeal S ^ (n - 1) := by
  refine sup_le (h.trans (Ideal.pow_le_pow_right (Nat.sub_le n 1))) ?_
  rw [Ideal.span_le]
  rintro _ ⟨i, f, hf, rfl⟩
  rcases n with _ | n
  · simp
  · exact pderiv_mem_centerIdeal_pow S i (h hf)

omit [IsDomain R] [DecidableEq σ] in
/-- If `I ⊆ I_Z^m`, then `D^l(I) ⊆ I_Z^(m-l)`. -/
theorem derivIdeal_iterate_le_chartCenterIdeal_pow {S : Finset σ} {m : ℕ}
    {I : Ideal (MvPolynomial σ R)} (h : I ≤ chartCenterIdeal S ^ m) (l : ℕ) :
    derivIdeal^[l] I ≤ chartCenterIdeal S ^ (m - l) := by
  induction l with
  | zero => simpa using h
  | succ l ih =>
    rw [Function.iterate_succ_apply', Nat.sub_succ]
    exact derivIdeal_le_chartCenterIdeal_pow ih

/-- The transform of the coefficient ideal in the center chart. Let `1 ≤ m` and `I ⊆ I_Z^m`.
Then the transform of `(∑_{l < m} D^l(I)^(m!/(m-l)), m!)` is `∑_{l < m} (J_l)^(m!/(m-l))`,
where `J_l` is the transform of `(D^l(I), m - l)`. This is the first step of the proof of
Volume 2, Proposition 3.2.3 of the handbook, for one blowup. -/
theorem centerChartTransformIdeal_coeffIdeal (S : Finset σ) (c : σ) {m : ℕ}
    {I : Ideal (MvPolynomial σ R)} (h : I ≤ chartCenterIdeal S ^ m) :
    centerChartTransformIdeal S c m.factorial
        (⨆ l : Fin m, (derivIdeal^[l] I) ^ (m.factorial / (m - l))) =
      ⨆ l : Fin m, centerChartTransformIdeal S c (m - l) (derivIdeal^[l] I) ^
        (m.factorial / (m - l)) :=
  centerChartTransformIdeal_iSup_pow S c (fun l : Fin m => derivIdeal^[l] I)
    (fun l => m - l) (fun l => Nat.dvd_factorial (by omega) (Nat.sub_le _ _))
    fun l => derivIdeal_iterate_le_chartCenterIdeal_pow h l

end Center

section Point

variable {σ k : Type*} [Field k] [DecidableEq σ]

/-- If `m ≤ ord I` at the origin, then the image of `I` in the `x_j`-chart of the blowup of the
origin lies in `(x_j^m)`. -/
theorem map_pointChart_le_span (j : σ) (t : σ → k) {m : ℕ} {I : Ideal (MvPolynomial σ k)}
    (h : (m : ℕ∞) ≤ idealOrd I) : I.map (pointChart j t) ≤ Ideal.span {X j ^ m} :=
  (map_pointChart_eq_span_mul_chartTransformIdeal j t h).le.trans Ideal.mul_le_left

/-- Lemma 2.2.4 (1), products, in the `x_j`-chart of the blowup of the origin. -/
theorem chartTransformIdeal_mul (j : σ) (t : σ → k) {a b : ℕ}
    {A B : Ideal (MvPolynomial σ k)} (hA : (a : ℕ∞) ≤ idealOrd A)
    (hB : (b : ℕ∞) ≤ idealOrd B) :
    chartTransformIdeal j t (a + b) (A * B) =
      chartTransformIdeal j t a A * chartTransformIdeal j t b B :=
  markedTransform_mul (X_ne_zero j) (map_pointChart_le_span j t hA)
    (map_pointChart_le_span j t hB)

/-- Lemma 2.2.4 (1), powers, in the `x_j`-chart of the blowup of the origin. -/
theorem chartTransformIdeal_pow (j : σ) (t : σ → k) {a : ℕ} {A : Ideal (MvPolynomial σ k)}
    (hA : (a : ℕ∞) ≤ idealOrd A) (e : ℕ) :
    chartTransformIdeal j t (a * e) (A ^ e) = chartTransformIdeal j t a A ^ e :=
  markedTransform_pow (X_ne_zero j) (map_pointChart_le_span j t hA) e

/-- Lemma 2.2.4 (2), sums, in the `x_j`-chart of the blowup of the origin. -/
theorem chartTransformIdeal_sup (j : σ) (t : σ → k) {a : ℕ}
    {A B : Ideal (MvPolynomial σ k)} (hA : (a : ℕ∞) ≤ idealOrd A)
    (hB : (a : ℕ∞) ≤ idealOrd B) :
    chartTransformIdeal j t a (A ⊔ B) =
      chartTransformIdeal j t a A ⊔ chartTransformIdeal j t a B :=
  markedTransform_sup (X_ne_zero j) (map_pointChart_le_span j t hA)
    (map_pointChart_le_span j t hB)

/-- Lemma 2.2.4 (2), inclusions, in the `x_j`-chart of the blowup of the origin. -/
theorem chartTransformIdeal_mono (j : σ) (t : σ → k) (a : ℕ) {A B : Ideal (MvPolynomial σ k)}
    (h : A ≤ B) : chartTransformIdeal j t a A ≤ chartTransformIdeal j t a B :=
  markedTransform_mono (pointChart j t) (X j) a h

/-- Lemma 2.2.4 (3), in the `x_j`-chart of the blowup of the origin: for `a' ≤ a ≤ ord A`, the
transform of `(A, a')` is `x_j^(a - a')` times the transform of `(A, a)`. -/
theorem chartTransformIdeal_of_mark_le (j : σ) (t : σ → k) {a a' : ℕ} (h : a' ≤ a)
    {A : Ideal (MvPolynomial σ k)} (hA : (a : ℕ∞) ≤ idealOrd A) :
    chartTransformIdeal j t a' A = Ideal.span {X j ^ (a - a')} * chartTransformIdeal j t a A :=
  markedTransform_of_mark_le (X_ne_zero j) h (map_pointChart_le_span j t hA)

/-- Lemma 2.2.4 (3), the inclusion, in the `x_j`-chart of the blowup of the origin. -/
theorem chartTransformIdeal_le_of_mark_le (j : σ) (t : σ → k) {a a' : ℕ} (h : a' ≤ a)
    {A : Ideal (MvPolynomial σ k)} (hA : (a : ℕ∞) ≤ idealOrd A) :
    chartTransformIdeal j t a' A ≤ chartTransformIdeal j t a A :=
  markedTransform_le_of_mark_le (X_ne_zero j) h (map_pointChart_le_span j t hA)

end Point

end Singularity
