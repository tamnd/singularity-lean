/-!
# The charts of the blowup of a regular local ring

Let `R` be a regular local ring with maximal ideal `𝔪` and residue field `κ`, and let
`x ∈ 𝔪 \ 𝔪²`. The chart `R[𝔪/x]` of the blowup of `Spec R` at the closed point is the
`R`-subalgebra of `R_x` generated by the fractions `a/x` with `a ∈ 𝔪`. This file proves that
`R[𝔪/x]` is a regular ring.

## Main results

* `coeff_mem_maximalIdeal_of_aeval_mem_pow`: let `g₀, ..., g_d` generate `𝔪`, with
  `dim R = d + 1`. If a homogeneous polynomial `P` of degree `n` has `P(g) ∈ 𝔪^(n+1)`, then the
  coefficients of `P` are in `𝔪`. Thus the associated graded ring of `R` is a polynomial ring over
  `κ` ([Mat89, Theorem 14.4]).
* `blowupChart`: the chart `R[𝔪/x]`.
* `mem_blowupChart_iff`: the elements of `R[𝔪/x]` are the fractions `b/x^n` with `b ∈ 𝔪^n`.
* `blowupChartQuotientEquiv`: let `x, y₁, ..., y_d` generate `𝔪`, with `dim R = d + 1`. Then
  `R[𝔪/x] / (x)` is isomorphic to the polynomial ring `κ[T₁, ..., T_d]`. This ring is the ring of
  the exceptional divisor in the chart.
* `isNoetherianRing_blowupChart` and `isDomain_blowupChart`.
* `isRegularRing_of_quotient_of_isLocalization`: let `A` be a Noetherian domain and let `t ≠ 0`.
  If `A_t` and `A / (t)` are regular rings, then `A` is a regular ring.
* `isRegularRing_blowupChart`: if `x ∈ 𝔪 \ 𝔪²`, then `R[𝔪/x]` is a regular ring.

## The proof

Let `x = g₀, g₁ = y₁, ..., g_d = y_d` generate `𝔪`, with `dim R = d + 1`. The space
`𝔪^n / 𝔪^(n+1)` has dimension `(n + d).choose d` over `κ` (`length_grPiece_eq_choose`). This is
the number of monomials of degree `n` in `g`. The monomials span the space, so they are linearly
independent. This gives the first result, and with it the equality `(𝔪^(n+1) : x) = 𝔪^n`.

The `R`-algebra map `R[T₁, ..., T_d] → R[𝔪/x] / (x)`, `Tᵢ ↦ yᵢ/x`, is surjective, and `𝔪` goes
to `0`. Let `F` be in the kernel. Then `x^N F(y/x) = G(g)` for the homogenization `G` of `F`, of
degree `N`. With `F(y/x) = x b / x^k` and `b ∈ 𝔪^k`, we get `x^k G(g) = x^(N+1) b ∈ 𝔪^(N+1+k)`.
Thus `G(g) ∈ 𝔪^(N+1)` and the coefficients of `F` are in `𝔪`. So the kernel is `𝔪 R[T]` and
`R[𝔪/x] / (x) ≅ κ[T₁, ..., T_d]`.

Let `P` be a prime of `A = R[𝔪/x]`. If `x ∉ P`, then `A_P` is a localization of `A_x = R_x`, and
`R_x` is a regular ring because `R` is regular. If `x ∈ P`, then `x` is a nonzerodivisor of the
Noetherian local domain `A_P`, and `A_P / (x)` is a localization of `κ[T₁, ..., T_d]`. Thus
`A_P / (x)` is regular, and `A_P` is regular by `of_quotient_span_singleton`.

## References

* [Mat89] H. Matsumura, *Commutative Ring Theory*, Cambridge University Press, 1989.
-/

universe u

open IsLocalRing Ideal MvPolynomial

namespace Singularity.Algebra

variable {R : Type u} [CommRing R]

/-! ### 1. Monomials in the generators of an ideal -/

section Monomial

variable {σ : Type*} [Fintype σ]

/-- A monomial of degree `n` in elements of `I` is in `I^n`. -/
theorem prod_pow_mem_pow_sum {I : Ideal R} {g : σ → R} (hg : ∀ i, g i ∈ I) (s : σ →₀ ℕ) :
    (s.prod fun i e => g i ^ e) ∈ I ^ (∑ i, s i) := by
  rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _), ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow (hg i) _

variable [DecidableEq σ]

/-- The exponents of the monomials of a homogeneous polynomial of degree `n`. -/
theorem mem_finsuppAntidiag_of_coeff_ne_zero {P : MvPolynomial σ R} {n : ℕ}
    (hP : P.IsHomogeneous n) {s : σ →₀ ℕ} (hs : P.coeff s ≠ 0) :
    s ∈ Finset.finsuppAntidiag Finset.univ n := by
  have h := hP hs
  change (Finsupp.weight fun _ => 1) s = n at h
  rw [← Finsupp.degree_eq_weight_one, Finsupp.degree_eq_sum] at h
  exact Finset.mem_finsuppAntidiag.mpr ⟨h, Finset.subset_univ _⟩

/-- The value of a homogeneous polynomial of degree `n`, as a sum over the monomials of degree
`n`. -/
theorem aeval_eq_sum_finsuppAntidiag {P : MvPolynomial σ R} {n : ℕ} (hP : P.IsHomogeneous n)
    (g : σ → R) :
    aeval g P = ∑ s ∈ Finset.finsuppAntidiag Finset.univ n,
      P.coeff s * s.prod fun i e => g i ^ e := by
  conv_lhs => rw [P.as_sum]
  rw [map_sum]
  simp only [aeval_monomial, Algebra.algebraMap_self, RingHom.id_apply]
  refine Finset.sum_subset (fun s hs => mem_finsuppAntidiag_of_coeff_ne_zero hP
    (mem_support_iff.mp hs)) fun s _ hs => ?_
  rw [notMem_support_iff.mp hs, zero_mul]

/-- Let each `g i` be in `I`, and let `P` be homogeneous of degree `n` with coefficients in `J`.
Then `P(g) ∈ J I^n`. -/
theorem aeval_mem_mul_pow {I J : Ideal R} {g : σ → R} (hg : ∀ i, g i ∈ I)
    {P : MvPolynomial σ R} {n : ℕ} (hP : P.IsHomogeneous n) (hJ : ∀ s, P.coeff s ∈ J) :
    aeval g P ∈ J * I ^ n := by
  rw [aeval_eq_sum_finsuppAntidiag hP]
  refine Ideal.sum_mem _ fun s hs => Ideal.mul_mem_mul (hJ s) ?_
  have h := (Finset.mem_finsuppAntidiag.mp hs).1
  rw [← h]
  exact prod_pow_mem_pow_sum hg s

end Monomial

/-- Let `g` generate `I`. Each element of `I^n` is `P(g)` for a homogeneous polynomial `P` of
degree `n`. -/
theorem exists_isHomogeneous_aeval_eq {σ : Type*} {I : Ideal R} {g : σ → R}
    (hI : I = span (Set.range g)) {n : ℕ} {y : R} (hy : y ∈ I ^ n) :
    ∃ P : MvPolynomial σ R, P.IsHomogeneous n ∧ aeval g P = y := by
  induction n generalizing y with
  | zero => exact ⟨C y, isHomogeneous_C _ _, by simp⟩
  | succ n ih =>
    rw [pow_succ] at hy
    refine Submodule.mul_induction_on hy (fun a ha b hb => ?_)
      (fun a b ⟨P, hP, hPa⟩ ⟨Q, hQ, hQb⟩ => ⟨P + Q, hP.add hQ, by rw [map_add, hPa, hQb]⟩)
    obtain ⟨P, hP, rfl⟩ := ih ha
    rw [hI] at hb
    induction hb using Submodule.span_induction with
    | mem b hb =>
      obtain ⟨i, rfl⟩ := hb
      exact ⟨P * X i, hP.mul (isHomogeneous_X _ _), by simp⟩
    | zero => exact ⟨0, isHomogeneous_zero _ _ _, by simp⟩
    | add b c _ _ hb hc =>
      obtain ⟨Q, hQ, hQb⟩ := hb
      obtain ⟨Q', hQ', hQc⟩ := hc
      exact ⟨Q + Q', hQ.add hQ', by rw [map_add, hQb, hQc, mul_add]⟩
    | smul r b _ hb =>
      obtain ⟨Q, hQ, hQb⟩ := hb
      refine ⟨C r * Q, ?_, ?_⟩
      · simpa using hQ.C_mul r
      · rw [map_mul, hQb, aeval_C, Algebra.algebraMap_self, RingHom.id_apply, smul_eq_mul]
        ring

/-! ### 2. The associated graded ring of a regular local ring -/

section Graded

variable [IsRegularLocalRing R]

/-- Let `R` be a regular local ring of dimension `d + 1` and let `g : Fin (d + 1) → R` generate
`𝔪`. Let `P` be homogeneous of degree `n` with `P(g) ∈ 𝔪^(n+1)`. Then each coefficient of `P` is in
`𝔪`. Thus the monomials of degree `n` in `g` are linearly independent in `𝔪^n / 𝔪^(n+1)` over the
residue field, and the associated graded ring of `R` is a polynomial ring ([Mat89, Theorem
14.4]). -/
theorem coeff_mem_maximalIdeal_of_aeval_mem_pow {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {g : Fin (d + 1) → R} (hg : maximalIdeal R = span (Set.range g)) {n : ℕ}
    {P : MvPolynomial (Fin (d + 1)) R} (hP : P.IsHomogeneous n)
    (hPm : aeval g P ∈ maximalIdeal R ^ (n + 1)) (s : Fin (d + 1) →₀ ℕ) :
    P.coeff s ∈ maximalIdeal R := by
  classical
  set m := maximalIdeal R with hm
  have hgm : ∀ i, g i ∈ m := fun i => hg ▸ subset_span ⟨i, rfl⟩
  have hsm : ∀ k, (m ^ k • ⊤ : Submodule R R) = m ^ k := fun k => by
    rw [smul_eq_mul, Ideal.mul_top]
  set V := grPiece m R n
  -- `V` is a vector space over `κ = R / 𝔪`.
  have hT : Module.IsTorsionBySet R V m := by
    intro z a
    obtain ⟨y, rfl⟩ := grMk_surjective m R n z
    refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
    exact smul_mem_pow_smul a.2 y.2
  let _ : Field (R ⧸ m) := Ideal.Quotient.field m
  let _ : Module (R ⧸ m) V := hT.module
  have : IsScalarTower R (R ⧸ m) V := hT.isScalarTower
  have : Module.Finite R V := Module.Finite.of_surjective (grMk m R n) (grMk_surjective m R n)
  have : Module.Finite (R ⧸ m) V := Module.Finite.of_restrictScalars_finite R (R ⧸ m) V
  have hfin : Module.finrank (R ⧸ m) V = (n + d).choose d := by
    have h : Module.length R V = _ := length_grPiece_eq_choose hd n
    rw [Module.length_eq_of_surjective (S := R) (R := R ⧸ m) (M := V)
      Ideal.Quotient.mk_surjective, Module.length_eq_finrank] at h
    exact_mod_cast h
  -- The monomials of degree `n`.
  set S := Finset.finsuppAntidiag (Finset.univ : Finset (Fin (d + 1))) n
  have hmono : ∀ s : S, ((s : Fin (d + 1) →₀ ℕ).prod fun i e => g i ^ e) ∈
      (m ^ n • ⊤ : Submodule R R) := by
    intro s
    rw [hsm, ← (Finset.mem_finsuppAntidiag.mp s.2).1]
    exact prod_pow_mem_pow_sum hgm s
  let w : S → V := fun s => grMk m R n ⟨_, hmono s⟩
  have hsum : ∀ (Q : MvPolynomial (Fin (d + 1)) R) (hQ : Q.IsHomogeneous n)
      (h : aeval g Q ∈ (m ^ n • ⊤ : Submodule R R)),
      grMk m R n ⟨aeval g Q, h⟩ = ∑ s : S, Q.coeff s • w s := by
    intro Q hQ h
    have : (⟨aeval g Q, h⟩ : (m ^ n • ⊤ : Submodule R R)) =
        ∑ s : S, Q.coeff s • ⟨_, hmono s⟩ := by
      ext
      simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul]
      rw [aeval_eq_sum_finsuppAntidiag hQ, ← Finset.sum_coe_sort]
    rw [this, map_sum]
    simp only [map_smul, w]
  -- The monomials span `V`, so they are linearly independent.
  have hspan : ⊤ ≤ Submodule.span (R ⧸ m) (Set.range w) := by
    rintro z -
    obtain ⟨⟨y, hy⟩, rfl⟩ := grMk_surjective m R n z
    obtain ⟨Q, hQ, rfl⟩ := exists_isHomogeneous_aeval_eq hg (hsm n ▸ hy)
    rw [hsum Q hQ hy]
    refine Submodule.sum_mem _ fun s _ => ?_
    rw [← algebraMap_smul (R ⧸ m)]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨s, rfl⟩)
  have hcard : Fintype.card S = Module.finrank (R ⧸ m) V := by
    rw [hfin, Fintype.card_coe, Finset.card_finsuppAntidiag_nat_eq_choose, Finset.card_univ,
      Fintype.card_fin, show d + 1 + n - 1 = n + d by omega, Nat.choose_symm_add]
  have hli := linearIndependent_of_top_le_span_of_card_eq_finrank hspan hcard
  -- The class of `P(g)` is `0`.
  have hPn : aeval g P ∈ (m ^ n • ⊤ : Submodule R R) := by
    rw [hsm]
    exact Ideal.pow_le_pow_right n.le_succ hPm
  have h0 : ∑ s : S, (Ideal.Quotient.mk m (P.coeff s)) • w s = 0 := by
    simp only [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
    rw [← hsum P hP hPn]
    refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
    change aeval g P ∈ (m ^ (n + 1) • ⊤ : Submodule R R)
    rw [hsm]
    exact hPm
  by_cases hs : P.coeff s = 0
  · rw [hs]
    exact zero_mem _
  · have hsS : s ∈ S := mem_finsuppAntidiag_of_coeff_ne_zero hP hs
    have := Fintype.linearIndependent_iff.mp hli _ h0 ⟨s, hsS⟩
    exact Ideal.Quotient.eq_zero_iff_mem.mp this

/-- Let `g : Fin (d + 1) → R` generate `𝔪`, with `dim R = d + 1`. Then each `g i` is not in
`𝔪²`. -/
theorem notMem_maximalIdeal_sq_of_span {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {g : Fin (d + 1) → R} (hg : maximalIdeal R = span (Set.range g)) (i : Fin (d + 1)) :
    g i ∉ maximalIdeal R ^ 2 := by
  intro h
  have := coeff_mem_maximalIdeal_of_aeval_mem_pow hd hg (isHomogeneous_X R i)
    (by rwa [aeval_X]) (Finsupp.single i 1)
  rw [coeff_X] at this
  simp only [↓reduceIte] at this
  exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr this)

/-- Let `g : Fin (d + 1) → R` generate `𝔪`, with `dim R = d + 1`. If `g₀ v ∈ 𝔪^(k+1)`, then
`v ∈ 𝔪^k`. -/
theorem mem_pow_of_mul_mem_pow_succ_of_span {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {g : Fin (d + 1) → R} (hg : maximalIdeal R = span (Set.range g)) {k : ℕ} {v : R}
    (hv : g 0 * v ∈ maximalIdeal R ^ (k + 1)) : v ∈ maximalIdeal R ^ k := by
  have hgm : ∀ i, g i ∈ maximalIdeal R := fun i => hg ▸ subset_span ⟨i, rfl⟩
  suffices h : ∀ j ≤ k, v ∈ maximalIdeal R ^ j from h k le_rfl
  intro j
  induction j with
  | zero =>
    intro _
    rw [pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  | succ j ih =>
    intro hj
    obtain ⟨P, hP, rfl⟩ := exists_isHomogeneous_aeval_eq hg (ih (by omega))
    have hXP : (X 0 * P).IsHomogeneous (j + 1) := by
      have := (isHomogeneous_X R (0 : Fin (d + 1))).mul hP
      rwa [Nat.add_comm 1 j] at this
    have hmem : aeval g (X 0 * P) ∈ maximalIdeal R ^ (j + 1 + 1) := by
      rw [map_mul, aeval_X]
      exact Ideal.pow_le_pow_right (by omega) hv
    have hc : ∀ s, P.coeff s ∈ maximalIdeal R := fun s => by
      have := coeff_mem_maximalIdeal_of_aeval_mem_pow hd hg hXP hmem (Finsupp.single 0 1 + s)
      rwa [coeff_X_mul] at this
    have := aeval_mem_mul_pow hgm hP hc
    rwa [← pow_succ'] at this

/-- Let `g : Fin (d + 1) → R` generate `𝔪`, with `dim R = d + 1`. If `g₀^n v ∈ 𝔪^(k+n)`, then
`v ∈ 𝔪^k`. -/
theorem mem_pow_of_pow_mul_mem_pow_add_of_span {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {g : Fin (d + 1) → R} (hg : maximalIdeal R = span (Set.range g)) {k n : ℕ} {v : R}
    (hv : g 0 ^ n * v ∈ maximalIdeal R ^ (k + n)) : v ∈ maximalIdeal R ^ k := by
  induction n with
  | zero => simpa using hv
  | succ n ih =>
    rw [pow_succ', mul_assoc, ← add_assoc] at hv
    exact ih (mem_pow_of_mul_mem_pow_succ_of_span hd hg hv)

end Graded

/-! ### 3. The chart `R[𝔪/x]` -/

section Chart

variable [IsLocalRing R]

variable (R) in
/-- The chart `R[𝔪/x]` of the blowup of a local ring `R` at its maximal ideal `𝔪`: the
`R`-subalgebra of `R_x` generated by the fractions `a/x` with `a ∈ 𝔪`. -/
noncomputable def blowupChart (x : R) : Subalgebra R (Localization.Away x) :=
  Algebra.adjoin R ((fun a => algebraMap R (Localization.Away x) a *
    IsLocalization.Away.invSelf x) '' (maximalIdeal R : Set R))

/-- For `a ∈ 𝔪`, the fraction `a/x` is in `R[𝔪/x]`. -/
theorem div_mem_blowupChart {x a : R} (ha : a ∈ maximalIdeal R) :
    algebraMap R (Localization.Away x) a * IsLocalization.Away.invSelf x ∈ blowupChart R x :=
  Algebra.subset_adjoin ⟨a, ha, rfl⟩

/-- For `b ∈ 𝔪^n`, the fraction `b/x^n` is in `R[𝔪/x]`. -/
theorem div_pow_mem_blowupChart {x : R} (n : ℕ) {b : R} (hb : b ∈ maximalIdeal R ^ n) :
    algebraMap R (Localization.Away x) b * IsLocalization.Away.invSelf x ^ n ∈
      blowupChart R x := by
  induction n generalizing b with
  | zero => simp
  | succ n ih =>
    rw [pow_succ] at hb
    refine Submodule.mul_induction_on hb (fun c hc a ha => ?_) (fun a c ha hc => ?_)
    · rw [map_mul, pow_succ, show ∀ p q r s : Localization.Away x, p * q * (r * s) =
          (p * r) * (q * s) from fun _ _ _ _ => by ring]
      exact Subalgebra.mul_mem _ (ih hc) (div_mem_blowupChart ha)
    · rw [map_add, add_mul]
      exact Subalgebra.add_mem _ ha hc

/-- The elements of `R[𝔪/x]` are the fractions `b/x^n` with `b ∈ 𝔪^n`. -/
theorem mem_blowupChart_iff {x : R} (hx : x ∈ maximalIdeal R) {z : Localization.Away x} :
    z ∈ blowupChart R x ↔ ∃ n : ℕ, ∃ b ∈ maximalIdeal R ^ n,
      z * algebraMap R (Localization.Away x) x ^ n = algebraMap R (Localization.Away x) b := by
  constructor
  · intro hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨a, ha, rfl⟩ := hz
      refine ⟨1, a, by rwa [pow_one], ?_⟩
      rw [pow_one, mul_assoc, mul_comm (IsLocalization.Away.invSelf x),
        IsLocalization.Away.mul_invSelf, mul_one]
    | algebraMap r => exact ⟨0, r, by simp, by simp⟩
    | add z w _ _ hz hw =>
      obtain ⟨n, b, hb, hzb⟩ := hz
      obtain ⟨k, c, hc, hwc⟩ := hw
      refine ⟨n + k, b * x ^ k + c * x ^ n, Ideal.add_mem _ ?_ ?_, ?_⟩
      · rw [pow_add]
        exact Ideal.mul_mem_mul hb (Ideal.pow_mem_pow hx k)
      · rw [pow_add, mul_comm (maximalIdeal R ^ n)]
        exact Ideal.mul_mem_mul hc (Ideal.pow_mem_pow hx n)
      · rw [map_add, map_mul, map_mul, map_pow, map_pow, ← hzb, ← hwc]
        ring
    | mul z w _ _ hz hw =>
      obtain ⟨n, b, hb, hzb⟩ := hz
      obtain ⟨k, c, hc, hwc⟩ := hw
      refine ⟨n + k, b * c, by rw [pow_add]; exact Ideal.mul_mem_mul hb hc, ?_⟩
      rw [map_mul, ← hzb, ← hwc]
      ring
  · rintro ⟨n, b, hb, hzb⟩
    have h1 : (algebraMap R (Localization.Away x) x * IsLocalization.Away.invSelf x) ^ n = 1 := by
      rw [IsLocalization.Away.mul_invSelf, one_pow]
    have : z = algebraMap R (Localization.Away x) b * IsLocalization.Away.invSelf x ^ n := by
      rw [← hzb, mul_assoc, ← mul_pow, h1, mul_one]
    rw [this]
    exact div_pow_mem_blowupChart n hb

omit [IsLocalRing R] in
/-- If `R` is a domain and `x ≠ 0`, then `R → R_x` is injective. -/
theorem algebraMap_away_injective [IsDomain R] {x : R} (hx0 : x ≠ 0) :
    Function.Injective (algebraMap R (Localization.Away x)) :=
  IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)

/-- The localization of `R[𝔪/x]` away from `x` is `R_x`. -/
theorem isLocalization_blowupChart (x : R) :
    IsLocalization (Submonoid.powers (algebraMap R (blowupChart R x) x))
      (Localization.Away x) := by
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, k, rfl⟩
    have := IsLocalization.map_units (Localization.Away x)
      (⟨x ^ k, k, rfl⟩ : Submonoid.powers x)
    simpa using this
  · intro z
    obtain ⟨⟨r, s⟩, h⟩ := IsLocalization.surj (Submonoid.powers x) z
    obtain ⟨k, hk⟩ := s.2
    refine ⟨⟨algebraMap R _ r, ⟨algebraMap R _ x ^ k, k, rfl⟩⟩, ?_⟩
    simpa [← hk] using h
  · intro a b h
    exact ⟨1, by simpa using Subtype.ext h⟩

/-- If `R` is a domain and `x ≠ 0`, then `R[𝔪/x]` is a domain. -/
theorem isDomain_blowupChart [IsDomain R] {x : R} (hx0 : x ≠ 0) : IsDomain (blowupChart R x) :=
  have : IsDomain (Localization.Away x) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)
  inferInstance

end Chart

/-! ### 4. A presentation of the chart -/

section Presentation

variable [IsLocalRing R]

/-- The `R`-algebra map `R[T₁, ..., T_d] → R[𝔪/x]` with `Tᵢ ↦ yᵢ/x`. -/
noncomputable def blowupChartAeval {d : ℕ} (x : R) {y : Fin d → R}
    (hy : ∀ i, y i ∈ maximalIdeal R) : MvPolynomial (Fin d) R →ₐ[R] blowupChart R x :=
  aeval fun i => ⟨_, div_mem_blowupChart (hy i)⟩

theorem coe_blowupChartAeval {d : ℕ} (x : R) {y : Fin d → R} (hy : ∀ i, y i ∈ maximalIdeal R)
    (F : MvPolynomial (Fin d) R) :
    (blowupChartAeval x hy F : Localization.Away x) =
      aeval (fun i => algebraMap R (Localization.Away x) (y i) * IsLocalization.Away.invSelf x)
        F := by
  rw [← Subalgebra.val_apply, blowupChartAeval, comp_aeval_apply]
  rfl

/-- Let `x, y₁, ..., y_d` generate `𝔪`. Then the fractions `yᵢ/x` generate `R[𝔪/x]`. -/
theorem blowupChartAeval_surjective {d : ℕ} {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R))) :
    Function.Surjective (blowupChartAeval x (y := y) fun i =>
      hg ▸ subset_span ⟨i.succ, Fin.cons_succ _ _ _⟩) := by
  set ι := algebraMap R (Localization.Away x)
  set u := IsLocalization.Away.invSelf (S := Localization.Away x) x
  have hle : blowupChart R x ≤ Algebra.adjoin R (Set.range fun i => ι (y i) * u) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨a, ha, rfl⟩
    rw [SetLike.mem_coe, hg] at ha
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp ha
    have : ι (∑ i, c i • (Fin.cons x y : Fin (d + 1) → R) i) * u =
        algebraMap R _ (c 0) + ∑ j, algebraMap R _ (c j.succ) * (ι (y j) * u) := by
      simp only [Fin.sum_univ_succ, smul_eq_mul, Fin.cons_zero, Fin.cons_succ, map_add, map_sum,
        map_mul, add_mul, Finset.sum_mul]
      rw [mul_assoc, IsLocalization.Away.mul_invSelf, mul_one]
      congr 1
      exact Finset.sum_congr rfl fun j _ => by ring
    simp only at this ⊢
    rw [this]
    refine Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ _) (Subalgebra.sum_mem _ fun j _ => ?_)
    exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin ⟨j, rfl⟩)
  rintro ⟨z, hz⟩
  have hz' := hle hz
  rw [Algebra.adjoin_range_eq_range_aeval] at hz'
  obtain ⟨F, hF⟩ := hz'
  exact ⟨F, Subtype.ext ((coe_blowupChartAeval x _ F).trans hF)⟩

end Presentation

/-! ### 5. The chart modulo `x` -/

section Quotient

variable [IsRegularLocalRing R]

/-- Let `x, y₁, ..., y_d` generate `𝔪`, with `dim R = d + 1`. Let `F` be a polynomial such that
`F(y/x)` is a multiple of `x` in `R[𝔪/x]`. Then all coefficients of `F` are in `𝔪`. -/
theorem coeff_mem_maximalIdeal_of_blowupChartAeval_mem {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R)))
    (hy : ∀ i, y i ∈ maximalIdeal R) {F : MvPolynomial (Fin d) R}
    (hF : blowupChartAeval x hy F ∈ span {algebraMap R (blowupChart R x) x}) (α : Fin d →₀ ℕ) :
    F.coeff α ∈ maximalIdeal R := by
  set g : Fin (d + 1) → R := Fin.cons x y
  set ι := algebraMap R (Localization.Away x)
  set u := IsLocalization.Away.invSelf (S := Localization.Away x) x
  have hx : x ∈ maximalIdeal R := hg ▸ subset_span ⟨0, rfl⟩
  have hx0 : x ≠ 0 := by
    intro h
    apply notMem_maximalIdeal_sq_of_span hd hg 0
    change x ∈ _
    rw [h]
    exact Ideal.zero_mem _
  have := isDomain_of_isRegularLocalRing R
  have hι := algebraMap_away_injective hx0
  set N := F.totalDegree
  let β' : (Fin d →₀ ℕ) → (Fin (d + 1) →₀ ℕ) := fun β => Finsupp.cons (N - β.degree) β
  let H : MvPolynomial (Fin (d + 1)) R := ∑ β ∈ F.support, monomial (β' β) (F.coeff β)
  have hdeg : ∀ β ∈ F.support, β.degree ≤ N := fun β hβ => le_totalDegree hβ
  have hH : H.IsHomogeneous N := by
    refine IsHomogeneous.sum _ _ _ fun β hβ => isHomogeneous_monomial _ ?_
    rw [Finsupp.degree_eq_sum, Fin.sum_univ_succ]
    simp only [β', Finsupp.cons_zero, Finsupp.cons_succ]
    rw [← Finsupp.degree_eq_sum]
    exact Nat.sub_add_cancel (hdeg β hβ)
  have hHc : ∀ β ∈ F.support, H.coeff (β' β) = F.coeff β := by
    intro β hβ
    simp only [H, coeff_sum, coeff_monomial]
    rw [Finset.sum_eq_single β (fun γ _ hγ => ?_) (fun h => absurd hβ h)]
    · simp
    · split_ifs with he
      · exact absurd (by simpa [β'] using congrArg Finsupp.tail he) hγ
      · rfl
  have hterm : ∀ β ∈ F.support, ι (aeval g (monomial (β' β) (F.coeff β))) =
      ι x ^ N * aeval (fun i => ι (y i) * u) (monomial β (F.coeff β)) := by
    intro β hβ
    rw [aeval_monomial, aeval_monomial, Finsupp.prod_fintype _ _ (by simp),
      Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_succ]
    simp only [β', g, Finsupp.cons_zero, Finsupp.cons_succ, Fin.cons_zero, Fin.cons_succ, mul_pow,
      Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, map_mul, map_pow, map_prod,
      Algebra.algebraMap_self, RingHom.id_apply]
    rw [← Finsupp.degree_eq_sum]
    have h1 : ι x ^ β.degree * u ^ β.degree = 1 := by
      rw [← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
    have h2 : ι x ^ N = ι x ^ (N - β.degree) * ι x ^ β.degree := by
      rw [← pow_add, Nat.sub_add_cancel (hdeg β hβ)]
    rw [h2]
    linear_combination (-(algebraMap R (Localization.Away x) (F.coeff β) * ι x ^ (N - β.degree) *
      ∏ i, ι (y i) ^ β i)) * h1
  have hHF : ι (aeval g H) = ι x ^ N * (blowupChartAeval x hy F : Localization.Away x) := by
    rw [coe_blowupChartAeval]
    conv_rhs => rw [F.as_sum]
    rw [map_sum, map_sum, map_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl hterm
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hF
  obtain ⟨n, b, hb, hzb⟩ := (mem_blowupChart_iff hx).mp z.2
  have hz' : (z : Localization.Away x) * ι x = blowupChartAeval x hy F := by
    rw [← hz]
    rfl
  have heq : g 0 ^ n * aeval g H = x ^ (N + 1) * b := by
    apply hι
    rw [map_mul, map_pow, hHF, ← hz', map_mul, map_pow, ← hzb]
    change ι x ^ n * _ = _
    ring
  have hmem : g 0 ^ n * aeval g H ∈ maximalIdeal R ^ (N + 1 + n) := by
    rw [heq, pow_add]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hx _) hb
  have hHm := mem_pow_of_pow_mul_mem_pow_add_of_span hd hg hmem
  by_cases hα : α ∈ F.support
  · rw [← hHc α hα]
    exact coeff_mem_maximalIdeal_of_aeval_mem_pow hd hg hH hHm _
  · rw [notMem_support_iff.mp hα]
    exact Ideal.zero_mem _

/-- The map `R[T₁, ..., T_d] → R[𝔪/x] / (x)`. -/
noncomputable def blowupChartQuotientHom {d : ℕ} (x : R) {y : Fin d → R}
    (hy : ∀ i, y i ∈ maximalIdeal R) :
    MvPolynomial (Fin d) R →+* blowupChart R x ⧸ span {algebraMap R (blowupChart R x) x} :=
  (Ideal.Quotient.mk _).comp (blowupChartAeval x hy).toRingHom

theorem ker_blowupChartQuotientHom {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R)))
    (hy : ∀ i, y i ∈ maximalIdeal R) :
    RingHom.ker (blowupChartQuotientHom x hy) = RingHom.ker (MvPolynomial.map (residue R)) := by
  ext F
  rw [ker_map, ker_residue, MvPolynomial.mem_map_C_iff, RingHom.mem_ker, blowupChartQuotientHom,
    RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
  refine ⟨fun h α => coeff_mem_maximalIdeal_of_blowupChartAeval_mem hd hg hy h α, fun h => ?_⟩
  have hc : ∀ a ∈ maximalIdeal R, algebraMap R (blowupChart R x) a ∈
      span {algebraMap R (blowupChart R x) x} := by
    intro a ha
    refine Ideal.mem_span_singleton'.mpr ⟨⟨_, div_mem_blowupChart ha⟩, Subtype.ext ?_⟩
    change algebraMap R (Localization.Away x) a * IsLocalization.Away.invSelf x *
      algebraMap R (Localization.Away x) x = algebraMap R (Localization.Away x) a
    rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf x), IsLocalization.Away.mul_invSelf,
      mul_one]
  change blowupChartAeval x hy F ∈ _
  rw [F.as_sum, map_sum]
  refine Ideal.sum_mem _ fun β _ => ?_
  rw [blowupChartAeval, aeval_monomial]
  exact Ideal.mul_mem_right _ _ (hc _ (h β))

/-- Let `x, y₁, ..., y_d` generate `𝔪`, with `dim R = d + 1`. Then `R[𝔪/x] / (x)` is the
polynomial ring `κ[T₁, ..., T_d]` over the residue field `κ` of `R`. -/
noncomputable def blowupChartQuotientEquiv {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R))) :
    blowupChart R x ⧸ span {algebraMap R (blowupChart R x) x} ≃+*
      MvPolynomial (Fin d) (ResidueField R) :=
  have hy : ∀ i, y i ∈ maximalIdeal R := fun i => hg ▸ subset_span ⟨i.succ, Fin.cons_succ _ _ _⟩
  have hs : Function.Surjective (blowupChartQuotientHom x hy) :=
    Ideal.Quotient.mk_surjective.comp (blowupChartAeval_surjective hg)
  (RingHom.quotientKerEquivOfSurjective hs).symm.trans
    ((Ideal.quotEquivOfEq (ker_blowupChartQuotientHom hd hg hy)).trans
      (RingHom.quotientKerEquivOfSurjective
        (MvPolynomial.map_surjective (residue R) residue_surjective)))

end Quotient

/-! ### 6. Regularity of the chart -/

/-- Let `A` be a Noetherian domain and let `t ≠ 0` in `A`. Assume that `A_t` and `A / (t)` are
regular rings. Then `A` is a regular ring. -/
theorem isRegularRing_of_quotient_of_isLocalization {A : Type*} [CommRing A] [IsDomain A]
    [IsNoetherianRing A] (t : A) (ht : t ≠ 0) (L : Type*) [CommRing L] [Algebra A L]
    [IsLocalization (Submonoid.powers t) L] [hL : IsRegularRing L]
    (hq : IsRegularRing (A ⧸ span {t})) : IsRegularRing A := by
  rw [isRegularRing_iff]
  intro P hP
  by_cases htP : t ∈ P
  · have hpq : span {t} ≤ P := (span_singleton_le_iff_mem _).mpr htP
    have := isPrime_map_quotient _ P hpq
    have h2 := isRegularRing_iff.mp hq (P.map (Ideal.Quotient.mk _))
    have h3 : IsRegularLocalRing (Localization.AtPrime P ⧸ (span {t}).map
        (algebraMap A (Localization.AtPrime P))) :=
      IsRegularLocalRing.of_ringEquiv (localizationQuotientEquiv _ P hpq)
    rw [Ideal.map_span, Set.image_singleton] at h3
    have : IsNoetherianRing (Localization.AtPrime P) :=
      IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
    have : IsDomain (Localization.AtPrime P) := IsLocalization.isDomain_of_atPrime _ P
    refine (of_quotient_span_singleton ?_ ?_ h3).1
    · exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ P _).mpr htP
    · refine mem_nonZeroDivisors_of_ne_zero fun h => ht ?_
      exact IsLocalization.injective (Localization.AtPrime P) P.primeCompl_le_nonZeroDivisors
        (h.trans (map_zero _).symm)
  · have disj : Disjoint (Submonoid.powers t : Set A) (P : Set A) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hn
      exact htP (hP.mem_of_pow_mem n hn)
    have : (P.map (algebraMap A L)).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers t) L P hP disj
    have : IsLocalization.AtPrime (Localization.AtPrime (P.map (algebraMap A L))) P := by
      convert IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.powers t) (Localization.AtPrime (P.map (algebraMap A L)))
        (P.map (algebraMap A L))
      exact (IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers t) L hP disj).symm
    have := isRegularRing_iff.mp hL (P.map (algebraMap A L))
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv P.primeCompl
      (Localization.AtPrime (P.map (algebraMap A L))) (Localization.AtPrime P)).toRingEquiv

section Regular

variable [IsRegularLocalRing R]

/-- Let `x, y₁, ..., y_d` generate `𝔪`. Then `R[𝔪/x]` is Noetherian. -/
theorem isNoetherianRing_blowupChart_of_span {d : ℕ} {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R))) :
    IsNoetherianRing (blowupChart R x) :=
  isNoetherianRing_of_surjective _ _
    (blowupChartAeval x fun i => hg ▸ subset_span ⟨i.succ, Fin.cons_succ _ _ _⟩).toRingHom
    (blowupChartAeval_surjective hg)

/-- Let `x, y₁, ..., y_d` generate `𝔪`, with `dim R = d + 1`. Then `R[𝔪/x]` is a regular
ring. -/
theorem isRegularRing_blowupChart_of_span {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ))
    {x : R} {y : Fin d → R}
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R))) :
    IsRegularRing (blowupChart R x) := by
  have hx0 : x ≠ 0 := by
    intro h
    apply notMem_maximalIdeal_sq_of_span hd hg 0
    change x ∈ _
    rw [h]
    exact Ideal.zero_mem _
  have := isDomain_of_isRegularLocalRing R
  have : IsDomain (blowupChart R x) := isDomain_blowupChart hx0
  have : IsNoetherianRing (blowupChart R x) := isNoetherianRing_blowupChart_of_span hg
  have : IsRegularRing R := isRegularRing_iff.mpr fun p _ => isRegularLocalRing_localization p
  have : IsRegularRing (Localization.Away x) :=
    isRegularRing_of_isLocalization (Submonoid.powers x)
  have hxA0 : algebraMap R (blowupChart R x) x ≠ 0 := fun h => hx0 (algebraMap_away_injective hx0
    (by rw [map_zero]; exact congrArg Subtype.val h))
  have := isLocalization_blowupChart (R := R) x
  exact isRegularRing_of_quotient_of_isLocalization _ hxA0 (Localization.Away x)
    (IsRegularRing.of_ringEquiv (blowupChartQuotientEquiv hd hg).symm)

/-- Let `x ∈ 𝔪 \ 𝔪²`. Then `𝔪` has generators `x, y₁, ..., y_d` with `dim R = d + 1`. -/
theorem exists_fin_cons_span_eq_maximalIdeal {x : R} (hx : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) :
    ∃ d : ℕ, ∃ y : Fin d → R, ringKrullDim R = (d + 1 : ℕ) ∧
      maximalIdeal R = span (Set.range (Fin.cons x y : Fin (d + 1) → R)) := by
  obtain ⟨t, -, hcard, hspan⟩ := exists_span_insert_eq_maximalIdeal hx hx2
  refine ⟨t.card, fun i => (t.equivFin.symm i : R), ?_, ?_⟩
  · have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hcard] at this
    exact_mod_cast this.symm
  · rw [hspan, Fin.range_cons]
    congr 2
    ext a
    constructor
    · intro ha
      exact ⟨t.equivFin ⟨a, ha⟩, by simp⟩
    · rintro ⟨i, rfl⟩
      exact (t.equivFin.symm i).2

/-- **The chart of the blowup of a regular local ring is regular.** Let `R` be a regular local
ring and let `x ∈ 𝔪 \ 𝔪²`. Then `R[𝔪/x]` is a regular ring. -/
theorem isRegularRing_blowupChart {x : R} (hx : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) : IsRegularRing (blowupChart R x) := by
  obtain ⟨d, y, hd, hg⟩ := exists_fin_cons_span_eq_maximalIdeal hx hx2
  exact isRegularRing_blowupChart_of_span hd hg

/-- Let `R` be a regular local ring and let `x ∈ 𝔪 \ 𝔪²`. Then `R[𝔪/x]` is Noetherian. -/
theorem isNoetherianRing_blowupChart {x : R} (hx : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2) : IsNoetherianRing (blowupChart R x) :=
  have := isRegularRing_blowupChart hx hx2
  inferInstance

end Regular


