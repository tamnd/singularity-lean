import Singularity.Algebra.Multiplicity
import Singularity.Algebra.RegularSequence

/-!
# The multiplicity of a regular local ring

Let `R` be a regular local ring of dimension `d` with maximal ideal `𝔪`. This file proves that
the Hilbert-Samuel function of `R` is `χ(n) = ℓ(R / 𝔪^n) = (n + d - 1).choose d` for `n ≥ 1`,
that `ℓ(𝔪^n / 𝔪^(n+1)) = (n + d - 1).choose (d - 1)` for `d ≥ 1`, and that the multiplicity
`e_d(𝔪, R)` is `1` ([AM69, Theorem 11.22]). The number `(n + d - 1).choose (d - 1)` is the number
of monomials of degree `n` in `d` variables. The length `ℓ(𝔪^n / 𝔪^(n+1))` over `R` is the
dimension of `𝔪^n / 𝔪^(n+1)` over the residue field.

## Main results

* `Singularity.Algebra.mem_pow_of_mul_mem_of_isWeaklyRegular`: let `I` be generated by a weakly
  regular sequence in `𝔪`, and let `z` be a nonzerodivisor on `R / I`. Then `z` is a
  nonzerodivisor on each `R / I^n` ([Mat89, §16]).
* `Singularity.Algebra.hilbertSamuel_succ_of_isWeaklyRegular`: if `𝔪` is generated by a weakly
  regular sequence of length `d`, then `ℓ(R / 𝔪^(n+1)) = (n + d).choose d`.
* `Singularity.Algebra.hilbertSamuel_succ_eq_choose`, `hilbertSamuel_eq_choose`: the
  Hilbert-Samuel function of a regular local ring.
* `Singularity.Algebra.length_grPiece_eq_choose`: `ℓ(𝔪^n / 𝔪^(n+1)) = (n + d - 1).choose (d - 1)`
  for a regular local ring of dimension `d ≥ 1`.
* `Singularity.Algebra.samuelMultiplicity_regular`: `e_d(𝔪, R) = 1`.

## The proof

We do not use the associated graded ring. Let `x₁, ..., x_d` be a regular sequence that generates
`𝔪` (`exists_isRegular_of_ringKrullDim_eq`). Put `a = x₁` and `J = (x₂, ..., x_d)`, thus
`𝔪 = (a) + J`. The main step is the equality `(𝔪^(n+1) : a) = 𝔪^n`. Then the exact sequence
`0 → R / 𝔪^n → R / 𝔪^(n+1) → R / ((a) + 𝔪^(n+1)) → 0`, where the first map is the
multiplication by `a`, gives `χ(n + 1) = χ(n) + χ'(n + 1)`. Here `χ'` is the Hilbert-Samuel
function of `R / (a)`, whose maximal ideal is generated by a regular sequence of length `d - 1`.
Induction on `d` and the rule of Pascal give the result.

For the main step, the sequence `x₂, ..., x_d, a` is also regular, because `R` is local. Thus `a`
is a nonzerodivisor on `R / J`. Then `a` is a nonzerodivisor on each `R / J^n` (the statement in
the first bullet point above, for the shorter sequence `x₂, ..., x_d`). Let `a u ∈ 𝔪^(n+1)`. Since
`𝔪^(n+1) = J^(n+1) + a 𝔪^n`, we have `a u = v + a w` with `v ∈ J^(n+1)` and `w ∈ 𝔪^n`. Then
`a (u - w) ∈ J^(n+1)`, thus `u - w ∈ J^(n+1) ⊆ 𝔪^n` and `u ∈ 𝔪^n`.

The statement in the first bullet point is proved by induction on the length of the sequence,
over all Noetherian local rings. Let `I = (a) + J` as above and let `z y ∈ I^(n+1)`. The induction
hypothesis for the ring `R / (a)` gives `y = a t + y₀` with `y₀ ∈ J^(n+1)`. Then
`a (z t) ∈ I^(n+1)`, thus `z t ∈ I^n` by the main step, and `t ∈ I^n` by induction on `n`.

## References

* [AM69] M. F. Atiyah, I. G. Macdonald, *Introduction to Commutative Algebra*, Theorem 11.22.
* [Mat89] H. Matsumura, *Commutative Ring Theory*, §16.
-/

universe u

namespace Singularity.Algebra

open Module Filter fwdDiff IsLocalRing Ideal RingTheory.Sequence

section Colon

variable {R : Type u} [CommRing R]

/-- Let `I = (a) + J`. Then `I^(n+1) = J^(n+1) + a I^n`. -/
theorem span_singleton_sup_pow_succ (a : R) (J : Ideal R) (n : ℕ) :
    (span {a} ⊔ J) ^ (n + 1) = J ^ (n + 1) ⊔ span {a} * (span {a} ⊔ J) ^ n := by
  induction n with
  | zero => rw [zero_add, pow_one, pow_one, pow_zero, mul_one, sup_comm]
  | succ n ih =>
    refine le_antisymm ?_ (sup_le (Ideal.pow_right_mono le_sup_right _) ?_)
    · have h : J * (span {a} ⊔ J) ^ (n + 1) ≤
          J ^ (n + 1 + 1) ⊔ span {a} * (span {a} ⊔ J) ^ (n + 1) := by
        conv_lhs => rw [ih]
        rw [Ideal.mul_sup, ← pow_succ']
        refine sup_le_sup_left ?_ _
        rw [mul_left_comm, pow_succ' _ n]
        exact Ideal.mul_mono le_rfl (Ideal.mul_mono le_sup_right le_rfl)
      calc (span {a} ⊔ J) ^ (n + 1 + 1) = (span {a} ⊔ J) * (span {a} ⊔ J) ^ (n + 1) :=
            pow_succ' _ _
        _ = span {a} * (span {a} ⊔ J) ^ (n + 1) ⊔ J * (span {a} ⊔ J) ^ (n + 1) :=
            Ideal.sup_mul _ _ _
        _ ≤ _ := sup_le le_sup_right h
    · rw [pow_succ' _ (n + 1)]
      exact Ideal.mul_mono le_sup_left le_rfl

/-- Let `I = (a) + J`, and let `a` be a nonzerodivisor on each `R / J^n`. Then
`(I^(n+1) : a) = I^n`. -/
theorem mem_pow_of_mul_mem_pow_succ {a : R} {J : Ideal R}
    (ha : ∀ n y, a * y ∈ J ^ n → y ∈ J ^ n) {n : ℕ} {u : R}
    (hu : a * u ∈ (span {a} ⊔ J) ^ (n + 1)) : u ∈ (span {a} ⊔ J) ^ n := by
  rw [span_singleton_sup_pow_succ, Submodule.mem_sup] at hu
  obtain ⟨v, hv, w', hw', hvw⟩ := hu
  obtain ⟨w, hw, rfl⟩ := mem_span_singleton_mul.mp hw'
  have h1 : u - w ∈ J ^ (n + 1) := ha _ _ (by
    rw [mul_sub, ← hvw, add_sub_cancel_right]
    exact hv)
  have h2 : u - w ∈ (span {a} ⊔ J) ^ n :=
    Ideal.pow_le_pow_right n.le_succ (Ideal.pow_right_mono le_sup_right _ h1)
  simpa using add_mem h2 hw

/-- If `a` is a nonzerodivisor on `R / J`, then `a y ∈ J` implies `y ∈ J`. -/
theorem mem_of_mul_mem_of_isSMulRegular {a : R} {J : Ideal R} (h : IsSMulRegular (R ⧸ J) a)
    {y : R} (hy : a * y ∈ J) : y ∈ J := by
  rw [← Ideal.Quotient.eq_zero_iff_mem] at hy ⊢
  refine h.right_eq_zero_of_smul ?_
  rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul]
  exact hy

/-- The image of `y` in `R / (a)` lies in the image of `J` if and only if `y ∈ (a) + J`. -/
theorem mk_mem_map_iff {a y : R} {J : Ideal R} :
    Ideal.Quotient.mk (span {a}) y ∈ J.map (Ideal.Quotient.mk (span {a})) ↔ y ∈ span {a} ⊔ J := by
  rw [← Ideal.mem_comap, comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, mk_ker,
    sup_comm]

/-- If `a :: rs` is weakly regular on `R`, then `rs` is weakly regular on `R / (a)`. -/
theorem isWeaklyRegular_map_quotient {a : R} {rs : List R} (h : IsWeaklyRegular R (a :: rs)) :
    IsWeaklyRegular (R ⧸ span {a}) (rs.map (Ideal.Quotient.mk (span {a}))) := by
  rw [isWeaklyRegular_cons_iff, (quotSMulTopEquivQuotSpan a).isWeaklyRegular_congr,
    ← isWeaklyRegular_map_algebraMap_iff (R ⧸ span {a}) (R ⧸ span {a}) rs,
    Ideal.Quotient.algebraMap_eq] at h
  exact h.2

/-- Let `R` be a Noetherian local ring and let `a :: rs` be a weakly regular sequence in `𝔪`.
Then `rs` is weakly regular, and `a` is a nonzerodivisor on `R / (rs)`. -/
theorem isWeaklyRegular_tail_of_cons [IsLocalRing R] [IsNoetherianRing R] {a : R}
    {rs : List R} (h : IsWeaklyRegular R (a :: rs)) (hm : ∀ r ∈ a :: rs, r ∈ maximalIdeal R) :
    IsWeaklyRegular R rs ∧ ∀ y, a * y ∈ ofList rs → y ∈ ofList rs := by
  have h' := IsLocalRing.isWeaklyRegular_of_perm_of_subset_maximalIdeal h
    (List.perm_append_singleton a rs).symm hm
  rw [isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff, smul_eq_mul,
    Ideal.mul_top] at h'
  exact ⟨h'.1, fun y hy => mem_of_mul_mem_of_isSMulRegular h'.2 hy⟩

end Colon

section Powers

/-- The statement `mem_pow_of_mul_mem_of_isWeaklyRegular`, by induction on the length `r` of the
sequence, for all Noetherian local rings. -/
theorem mem_pow_of_mul_mem_aux (r : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (rs : List R),
      rs.length = r → IsWeaklyRegular R rs → (∀ a ∈ rs, a ∈ maximalIdeal R) →
      ∀ z : R, (∀ y, z * y ∈ ofList rs → y ∈ ofList rs) →
      ∀ n y, z * y ∈ ofList rs ^ n → y ∈ ofList rs ^ n := by
  induction r with
  | zero =>
    intro R _ _ _ rs hlen _ _ z hz n y hy
    obtain rfl := List.length_eq_zero_iff.mp hlen
    rw [ofList_nil] at hz hy ⊢
    cases n with
    | zero => rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    | succ n =>
      rw [← Ideal.zero_eq_bot, zero_pow n.succ_ne_zero, Ideal.zero_eq_bot] at hy ⊢
      exact hz y hy
  | succ r ih =>
    intro R _ _ _ rs hlen hreg hm z hz
    obtain ⟨a, rest, rfl⟩ := List.exists_cons_of_length_eq_add_one hlen
    have hlen' : rest.length = r := by simpa using hlen
    have hm' : ∀ b ∈ rest, b ∈ maximalIdeal R := fun b hb => hm b (List.mem_cons_of_mem a hb)
    obtain ⟨hrest, harest⟩ := isWeaklyRegular_tail_of_cons hreg hm
    -- `a` is a nonzerodivisor on each `R / J^n`, by induction.
    have ha := ih R rest hlen' hrest hm' a harest
    -- The induction hypothesis for `R / (a)`.
    have ham : span {a} ≤ maximalIdeal R :=
      (span_singleton_le_iff_mem _).mpr (hm a List.mem_cons_self)
    have := isLocalRing_quotient_of_le_maximalIdeal ham
    have hQ := ih (R ⧸ span {a}) (rest.map (Ideal.Quotient.mk _)) (by simpa using hlen')
      (isWeaklyRegular_map_quotient hreg) (by
        intro b hb
        obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hb
        rw [maximalIdeal_quotient_eq_map]
        exact mem_map_of_mem _ (hm' c hc)) (Ideal.Quotient.mk _ z) (by
        intro y hy
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [← map_ofList, ← map_mul, mk_mem_map_iff, ← ofList_cons] at hy
        rw [← map_ofList, mk_mem_map_iff, ← ofList_cons]
        exact hz y hy)
    have hQ' : ∀ n y, z * y ∈ span {a} ⊔ ofList rest ^ n → y ∈ span {a} ⊔ ofList rest ^ n := by
      intro n y hy
      have h := hQ n (Ideal.Quotient.mk _ y) (by
        rw [← map_ofList, ← Ideal.map_pow, ← map_mul, mk_mem_map_iff]
        exact hy)
      rwa [← map_ofList, ← Ideal.map_pow, mk_mem_map_iff] at h
    rw [ofList_cons]
    intro n
    induction n with
    | zero => intro y _; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    | succ n ihn =>
      intro y hy
      have hle : (span {a} ⊔ ofList rest) ^ (n + 1) ≤ span {a} ⊔ ofList rest ^ (n + 1) := by
        rw [span_singleton_sup_pow_succ, sup_comm]
        exact sup_le_sup_right Ideal.mul_le_left _
      obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp (hQ' (n + 1) y (hle hy))
      obtain ⟨c, rfl⟩ := mem_span_singleton'.mp hp
      have hqI : q ∈ (span {a} ⊔ ofList rest) ^ (n + 1) :=
        Ideal.pow_right_mono le_sup_right _ hq
      have hc : a * (z * c) ∈ (span {a} ⊔ ofList rest) ^ (n + 1) := by
        have h := sub_mem hy (Ideal.mul_mem_left _ z hqI)
        rw [mul_add, add_sub_cancel_right] at h
        rw [show a * (z * c) = z * (c * a) by ring]
        exact h
      have hcn := ihn c (mem_pow_of_mul_mem_pow_succ ha hc)
      refine add_mem ?_ hqI
      rw [pow_succ]
      exact mul_mem_mul hcn (mem_sup_left (mem_span_singleton_self a))

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- Let `R` be a Noetherian local ring, let `I` be generated by a weakly regular sequence in `𝔪`
and let `z` be a nonzerodivisor on `R / I`. Then `z` is a nonzerodivisor on each `R / I^n`
([Mat89, §16]). -/
theorem mem_pow_of_mul_mem_of_isWeaklyRegular {rs : List R} (hreg : IsWeaklyRegular R rs)
    (hm : ∀ a ∈ rs, a ∈ maximalIdeal R) {z : R} (hz : ∀ y, z * y ∈ ofList rs → y ∈ ofList rs)
    (n : ℕ) {y : R} (hy : z * y ∈ ofList rs ^ n) : y ∈ ofList rs ^ n :=
  mem_pow_of_mul_mem_aux _ R rs rfl hreg hm z hz n y hy

/-- Let `R` be a Noetherian local ring and let `a :: rs` be a weakly regular sequence that
generates `𝔪`. Then `(𝔪^(n+1) : a) = 𝔪^n`. -/
theorem mem_maximalIdeal_pow_of_mul_mem {a : R} {rs : List R}
    (hreg : IsWeaklyRegular R (a :: rs)) (hrs : ofList (a :: rs) = maximalIdeal R) {n : ℕ}
    {u : R} (hu : a * u ∈ maximalIdeal R ^ (n + 1)) : u ∈ maximalIdeal R ^ n := by
  have hm : ∀ r ∈ a :: rs, r ∈ maximalIdeal R := fun r hr => hrs ▸ subset_span hr
  obtain ⟨hrest, harest⟩ := isWeaklyRegular_tail_of_cons hreg hm
  have ha : ∀ n y, a * y ∈ ofList rs ^ n → y ∈ ofList rs ^ n := fun n y hy =>
    mem_pow_of_mul_mem_of_isWeaklyRegular hrest (fun b hb => hm b (List.mem_cons_of_mem a hb))
      harest n hy
  rw [← hrs, ofList_cons] at hu ⊢
  exact mem_pow_of_mul_mem_pow_succ ha hu

end Powers

section Length

variable {R : Type u} [CommRing R]

/-- The Hilbert-Samuel function of `R` itself: `χ(n) = ℓ(R / I^n)`. -/
theorem hilbertSamuel_self_eq (I : Ideal R) (n : ℕ) :
    hilbertSamuel I R n = length R (R ⧸ I ^ n) := by
  rw [hilbertSamuel, smul_eq_mul, Ideal.mul_top]

/-- Let `a ∈ I` with `(I^(n+1) : a) = I^n`. Then
`ℓ(R / I^(n+1)) = ℓ(R / I^n) + ℓ(R / ((a) + I^(n+1)))`. -/
theorem length_quotient_pow_succ {a : R} {I : Ideal R} (haI : a ∈ I) {n : ℕ}
    (h : ∀ u, a * u ∈ I ^ (n + 1) → u ∈ I ^ n) :
    length R (R ⧸ I ^ (n + 1)) =
      length R (R ⧸ I ^ n) + length R (R ⧸ span {a} ⊔ I ^ (n + 1)) := by
  have hf : I ^ n ≤ Submodule.comap (LinearMap.mulLeft R a) (I ^ (n + 1)) := fun u hu => by
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply, pow_succ']
    exact mul_mem_mul haI hu
  let f : (R ⧸ I ^ n) →ₗ[R] R ⧸ I ^ (n + 1) := Submodule.mapQ _ _ (LinearMap.mulLeft R a) hf
  let g : (R ⧸ I ^ (n + 1)) →ₗ[R] R ⧸ span {a} ⊔ I ^ (n + 1) :=
    Submodule.mapQ _ _ LinearMap.id (le_sup_right : I ^ (n + 1) ≤ span {a} ⊔ I ^ (n + 1))
  refine length_eq_add_of_exact f g ?_ ?_ ?_
  · intro x y hxy
    induction x using Submodule.Quotient.induction_on with | _ x => ?_
    induction y using Submodule.Quotient.induction_on with | _ y => ?_
    simp only [f, Submodule.mapQ_apply, LinearMap.mulLeft_apply, Submodule.Quotient.eq]
      at hxy ⊢
    exact h _ (by rw [mul_sub]; exact hxy)
  · intro y
    induction y using Submodule.Quotient.induction_on with | _ y => ?_
    exact ⟨Submodule.Quotient.mk y, rfl⟩
  · intro y
    induction y using Submodule.Quotient.induction_on with | _ y => ?_
    simp only [g, Submodule.mapQ_apply, LinearMap.id_apply, Submodule.Quotient.mk_eq_zero]
    constructor
    · intro hy
      obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hy
      obtain ⟨c, rfl⟩ := mem_span_singleton'.mp hp
      refine ⟨Submodule.Quotient.mk c, ?_⟩
      simp only [f, Submodule.mapQ_apply, LinearMap.mulLeft_apply, Submodule.Quotient.eq]
      rw [show a * c - (c * a + q) = -q by ring]
      exact neg_mem hq
    · rintro ⟨x, hx⟩
      induction x using Submodule.Quotient.induction_on with | _ x => ?_
      simp only [f, Submodule.mapQ_apply, LinearMap.mulLeft_apply, Submodule.Quotient.eq] at hx
      rw [show y = a * x - (a * x - y) by ring]
      exact sub_mem (mem_sup_left (mem_span_singleton.mpr (dvd_mul_right a x)))
        (mem_sup_right hx)

/-- The length of `R / ((a) + J)` over `R` is the length of `(R / (a)) / J` over `R / (a)`. -/
theorem length_quotient_span_singleton_sup (a : R) (J : Ideal R) :
    length R (R ⧸ span {a} ⊔ J) =
      length (R ⧸ span {a}) ((R ⧸ span {a}) ⧸ J.map (Ideal.Quotient.mk (span {a}))) := by
  rw [← (DoubleQuot.quotQuotEquivQuotSupₐ R (span {a}) J).toLinearEquiv.length_eq]
  exact Module.length_eq_of_surjective (S := R) (R := R ⧸ span {a})
    (M := (R ⧸ span {a}) ⧸ J.map (Ideal.Quotient.mk (span {a}))) Ideal.Quotient.mk_surjective

end Length

section Main

/-- The statement `hilbertSamuel_succ_of_isWeaklyRegular`, by induction on `d`, for all
Noetherian local rings. -/
theorem hilbertSamuel_succ_aux (d : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (rs : List R),
      rs.length = d → IsWeaklyRegular R rs → ofList rs = maximalIdeal R →
      ∀ n, hilbertSamuel (maximalIdeal R) R (n + 1) = (n + d).choose d := by
  induction d with
  | zero =>
    intro R _ _ _ rs hlen _ hrs n
    obtain rfl := List.length_eq_zero_iff.mp hlen
    rw [ofList_nil] at hrs
    have h : maximalIdeal R ^ (n + 1) = maximalIdeal R ^ 1 := by
      rw [← hrs, ← Ideal.zero_eq_bot, zero_pow n.succ_ne_zero, zero_pow one_ne_zero]
    rw [hilbertSamuel, h, ← hilbertSamuel, hilbertSamuel_self_one, Nat.choose_zero_right,
      Nat.cast_one]
  | succ d ih =>
    intro R _ _ _ rs hlen hreg hrs
    obtain ⟨a, rest, rfl⟩ := List.exists_cons_of_length_eq_add_one hlen
    have hm : ∀ r ∈ a :: rest, r ∈ maximalIdeal R := fun r hr => hrs ▸ subset_span hr
    have ham : span {a} ≤ maximalIdeal R :=
      (span_singleton_le_iff_mem _).mpr (hm a List.mem_cons_self)
    have := isLocalRing_quotient_of_le_maximalIdeal ham
    have hQ := ih (R ⧸ span {a}) (rest.map (Ideal.Quotient.mk _)) (by simpa using hlen)
      (isWeaklyRegular_map_quotient hreg) (by
        rw [← map_ofList, maximalIdeal_quotient_eq_map, ← hrs, ofList_cons, Ideal.map_sup,
          map_quotient_self, bot_sup_eq])
    have hrec : ∀ n, length R (R ⧸ maximalIdeal R ^ (n + 1)) =
        length R (R ⧸ maximalIdeal R ^ n) + ((n + d).choose d : ℕ∞) := by
      intro n
      rw [length_quotient_pow_succ (hm a List.mem_cons_self)
        (fun u hu => mem_maximalIdeal_pow_of_mul_mem hreg hrs hu),
        length_quotient_span_singleton_sup, Ideal.map_pow, ← maximalIdeal_quotient_eq_map,
        ← hilbertSamuel_self_eq (maximalIdeal (R ⧸ span {a})) (n + 1), hQ n]
    have hall : ∀ n, length R (R ⧸ maximalIdeal R ^ n) = (n + d).choose (d + 1) := by
      intro n
      induction n with
      | zero =>
        rw [← hilbertSamuel_self_eq, hilbertSamuel_zero, zero_add,
          Nat.choose_eq_zero_of_lt (Nat.lt_succ_self d), Nat.cast_zero]
      | succ n ihn =>
        rw [hrec, ihn, show n + 1 + d = n + d + 1 by omega, Nat.choose_succ_succ' (n + d) d,
          Nat.cast_add, add_comm]
    intro n
    rw [hilbertSamuel_self_eq, hall, show n + 1 + d = n + (d + 1) by omega]

variable {R : Type u} [CommRing R]

/-- Let `R` be a Noetherian local ring whose maximal ideal `𝔪` is generated by a weakly regular
sequence of length `d`. Then `ℓ(R / 𝔪^(n+1)) = (n + d).choose d`. -/
theorem hilbertSamuel_succ_of_isWeaklyRegular [IsLocalRing R] [IsNoetherianRing R]
    {rs : List R} (hreg : IsWeaklyRegular R rs) (hrs : ofList rs = maximalIdeal R) (n : ℕ) :
    hilbertSamuel (maximalIdeal R) R (n + 1) = (n + rs.length).choose rs.length :=
  hilbertSamuel_succ_aux _ R rs rfl hreg hrs n

variable [IsRegularLocalRing R]

/-- **The Hilbert-Samuel function of a regular local ring.** Let `R` be a regular local ring of
dimension `d`. Then `ℓ(R / 𝔪^(n+1)) = (n + d).choose d` ([AM69, Theorem 11.22]). -/
theorem hilbertSamuel_succ_eq_choose {d : ℕ} (hd : ringKrullDim R = d) (n : ℕ) :
    hilbertSamuel (maximalIdeal R) R (n + 1) = (n + d).choose d := by
  obtain ⟨rs, hlen, hrs, hreg⟩ := exists_isRegular_of_ringKrullDim_eq d R hd
  rw [← hlen]
  exact hilbertSamuel_succ_of_isWeaklyRegular hreg.toIsWeaklyRegular hrs n

/-- Let `R` be a regular local ring of dimension `d + 1`. Then
`ℓ(R / 𝔪^n) = (n + d).choose (d + 1)` for each `n`. -/
theorem hilbertSamuel_eq_choose {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ)) (n : ℕ) :
    hilbertSamuel (maximalIdeal R) R n = (n + d).choose (d + 1) := by
  cases n with
  | zero =>
    rw [hilbertSamuel_zero, zero_add, Nat.choose_eq_zero_of_lt (Nat.lt_succ_self d),
      Nat.cast_zero]
  | succ n => rw [hilbertSamuel_succ_eq_choose hd, show n + 1 + d = n + (d + 1) by omega]

/-- Let `R` be a regular local ring of dimension `d + 1`. Then
`ℓ(𝔪^n / 𝔪^(n+1)) = (n + d).choose d`, the number of monomials of degree `n` in `d + 1`
variables ([AM69, Theorem 11.22]). -/
theorem length_grPiece_eq_choose {d : ℕ} (hd : ringKrullDim R = (d + 1 : ℕ)) (n : ℕ) :
    length R (grPiece (maximalIdeal R) R n) = (n + d).choose d := by
  have h := hilbertSamuel_succ (maximalIdeal R) R n
  change _ = _ + length R (grPiece (maximalIdeal R) R n) at h
  rw [hilbertSamuel_eq_choose hd, hilbertSamuel_eq_choose hd,
    show n + 1 + d = n + d + 1 by omega, Nat.choose_succ_succ' (n + d) d, Nat.cast_add,
    add_comm] at h
  exact (WithTop.add_left_cancel (ENat.natCast_ne_top _) h).symm

end Main

section Multiplicity

/-- `Δ^j` of `n ↦ (n + c).choose (k + j)` is `n ↦ (n + c).choose k`. -/
theorem fwdDiff_iter_choose_add (c k j : ℕ) :
    Δ_[1]^[j] (fun n : ℕ => ((n + c).choose (k + j) : ℤ)) = fun n => ((n + c).choose k : ℤ) := by
  induction j with
  | zero => rfl
  | succ j ih =>
    rw [Function.iterate_succ_apply]
    convert ih using 2
    funext n
    simp only [fwdDiff]
    rw [show n + 1 + c = n + c + 1 by omega, show k + (j + 1) = k + j + 1 by omega,
      Nat.choose_succ_succ', Nat.cast_add]
    ring

variable (R : Type u) [CommRing R] [IsRegularLocalRing R]

/-- **The multiplicity of a regular local ring.** Let `R` be a regular local ring of dimension
`d`. Then `e_d(𝔪, R) = 1` ([AM69, Theorem 11.22]). -/
theorem samuelMultiplicity_regular {d : ℕ} (hd : ringKrullDim R = d) :
    samuelMultiplicity (maximalIdeal R) R d = 1 := by
  cases d with
  | zero =>
    refine samuelMultiplicity_eq_of_eventually ((eventually_ge_atTop 1).mono fun n hn => ?_)
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hn
    rw [Function.iterate_zero_apply, hilbertSamuelInt, hilbertSamuel_succ_eq_choose hd,
      Nat.choose_zero_right]
    rfl
  | succ d =>
    have h : hilbertSamuelInt (maximalIdeal R) R = fun n => ((n + d).choose (0 + (d + 1)) : ℤ) := by
      funext n
      rw [hilbertSamuelInt, hilbertSamuel_eq_choose hd, zero_add]
      rfl
    refine samuelMultiplicity_eq_of_eventually (Eventually.of_forall fun n => ?_)
    rw [h, fwdDiff_iter_choose_add]
    simp

end Multiplicity

end Singularity.Algebra
