import Singularity.Algebra.HilbertSerre
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Nakayama

/-!
# The multiplicity of a module with respect to an ideal

Let `R` be a commutative ring, let `I` be an ideal of `R` and let `M` be an `R`-module. Let
`χ(n) = ℓ(M / I^n M)` be the Hilbert-Samuel function. We define the multiplicity
`e_d(I, M)` as the eventual value of the `d`-th forward difference `Δ^d χ`.

If `R` is Noetherian, `M` is finite, `I` is generated by `r` elements and `ℓ(M / I M)` is
finite, then `χ` is eventually a polynomial `P` of degree at most `r`
(`isEventuallyPolynomial_hilbertSamuel`). Then `e_d(I, M) = d! * P.coeff d` for each
`d ≥ deg P`. If `d` is the degree of `P`, this is the leading coefficient of `P` times `d!`, which
is the usual multiplicity `e(I, M)` ([Mat89], §14). We do not identify `deg P` with the Krull
dimension of `M`, because this needs the dimension theory of local rings.

## Main results

* `Singularity.Algebra.samuelMultiplicity`: the multiplicity `e_d(I, M)`, a natural number.
* `Singularity.Algebra.eventually_fwdDiff_iter_hilbertSamuelInt`: `Δ^d χ` is eventually equal to
  `e_d(I, M)` if `d` is at least the number of generators of `I`.
* `Singularity.Algebra.samuelMultiplicity_eq_coeff`: `e_d(I, M) = d! * P.coeff d`.
* `Singularity.Algebra.samuelMultiplicity_eq_zero_of_natDegree_lt`: `e_d(I, M) = 0` for
  `d > deg P`.
* `Singularity.Algebra.samuelMultiplicity_pos`: in a local ring, if `M ≠ 0` and `I` is a proper
  ideal, then `e_d(I, M) > 0` for `d = deg P`.
* `Singularity.Algebra.samuelMultiplicity_anti`: a larger ideal gives a smaller multiplicity.
* `Singularity.Algebra.samuelMultiplicity_field`, `samuelMultiplicity_dvr`: `e(m, R) = 1` for a
  field (`d = 0`) and for a discrete valuation ring (`d = 1`). These are the regular local rings
  of dimension at most one.

## References

* [AM69] M. F. Atiyah, I. G. Macdonald, *Introduction to Commutative Algebra*, Chapter 11.
* [Mat89] H. Matsumura, *Commutative Ring Theory*, Theorem 13.4 and §14.
-/

universe u v

namespace Singularity.Algebra

open Module Filter Finset fwdDiff Polynomial IsLocalRing

section General

/-- If `f` is eventually polynomial of degree less than `d + 1`, then `Δ^d f` is eventually equal
to its eventual value. -/
theorem IsEventuallyPolynomial.eventually_fwdDiff_iter_eq_eventualValue {f : ℕ → ℤ} {d : ℕ}
    (hf : IsEventuallyPolynomial f (d + 1)) :
    ∀ᶠ n in atTop, Δ_[1]^[d] f n = eventualValue (Δ_[1]^[d] f) := by
  obtain ⟨N, hN⟩ := eventually_atTop.mp (isEventuallyPolynomial_iff_fwdDiff.mp hf)
  have hc : ∀ n, N ≤ n → Δ_[1]^[d] f n = Δ_[1]^[d] f N := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => rfl
    | succ n hn ih =>
      have h := hN n hn
      rw [Function.iterate_succ_apply'] at h
      have h' : Δ_[1]^[d] f (n + 1) - Δ_[1]^[d] f n = 0 := h
      omega
  have hev : ∀ᶠ n in atTop, Δ_[1]^[d] f n = Δ_[1]^[d] f N := eventually_atTop.mpr ⟨N, hc⟩
  rw [eventualValue_eq hev]
  exact hev

/-- If `f` agrees eventually with a polynomial `P` with `natDegree P ≤ d`, then the eventual
value of `Δ^d f` is `d! * P.coeff d`. -/
theorem eventualValue_fwdDiff_iter_eq_coeff {f : ℕ → ℤ} {d : ℕ} {P : ℚ[X]}
    (hd : P.natDegree ≤ d) (hP : ∀ᶠ n in atTop, (f n : ℚ) = P.eval (n : ℚ)) :
    (eventualValue (Δ_[1]^[d] f) : ℚ) = d.factorial * P.coeff d := by
  have hdeg : P.degree < (d + 1 : ℕ) :=
    degree_lt_succ_iff.mpr (Polynomial.degree_le_of_natDegree_le hd)
  have h1 := IsEventuallyPolynomial.eventually_fwdDiff_iter_eq hdeg hP
  have h2 :=
    (isEventuallyPolynomial_succ_iff.mpr ⟨P, hd, hP⟩).eventually_fwdDiff_iter_eq_eventualValue
  obtain ⟨n, hn1, hn2⟩ := (h1.and h2).exists
  rw [← hn2, hn1]

end General

section Multiplicity

variable {R : Type u} [CommRing R] (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]

/-- The Hilbert-Samuel function `n ↦ ℓ(M / I^n M)` with values in `ℤ`. An infinite length gives
the value `0`. -/
noncomputable def hilbertSamuelInt (n : ℕ) : ℤ :=
  ((hilbertSamuel I M n).toNat : ℤ)

/-- The multiplicity `e_d(I, M)`: the eventual value of `Δ^d` of the Hilbert-Samuel function. If
`Δ^d χ` is not eventually constant, or if its eventual value is negative, the value is `0`. -/
noncomputable def samuelMultiplicity (d : ℕ) : ℕ :=
  (eventualValue (Δ_[1]^[d] (hilbertSamuelInt I M))).toNat

variable {I M}

/-- If `Δ^d χ` is eventually equal to `c ≥ 0`, then `e_d(I, M) = c`. -/
theorem samuelMultiplicity_eq_of_eventually {d c : ℕ}
    (h : ∀ᶠ n in atTop, Δ_[1]^[d] (hilbertSamuelInt I M) n = c) :
    samuelMultiplicity I M d = c := by
  rw [samuelMultiplicity, eventualValue_eq h, Int.toNat_natCast]

/-- If `χ` agrees eventually with a polynomial `P` and `natDegree P ≤ d`, then `Δ^d χ` is
eventually equal to `e_d(I, M)`. -/
theorem eventually_fwdDiff_iter_eq_samuelMultiplicity {d : ℕ} {P : ℚ[X]} (hd : P.natDegree ≤ d)
    (hP : ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ)) :
    ∀ᶠ n in atTop, Δ_[1]^[d] (hilbertSamuelInt I M) n = samuelMultiplicity I M d := by
  have hP' : ∀ᶠ n in atTop, (hilbertSamuelInt I M n : ℚ) = P.eval (n : ℚ) :=
    hP.mono fun n hn => by rw [hilbertSamuelInt, Int.cast_natCast, hn]
  have hev :=
    (isEventuallyPolynomial_succ_iff.mpr ⟨P, hd, hP'⟩).eventually_fwdDiff_iter_eq_eventualValue
  have hnn : 0 ≤ eventualValue (Δ_[1]^[d] (hilbertSamuelInt I M)) :=
    eventualValue_fwdDiff_iter_nonneg (Eventually.of_forall fun n => Int.natCast_nonneg _)
      ⟨_, hev⟩
  exact hev.mono fun n hn => by rw [hn, samuelMultiplicity, Int.toNat_of_nonneg hnn]

/-- Let `R` be Noetherian, let `M` be finite, let `I` be generated by `r` elements and let
`ℓ(M / I M)` be finite. Then `Δ^d χ` is eventually equal to `e_d(I, M)` for each `d ≥ r`. -/
theorem eventually_fwdDiff_iter_hilbertSamuelInt [IsNoetherianRing R] [Module.Finite R M]
    {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x))
    (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) {d : ℕ} (hd : r ≤ d) :
    ∀ᶠ n in atTop, Δ_[1]^[d] (hilbertSamuelInt I M) n = samuelMultiplicity I M d := by
  obtain ⟨P, hP, h⟩ := exists_hilbertSamuel_polynomial hI hfin
  exact eventually_fwdDiff_iter_eq_samuelMultiplicity (hP.trans hd) h

/-- If `χ` agrees eventually with a polynomial `P` and `natDegree P ≤ d`, then
`e_d(I, M) = d! * P.coeff d`. -/
theorem samuelMultiplicity_eq_coeff {d : ℕ} {P : ℚ[X]} (hd : P.natDegree ≤ d)
    (hP : ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ)) :
    (samuelMultiplicity I M d : ℚ) = d.factorial * P.coeff d := by
  have hP' : ∀ᶠ n in atTop, (hilbertSamuelInt I M n : ℚ) = P.eval (n : ℚ) :=
    hP.mono fun n hn => by rw [hilbertSamuelInt, Int.cast_natCast, hn]
  have h1 := eventually_fwdDiff_iter_eq_samuelMultiplicity hd hP
  have h2 := IsEventuallyPolynomial.eventually_fwdDiff_iter_eq
    (degree_lt_succ_iff.mpr (Polynomial.degree_le_of_natDegree_le hd)) hP'
  obtain ⟨n, hn1, hn2⟩ := (h1.and h2).exists
  rw [← hn2, hn1, Int.cast_natCast]

/-- If `χ` agrees eventually with a polynomial `P`, then `e_d(I, M) = 0` for `d > deg P`. -/
theorem samuelMultiplicity_eq_zero_of_natDegree_lt {d : ℕ} {P : ℚ[X]} (hd : P.natDegree < d)
    (hP : ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ)) :
    samuelMultiplicity I M d = 0 := by
  have h := samuelMultiplicity_eq_coeff hd.le hP
  rw [Polynomial.coeff_eq_zero_of_natDegree_lt hd, mul_zero] at h
  exact_mod_cast h

/-- If `χ` agrees eventually with a nonzero polynomial `P`, then `e_d(I, M) > 0` for
`d = deg P`. -/
theorem samuelMultiplicity_pos_of_ne_zero {P : ℚ[X]} (hP0 : P ≠ 0)
    (hP : ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ)) :
    0 < samuelMultiplicity I M P.natDegree := by
  have h := samuelMultiplicity_eq_coeff le_rfl hP
  rw [Polynomial.coeff_natDegree] at h
  have hne : (samuelMultiplicity I M P.natDegree : ℚ) ≠ 0 := by
    rw [h]
    exact mul_ne_zero (by exact_mod_cast (Nat.factorial_pos _).ne')
      (Polynomial.leadingCoeff_ne_zero.mpr hP0)
  exact Nat.pos_of_ne_zero (by exact_mod_cast hne)

/-- **Positivity of the multiplicity.** Let `R` be a local ring, let `M ≠ 0` be a finite
`R`-module and let `I ≤ m` be generated by `r` elements, with `ℓ(M / I M)` finite. Let `P` be the
Hilbert-Samuel polynomial. Then `e_d(I, M) > 0` for `d = deg P`. -/
theorem samuelMultiplicity_pos [IsLocalRing R] [Module.Finite R M] [Nontrivial M] {r : ℕ}
    {x : Fin r → R} (hI : I = Ideal.span (Set.range x)) (hIm : I ≤ maximalIdeal R)
    (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) {P : ℚ[X]}
    (hP : ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ)) :
    0 < samuelMultiplicity I M P.natDegree := by
  refine samuelMultiplicity_pos_of_ne_zero ?_ hP
  rintro rfl
  have hnt : Nontrivial (M ⧸ (I • ⊤ : Submodule R M)) := by
    rw [Submodule.Quotient.nontrivial_iff]
    intro htop
    have h := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot I ⊤ Module.Finite.fg_top htop.ge
      (hIm.trans (maximalIdeal_le_jacobson ⊥))
    exact top_ne_bot h
  have h1 : hilbertSamuel I M 1 ≠ 0 := by
    rw [hilbertSamuel, pow_one]
    exact (length_pos (R := R) (M := M ⧸ (I • ⊤ : Submodule R M))).ne'
  obtain ⟨n, hn, hn1⟩ := (hP.and (eventually_ge_atTop 1)).exists
  rw [eval_zero, Nat.cast_eq_zero, ENat.toNat_eq_zero] at hn
  rcases hn with hn | hn
  · exact h1 (nonpos_iff_eq_zero.mp (hn ▸ hilbertSamuel_mono I M hn1))
  · exact hilbertSamuel_ne_top_of_length_ne_top hI hfin n hn

/-- **Monotony of the multiplicity.** Let `I ≤ J` be ideals generated by `r` and `s` elements,
with `ℓ(M / I M)` finite. Then `e_d(J, M) ≤ e_d(I, M)` for each `d ≥ r` and `d ≥ s`. -/
theorem samuelMultiplicity_anti [IsNoetherianRing R] [Module.Finite R M] {J : Ideal R}
    (hIJ : I ≤ J) {r s : ℕ} {x : Fin r → R} {z : Fin s → R} (hI : I = Ideal.span (Set.range x))
    (hJ : J = Ideal.span (Set.range z)) (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤)
    {d : ℕ} (hr : r ≤ d) (hs : s ≤ d) : samuelMultiplicity J M d ≤ samuelMultiplicity I M d := by
  have hfinJ : length R (M ⧸ (J • ⊤ : Submodule R M)) ≠ ⊤ := by
    have h := hilbertSamuel_anti M hIJ 1
    rw [hilbertSamuel, hilbertSamuel, pow_one, pow_one] at h
    exact ne_top_of_le_ne_top hfin h
  have hle : ∀ᶠ n in atTop, hilbertSamuelInt J M n ≤ hilbertSamuelInt I M n :=
    Eventually.of_forall fun n => by
      rw [hilbertSamuelInt, hilbertSamuelInt, Nat.cast_le]
      exact ENat.toNat_le_toNat (hilbertSamuel_anti M hIJ n)
        (hilbertSamuel_ne_top_of_length_ne_top hI hfin n)
  exact Int.toNat_le_toNat (eventualValue_fwdDiff_iter_mono hle
    ⟨_, eventually_fwdDiff_iter_hilbertSamuelInt hJ hfinJ hs⟩
    ⟨_, eventually_fwdDiff_iter_hilbertSamuelInt hI hfin hr⟩)

end Multiplicity

section Regular

/-- For a field `K`, `ℓ(K / m^n) = 1` for `n ≥ 1`, thus `e_0(m, K) = 1`. -/
theorem samuelMultiplicity_field (K : Type u) [Field K] :
    samuelMultiplicity (maximalIdeal K) K 0 = 1 := by
  refine samuelMultiplicity_eq_of_eventually ((eventually_ge_atTop 1).mono fun n hn => ?_)
  rw [Function.iterate_zero_apply, hilbertSamuelInt, hilbertSamuel, maximalIdeal_eq_bot,
    ← Ideal.zero_eq_bot, zero_pow (by omega), Ideal.zero_eq_bot, Submodule.bot_smul,
    (Submodule.quotEquivOfEqBot ⊥ rfl).length_eq, length_eq_one]
  rfl

/-- For a discrete valuation ring `R`, `ℓ(R / m^n) = n`, thus `e_1(m, R) = 1`. -/
theorem samuelMultiplicity_dvr (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] : samuelMultiplicity (maximalIdeal R) R 1 = 1 := by
  have h : ∀ n, hilbertSamuelInt (maximalIdeal R) R n = n := fun n => by
    rw [hilbertSamuelInt, hilbertSamuel, smul_eq_mul, Ideal.mul_top,
      IsDiscreteValuationRing.length_quotient_pow_maximalIdeal]
    rfl
  refine samuelMultiplicity_eq_of_eventually (Eventually.of_forall fun n => ?_)
  rw [Function.iterate_one]
  change hilbertSamuelInt (maximalIdeal R) R (n + 1) - hilbertSamuelInt (maximalIdeal R) R n = _
  rw [h, h]
  push_cast
  ring

end Regular

end Singularity.Algebra
