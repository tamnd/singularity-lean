import Mathlib.LinearAlgebra.Dimension.OrzechProperty
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Singularity.Valuation.LatticeLemmaOrdered

/-!
# The cone lemma

Let `V` be a vector space of finite dimension over `ℚ` with a total order that is compatible with addition, and let `E` be a finite set of elements `e ≥ 0` of `V`. The cone lemma (Volume 5, Lemma 2.1.3 of the handbook) says: there is a basis `m_1, ..., m_r` of `V` with `m_i > 0` for each `i`, such that `E` lies in the rational cone of the `m_i`. That is, each `e ∈ E` has coordinates `≥ 0` in this basis.

## The proof

The handbook proves the lemma by induction on the convex subspaces and the theorem of Hölder. Then it proves the lattice lemma (Lemma 2.1.4) from the cone lemma. The library has a proof of the lattice lemma that does not use the cone lemma (`Singularity.latticeLemma`). So the proof here goes in the other direction, and it gives the cone lemma from the lattice lemma.

1. A lattice. Let `b` be a basis of `V`, and let `N ≥ 1` be a common denominator of the coordinates of the elements of `E` in the basis `b`. Let `c_i = b_i / N`, and let `Γ` be the subgroup of `V` that the `c_i` generate. It is free with basis `c`, and it contains `E`.
2. The lattice lemma. The order of `V` restricts to `Γ`. The lattice lemma gives a basis `m` of `Γ` over `ℤ` with `m_i > 0`, such that each `e ∈ E` has coordinates in `ℕ`.
3. A basis of `V`. The `m_i` span `Γ` over `ℤ`, so they span `V` over `ℚ`. There are `r` of them, so they are a basis of `V`. The coordinates of `e ∈ E` in this basis are its coordinates in `Γ`, so they are `≥ 0`.

The order of `V` needs only to be compatible with addition. The coordinates in the result are in `ℕ`, which is a little more than the handbook asks.

## Main results

* `Singularity.ConeLemma.exists_basis_of_mem_span`: the cone lemma when `E` lies in the subgroup that is generated by a basis of `V`.
* `Singularity.ConeLemma.exists_basis_mem_span`: a basis of `V` that generates a subgroup that contains `E`.
* `Singularity.coneLemma`: the cone lemma.
-/

open Module

namespace Singularity

namespace ConeLemma

variable {V : Type*} [AddCommGroup V] [LinearOrder V] [IsOrderedAddMonoid V] [Module ℚ V]
  {ι : Type*} [Fintype ι]

/-- If the denominator of `q` divides `d`, then `d q` is an integer. -/
theorem exists_int_eq_mul (q : ℚ) {d : ℕ} (h : q.den ∣ d) : ∃ z : ℤ, (z : ℚ) = d * q := by
  obtain ⟨a, rfl⟩ := h
  refine ⟨a * q.num, ?_⟩
  push_cast
  rw [mul_comm (q.den : ℚ) (a : ℚ), mul_assoc, Rat.den_mul_eq_num]

/-- Each finite subset `E` of `V` lies in the subgroup that is generated by some basis of `V` over `ℚ`. -/
theorem exists_basis_mem_span (b : Basis ι ℚ V) (E : Finset V) :
    ∃ c : Basis ι ℚ V, ∀ e ∈ E, e ∈ Submodule.span ℤ (Set.range c) := by
  classical
  let N : ℕ := ∏ e ∈ E, ∏ i, (b.repr e i).den
  have hN0 : (N : ℚ) ≠ 0 := by
    have h : N ≠ 0 := Finset.prod_ne_zero_iff.mpr fun e _ =>
      Finset.prod_ne_zero_iff.mpr fun i _ => (b.repr e i).den_ne_zero
    exact_mod_cast h
  have hw : ∀ _ : ι, IsUnit ((N : ℚ)⁻¹) := fun _ => (inv_ne_zero hN0).isUnit
  refine ⟨b.isUnitSMul hw, fun e he => ?_⟩
  have hdvd : ∀ i, (b.repr e i).den ∣ N := fun i =>
    (Finset.dvd_prod_of_mem (fun i => (b.repr e i).den) (Finset.mem_univ i)).trans
      (Finset.dvd_prod_of_mem (fun e => ∏ i, (b.repr e i).den) he)
  choose z hz using fun i => exists_int_eq_mul (b.repr e i) (hdvd i)
  have he' : e = ∑ i, z i • (b.isUnitSMul hw) i := by
    conv_lhs => rw [← b.sum_repr e]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Basis.isUnitSMul_apply, ← Int.cast_smul_eq_zsmul ℚ, hz i, smul_smul]
    congr 1
    rw [mul_comm (N : ℚ), mul_assoc, mul_inv_cancel₀ hN0, mul_one]
  rw [he']
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- The cone lemma when `E` lies in the subgroup `Γ` that is generated by a basis `c` of `V`. The lattice lemma for `Γ` gives the basis. -/
theorem exists_basis_of_mem_span (c : Basis ι ℚ V) (E : Finset V)
    (hEc : ∀ e ∈ E, e ∈ Submodule.span ℤ (Set.range c)) (hE : ∀ e ∈ E, 0 ≤ e) :
    ∃ m : Basis ι ℚ V, (∀ i, 0 < m i) ∧ ∀ e ∈ E, ∀ i, 0 ≤ m.repr e i := by
  classical
  have hli : LinearIndependent ℤ c := c.linearIndependent.restrict_scalars' ℤ
  obtain ⟨m, hm, hmD⟩ := latticeLemma (Basis.span hli)
    (E.subtype (· ∈ Submodule.span ℤ (Set.range c)))
    (fun d hd => hE _ (Finset.mem_subtype.mp hd))
  have hsum : ∀ x : Submodule.span ℤ (Set.range c), ∑ i, m.repr x i • (m i : V) = x := by
    intro x
    have h := congrArg Subtype.val (m.sum_repr x)
    simp only [Submodule.coe_sum, Submodule.coe_smul] at h
    exact h
  have hspan : ⊤ ≤ Submodule.span ℚ (Set.range fun i => (m i : V)) := by
    refine le_trans (le_of_eq c.span_eq.symm) (Submodule.span_le.mpr ?_)
    rintro _ ⟨j, rfl⟩
    have hcj : c j ∈ Submodule.span ℤ (Set.range c) := Submodule.subset_span ⟨j, rfl⟩
    have h2 := hsum ⟨c j, hcj⟩
    change ∑ i, m.repr ⟨c j, hcj⟩ i • (m i : V) = c j at h2
    rw [SetLike.mem_coe, ← h2]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [← Int.cast_smul_eq_zsmul ℚ]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  obtain ⟨M, hM⟩ : ∃ M : Basis ι ℚ V, ∀ i, M i = (m i : V) :=
    ⟨basisOfTopLeSpanOfCardEqFinrank _ hspan (finrank_eq_card_basis c).symm, fun i => by
      rw [coe_basisOfTopLeSpanOfCardEqFinrank]⟩
  refine ⟨M, fun i => ?_, fun e he i => ?_⟩
  · rw [hM]
    exact hm i
  · have hme := hEc e he
    have he2 : e = ∑ i, ((m.repr ⟨e, hme⟩ i : ℤ) : ℚ) • M i := by
      have h3 := hsum ⟨e, hme⟩
      change ∑ i, m.repr ⟨e, hme⟩ i • (m i : V) = e at h3
      conv_lhs => rw [← h3]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hM, Int.cast_smul_eq_zsmul]
    rw [he2, Basis.repr_sum_self]
    exact_mod_cast hmD _ (Finset.mem_subtype.mpr he) i

end ConeLemma

open ConeLemma

/-- **The cone lemma** (Volume 5, Lemma 2.1.3 of the handbook). Let `V` be a vector space of finite dimension `r` over `ℚ`, with a total order that is compatible with addition, and let `E` be a finite set of elements `e ≥ 0` of `V`. Then there is a basis `m_1, ..., m_r` of `V` with `m_i > 0` for each `i`, such that each `e ∈ E` has coordinates `≥ 0` in this basis. So `E` lies in the rational cone of the `m_i`. -/
theorem coneLemma {V : Type*} [AddCommGroup V] [LinearOrder V] [IsOrderedAddMonoid V]
    [Module ℚ V] [FiniteDimensional ℚ V] (E : Finset V) (hE : ∀ e ∈ E, 0 ≤ e) :
    ∃ m : Basis (Fin (finrank ℚ V)) ℚ V, (∀ i, 0 < m i) ∧ ∀ e ∈ E, ∀ i, 0 ≤ m.repr e i := by
  obtain ⟨c, hc⟩ := exists_basis_mem_span (Module.finBasis ℚ V) E
  exact exists_basis_of_mem_span c E hc hE

end Singularity
