import Singularity.Hypotheses.Integral
import Singularity.Scheme.Reduction
import Hironaka.Resolution.Algebraic.Hir64.MainTheoremI
import Hironaka.Scheme.BlowUp.Glue.BlowUp
import Hironaka.Scheme.BlowUp.Glue.Trivial
import Hironaka.Scheme.BlowUp.Glue.Global

/-!
# Resolution in characteristic 0, from the base

This file proves the characteristic 0 case of the main statement from Hironaka's Main Theorem I in resolutionorg/hironaka (`AlgebraicGeometry.exists_support_eq_singularLocus_isRegular_blowUp`).

Main Theorem I gives, for an integral variety `X` over a field of characteristic 0, an ideal sheaf `D` whose support is the singular locus of `X`, such that the blowup of `X` along `D` is regular. The blowup `π` is then a resolution in the sense of `IsResolution`:

* `Y` is regular, from Main Theorem I;
* `π` is proper, because `X` is locally Noetherian (`blowUp.isProper_π` of the base);
* `π` is an isomorphism off the centre (`blowUp.isIso_π_restrict_compl_support` of the base), and the complement of the centre is the regular locus;
* the preimage of the regular locus is the complement of the exceptional divisor, and the exceptional divisor is invertible (`blowUp.isInvertible_comap_π` of the base). The complement of the support of an invertible ideal sheaf is dense. This file proves that last fact.

Main Theorem I in the base needs `X` integral. The step from integral to reduced is `Singularity.Reduction.reductionToIntegral`.
-/

open AlgebraicGeometry CategoryTheory Topology

universe u

namespace Singularity.Base

/-- Let `g` be a nonzerodivisor of a commutative ring `A`. Then the basic open set `D(g)` is dense in `Spec A`. Each nonempty open set contains a minimal prime, and a minimal prime contains no nonzerodivisor. -/
lemma dense_basicOpen_of_mem_nonZeroDivisors {A : Type*} [CommRing A] {g : A}
    (hg : g ∈ nonZeroDivisors A) :
    Dense (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum A)) := by
  rw [dense_iff_inter_open]
  rintro V hV ⟨q, hq⟩
  obtain ⟨p, hp, hpq⟩ := Ideal.exists_minimalPrimes_le (J := q.asIdeal) bot_le
  have hpp : p.IsPrime := hp.1.1
  refine ⟨⟨p, hpp⟩, ?_, ?_⟩
  · exact ((PrimeSpectrum.le_iff_specializes ⟨p, hpp⟩ q).mp hpq).mem_open hV hq
  · rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    exact fun hgp =>
      Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hp) hgp hg

/-- Let `J` be an ideal sheaf on a scheme `Y` that is locally generated by one nonzerodivisor. Then the complement of the support of `J` is dense in `Y`. -/
lemma dense_compl_support_of_locally_nonZeroDivisor {Y : Scheme.{u}} (J : Y.IdealSheafData)
    (hJ : ∀ y : Y, ∃ U : Y.affineOpens, y ∈ U.1 ∧
      ∃ g ∈ nonZeroDivisors Γ(Y, U), J.ideal U = Ideal.span {g}) :
    Dense ((J.support : Set Y)ᶜ) := by
  rw [dense_iff_inter_open]
  rintro V hV ⟨y, hy⟩
  obtain ⟨U, hyU, g, hg, hJU⟩ := hJ y
  have hU : IsAffineOpen U.1 := U.2
  have hW : IsOpen (hU.fromSpec ⁻¹' V) := hV.preimage hU.fromSpec.continuous
  have hWne : (hU.fromSpec ⁻¹' V).Nonempty := by
    have : y ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hyU
    obtain ⟨q, hq⟩ := this
    exact ⟨q, by rw [Set.mem_preimage, hq]; exact hy⟩
  obtain ⟨q, hqV, hqg⟩ :=
    (dense_basicOpen_of_mem_nonZeroDivisors hg).inter_open_nonempty _ hW hWne
  refine ⟨hU.fromSpec q, hqV, ?_⟩
  have hqU : hU.fromSpec q ∈ U.1 := by
    have h := hU.range_fromSpec.subset ⟨q, rfl⟩
    exact h
  intro hmem
  rw [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem hqU] at hmem
  have h2 : q ∈ PrimeSpectrum.zeroLocus (J.ideal U : Set Γ(Y, U)) := by
    rw [← hU.fromSpec_preimage_zeroLocus]
    exact hmem
  rw [hJU, PrimeSpectrum.mem_zeroLocus] at h2
  rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hqg
  exact hqg (h2 (Ideal.subset_span (Set.mem_singleton g)))

/-- The regular locus of a scheme is the complement of the singular locus of the base. -/
lemma regularLocus_eq_compl_singularLocus (X : Scheme.{u}) :
    regularLocus X = X.singularLocusᶜ := by
  ext x
  simp [regularLocus, Scheme.singularLocus, Scheme.IsRegularAt]

/-- Hironaka's Main Theorem I, in the form of `IsResolution`: an integral variety over a field of characteristic 0 has a resolution. -/
theorem exists_isResolution_of_isIntegral {k : Type u} [Field k] [CharZero k] (X : Scheme.{u})
    (f : X ⟶ Spec (.of k)) [hX : IsVariety X f] [IsIntegral X] :
    ∃ (Y : Scheme.{u}) (π : Y ⟶ X), IsResolution π := by
  have : LocallyOfFiniteType f := hX.finiteType
  have : QuasiCompact f := hX.quasiCompact
  have : IsSeparated f := hX.separated
  have hft : FiniteType f := inferInstance
  let Xa : AlgScheme k := MorphismProperty.Over.mk ⊤ f ⟨hft, hX.separated⟩
  have : IsIntegral Xa.left := ‹IsIntegral X›
  obtain ⟨D, hD, hreg⟩ : ∃ D : X.IdealSheafData,
      (D.support : Set X) = X.singularLocus ∧ IsRegular D.blowUp :=
    exists_support_eq_singularLocus_isRegular_blowUp Xa
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hU : ((D.support.compl : X.Opens) : Set X) = regularLocus X := by
    rw [regularLocus_eq_compl_singularLocus, ← hD]
    rfl
  refine ⟨D.blowUp, D.blowUpπ, ?_⟩
  refine ⟨fun y => hreg.isRegularAt y, Scheme.IdealSheafData.blowUp.isProper_π D,
    ⟨D.support.compl, hU, Scheme.IdealSheafData.blowUp.isIso_π_restrict_compl_support D⟩, ?_⟩
  have hpre : D.blowUpπ.base ⁻¹' regularLocus X =
      ((D.comap D.blowUpπ).support : Set D.blowUp)ᶜ := by
    rw [Scheme.IdealSheafData.support_comap, ← hU]
    rfl
  rw [hpre]
  exact dense_compl_support_of_locally_nonZeroDivisor _
    (Scheme.IdealSheafData.blowUp.isInvertible_comap_π D)

/-- The integral case of the main statement in characteristic 0, in each dimension. -/
theorem integralResolutionInDim_zero (n : ℕ) : IntegralResolutionInDim.{u} 0 n := by
  intro k _ _ X f _ _ _
  have : CharZero k := CharP.charP_to_charZero k
  exact exists_isResolution_of_isIntegral X f

end Singularity.Base

namespace Singularity

/-- Resolution in characteristic 0, in each dimension, from the base and the hypothesis `ReductionToIntegral`. -/
theorem resolutionInDim_zero (h : ReductionToIntegral.{u}) (n : ℕ) : ResolutionInDim.{u} 0 n :=
  h 0 n (Base.integralResolutionInDim_zero n)

/-- Resolution in characteristic 0, in each dimension. This is Hironaka's theorem in the form of the project. It uses Main Theorem I of the base and the reduction to integral varieties. It takes no hypothesis. -/
theorem resolutionInDim_charZero (n : ℕ) : ResolutionInDim.{u} 0 n :=
  resolutionInDim_zero Reduction.reductionToIntegral n

end Singularity
