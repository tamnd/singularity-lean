import Singularity.Invariant.LogJacobianKangaroo
import Singularity.Invariant.LogJacobianNearPoint

/-!
# The forms of `H` in case A

Let `k` be a field, let `g = x^r G` with `r = divisorExponent Δ g` and `G = residualFactor Δ g`,
and let `ρ = logJacobianOrder Δ g = m`. Let `F` be the part of degree `m` of `G`. For `i ∈ Δ` put
`E_i F = r_i F + x_i ∂_i F`.

This file proves Lemma 3.11.4 of Volume 7, Section 3.11 of the handbook: if `g` is of case A,
then `T_ρ(g)` is the intersection of the directrices of the `E_i F` for `i ∈ Δ`. So in case A the
directrix `T_ρ(g)` depends only on `F`, on `r` and on `Δ`.

The proof. The ideal `Θ̃₀(G)` (`residualLogJacobianTangent`) is generated by the
`e_i = r_i G + x_i ∂_i G` for `i ∈ Δ` and by the `x_a ∂_l G` for `l ∉ Δ`. Each `e_i` and each
`∂_l G` is in `Θ̃(G)`, which has order `m`. So each `e_i` has order at least `m`, with the part
`E_i F` of degree `m`, and each `x_a ∂_l G` has order at least `m + 1`, with the part `0` of degree
`m`. In case A each `ψ` of the definition of `T_ρ(g)` is in `Θ̃₀(G)`, so its part of degree `m`
is a linear combination of the `E_i F`. This gives `⋂ T(E_i F) ⊆ T_ρ(g)`. Conversely, if
`E_i F ≠ 0`, then `e_i` has order `m` and `x^r e_i = x_i ∂_i g` is in `Θ₀(g)`, so `e_i` is in the
definition of `T_ρ(g)`. This gives `T_ρ(g) ⊆ T(E_i F)`.

The lemma needs no hypothesis on `k` and no hypothesis that `g` is clean.

## Main definitions

* `caseAForm Δ g m i`: the form `E_i F = r_i F + x_i ∂_i F`.

## Main results

* `logJacobianDirectrix_eq_iInf_caseAForm`: Lemma 3.11.4, in case A,
  `T_ρ(g) = ⋂_{i ∈ Δ} T(E_i F)`.

## References

* Volume 7, Section 3.11 of the handbook: Lemma 3.11.4.
* Volume 7, Section 3.8 of the handbook: the definition of `T_ρ(g)`.
-/

open MvPolynomial Finsupp

namespace Singularity

section CaseAForms

variable {σ k : Type*} [Field k] [DecidableEq σ] [DecidableEq k] [Fintype σ]

/-- **The form `E_i F`.** With `r = divisorExponent Δ g` and `F` the part of degree `m` of
`G = residualFactor Δ g`, this is `E_i F = r_i F + x_i ∂_i F`. -/
noncomputable def caseAForm (Δ : Finset σ) (g : MvPolynomial σ k) (m : ℕ) (i : σ) :
    MvPolynomial σ k :=
  (divisorExponent Δ g i : k) • homogeneousComponent m (residualFactor Δ g) +
    X i * pderiv i (homogeneousComponent m (residualFactor Δ g))

omit [Fintype σ] in
/-- **The forms of `H` in case A** (Volume 7, Section 3.11 of the handbook, Lemma 3.11.4). Let
`ρ(g) = m`, and let `g` be of case A. Then `T_ρ(g)` is the intersection of the directrices of the
forms `E_i F = r_i F + x_i ∂_i F` for `i ∈ Δ`, with `F` the part of degree `m` of `G`. -/
theorem logJacobianDirectrix_eq_iInf_caseAForm {Δ : Finset σ} {g : MvPolynomial σ k} {m : ℕ}
    (hρ : logJacobianOrder Δ g = m) (hA : IsLogJacobianCaseA (Δ, g)) :
    logJacobianDirectrix Δ g = ⨅ i ∈ Δ, directrix (caseAForm Δ g m i) := by
  have hI : logJacobianCaseIdeal Δ g = logJacobianTangent Δ g :=
    logJacobianCaseIdeal_of_eq (by unfold IsLogJacobianCaseA at hA; exact_mod_cast hA)
  have hm : (logJacobianOrder Δ g).toNat = m := by rw [hρ]; rfl
  -- Each element of `Θ̃(G)` has order at least `m`.
  have hR : ∀ f ∈ residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g),
      (m : ℕ∞) ≤ ord f := fun f hf => hρ ▸ idealOrd_le_ord hf
  have hE : ∀ i ∈ Δ, (m : ℕ∞) ≤ ord ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) :=
    fun i hi => hR _ (smul_add_X_mul_pderiv_mem_residualLogJacobian hi _ _)
  have hE' : ∀ i, homogeneousComponent m ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) = caseAForm Δ g m i :=
    fun i => homogeneousComponent_smul_add_X_mul_pderiv m _ i _
  have hF : ∀ l ∉ Δ, ∀ a : σ, ((m + 1 : ℕ) : ℕ∞) ≤ ord (X a * pderiv l (residualFactor Δ g)) :=
    fun l hl a => natCast_succ_le_ord_X_mul (hR _ (pderiv_mem_residualLogJacobian hl _ _)) a
  refine le_antisymm ?_ ?_
  · refine le_iInf₂ fun i hi => ?_
    by_cases h0 : caseAForm Δ g m i = 0
    · rw [h0, directrix_zero]
      exact le_top
    · refine (logJacobianDirectrix_le (ψ := (divisorExponent Δ g i : k) • residualFactor Δ g +
        X i * pderiv i (residualFactor Δ g)) ⟨?_, ?_⟩).trans_eq (by rw [hm, hE'])
      · rw [hρ]
        refine le_antisymm ?_ (hE i hi)
        rw [← hE' i] at h0
        exact ord_le_of_homogeneousComponent_ne_zero h0
      · rw [hI, ← X_mul_pderiv_monomial_mul, monomial_mul_residualFactor]
        exact X_mul_pderiv_mem_logJacobianTangent hi g
  · refine le_logJacobianDirectrix fun ψ hψ => ?_
    rw [hm]
    have hψ' := mem_residualLogJacobianTangent (by rw [← hI]; exact hψ.2)
    refine le_directrix_homogeneousComponent_of_mem_span ?_ ?_ hψ'
    · rintro s (⟨i, hi, rfl⟩ | ⟨a, ha, rfl⟩)
      · exact hE i hi
      · exact (by exact_mod_cast Nat.le_succ m : (m : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞)).trans
          (hF a.2 ha a.1)
    · rintro s (⟨i, hi, rfl⟩ | ⟨a, ha, rfl⟩)
      · rw [hE']
        exact iInf₂_le i hi
      · rw [homogeneousComponent_eq_zero_of_lt_ord (lt_of_lt_of_le
          (by exact_mod_cast Nat.lt_succ_self m) (hF a.2 ha a.1)), directrix_zero]
        exact le_top

end CaseAForms

end Singularity
