import Singularity.Invariant.LogJacobianCornerRuns
import Singularity.Invariant.LogJacobianCenterNonincrease

/-!
# The blowups of the corner curves of `x^a y^b z^c`

This file proves Example 3.13.21 of Volume 7, Section 3.13 of the handbook. The field is `ZMod p`
for a prime `p`. The variables `x, y, z` are the indices `0, 1, 2` of `Fin 3`, the divisor is
`Δ = {y, z}`, and `g = x^a y^b z^c` with `p ∤ a`.

* The residual factor is `G = x^a`, and the residual log-Jacobian ideal is generated by `b x^a`,
  `c x^a` and `a x^(a-1)` (`residualLogJacobian_curve`). So `ρ = a - 1`
  (`logJacobianOrder_curvePoly`).
* The order of `g` along the corner curve `C = V(x, y)` is `a + b` (`ordAlong_curvePoly_xy`). The
  clean order is the same (`cleanOrdAlong_curvePoly`), so the order of `G` along `C` is
  `ν^G_C = a + b - b = a` (`orderGAlong_curvePoly_xy`). For `V(x, z)` the order is `a + c`, and
  `ν^G_C = a` (`orderGAlong_curvePoly_xz`).
* The blowup of `C = V(x, y)` is `centerChart {x, y}`. If `a + b ≥ p`, the origin of the
  `y`-chart, `x = y x'`, sends `g` to `y^p x'^a y^(a+b-p) z^c`. The new divisor is again `{y, z}`,
  the new point is again of the same form with `b` replaced by `a + b - p`, and `ρ = a - 1` at both
  points (`centerRhoStep_curvePoint_y`). The curve `V(x, z)` and the `z`-chart are the same with
  `y` and `z` exchanged (`centerRhoStep_curvePoint_z`).
* The map on the exponent data is `curveStepData`, and `curveSeq` iterates it for a sequence of
  the two charts. Each step at which the curve has the order at least `p` keeps `ρ = a - 1`
  (`curveRun_of_le`). For `a > p` this holds at each step, so each sequence of the two charts is
  an infinite sequence of these steps with `ρ = a - 1` at each point, and the points are distinct
  (`curveRun_of_charts`).
* At the other points over the origin, `ρ = 0`. In the `y`-chart with a translation `t ≠ 0` of
  `x'`, the new polynomial is `(x' + t)^a y^(a+b-p) z^c` (`logJacobianOrder_curve_y_translate`).
  At the origin of the `x`-chart, `y = x y'`, the new divisor is `{x, y, z}` and the new polynomial
  is `x^(a+b-p) y'^b z^c` (`logJacobianOrder_curve_x_origin`). In the `x`-chart with a translation
  `t ≠ 0` of `y'`, the new divisor is `{x, z}` and the new polynomial is
  `x^(a+b-p) (y' + t)^b z^c` (`logJacobianOrder_curve_x_translate`). The same holds for `V(x, z)`
  (`logJacobianOrder_curve_z_translate`, `logJacobianOrder_curve_xz_origin`,
  `logJacobianOrder_curve_xz_translate`). The result is for the clean part of the new polynomial,
  since the chart can give a `p`-th power.

The handbook says that each sequence of blowups of corner curves keeps `ρ = a - 1` for ever. If
`a < p`, the `y`-chart lowers `b` by `p - a`, so after a finite number of steps the order of `g`
along the curve is less than `p`. Then this file gives no step. The file proves the claim for each
step where the order along the curve is at least `p`, and for all the steps if `a > p`.

The file does not prove that (H1) and (H2) of Section 3.4 hold for `C`.

## Main definitions

* `CornerCurves.CenterRhoStep p S m P Q`: a step of the blowup of `V(x_i : i ∈ S)` where `ρ`
  stays `m`.
* `CornerCurves.curvePoint p a b c`: the point `({y, z}, x^a y^b z^c)`.
* `CornerCurves.curveStepData` and `CornerCurves.curveSeq`: the map on the exponent data and its
  iteration.

## References

* Volume 7, Section 3.13 of the handbook: Example 3.13.21.
* Volume 7, Section 3.4 of the handbook: the blowup of a coordinate center.
-/

open MvPolynomial Finsupp

namespace Singularity

namespace CornerCurves

open SurfaceRuns

/-! ### A step of the blowup of a coordinate center -/

section Step

variable {σ k : Type*} [Field k] [DecidableEq σ] [DecidableEq k] (p : ℕ)

/-- **A step of the blowup of a coordinate center where `ρ` stays `m`.** Let
`C = V(x_i : i ∈ S)`. The polynomial `g ≠ 0` of `P = (Δ, g)` is clean with the order at least `p`
along `C`, the `x_j`-chart of the blowup of `C` with `j ∈ S` sends `g` to `x_j^p g'`, the new point
is `Q = (centerDivisor Δ S j t, cleanPart p g')`, and `ρ = m` at `P` and at `Q`. For `S` the set of
all the variables, this is `RhoStep`. -/
def CenterRhoStep (S : Finset σ) (m : ℕ) (P Q : Finset σ × MvPolynomial σ k) : Prop :=
  ∃ j ∈ S, ∃ (t : σ → k) (g' : MvPolynomial σ k), P.2 ≠ 0 ∧ IsClean p P.2 ∧
    (p : ℕ∞) ≤ ordAlong S P.2 ∧ centerChart S j t P.2 = X j ^ p * g' ∧
    Q = (centerDivisor P.1 S j t, cleanPart p g') ∧
    logJacobianOrder P.1 P.2 = m ∧ logJacobianOrder Q.1 Q.2 = m

end Step

/-! ### A criterion for `ρ = 0` after the cleaning -/

section Zero

variable {σ k : Type*} [Field k] (p : ℕ) [CharP k p]

omit [CharP k p] in
theorem pderiv_monomial_of_eq_zero {N : σ →₀ ℕ} {i : σ} (h : N i = 0) (c : k) :
    pderiv i (monomial N c) = 0 := by
  rw [pderiv_monomial, h, Nat.cast_zero, mul_zero, monomial_zero]

omit [CharP k p] in
theorem ord_eq_zero_of_constantCoeff_ne_zero {w : MvPolynomial σ k} (hw : constantCoeff w ≠ 0) :
    ord w = 0 := by
  have h := ord_le (f := w) (d := 0) (by rwa [← constantCoeff_eq])
  rw [map_zero, Nat.cast_zero] at h
  exact nonpos_iff_eq_zero.mp h

/-- **A criterion for `ρ = 0`.** Let `x^N` divide each monomial of `g'`, with `N` supported in
`Δ`, and let `x^N w` be an element of `Θ(g')` with `w(0) ≠ 0`. Then `ρ = 0` for the clean part of
`g'`. The reason is that `Θ` does not change under the cleaning, the divisor exponent `r` of the
clean part is at least `N`, and `ord Θ = |r| + ρ ≤ |N|`. -/
theorem logJacobianOrder_cleanPart_eq_zero_of {Δ : Finset σ} {g' : MvPolynomial σ k}
    {N : σ →₀ ℕ} (hN : ∀ i, i ∉ Δ → N i = 0) (hdiv : ∀ β ∈ g'.support, N ≤ β)
    {w : MvPolynomial σ k} (hφ : monomial N 1 * w ∈ logJacobian Δ g')
    (hw : constantCoeff w ≠ 0) : logJacobianOrder Δ (cleanPart p g') = 0 := by
  have hw0 : w ≠ 0 := fun h => hw (by rw [h, map_zero])
  have hm0 : monomial N (1 : k) ≠ 0 := by
    rw [Ne, monomial_eq_zero]
    exact one_ne_zero
  have hφ' : monomial N 1 * w ∈ logJacobian Δ (cleanPart p g') := by
    rwa [logJacobian_cleanPart]
  have hc0 : cleanPart p g' ≠ 0 := by
    intro h
    rw [h, logJacobian_zero, Ideal.mem_bot] at hφ'
    exact mul_ne_zero hm0 hw0 hφ'
  have hle : N ≤ divisorExponent Δ (cleanPart p g') :=
    le_divisorExponent hc0 hN fun β hβ => hdiv β (mem_support_of_mem_support_cleanPart hβ)
  obtain ⟨e, he⟩ := exists_add_of_le hle
  have h1 := idealOrd_logJacobian Δ (cleanPart p g')
  have h2 := idealOrd_le_ord hφ'
  rw [ord_mul, ord_monomial one_ne_zero, ord_eq_zero_of_constantCoeff_ne_zero hw, add_zero, h1,
    he, map_add] at h2
  generalize logJacobianOrder Δ (cleanPart p g') = x at h2 ⊢
  induction x using ENat.recTopCoe with
  | top => simp at h2
  | coe m =>
    have : degree N + degree e + m ≤ degree N := by exact_mod_cast h2
    have hm : m = 0 := by omega
    rw [hm, Nat.cast_zero]

end Zero

/-! ### The point `x^a y^b z^c` -/

section Point

variable (p : ℕ) [Fact p.Prime]

/-- The polynomial `g = x^a y^b z^c` of Example 3.13.21. -/
noncomputable def curvePoly (a b c : ℕ) : MvPolynomial (Fin 3) (ZMod p) :=
  X 0 ^ a * X 1 ^ b * X 2 ^ c

/-- The point `({y, z}, x^a y^b z^c)` of Example 3.13.21. -/
noncomputable def curvePoint (a b c : ℕ) : Finset (Fin 3) × MvPolynomial (Fin 3) (ZMod p) :=
  ({1, 2}, curvePoly p a b c)

variable {p}

theorem curvePoly_eq_monomial (a b c : ℕ) :
    curvePoly p a b c = monomial (single 0 a + single 1 b + single 2 c) 1 := by
  rw [curvePoly, X_pow_eq_monomial, X_pow_eq_monomial, X_pow_eq_monomial, monomial_mul_monomial,
    monomial_mul_monomial, one_mul, one_mul]

theorem curvePoly_eq_mul (a b c : ℕ) :
    curvePoly p a b c = monomial (single 1 b + single 2 c) 1 * X 0 ^ a := by
  have h : (X 1 ^ b * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) =
      monomial (single 1 b + single 2 c) 1 := by
    rw [X_pow_eq_monomial, X_pow_eq_monomial, monomial_mul_monomial, one_mul]
  rw [← h, curvePoly]
  ring

theorem curve_hG (a : ℕ) :
    ∀ i ∈ ({1, 2} : Finset (Fin 3)), ∃ d ∈ (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)).support,
      d i = 0 := by
  intro i hi
  refine ⟨single 0 a, ?_, ?_⟩
  · rw [X_pow_eq_monomial, support_monomial, ite_eq_right one_ne_zero]
    exact Finset.mem_singleton_self _
  · simp only [Finset.mem_insert, Finset.mem_singleton] at hi
    rcases hi with rfl | rfl <;> simp

theorem divisorExponent_curvePoly (a b c : ℕ) :
    divisorExponent {1, 2} (curvePoly p a b c) = single 1 b + single 2 c := by
  rw [curvePoly_eq_mul]
  exact KangarooCounterexample.divisorExponent_monomial_mul' (surface_hr b c) (curve_hG a)

theorem residualFactor_curvePoly (a b c : ℕ) :
    residualFactor {1, 2} (curvePoly p a b c) = X 0 ^ a := by
  rw [curvePoly_eq_mul]
  exact residualFactor_monomial_mul (surface_hr b c) (curve_hG a)

theorem curvePoly_ne_zero (a b c : ℕ) : curvePoly p a b c ≠ 0 := by
  rw [curvePoly_eq_monomial]
  exact fun h => one_ne_zero (monomial_eq_zero.mp h)

/-- If `p ∤ a`, then `x^a y^b z^c` is clean. -/
theorem isClean_curvePoly {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) : IsClean p (curvePoly p a b c) := by
  intro d hd hall
  rw [curvePoly_eq_monomial, support_monomial, ite_eq_right one_ne_zero,
    Finset.mem_singleton] at hd
  subst hd
  exact ha (by simpa using hall 0)

theorem pderiv_X_zero_pow_of_ne {i : Fin 3} (hi : i ≠ 0) (a : ℕ) :
    pderiv i (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)) = 0 := by
  rw [Derivation.leibniz_pow, pderiv_X_of_ne (Ne.symm hi), smul_zero, smul_zero]

theorem pderiv_zero_X_pow (a : ℕ) :
    pderiv 0 (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)) =
      (a : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ (a - 1) := by
  rw [Derivation.leibniz_pow, pderiv_X_self, smul_eq_mul, mul_one, nsmul_eq_mul]

/-- **The residual log-Jacobian ideal of Example 3.13.21.** For `G = x^a` and the exponents
`(b, c)` of `y` and `z`, the ideal is generated by `b x^a`, `c x^a` and `a x^(a-1)`. -/
theorem residualLogJacobian_curve (a b c : ℕ) :
    residualLogJacobian {1, 2} (single 1 b + single 2 c) (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)) =
      Ideal.span {(b : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ a,
        (c : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ a,
        (a : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ (a - 1)} := by
  have g1 : (((single 1 b + single 2 c : Fin 3 →₀ ℕ) 1 : ℕ) : ZMod p) •
      (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)) + X 1 * pderiv 1 (X 0 ^ a) =
      (b : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ a := by
    rw [pderiv_X_zero_pow_of_ne (by decide), mul_zero, add_zero, smul_eq_C_mul]
    simp
  have g2 : (((single 1 b + single 2 c : Fin 3 →₀ ℕ) 2 : ℕ) : ZMod p) •
      (X 0 ^ a : MvPolynomial (Fin 3) (ZMod p)) + X 2 * pderiv 2 (X 0 ^ a) =
      (c : MvPolynomial (Fin 3) (ZMod p)) * X 0 ^ a := by
    rw [pderiv_X_zero_pow_of_ne (by decide), mul_zero, add_zero, smul_eq_C_mul]
    simp
  apply le_antisymm
  · rw [residualLogJacobian, Ideal.span_le]
    rintro s (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
    · simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hi
      rcases hi with rfl | rfl
      · rw [SetLike.mem_coe]
        dsimp only
        rw [g1]
        exact Ideal.subset_span (Set.mem_insert _ _)
      · rw [SetLike.mem_coe]
        dsimp only
        rw [g2]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    · have : i = 0 := by
        simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_compl_iff,
          Set.mem_insert_iff, Set.mem_singleton_iff] at hi
        fin_cases i <;> simp_all
      subst this
      rw [SetLike.mem_coe]
      dsimp only
      rw [pderiv_zero_X_pow]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  · rw [Ideal.span_le]
    rintro s (rfl | rfl | rfl)
    · rw [SetLike.mem_coe, ← g1, residualLogJacobian]
      exact Ideal.subset_span (Or.inl ⟨1, by simp, rfl⟩)
    · rw [SetLike.mem_coe, ← g2, residualLogJacobian]
      exact Ideal.subset_span (Or.inl ⟨2, by simp, rfl⟩)
    · rw [SetLike.mem_coe, ← pderiv_zero_X_pow, residualLogJacobian]
      exact Ideal.subset_span (Or.inr ⟨0, by simp, rfl⟩)

/-- **`ρ = a - 1`** (Example 3.13.21). If `p ∤ a`, then the order of the log-Jacobian ideal of
`x^a y^b z^c` for `Δ = {y, z}` is `a - 1`. The generator `a x^(a-1)` has the order `a - 1`, and
the other generators have the order at least `a`. -/
theorem logJacobianOrder_curvePoly {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) :
    logJacobianOrder ({1, 2} : Finset (Fin 3)) (curvePoly p a b c) = (a - 1 : ℕ) := by
  rw [logJacobianOrder, divisorExponent_curvePoly, residualFactor_curvePoly,
    residualLogJacobian_curve]
  have ha' : ((a : ℕ) : ZMod p) ≠ 0 := by
    rwa [Ne, ZMod.natCast_eq_zero_iff]
  have hle : ∀ q : MvPolynomial (Fin 3) (ZMod p), ((a - 1 : ℕ) : ℕ∞) ≤ ord (q * X 0 ^ a) :=
    fun q => le_trans (by rw [ord_X_pow]; exact_mod_cast Nat.sub_le a 1)
      (le_add_self.trans (le_ord_mul q _))
  refine idealOrd_span_eq' ?_ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)) ?_
  · rintro s (rfl | rfl | rfl)
    · exact hle _
    · exact hle _
    · exact (ord_X_pow 0 (a - 1)).ge.trans (le_add_self.trans (le_ord_mul _ _))
  · rw [ord_mul, ← map_natCast (C : ZMod p →+* MvPolynomial (Fin 3) (ZMod p)) a, ord_C ha',
      ord_X_pow, zero_add]

/-! ### The order along the corner curves -/

/-- The order of `x^a y^b z^c` along `V(x, y)` is `a + b`. -/
theorem ordAlong_curvePoly_xy (a b c : ℕ) :
    ordAlong {0, 1} (curvePoly p a b c) = ((a + b : ℕ) : ℕ∞) := by
  rw [curvePoly_eq_monomial, ordAlong_monomial _ one_ne_zero]
  simp

/-- The order of `x^a y^b z^c` along `V(x, z)` is `a + c`. -/
theorem ordAlong_curvePoly_xz (a b c : ℕ) :
    ordAlong {0, 2} (curvePoly p a b c) = ((a + c : ℕ) : ℕ∞) := by
  rw [curvePoly_eq_monomial, ordAlong_monomial _ one_ne_zero]
  simp

/-- If `p ∤ a`, then the clean order of `x^a y^b z^c` along each coordinate subvariety is its
order. The reason is that `x^a y^b z^c` is not a `p`-th power, so for each `h` the monomial stays in
`g + h^p`. -/
theorem cleanOrdAlong_curvePoly {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) (S : Finset (Fin 3)) :
    cleanOrdAlong p S (curvePoly p a b c) = ordAlong S (curvePoly p a b c) := by
  refine le_antisymm (iSup_le fun h => ?_)
    (ordAlong_le_cleanOrdAlong (Fact.out : p.Prime).ne_zero S _)
  have hnot : ¬ ∀ i, p ^ 1 ∣ (single 0 a + single 1 b + single 2 c : Fin 3 →₀ ℕ) i :=
    fun hall => ha (by simpa using hall 0)
  have hpow := coeff_pow_eq_zero_of_not_dvd p 1 h hnot
  rw [pow_one] at hpow
  have hc : (curvePoly p a b c + h ^ p).coeff (single 0 a + single 1 b + single 2 c) ≠ 0 := by
    rw [coeff_add_apply, hpow, add_zero, curvePoly_eq_monomial, coeff_monomial]
    simp
  refine (ordAlong_le hc).trans (le_of_eq ?_)
  rw [curvePoly_eq_monomial, ordAlong_monomial _ one_ne_zero]

/-- **`ν^G_C = a` for `C = V(x, y)`** (Example 3.13.21). If `p ∤ a`, the order of `G` along
`V(x, y)` is `a + b - b = a`. -/
theorem orderGAlong_curvePoly_xy {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) :
    orderGAlong p {1, 2} {0, 1} (curvePoly p a b c) = a := by
  rw [orderGAlong, cleanOrdAlong_curvePoly ha, ordAlong_curvePoly_xy, divisorExponent_curvePoly,
    show ({1, 2} ∩ {0, 1} : Finset (Fin 3)) = {1} by decide]
  simp only [Finset.sum_singleton, Finsupp.add_apply, Finsupp.single_eq_same]
  rw [← ENat.natCast_sub, Finsupp.single_eq_of_ne (show (1 : Fin 3) ≠ 2 by decide), add_zero,
    Nat.add_sub_cancel]

/-- **`ν^G_C = a` for `C = V(x, z)`** (Example 3.13.21). If `p ∤ a`, the order of `G` along
`V(x, z)` is `a + c - c = a`. -/
theorem orderGAlong_curvePoly_xz {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) :
    orderGAlong p {1, 2} {0, 2} (curvePoly p a b c) = a := by
  rw [orderGAlong, cleanOrdAlong_curvePoly ha, ordAlong_curvePoly_xz, divisorExponent_curvePoly,
    show ({1, 2} ∩ {0, 2} : Finset (Fin 3)) = {2} by decide]
  simp only [Finset.sum_singleton, Finsupp.add_apply, Finsupp.single_eq_same]
  rw [← ENat.natCast_sub, Finsupp.single_eq_of_ne (show (2 : Fin 3) ≠ 1 by decide), zero_add,
    Nat.add_sub_cancel]

/-! ### The origins of the `y`-chart and the `z`-chart -/

theorem centerDivisor_curve_y (t : Fin 3 → ZMod p) :
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 1} 1 t = {1, 2} := by
  ext i
  fin_cases i <;> simp [centerDivisor]

theorem centerDivisor_curve_z (t : Fin 3 → ZMod p) :
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 2} 2 t = {1, 2} := by
  ext i
  fin_cases i <;> simp [centerDivisor]

/-- **The `y`-chart of the blowup of `V(x, y)`.** If `a + b ≥ p`, the origin of the `y`-chart,
`x = y x'`, sends `x^a y^b z^c` to `y^p x'^a y^(a+b-p) z^c`. -/
theorem centerChart_curvePoly_y {a b : ℕ} (h : p ≤ a + b) (c : ℕ) :
    centerChart {0, 1} 1 (0 : Fin 3 → ZMod p) (curvePoly p a b c) =
      X 1 ^ p * curvePoly p a (a + b - p) c := by
  have hx : centerChart ({0, 1} : Finset (Fin 3)) 1 (0 : Fin 3 → ZMod p) (X 0) = X 1 * X 0 := by
    rw [centerChart_X_of_mem _ (by decide) (by decide)]
    simp
  have hz : centerChart ({0, 1} : Finset (Fin 3)) 1 (0 : Fin 3 → ZMod p) (X 2) = X 2 :=
    centerChart_X_of_notMem _ (by decide) (by decide)
  obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
  have e : (X 1 ^ a * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) = X 1 ^ p * X 1 ^ m := by
    rw [← pow_add, ← pow_add, hm]
  rw [hm, Nat.add_sub_cancel_left]
  simp only [curvePoly, map_mul, map_pow, hx, hz, centerChart_X_self]
  linear_combination (X 0 ^ a * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) * e

/-- **The `z`-chart of the blowup of `V(x, z)`.** If `a + c ≥ p`, the origin of the `z`-chart,
`x = z x'`, sends `x^a y^b z^c` to `z^p x'^a y^b z^(a+c-p)`. -/
theorem centerChart_curvePoly_z {a c : ℕ} (h : p ≤ a + c) (b : ℕ) :
    centerChart {0, 2} 2 (0 : Fin 3 → ZMod p) (curvePoly p a b c) =
      X 2 ^ p * curvePoly p a b (a + c - p) := by
  have hx : centerChart ({0, 2} : Finset (Fin 3)) 2 (0 : Fin 3 → ZMod p) (X 0) = X 2 * X 0 := by
    rw [centerChart_X_of_mem _ (by decide) (by decide)]
    simp
  have hy : centerChart ({0, 2} : Finset (Fin 3)) 2 (0 : Fin 3 → ZMod p) (X 1) = X 1 :=
    centerChart_X_of_notMem _ (by decide) (by decide)
  obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
  have e : (X 2 ^ a * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) = X 2 ^ p * X 2 ^ m := by
    rw [← pow_add, ← pow_add, hm]
  rw [hm, Nat.add_sub_cancel_left]
  simp only [curvePoly, map_mul, map_pow, hx, hy, centerChart_X_self]
  linear_combination (X 0 ^ a * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) * e

/-- **The step of the `y`-chart** (Example 3.13.21). Let `p ∤ a` and `a + b ≥ p`. The origin of
the `y`-chart of the blowup of `V(x, y)` sends `({y, z}, x^a y^b z^c)` to
`({y, z}, x^a y^(a+b-p) z^c)`, no cleaning is necessary, and `ρ = a - 1` at both points. -/
theorem centerRhoStep_curvePoint_y {a b : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + b) (c : ℕ) :
    CenterRhoStep p {0, 1} (a - 1) (curvePoint p a b c) (curvePoint p a (a + b - p) c) := by
  refine ⟨1, by decide, 0, curvePoly p a (a + b - p) c, curvePoly_ne_zero a b c,
    isClean_curvePoly ha b c, ?_, centerChart_curvePoly_y h c, ?_,
    logJacobianOrder_curvePoly ha b c, logJacobianOrder_curvePoly ha _ c⟩
  · show (p : ℕ∞) ≤ ordAlong {0, 1} (curvePoly p a b c)
    rw [ordAlong_curvePoly_xy]
    exact_mod_cast h
  · show ((({1, 2} : Finset (Fin 3)), curvePoly p a (a + b - p) c) :
        Finset (Fin 3) × MvPolynomial (Fin 3) (ZMod p)) =
      (centerDivisor ({1, 2} : Finset (Fin 3)) {0, 1} 1 0,
        cleanPart p (curvePoly p a (a + b - p) c))
    rw [centerDivisor_curve_y, cleanPart_eq_self (isClean_curvePoly ha _ c)]

/-- **The step of the `z`-chart** (Example 3.13.21). Let `p ∤ a` and `a + c ≥ p`. The origin of
the `z`-chart of the blowup of `V(x, z)` sends `({y, z}, x^a y^b z^c)` to
`({y, z}, x^a y^b z^(a+c-p))`, no cleaning is necessary, and `ρ = a - 1` at both points. -/
theorem centerRhoStep_curvePoint_z {a c : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + c) (b : ℕ) :
    CenterRhoStep p {0, 2} (a - 1) (curvePoint p a b c) (curvePoint p a b (a + c - p)) := by
  refine ⟨2, by decide, 0, curvePoly p a b (a + c - p), curvePoly_ne_zero a b c,
    isClean_curvePoly ha b c, ?_, centerChart_curvePoly_z h b, ?_,
    logJacobianOrder_curvePoly ha b c, logJacobianOrder_curvePoly ha b _⟩
  · show (p : ℕ∞) ≤ ordAlong {0, 2} (curvePoly p a b c)
    rw [ordAlong_curvePoly_xz]
    exact_mod_cast h
  · show ((({1, 2} : Finset (Fin 3)), curvePoly p a b (a + c - p)) :
        Finset (Fin 3) × MvPolynomial (Fin 3) (ZMod p)) =
      (centerDivisor ({1, 2} : Finset (Fin 3)) {0, 2} 2 0,
        cleanPart p (curvePoly p a b (a + c - p)))
    rw [centerDivisor_curve_z, cleanPart_eq_self (isClean_curvePoly ha b _)]

end Point

/-! ### The runs -/

/-- The map on the exponent data `(b, c)` of Example 3.13.21. The origin of the `y`-chart of the
blowup of `V(x, y)` sends `(b, c)` to `(a + b - p, c)`, and the origin of the `z`-chart of the
blowup of `V(x, z)` sends it to `(b, a + c - p)`. The first case is `y = true`. -/
def curveStepData (p a : ℕ) (y : Bool) (D : ℕ × ℕ) : ℕ × ℕ :=
  if y then (a + D.1 - p, D.2) else (D.1, a + D.2 - p)

/-- The exponent data of a sequence of the two charts that starts at `(b, c)`. At step `k` the
sequence takes the `y`-chart if `ch k` is true, and the `z`-chart if not. -/
def curveSeq (p a b c : ℕ) (ch : ℕ → Bool) : ℕ → ℕ × ℕ
  | 0 => (b, c)
  | k + 1 => curveStepData p a (ch k) (curveSeq p a b c ch k)

theorem curveSeq_succ (p a b c : ℕ) (ch : ℕ → Bool) (k : ℕ) :
    curveSeq p a b c ch (k + 1) = curveStepData p a (ch k) (curveSeq p a b c ch k) := rfl

/-- The condition that the curve of step `k` has the order at least `p`: `a + b ≥ p` for the
`y`-chart, and `a + c ≥ p` for the `z`-chart. -/
def curveStepOK (p a : ℕ) (y : Bool) (D : ℕ × ℕ) : Prop :=
  if y then p ≤ a + D.1 else p ≤ a + D.2

/-- The center of the step: `{x, y}` for the `y`-chart, and `{x, z}` for the `z`-chart. -/
def curveCenter (y : Bool) : Finset (Fin 3) := if y then {0, 1} else {0, 2}

section Run

variable (p : ℕ) [Fact p.Prime]

/-- The point `P_k = ({y, z}, x^a y^b z^c)` of a sequence of the two charts, with
`(b, c) = curveSeq p a b₀ c₀ ch k`. -/
noncomputable def curveRunPoint (a b c : ℕ) (ch : ℕ → Bool) (k : ℕ) :
    Finset (Fin 3) × MvPolynomial (Fin 3) (ZMod p) :=
  curvePoint p a (curveSeq p a b c ch k).1 (curveSeq p a b c ch k).2

variable {p}

/-- **A step of a sequence of the two charts** (Example 3.13.21). If the curve of the step has
the order at least `p`, then the step keeps `ρ = a - 1`. -/
theorem centerRhoStep_curveRunPoint {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) (ch : ℕ → Bool) (k : ℕ)
    (hk : curveStepOK p a (ch k) (curveSeq p a b c ch k)) :
    CenterRhoStep p (curveCenter (ch k)) (a - 1) (curveRunPoint p a b c ch k)
      (curveRunPoint p a b c ch (k + 1)) := by
  rw [curveRunPoint, curveRunPoint, curveSeq_succ]
  unfold curveStepOK at hk
  unfold curveStepData curveCenter
  cases hc : ch k
  · simp only [hc, Bool.false_eq_true, ↓reduceIte] at hk ⊢
    exact centerRhoStep_curvePoint_z ha hk _
  · simp only [hc, ↓reduceIte] at hk ⊢
    exact centerRhoStep_curvePoint_y ha hk _

/-- **Example 3.13.21, each step of a sequence of the corner curves.** Let `p ∤ a`. At each point
of a sequence of the two charts, `ρ = a - 1`. Each step where the curve has the order at least
`p` is a step of the blowup of the curve that keeps `ρ = a - 1`. -/
theorem curveRun_of_le {a : ℕ} (ha : ¬ p ∣ a) (b c : ℕ) (ch : ℕ → Bool) :
    (∀ k, logJacobianOrder (curveRunPoint p a b c ch k).1 (curveRunPoint p a b c ch k).2 =
      (a - 1 : ℕ)) ∧
    (∀ k, curveStepOK p a (ch k) (curveSeq p a b c ch k) →
      CenterRhoStep p (curveCenter (ch k)) (a - 1) (curveRunPoint p a b c ch k)
        (curveRunPoint p a b c ch (k + 1))) :=
  ⟨fun _ => logJacobianOrder_curvePoly ha _ _, centerRhoStep_curveRunPoint ha b c ch⟩

omit [Fact p.Prime] in
theorem curveSeq_sum_lt {a : ℕ} (hpa : p < a) (b c : ℕ) (ch : ℕ → Bool) (k : ℕ) :
    (curveSeq p a b c ch k).1 + (curveSeq p a b c ch k).2 <
      (curveSeq p a b c ch (k + 1)).1 + (curveSeq p a b c ch (k + 1)).2 := by
  rw [curveSeq_succ]
  unfold curveStepData
  cases ch k
  · simp only [Bool.false_eq_true, ↓reduceIte]
    omega
  · simp only [↓reduceIte]
    omega

theorem curveRunPoint_injective {a : ℕ} (hpa : p < a) (b c : ℕ) (ch : ℕ → Bool) :
    Function.Injective (curveRunPoint p a b c ch) := by
  have hm : StrictMono fun k => (curveSeq p a b c ch k).1 + (curveSeq p a b c ch k).2 :=
    strictMono_nat_of_lt_succ (curveSeq_sum_lt hpa b c ch)
  intro k l h
  have h1 := congrArg (fun P => divisorExponent P.1 P.2 1) h
  have h2 := congrArg (fun P => divisorExponent P.1 P.2 2) h
  simp only [curveRunPoint, curvePoint, divisorExponent_curvePoly] at h1 h2
  simp at h1 h2
  exact hm.injective (by simp only [h1, h2])

/-- **Example 3.13.21, each sequence of the corner curves** (Volume 7, Section 3.13 of the
handbook). Let `p` be a prime, `Δ = {y, z}`, `g = x^a y^b z^c`, `p ∤ a` and `a > p`. Each sequence
of the origins of the `y`-chart of the blowup of `V(x, y)` and of the `z`-chart of the blowup of
`V(x, z)` is an infinite sequence of steps that keep `ρ = a - 1`, and the points are distinct. -/
theorem curveRun_of_charts {a : ℕ} (ha : ¬ p ∣ a) (hpa : p < a) (b c : ℕ) (ch : ℕ → Bool) :
    (∀ k, CenterRhoStep p (curveCenter (ch k)) (a - 1) (curveRunPoint p a b c ch k)
        (curveRunPoint p a b c ch (k + 1))) ∧
    (∀ k, logJacobianOrder (curveRunPoint p a b c ch k).1 (curveRunPoint p a b c ch k).2 =
      (a - 1 : ℕ)) ∧
    Function.Injective (curveRunPoint p a b c ch) := by
  refine ⟨fun k => centerRhoStep_curveRunPoint ha b c ch k ?_, (curveRun_of_le ha b c ch).1,
    curveRunPoint_injective hpa b c ch⟩
  unfold curveStepOK
  split_ifs <;> omega

end Run

/-! ### The other points over the origin -/

section Other

variable {p : ℕ} [Fact p.Prime]

theorem pderiv_X_add_C_pow (i : Fin 3) (s : ZMod p) (n : ℕ) :
    pderiv i ((X i + C s) ^ n : MvPolynomial (Fin 3) (ZMod p)) =
      (n : MvPolynomial (Fin 3) (ZMod p)) * (X i + C s) ^ (n - 1) := by
  rw [Derivation.leibniz_pow, map_add, pderiv_X_self, pderiv_C, add_zero, smul_eq_mul, mul_one,
    nsmul_eq_mul]

theorem pderiv_X_add_C_pow_of_ne {i j : Fin 3} (hij : i ≠ j) (s : ZMod p) (n : ℕ) :
    pderiv j ((X i + C s) ^ n : MvPolynomial (Fin 3) (ZMod p)) = 0 := by
  rw [Derivation.leibniz_pow, map_add, pderiv_X_of_ne hij, pderiv_C, add_zero, smul_zero,
    smul_zero]

theorem constantCoeff_natCast_mul_X_add_C_pow {n : ℕ} (hn : ((n : ℕ) : ZMod p) ≠ 0) (i : Fin 3)
    {s : ZMod p} (hs : s ≠ 0) (m : ℕ) :
    constantCoeff ((n : MvPolynomial (Fin 3) (ZMod p)) * (X i + C s) ^ m) ≠ 0 := by
  rw [map_mul, map_pow, map_add, constantCoeff_X, constantCoeff_C, zero_add, map_natCast]
  exact mul_ne_zero hn (pow_ne_zero _ hs)

theorem monomial_le_of_mem_support {N β : Fin 3 →₀ ℕ} {w : MvPolynomial (Fin 3) (ZMod p)}
    (h : β ∈ (monomial N 1 * w).support) : N ≤ β := by
  rw [MvPolynomial.mem_support_iff, coeff_monomial_mul'] at h
  by_contra hN
  exact h (by simp [hN])

theorem X_pow_mul_X_pow_eq_monomial (i j : Fin 3) (m n : ℕ) :
    (X i ^ m * X j ^ n : MvPolynomial (Fin 3) (ZMod p)) = monomial (single i m + single j n) 1 := by
  rw [X_pow_eq_monomial, X_pow_eq_monomial, monomial_mul_monomial, one_mul]

/-- **The `y`-chart of `V(x, y)` with a translation** (Example 3.13.21). Let `p ∤ a`, `a + b ≥ p`
and `t_x ≠ 0`. The `y`-chart of the blowup of `V(x, y)` at `x' = t_x` sends `x^a y^b z^c` to
`y^p (x' + t_x)^a y^(a+b-p) z^c`, the new divisor is `{y, z}`, and `ρ = 0` for the clean part of
the new polynomial. The reason is that `∂_x` of the new polynomial is `y^(a+b-p) z^c` times
`a (x' + t_x)^(a-1)`, whose constant term is not `0`. -/
theorem logJacobianOrder_curve_y_translate {a b : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + b) (c : ℕ)
    {t : Fin 3 → ZMod p} (ht : t 0 ≠ 0) :
    centerChart {0, 1} 1 t (curvePoly p a b c) =
      X 1 ^ p * (X 1 ^ (a + b - p) * X 2 ^ c * (X 0 + C (t 0)) ^ a) ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 1} 1 t = {1, 2} ∧
    logJacobianOrder ({1, 2} : Finset (Fin 3))
      (cleanPart p (X 1 ^ (a + b - p) * X 2 ^ c * (X 0 + C (t 0)) ^ a)) = 0 := by
  refine ⟨?_, centerDivisor_curve_y t, ?_⟩
  · have hx : centerChart ({0, 1} : Finset (Fin 3)) 1 t (X 0) = X 1 * (X 0 + C (t 0)) :=
      centerChart_X_of_mem _ (by decide) (by decide)
    have hz : centerChart ({0, 1} : Finset (Fin 3)) 1 t (X 2) = X 2 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 1 ^ a * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) = X 1 ^ p * X 1 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hx, hz, centerChart_X_self]
    simp only [mul_pow]
    linear_combination ((X 0 + C (t 0)) ^ a * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) * e
  · set N : Fin 3 →₀ ℕ := single 1 (a + b - p) + single 2 c with hN
    have hNm : (X 1 ^ (a + b - p) * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) = monomial N 1 :=
      X_pow_mul_X_pow_eq_monomial 1 2 _ _
    rw [hNm]
    have ha' : ((a : ℕ) : ZMod p) ≠ 0 := by
      rwa [Ne, ZMod.natCast_eq_zero_iff]
    have hN0 : N 0 = 0 := by simp [hN]
    have hd : pderiv 0 (monomial N 1 * (X 0 + C (t 0)) ^ a) =
        monomial N 1 * ((a : MvPolynomial (Fin 3) (ZMod p)) * (X 0 + C (t 0)) ^ (a - 1)) := by
      rw [pderiv_mul, pderiv_monomial_of_eq_zero hN0, zero_mul, zero_add, pderiv_X_add_C_pow]
    refine logJacobianOrder_cleanPart_eq_zero_of p (surface_hr _ _)
      (fun β hβ => monomial_le_of_mem_support hβ) ?_
      (constantCoeff_natCast_mul_X_add_C_pow ha' 0 ht (a - 1))
    rw [← hd]
    exact Ideal.subset_span (Or.inr ⟨0, by simp, rfl⟩)

/-- **The `z`-chart of `V(x, z)` with a translation** (Example 3.13.21). This is
`logJacobianOrder_curve_y_translate` with `y` and `z` exchanged. -/
theorem logJacobianOrder_curve_z_translate {a c : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + c) (b : ℕ)
    {t : Fin 3 → ZMod p} (ht : t 0 ≠ 0) :
    centerChart {0, 2} 2 t (curvePoly p a b c) =
      X 2 ^ p * (X 1 ^ b * X 2 ^ (a + c - p) * (X 0 + C (t 0)) ^ a) ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 2} 2 t = {1, 2} ∧
    logJacobianOrder ({1, 2} : Finset (Fin 3))
      (cleanPart p (X 1 ^ b * X 2 ^ (a + c - p) * (X 0 + C (t 0)) ^ a)) = 0 := by
  refine ⟨?_, centerDivisor_curve_z t, ?_⟩
  · have hx : centerChart ({0, 2} : Finset (Fin 3)) 2 t (X 0) = X 2 * (X 0 + C (t 0)) :=
      centerChart_X_of_mem _ (by decide) (by decide)
    have hy : centerChart ({0, 2} : Finset (Fin 3)) 2 t (X 1) = X 1 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 2 ^ a * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) = X 2 ^ p * X 2 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hx, hy, centerChart_X_self]
    simp only [mul_pow]
    linear_combination ((X 0 + C (t 0)) ^ a * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) * e
  · set N : Fin 3 →₀ ℕ := single 1 b + single 2 (a + c - p) with hN
    have hNm : (X 1 ^ b * X 2 ^ (a + c - p) : MvPolynomial (Fin 3) (ZMod p)) = monomial N 1 :=
      X_pow_mul_X_pow_eq_monomial 1 2 _ _
    rw [hNm]
    have ha' : ((a : ℕ) : ZMod p) ≠ 0 := by
      rwa [Ne, ZMod.natCast_eq_zero_iff]
    have hN0 : N 0 = 0 := by simp [hN]
    have hd : pderiv 0 (monomial N 1 * (X 0 + C (t 0)) ^ a) =
        monomial N 1 * ((a : MvPolynomial (Fin 3) (ZMod p)) * (X 0 + C (t 0)) ^ (a - 1)) := by
      rw [pderiv_mul, pderiv_monomial_of_eq_zero hN0, zero_mul, zero_add, pderiv_X_add_C_pow]
    refine logJacobianOrder_cleanPart_eq_zero_of p (surface_hr _ _)
      (fun β hβ => monomial_le_of_mem_support hβ) ?_
      (constantCoeff_natCast_mul_X_add_C_pow ha' 0 ht (a - 1))
    rw [← hd]
    exact Ideal.subset_span (Or.inr ⟨0, by simp, rfl⟩)

/-- If `p ∤ a`, `p ∣ b` and `a + b ≥ p`, then `p ∤ a + b - p`. -/
theorem natCast_sub_ne_zero {a b : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + b) (hb : p ∣ b) :
    ((a + b - p : ℕ) : ZMod p) ≠ 0 := by
  rw [Nat.cast_sub h, ZMod.natCast_self, sub_zero, Nat.cast_add,
    (ZMod.natCast_eq_zero_iff b p).mpr hb, add_zero]
  rwa [Ne, ZMod.natCast_eq_zero_iff]

theorem X_mul_pderiv_monomial_one (i : Fin 3) (N : Fin 3 →₀ ℕ) :
    X i * pderiv i (monomial N (1 : ZMod p)) =
      monomial N 1 * ((N i : ℕ) : MvPolynomial (Fin 3) (ZMod p)) := by
  rw [X_mul_pderiv_monomial, nsmul_eq_mul, mul_comm]

/-- **The origin of the `x`-chart of `V(x, y)`** (Example 3.13.21). Let `p ∤ a` and `a + b ≥ p`.
The origin of the `x`-chart of the blowup of `V(x, y)`, `y = x y'`, sends `x^a y^b z^c` to
`x^p x^(a+b-p) y'^b z^c`, the new divisor is `{x, y, z}`, and `ρ = 0` for the clean part of the
new polynomial. If `p ∤ b`, the generator from `y` is `b` times the polynomial. If `p ∣ b`, then
`a + b - p ≢ 0`, and the generator from `x` is `(a + b - p)` times the polynomial. -/
theorem logJacobianOrder_curve_x_origin {a b : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + b) (c : ℕ) :
    centerChart {0, 1} 0 (0 : Fin 3 → ZMod p) (curvePoly p a b c) =
      X 0 ^ p * curvePoly p (a + b - p) b c ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 1} 0 (0 : Fin 3 → ZMod p) = {0, 1, 2} ∧
    logJacobianOrder ({0, 1, 2} : Finset (Fin 3)) (cleanPart p (curvePoly p (a + b - p) b c)) =
      0 := by
  refine ⟨?_, ?_, ?_⟩
  · have hy : centerChart ({0, 1} : Finset (Fin 3)) 0 (0 : Fin 3 → ZMod p) (X 1) = X 0 * X 1 := by
      rw [centerChart_X_of_mem _ (by decide) (by decide)]
      simp
    have hz : centerChart ({0, 1} : Finset (Fin 3)) 0 (0 : Fin 3 → ZMod p) (X 2) = X 2 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 0 ^ a * X 0 ^ b : MvPolynomial (Fin 3) (ZMod p)) = X 0 ^ p * X 0 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hy, hz, centerChart_X_self]
    linear_combination (X 1 ^ b * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) * e
  · ext i
    fin_cases i <;> simp [centerDivisor]
  · set N : Fin 3 →₀ ℕ := single 0 (a + b - p) + single 1 b + single 2 c with hN
    rw [curvePoly_eq_monomial]
    have hN' : ∀ i, i ∉ ({0, 1, 2} : Finset (Fin 3)) → N i = 0 := by
      intro i hi
      fin_cases i <;> simp at hi
    have hdiv : ∀ β ∈ (monomial N (1 : ZMod p)).support, N ≤ β := by
      intro β hβ
      rw [support_monomial, ite_eq_right one_ne_zero, Finset.mem_singleton] at hβ
      exact hβ.ge
    by_cases hb : p ∣ b
    · refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv (w := ((N 0 : ℕ) : _)) ?_ ?_
      · rw [← X_mul_pderiv_monomial_one]
        exact Ideal.subset_span (Or.inl ⟨0, by simp, rfl⟩)
      · rw [map_natCast]
        simpa [hN] using natCast_sub_ne_zero ha h hb
    · refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv (w := ((N 1 : ℕ) : _)) ?_ ?_
      · rw [← X_mul_pderiv_monomial_one]
        exact Ideal.subset_span (Or.inl ⟨1, by simp, rfl⟩)
      · rw [map_natCast]
        simpa [hN, Ne, ZMod.natCast_eq_zero_iff] using hb

/-- **The origin of the `x`-chart of `V(x, z)`** (Example 3.13.21). This is
`logJacobianOrder_curve_x_origin` with `y` and `z` exchanged. -/
theorem logJacobianOrder_curve_xz_origin {a c : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + c) (b : ℕ) :
    centerChart {0, 2} 0 (0 : Fin 3 → ZMod p) (curvePoly p a b c) =
      X 0 ^ p * curvePoly p (a + c - p) b c ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 2} 0 (0 : Fin 3 → ZMod p) = {0, 1, 2} ∧
    logJacobianOrder ({0, 1, 2} : Finset (Fin 3)) (cleanPart p (curvePoly p (a + c - p) b c)) =
      0 := by
  refine ⟨?_, ?_, ?_⟩
  · have hz : centerChart ({0, 2} : Finset (Fin 3)) 0 (0 : Fin 3 → ZMod p) (X 2) = X 0 * X 2 := by
      rw [centerChart_X_of_mem _ (by decide) (by decide)]
      simp
    have hy : centerChart ({0, 2} : Finset (Fin 3)) 0 (0 : Fin 3 → ZMod p) (X 1) = X 1 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 0 ^ a * X 0 ^ c : MvPolynomial (Fin 3) (ZMod p)) = X 0 ^ p * X 0 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hy, hz, centerChart_X_self]
    linear_combination (X 1 ^ b * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) * e
  · ext i
    fin_cases i <;> simp [centerDivisor]
  · set N : Fin 3 →₀ ℕ := single 0 (a + c - p) + single 1 b + single 2 c with hN
    rw [curvePoly_eq_monomial]
    have hN' : ∀ i, i ∉ ({0, 1, 2} : Finset (Fin 3)) → N i = 0 := by
      intro i hi
      fin_cases i <;> simp at hi
    have hdiv : ∀ β ∈ (monomial N (1 : ZMod p)).support, N ≤ β := by
      intro β hβ
      rw [support_monomial, ite_eq_right one_ne_zero, Finset.mem_singleton] at hβ
      exact hβ.ge
    by_cases hc : p ∣ c
    · refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv (w := ((N 0 : ℕ) : _)) ?_ ?_
      · rw [← X_mul_pderiv_monomial_one]
        exact Ideal.subset_span (Or.inl ⟨0, by simp, rfl⟩)
      · rw [map_natCast]
        simpa [hN] using natCast_sub_ne_zero ha h hc
    · refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv (w := ((N 2 : ℕ) : _)) ?_ ?_
      · rw [← X_mul_pderiv_monomial_one]
        exact Ideal.subset_span (Or.inl ⟨2, by simp, rfl⟩)
      · rw [map_natCast]
        simpa [hN, Ne, ZMod.natCast_eq_zero_iff] using hc

/-- **The `x`-chart of `V(x, y)` with a translation** (Example 3.13.21). Let `p ∤ a`, `a + b ≥ p`
and `t_y ≠ 0`. The `x`-chart of the blowup of `V(x, y)` at `y' = t_y` sends `x^a y^b z^c` to
`x^p x^(a+b-p) z^c (y' + t_y)^b`, the new divisor is `{x, z}`, and `ρ = 0` for the clean part of
the new polynomial. If `p ∤ a + b`, the generator from `x` is `(a + b - p)` times the polynomial.
If `p ∣ a + b`, then `p ∤ b`, and `∂_y` of the polynomial is `x^(a+b-p) z^c` times
`b (y' + t_y)^(b-1)`. -/
theorem logJacobianOrder_curve_x_translate {a b : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + b) (c : ℕ)
    {t : Fin 3 → ZMod p} (ht : t 1 ≠ 0) :
    centerChart {0, 1} 0 t (curvePoly p a b c) =
      X 0 ^ p * (X 0 ^ (a + b - p) * X 2 ^ c * (X 1 + C (t 1)) ^ b) ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 1} 0 t = {0, 2} ∧
    logJacobianOrder ({0, 2} : Finset (Fin 3))
      (cleanPart p (X 0 ^ (a + b - p) * X 2 ^ c * (X 1 + C (t 1)) ^ b)) = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · have hy : centerChart ({0, 1} : Finset (Fin 3)) 0 t (X 1) = X 0 * (X 1 + C (t 1)) :=
      centerChart_X_of_mem _ (by decide) (by decide)
    have hz : centerChart ({0, 1} : Finset (Fin 3)) 0 t (X 2) = X 2 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 0 ^ a * X 0 ^ b : MvPolynomial (Fin 3) (ZMod p)) = X 0 ^ p * X 0 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hy, hz, centerChart_X_self]
    simp only [mul_pow]
    linear_combination ((X 1 + C (t 1)) ^ b * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) * e
  · ext i
    fin_cases i <;> simp [centerDivisor, ht]
  · set N : Fin 3 →₀ ℕ := single 0 (a + b - p) + single 2 c with hN
    have hNm : (X 0 ^ (a + b - p) * X 2 ^ c : MvPolynomial (Fin 3) (ZMod p)) = monomial N 1 :=
      X_pow_mul_X_pow_eq_monomial 0 2 _ _
    rw [hNm]
    have hN' : ∀ i, i ∉ ({0, 2} : Finset (Fin 3)) → N i = 0 := by
      intro i hi
      fin_cases i <;> simp_all
    have hdiv : ∀ β ∈ (monomial N 1 * (X 1 + C (t 1)) ^ b).support, N ≤ β :=
      fun β hβ => monomial_le_of_mem_support hβ
    by_cases hab : p ∣ a + b
    · have hb : ¬ p ∣ b := fun hb => ha ((Nat.dvd_add_left hb).mp hab)
      have hb' : ((b : ℕ) : ZMod p) ≠ 0 := by
        rwa [Ne, ZMod.natCast_eq_zero_iff]
      have hN1 : N 1 = 0 := by simp [hN]
      have hd : pderiv 1 (monomial N 1 * (X 1 + C (t 1)) ^ b) =
          monomial N 1 * ((b : MvPolynomial (Fin 3) (ZMod p)) * (X 1 + C (t 1)) ^ (b - 1)) := by
        rw [pderiv_mul, pderiv_monomial_of_eq_zero hN1, zero_mul, zero_add, pderiv_X_add_C_pow]
      refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv ?_
        (constantCoeff_natCast_mul_X_add_C_pow hb' 1 ht (b - 1))
      rw [← hd]
      exact Ideal.subset_span (Or.inr ⟨1, by simp, rfl⟩)
    · have he : ((a + b - p : ℕ) : ZMod p) ≠ 0 := by
        rw [Nat.cast_sub h, ZMod.natCast_self, sub_zero]
        rwa [Ne, ZMod.natCast_eq_zero_iff]
      have hd : X 0 * pderiv 0 (monomial N 1 * (X 1 + C (t 1)) ^ b) =
          monomial N 1 * (((a + b - p : ℕ) : MvPolynomial (Fin 3) (ZMod p)) *
            (X 1 + C (t 1)) ^ b) := by
        rw [pderiv_mul, pderiv_X_add_C_pow_of_ne (by decide), mul_zero, add_zero, ← mul_assoc,
          X_mul_pderiv_monomial_one]
        simp only [hN, Finsupp.add_apply, Finsupp.single_eq_same,
          Finsupp.single_eq_of_ne (show (0 : Fin 3) ≠ 2 by decide), add_zero]
        ring
      refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv
        (w := ((a + b - p : ℕ) : MvPolynomial (Fin 3) (ZMod p)) * (X 1 + C (t 1)) ^ b) ?_ ?_
      · rw [← hd]
        exact Ideal.subset_span (Or.inl ⟨0, by simp, rfl⟩)
      · rw [map_mul, map_pow, map_add, constantCoeff_X, constantCoeff_C, zero_add, map_natCast]
        exact mul_ne_zero he (pow_ne_zero _ ht)

/-- **The `x`-chart of `V(x, z)` with a translation** (Example 3.13.21). This is
`logJacobianOrder_curve_x_translate` with `y` and `z` exchanged. -/
theorem logJacobianOrder_curve_xz_translate {a c : ℕ} (ha : ¬ p ∣ a) (h : p ≤ a + c) (b : ℕ)
    {t : Fin 3 → ZMod p} (ht : t 2 ≠ 0) :
    centerChart {0, 2} 0 t (curvePoly p a b c) =
      X 0 ^ p * (X 0 ^ (a + c - p) * X 1 ^ b * (X 2 + C (t 2)) ^ c) ∧
    centerDivisor ({1, 2} : Finset (Fin 3)) {0, 2} 0 t = {0, 1} ∧
    logJacobianOrder ({0, 1} : Finset (Fin 3))
      (cleanPart p (X 0 ^ (a + c - p) * X 1 ^ b * (X 2 + C (t 2)) ^ c)) = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · have hz : centerChart ({0, 2} : Finset (Fin 3)) 0 t (X 2) = X 0 * (X 2 + C (t 2)) :=
      centerChart_X_of_mem _ (by decide) (by decide)
    have hy : centerChart ({0, 2} : Finset (Fin 3)) 0 t (X 1) = X 1 :=
      centerChart_X_of_notMem _ (by decide) (by decide)
    obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le h
    have e : (X 0 ^ a * X 0 ^ c : MvPolynomial (Fin 3) (ZMod p)) = X 0 ^ p * X 0 ^ m := by
      rw [← pow_add, ← pow_add, hm]
    rw [hm, Nat.add_sub_cancel_left]
    simp only [curvePoly, map_mul, map_pow, hy, hz, centerChart_X_self]
    simp only [mul_pow]
    linear_combination ((X 2 + C (t 2)) ^ c * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) * e
  · ext i
    fin_cases i <;> simp [centerDivisor, ht]
  · set N : Fin 3 →₀ ℕ := single 0 (a + c - p) + single 1 b with hN
    have hNm : (X 0 ^ (a + c - p) * X 1 ^ b : MvPolynomial (Fin 3) (ZMod p)) = monomial N 1 :=
      X_pow_mul_X_pow_eq_monomial 0 1 _ _
    rw [hNm]
    have hN' : ∀ i, i ∉ ({0, 1} : Finset (Fin 3)) → N i = 0 := by
      intro i hi
      fin_cases i <;> simp_all
    have hdiv : ∀ β ∈ (monomial N 1 * (X 2 + C (t 2)) ^ c).support, N ≤ β :=
      fun β hβ => monomial_le_of_mem_support hβ
    by_cases hac : p ∣ a + c
    · have hc : ¬ p ∣ c := fun hc => ha ((Nat.dvd_add_left hc).mp hac)
      have hc' : ((c : ℕ) : ZMod p) ≠ 0 := by
        rwa [Ne, ZMod.natCast_eq_zero_iff]
      have hN2 : N 2 = 0 := by simp [hN]
      have hd : pderiv 2 (monomial N 1 * (X 2 + C (t 2)) ^ c) =
          monomial N 1 * ((c : MvPolynomial (Fin 3) (ZMod p)) * (X 2 + C (t 2)) ^ (c - 1)) := by
        rw [pderiv_mul, pderiv_monomial_of_eq_zero hN2, zero_mul, zero_add, pderiv_X_add_C_pow]
      refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv ?_
        (constantCoeff_natCast_mul_X_add_C_pow hc' 2 ht (c - 1))
      rw [← hd]
      exact Ideal.subset_span (Or.inr ⟨2, by simp, rfl⟩)
    · have he : ((a + c - p : ℕ) : ZMod p) ≠ 0 := by
        rw [Nat.cast_sub h, ZMod.natCast_self, sub_zero]
        rwa [Ne, ZMod.natCast_eq_zero_iff]
      have hd : X 0 * pderiv 0 (monomial N 1 * (X 2 + C (t 2)) ^ c) =
          monomial N 1 * (((a + c - p : ℕ) : MvPolynomial (Fin 3) (ZMod p)) *
            (X 2 + C (t 2)) ^ c) := by
        rw [pderiv_mul, pderiv_X_add_C_pow_of_ne (by decide), mul_zero, add_zero, ← mul_assoc,
          X_mul_pderiv_monomial_one]
        simp only [hN, Finsupp.add_apply, Finsupp.single_eq_same,
          Finsupp.single_eq_of_ne (show (0 : Fin 3) ≠ 1 by decide), add_zero]
        ring
      refine logJacobianOrder_cleanPart_eq_zero_of p hN' hdiv
        (w := ((a + c - p : ℕ) : MvPolynomial (Fin 3) (ZMod p)) * (X 2 + C (t 2)) ^ c) ?_ ?_
      · rw [← hd]
        exact Ideal.subset_span (Or.inl ⟨0, by simp, rfl⟩)
      · rw [map_mul, map_pow, map_add, constantCoeff_X, constantCoeff_C, zero_add, map_natCast]
        exact mul_ne_zero he (pow_ne_zero _ ht)

