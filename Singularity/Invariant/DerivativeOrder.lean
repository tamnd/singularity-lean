import Singularity.Invariant.Order
import Singularity.Algebra.DerivationIdealPow
import Mathlib.RingTheory.MvPolynomial.EulerIdentity

/-!
# The derivative lowers the order by one

Let `k` be a field and let `f` be a polynomial in `k[x_i : i ∈ σ]` with order `r ≥ 1` at the origin. This file proves that each partial derivative of `f` has order at least `r - 1`, and that some partial derivative has order exactly `r - 1` if `r` is not `0` in `k`. This is the algebraic part of Volume 2, Lemma 2.1.4 and Proposition 2.4.1 of the handbook, at the origin of the affine space.

The derivative ideal of an ideal `I` is `D(I) = I + (∂f/∂x_i : f ∈ I, i ∈ σ)` (`Singularity.derivIdeal`). In characteristic `0` its order is `ord I - 1` (`idealOrd_derivIdeal`), and the order of `D^j(I)` is `ord I - j` (`idealOrd_derivIdeal_iterate`). Here the subtraction is the truncated subtraction of `ℕ∞`, so `0 - 1 = 0` and `⊤ - 1 = ⊤`. This is the formula `max(ord I - j, 0)` of the handbook.

The handbook works at a closed point of a smooth variety and uses all the derivations of the local ring. Here the point is the origin of the affine space and the derivations are the partial derivatives. Each derivation of `k[x_i]` over `k` is a combination of the partial derivatives, so the derivative ideal is the same.

The proof is the proof of the handbook. A derivation maps `m^r` into `m^(r-1)` (Volume 6, Lemma 1.2.4, `Singularity.derivation_mem_pow_pred`). Let `f_r` be the homogeneous part of degree `r` of `f`. By the identity of Euler, `∑ x_i ∂f_r/∂x_i = r f_r ≠ 0`. So some `∂f_r/∂x_i` is not `0`, and it is the homogeneous part of degree `r - 1` of `∂f/∂x_i`.

## Main results

* `Singularity.le_ord_pderiv`: if `r ≤ ord f`, then `r - 1 ≤ ord (∂f/∂x_i)`, over each commutative ring.
* `Singularity.derivIdeal_span`: the derivative ideal of `(S)` is generated by `S` and the partial derivatives of the elements of `S`.
* `Singularity.exists_ord_pderiv_eq`: if `ord f = r ≥ 1` and `r ≠ 0` in `k`, then some `∂f/∂x_i` has order `r - 1`.
* `Singularity.idealOrd_derivIdeal_of_ne_zero`: Proposition 2.4.1, `ord D(I) = r - 1` if `ord I = r ≥ 1` and `r ≠ 0` in `k`.
* `Singularity.idealOrd_derivIdeal`, `Singularity.idealOrd_derivIdeal_iterate`: Lemma 2.1.4 in characteristic `0`.
* `Singularity.le_idealOrd_iff_one_le_idealOrd_derivIdeal_iterate`: Corollary 2.1.5 (1) at the origin. The origin has order at least `m` for `I` if and only if it is in the zero set of `D^(m-1)(I)`.
* `Singularity.exists_mem_derivIdeal_iterate_ord_eq_one`: if `ord I = m ≥ 1` in characteristic `0`, then `D^(m-1)(I)` has an element of order `1`. This is the algebraic part of the existence of a hypersurface of maximal contact (Volume 2, Lemma 2.3.2).
-/

open MvPolynomial Finsupp

namespace Singularity

section CommRing

variable {σ R : Type*} [CommRing R]

/-- A partial derivative lowers the order by at most one (Volume 2, Lemma 2.1.4 of the handbook, the lower bound). If `r ≤ ord f`, then `r - 1 ≤ ord (∂f/∂x_i)`. -/
theorem le_ord_pderiv {f : MvPolynomial σ R} {r : ℕ} (hf : (r : ℕ∞) ≤ ord f) (i : σ) :
    ((r - 1 : ℕ) : ℕ∞) ≤ ord (pderiv i f) :=
  le_ord_iff_mem_pow.mpr
    (derivation_mem_pow_pred (pderiv i) (idealOfVars σ R) r f (le_ord_iff_mem_pow.mp hf))

/-- The derivative ideal `D(I)`: the ideal generated by `I` and the partial derivatives of the elements of `I` (Volume 2, Definition 2.1.3 of the handbook, on the affine space). -/
noncomputable def derivIdeal (I : Ideal (MvPolynomial σ R)) : Ideal (MvPolynomial σ R) :=
  I ⊔ Ideal.span {g | ∃ i, ∃ f ∈ I, g = pderiv i f}

theorem le_derivIdeal (I : Ideal (MvPolynomial σ R)) : I ≤ derivIdeal I := le_sup_left

theorem pderiv_mem_derivIdeal {I : Ideal (MvPolynomial σ R)} {f : MvPolynomial σ R} (hf : f ∈ I)
    (i : σ) : pderiv i f ∈ derivIdeal I :=
  le_sup_right (a := I) (Ideal.subset_span ⟨i, f, hf, rfl⟩)

/-- The derivative ideal of `I` lies in `m^(n-1)` if `I` lies in `m^n`. -/
theorem derivIdeal_le_pow {I : Ideal (MvPolynomial σ R)} {n : ℕ} (h : I ≤ idealOfVars σ R ^ n) :
    derivIdeal I ≤ idealOfVars σ R ^ (n - 1) := by
  refine sup_le (h.trans (Ideal.pow_le_pow_right (Nat.sub_le n 1))) ?_
  rw [Ideal.span_le]
  rintro _ ⟨i, f, hf, rfl⟩
  exact derivation_mem_pow_pred (pderiv i) (idealOfVars σ R) n f (h hf)

/-- The lower bound for the order of the derivative ideal: if `n ≤ ord I`, then `n - 1 ≤ ord D(I)`. -/
theorem le_idealOrd_derivIdeal {I : Ideal (MvPolynomial σ R)} {n : ℕ} (h : (n : ℕ∞) ≤ idealOrd I) :
    ((n - 1 : ℕ) : ℕ∞) ≤ idealOrd (derivIdeal I) :=
  le_idealOrd_iff.mpr (derivIdeal_le_pow (le_idealOrd_iff.mp h))

/-- The derivative ideal is monotone. -/
theorem derivIdeal_mono {I J : Ideal (MvPolynomial σ R)} (h : I ≤ J) : derivIdeal I ≤ derivIdeal J := by
  refine sup_le_sup h (Ideal.span_mono ?_)
  rintro _ ⟨i, f, hf, rfl⟩
  exact ⟨i, f, h hf, rfl⟩

/-- The derivative ideal of the ideal generated by `S` is generated by `S` and the partial derivatives of the elements of `S` (Volume 2, the remark after Definition 2.1.3 of the handbook). -/
theorem derivIdeal_span (S : Set (MvPolynomial σ R)) :
    derivIdeal (Ideal.span S) = Ideal.span (S ∪ {g | ∃ i, ∃ f ∈ S, g = pderiv i f}) := by
  apply le_antisymm
  · refine sup_le (Ideal.span_mono Set.subset_union_left) ?_
    rw [Ideal.span_le]
    rintro _ ⟨i, f, hf, rfl⟩
    induction hf using Submodule.span_induction with
    | mem x hx => exact Ideal.subset_span (Or.inr ⟨i, x, hx, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | smul a x hx' hx =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact add_mem (Ideal.mul_mem_left _ _ hx)
        (Ideal.mul_mem_right _ _ (Ideal.span_mono Set.subset_union_left hx'))
  · rw [Ideal.span_le]
    rintro _ (hf | ⟨i, f, hf, rfl⟩)
    · exact le_derivIdeal _ (Ideal.subset_span hf)
    · exact pderiv_mem_derivIdeal (Ideal.subset_span hf) i

end CommRing

section Field

variable {σ k : Type*} [Field k] [Fintype σ]

/-- **The derivative lowers the order by one** (Volume 2, Lemma 2.1.4 and Proposition 2.4.1 of the handbook, for one polynomial at the origin). Let `f` have order `r ≥ 1` at the origin, and assume that `r ≠ 0` in `k`. Then some partial derivative of `f` has order `r - 1`. -/
theorem exists_ord_pderiv_eq {f : MvPolynomial σ k} {r : ℕ} (hf : ord f = r) (hr : 1 ≤ r)
    (hrk : (r : k) ≠ 0) : ∃ i, ord (pderiv i f) = ((r - 1 : ℕ) : ℕ∞) := by
  have hf0 : f ≠ 0 := by
    intro h
    rw [h, ord_zero] at hf
    exact ENat.top_ne_natCast r hf
  obtain ⟨d, hd, hdeg⟩ := exists_coeff_ne_zero_and_ord_eq hf0
  have hdr : degree d = r := by
    rw [hf] at hdeg
    exact_mod_cast hdeg.symm
  set fr := homogeneousComponent r f with hfr_def
  have hfr : fr ≠ 0 := by
    intro h
    have : fr.coeff d = (0 : MvPolynomial σ k).coeff d := by rw [h]
    rw [hfr_def, coeff_homogeneousComponent, if_pos hdr, MvPolynomial.coeff_zero] at this
    exact hd this
  have heuler := (homogeneousComponent_isHomogeneous r f).sum_X_mul_pderiv
  have hsum : ∑ i : σ, X i * pderiv i fr ≠ 0 := by
    rw [heuler, ← Nat.cast_smul_eq_nsmul k]
    exact smul_ne_zero hrk hfr
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  have hi' : pderiv i fr ≠ 0 := right_ne_zero_of_mul hi
  obtain ⟨e, he⟩ := ne_zero_iff.mp hi'
  rw [coeff_pderiv] at he
  have hc : fr.coeff (e + single i 1) ≠ 0 := left_ne_zero_of_mul he
  have hdeg_e : degree (e + single i 1) = r := by
    by_contra hne
    rw [hfr_def, coeff_homogeneousComponent, if_neg hne] at hc
    exact hc rfl
  have hcf : f.coeff (e + single i 1) = fr.coeff (e + single i 1) := by
    rw [hfr_def, coeff_homogeneousComponent, if_pos hdeg_e]
  have hcoeff : (pderiv i f).coeff e ≠ 0 := by
    rw [coeff_pderiv, hcf]
    exact he
  have hdege : degree e = r - 1 := by
    rw [map_add, degree_single] at hdeg_e
    omega
  refine ⟨i, le_antisymm ?_ (le_ord_pderiv hf.ge i)⟩
  rw [← hdege]
  exact ord_le hcoeff

/-- **Proposition 2.4.1 of Volume 2 of the handbook**, at the origin. Let `I` have order `r ≥ 1` at the origin, and assume that `r ≠ 0` in `k`, for example `r < p` in characteristic `p`. Then `D(I)` has order `r - 1`. -/
theorem idealOrd_derivIdeal_of_ne_zero {I : Ideal (MvPolynomial σ k)} {r : ℕ} (hI : idealOrd I = r)
    (hr : 1 ≤ r) (hrk : (r : k) ≠ 0) : idealOrd (derivIdeal I) = ((r - 1 : ℕ) : ℕ∞) := by
  refine le_antisymm ?_ (le_idealOrd_derivIdeal hI.ge)
  obtain ⟨f, hfI, hf⟩ := exists_mem_ord_eq_idealOrd I
  rw [hI] at hf
  obtain ⟨i, hi⟩ := exists_ord_pderiv_eq hf hr hrk
  rw [← hi]
  exact idealOrd_le_ord (pderiv_mem_derivIdeal hfI i)

/-- The order of `D(I)` is `ord I - 1` if `ord I` is `0` or `⊤`, in each characteristic. -/
theorem idealOrd_derivIdeal_of_eq_zero_or_top {I : Ideal (MvPolynomial σ k)}
    (h : idealOrd I = 0 ∨ idealOrd I = ⊤) : idealOrd (derivIdeal I) = idealOrd I - 1 := by
  rcases h with h | h
  · rw [h, zero_tsub]
    exact le_antisymm ((idealOrd_anti (le_derivIdeal I)).trans_eq h) bot_le
  · rw [h, ENat.top_sub_one]
    refine top_le_iff.mp (ENat.forall_natCast_le_iff_le.mp fun n _ => ?_)
    have := le_idealOrd_derivIdeal (I := I) (n := n + 1) (by rw [h]; exact le_top)
    simpa using this

variable [CharZero k]

/-- **The derivative lowers the order by one** (Volume 2, Lemma 2.1.4 of the handbook, at the origin). In characteristic `0`, `ord D(I) = ord I - 1`, with the truncated subtraction of `ℕ∞`. -/
theorem idealOrd_derivIdeal (I : Ideal (MvPolynomial σ k)) :
    idealOrd (derivIdeal I) = idealOrd I - 1 := by
  rcases eq_or_ne (idealOrd I) ⊤ with htop | htop
  · exact idealOrd_derivIdeal_of_eq_zero_or_top (Or.inr htop)
  obtain ⟨r, hr⟩ := ENat.ne_top_iff_exists.mp htop
  rcases Nat.eq_zero_or_pos r with h0 | hpos
  · subst h0
    exact idealOrd_derivIdeal_of_eq_zero_or_top (Or.inl (by rw [← hr, Nat.cast_zero]))
  · rw [idealOrd_derivIdeal_of_ne_zero hr.symm hpos (Nat.cast_ne_zero.mpr hpos.ne'), ← hr]
    rw [ENat.natCast_sub, Nat.cast_one]

/-- **The derivative lowers the order by one** (Volume 2, Lemma 2.1.4 of the handbook, the formula for `D^j`, at the origin). In characteristic `0`, `ord D^j(I) = ord I - j`, with the truncated subtraction of `ℕ∞`. -/
theorem idealOrd_derivIdeal_iterate (I : Ideal (MvPolynomial σ k)) (j : ℕ) :
    idealOrd (derivIdeal^[j] I) = idealOrd I - j := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply', idealOrd_derivIdeal, ih, tsub_tsub, Nat.cast_succ]

/-- **Volume 2, Corollary 2.1.5 (1) of the handbook**, at the origin. Let `m ≥ 1`. In characteristic `0`, the origin has order at least `m` for `I` if and only if `D^(m-1)(I)` lies in the ideal of the origin, that is, the origin is in the zero set of `D^(m-1)(I)`. -/
theorem le_idealOrd_iff_one_le_idealOrd_derivIdeal_iterate (I : Ideal (MvPolynomial σ k)) {m : ℕ}
    (hm : 1 ≤ m) : (m : ℕ∞) ≤ idealOrd I ↔ 1 ≤ idealOrd (derivIdeal^[m - 1] I) := by
  rw [idealOrd_derivIdeal_iterate]
  rcases eq_or_ne (idealOrd I) ⊤ with htop | htop
  · rw [htop, ENat.top_sub_coe]
    exact ⟨fun _ => le_top, fun _ => le_top⟩
  obtain ⟨r, hr⟩ := ENat.ne_top_iff_exists.mp htop
  rw [← hr, ← ENat.natCast_sub]
  norm_cast
  omega

/-- **An element of order one in `D^(m-1)(I)`** (the algebraic part of Volume 2, Lemma 2.3.2 of the handbook, at the origin). In characteristic `0`, let `I` have order `m ≥ 1`. Then `D^(m-1)(I)` contains an element of order `1`. Its zero set is a smooth hypersurface near the origin. -/
theorem exists_mem_derivIdeal_iterate_ord_eq_one {I : Ideal (MvPolynomial σ k)} {m : ℕ}
    (hI : idealOrd I = m) (hm : 1 ≤ m) : ∃ g ∈ derivIdeal^[m - 1] I, ord g = 1 := by
  obtain ⟨g, hg, hgo⟩ := exists_mem_ord_eq_idealOrd (derivIdeal^[m - 1] I)
  refine ⟨g, hg, ?_⟩
  have h1 : m - (m - 1) = 1 := by omega
  rw [hgo, idealOrd_derivIdeal_iterate, hI, ← ENat.natCast_sub, h1, Nat.cast_one]

end Field

end Singularity
