import Singularity.Valuation.WeakLogMonomialization
import Singularity.Algebra.AdjoinRootRegular
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The end cases of the monomial step

Let `k` be a field, let `E'/E` be an extension of degree `p` of extensions of `k`, where `p` is a prime and `E'` has characteristic `p`. Let `W` be a valuation subring of `E'` and let `V = W ∩ E`. Let `A ⊆ V` be an affine model of `E/k` such that the local ring `R = T_A` at the centre of `V` is regular. Let `z ∈ E'` with `z ∉ E` and `z ^ p = y ∈ R`. This file proves Proposition E of Volume 5, Chapter 4 of the handbook. If the class of `y` in the residue field of `R` is not a `p`-th power, or if `y ∈ 𝔪 \ 𝔪 ^ 2`, then `W` has a regular centre on an affine model of `E'/k` that contains `z` and the image of `A`. Then the file gives two end cases of the monomial step `MonomialInseparableStep` for a form `f = h ^ p + g ^ p * (u * ∏ x ^ a x)` of `IsMonomialModPow`. The first case is the residual type, where all exponents are zero and the class of the unit `u` is not a `p`-th power in the residue field. The second case is the ramified type, where some exponent is not divisible by `p`, in the special form where the monomial is one regular parameter.

## Main definitions

* `Singularity.rootHom`: the map `R[X] / (X ^ p - y) → E'` with `X ↦ z`, for `z ^ p = y ∈ R`.

## Main results

* `Singularity.rootHom_injective`: the map `R[X] / (X ^ p - y) → E'` with `X ↦ z` is injective when `X ^ p - y` is irreducible over `E`.
* `Singularity.hasRegularCenter_insert_of_rootHom`: the general form of Proposition E, for a subring `R` with `A ⊆ R ⊆ T_A`.
* `Singularity.hasRegularCenter_insert_of_forall_pow_ne`: Proposition E, case (i), the class of `y` is not a `p`-th power.
* `Singularity.hasRegularCenter_insert_of_mem_maximalIdeal`: Proposition E, case (ii), `y ∈ 𝔪 \ 𝔪 ^ 2`.
* `Singularity.exists_pow_eq_of_eq_add`: if `θ ^ p = h ^ p + g ^ p * y` with `g ≠ 0`, then `z = (θ - h) / g` satisfies `z ^ p = y` and `z ∉ E`.
* `Singularity.hasRegularCenter_of_eq_add_unit`: the monomial step for a form of the residual type.
* `Singularity.hasRegularCenter_of_eq_add_parameter`: the monomial step for a form of the ramified type where the monomial is one regular parameter.

## The proof

Let `Q = X ^ p - y ∈ R[X]` and let `φ : R[X] / (Q) → E'` be the map with `X ↦ z`. The polynomial `X ^ p - y` is irreducible over `E`, because `y` is not a `p`-th power in `E`. So it is the minimal polynomial of `z` over `E`. Each class in `R[X] / (Q)` has a representative of degree less than `p`, so `φ` is injective. By Corollary C or Theorem B of `Singularity/Algebra/AdjoinRootRegular.lean`, `R[X] / (Q)` is a regular local ring. Its maximal ideal is generated by `𝔪` (case (i)) or by `𝔪` and `z` (case (ii)). The image `N` of `φ` lies in `W`, and each generator of the maximal ideal maps to a non-unit of `W`. So an element of `N` that is a unit of `W` is a unit of `N`.

Let `B = k[z, g]`, where `g` generates `A`. Then `B ⊆ N ⊆ W`, and the fraction field of `B` is `E(z) = E'`. The local ring `T_B` of `B` at the centre of `W` contains `R` and `z`, so it contains `N`. Conversely an element of `T_B` is `a / c` with `a, c ∈ B ⊆ N` and `c` a unit of `W`. Then `c` is a unit of `N`, so `a / c ∈ N`. Thus `T_B = N`, and `T_B` is a regular local ring.

For the monomial step, let `f = h ^ p + g ^ p * y` with `g ≠ 0` and `θ ^ p = f`. Put `z = (θ - h) / g`. In characteristic `p` the equation `z ^ p = y` holds, and `z ∉ E` because `θ ∉ E`.

## What is not proved

This file does not join its theorems to `MonomialInseparableStep`. This file does not prove the normal form that reduces a general form of the ramified type to one regular parameter. This file does not prove the toric case of the monomial step, where two or more exponents of the monomial are not divisible by `p`. So `MonomialInseparableStep` is still a hypothesis. This file does not prove weak log monomialization (`WeakLogMonomialization`). This file does not prove local uniformization in dimension 4.

## References

* Volume 5, Chapter 4 of the handbook.
-/

open IsLocalRing Polynomial Module IntermediateField

namespace Singularity

section RootHom

variable {E E' : Type*} [Field E] [Field E'] [Algebra E E']

/-- The ring homomorphism `R[X] / (X ^ p - y) → E'` that is the inclusion on the subring `R` of `E` and sends the class of `X` to `z`, where `z ^ p = y`. -/
noncomputable def rootHom (R : Subring E) {p : ℕ} {y : R} {z : E'}
    (hy : algebraMap E E' (y : E) = z ^ p) : AdjoinRoot (X ^ p - C y : R[X]) →+* E' :=
  AdjoinRoot.lift ((algebraMap E E').comp R.subtype) z (by simp [hy])

variable (R : Subring E) {p : ℕ} {y : R} {z : E'} (hy : algebraMap E E' (y : E) = z ^ p)

/-- The map `rootHom` sends the class of `X` to `z`. -/
theorem rootHom_root : rootHom R hy (AdjoinRoot.root _) = z :=
  AdjoinRoot.lift_root _

/-- The map `rootHom` is the inclusion on `R`. -/
theorem rootHom_of (r : R) : rootHom R hy (AdjoinRoot.of _ r) = algebraMap E E' r :=
  AdjoinRoot.lift_of _

/-- The map `rootHom` sends the class of a polynomial `q` to the value of `q` at `z`. -/
theorem rootHom_mk (q : R[X]) :
    rootHom R hy (AdjoinRoot.mk _ q) = aeval z (q.map R.subtype) := by
  rw [rootHom, AdjoinRoot.lift_mk, aeval_def, eval₂_map]

variable {R hy} in
/-- If a subring `S` of `E'` contains the image of `R` and `z`, then `S` contains the image of `rootHom`. -/
theorem range_rootHom_le {S : Subring E'} (hR : ∀ r : R, algebraMap E E' r ∈ S) (hz : z ∈ S) :
    (rootHom R hy).range ≤ S := by
  rintro _ ⟨b, rfl⟩
  obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective b
  rw [rootHom, AdjoinRoot.lift_mk]
  induction q using Polynomial.induction_on' with
  | add q₁ q₂ h₁ h₂ => rw [eval₂_add]; exact S.add_mem h₁ h₂
  | monomial n a => rw [eval₂_monomial]; exact S.mul_mem (hR a) (S.pow_mem hz n)

/-- **The map `R[X] / (X ^ p - y) → E'` is injective.** Let `R` be a subring of `E`, let `z ∈ E'` with `z ^ p = y ∈ R`, and assume that `X ^ p - y` is irreducible over `E`. Then this polynomial is the minimal polynomial of `z` over `E`. Each class has a representative `q` of degree less than `p`. If `q(z) = 0`, then `q = 0` by the degree. -/
theorem rootHom_injective (hp : p ≠ 0) (hirr : Irreducible (X ^ p - C (y : E))) :
    Function.Injective (rootHom R hy) := by
  rw [injective_iff_map_eq_zero]
  intro b hb
  obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective b
  have hQ : (X ^ p - C y : R[X]).Monic := monic_X_pow_sub_C y hp
  have hmk : AdjoinRoot.mk (X ^ p - C y : R[X]) q =
      AdjoinRoot.mk (X ^ p - C y : R[X]) (q %ₘ (X ^ p - C y)) := by
    conv_lhs => rw [← modByMonic_add_div q (X ^ p - C y)]
    rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
  rw [hmk] at hb ⊢
  rw [rootHom_mk] at hb
  have hmin : minpoly E z = X ^ p - C (y : E) := by
    refine (minpoly.eq_of_irreducible_of_monic hirr ?_ (monic_X_pow_sub_C _ hp)).symm
    rw [map_sub, map_pow, aeval_X, aeval_C, hy, sub_self]
  have h0 : (q %ₘ (X ^ p - C y)).map R.subtype = 0 := by
    by_contra hne
    have h1 := minpoly.degree_le_of_ne_zero E z hne hb
    rw [hmin, degree_X_pow_sub_C (Nat.pos_of_ne_zero hp)] at h1
    have h2 : ((q %ₘ (X ^ p - C y)).map R.subtype).degree < p :=
      calc _ ≤ (q %ₘ (X ^ p - C y)).degree := degree_map_le
        _ < (X ^ p - C y : R[X]).degree := degree_modByMonic_lt q hQ
        _ = p := degree_X_pow_sub_C (Nat.pos_of_ne_zero hp) y
    exact absurd h1 (not_le.2 h2)
  rw [Polynomial.map_eq_zero_iff R.subtype_injective] at h0
  rw [h0, map_zero]

end RootHom

section Degree

variable {E E' : Type*} [Field E] [Field E'] [Algebra E E']

/-- In an extension `E'/E` of prime degree, each element `z ∉ E` generates `E'` over `E`. The intermediate fields are only `E` and `E'`, and `E(z) ≠ E`. -/
theorem adjoin_simple_eq_top_of_finrank_eq_prime {p : ℕ} (hp : p.Prime) (hfin : finrank E E' = p)
    {z : E'} (hz : z ∉ Set.range (algebraMap E E')) : E⟮z⟯ = ⊤ := by
  have := isSimpleOrder_of_finrank_prime E E' (hfin ▸ hp)
  refine (eq_bot_or_eq_top E⟮z⟯).resolve_left fun h => hz ?_
  rw [adjoin_simple_eq_bot_iff, mem_bot] at h
  exact h

end Degree

section Valuation

variable {K L : Type*} [Field K] [Field L]

/-- If a subring `R` of `K` lies in `V`, then `T_R` lies in `V`. If `z c = a` with `a ∈ R` and `v(c) = 1`, then `v(z) = v(a) ≤ 1`. -/
theorem mem_of_mem_centerSubring' {V : ValuationSubring K} {R : Subring K}
    (hR : ∀ a ∈ R, a ∈ V) {z : K} (hz : z ∈ centerSubring V R) : z ∈ V := by
  obtain ⟨a, ha, c, hc, hc1, hzc⟩ := mem_centerSubring.mp hz
  rw [← V.valuation_le_one_iff]
  calc V.valuation z = V.valuation z * V.valuation c := by rw [hc1, mul_one]
    _ = V.valuation a := by rw [← map_mul, hzc]
    _ ≤ 1 := (V.valuation_le_one_iff a).2 (hR a ha)

/-- If `T_R` is a local ring, then an element of its maximal ideal does not have value `1`. An element of `T_R` with value `1` has its inverse in `T_R`, so it is a unit. -/
theorem valuation_ne_one_of_mem_maximalIdeal {V : ValuationSubring K} {R : Subring K}
    [IsLocalRing (centerSubring V R)] {r : centerSubring V R}
    (hr : r ∈ maximalIdeal (centerSubring V R)) : V.valuation (r : K) ≠ 1 := by
  intro h1
  have hr0 : (r : K) ≠ 0 := ((valuation_eq_one_iff_mem V _).1 h1).1
  exact (mem_maximalIdeal r).1 hr (isUnit_iff_exists_inv.2
    ⟨⟨(r : K)⁻¹, inv_mem_centerSubring r.2 h1⟩, Subtype.ext (mul_inv_cancel₀ hr0)⟩)

/-- Let `f : K → L` be a homomorphism of fields, let `W` be a valuation subring of `L`, and let `R` be a subring of `K` whose image lies in a subring `B` of `L`. Then `f` maps `T_R` for `W ∩ K` into `T_B` for `W`. -/
theorem map_mem_centerSubring {W : ValuationSubring L} {f : K →+* L} {R : Subring K}
    {B : Subring L} (hRB : ∀ a ∈ R, f a ∈ B) {x : K} (hx : x ∈ centerSubring (W.comap f) R) :
    f x ∈ centerSubring W B := by
  obtain ⟨a, ha, c, hc, hc1, hxc⟩ := mem_centerSubring.mp hx
  exact ⟨f a, hRB a ha, f c, hRB c hc, (valuation_comap_eq_one_iff W f c).1 hc1,
    by rw [← map_mul, hxc]⟩

/-- Let `B ⊆ N` be subrings of `K`. If each element of `N` with value `1` has its inverse in `N`, then `T_B ⊆ N`. An element of `T_B` is `a / c` with `a, c ∈ B` and `v(c) = 1`. -/
theorem centerSubring_le_of_inv_mem {W : ValuationSubring K} {B N : Subring K} (hBN : B ≤ N)
    (hN : ∀ x ∈ N, W.valuation x = 1 → x⁻¹ ∈ N) : centerSubring W B ≤ N := by
  intro x hx
  obtain ⟨a, ha, c, hc, hc1, hxc⟩ := mem_centerSubring.mp hx
  have hc0 : c ≠ 0 := ((valuation_eq_one_iff_mem W c).1 hc1).1
  have hxa : x = a * c⁻¹ := by rw [← hxc, mul_assoc, mul_inv_cancel₀ hc0, mul_one]
  rw [hxa]
  exact N.mul_mem (hBN ha) (hN c (hBN hc) hc1)

/-- Let `ψ : S → K` be a ring homomorphism with image in `W`. The elements `b ∈ S` such that `ψ b` does not have value `1` form an ideal of `S`. It is the inverse image of the maximal ideal of `W`. -/
theorem exists_ideal_iff_valuation_ne_one {S : Type*} [CommRing S] (W : ValuationSubring K)
    (ψ : S →+* K) (hψ : ∀ b, ψ b ∈ W) :
    ∃ J : Ideal S, ∀ b, b ∈ J ↔ W.valuation (ψ b) ≠ 1 := by
  refine ⟨(maximalIdeal W).comap (ψ.codRestrict W hψ), fun b => ?_⟩
  rw [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff, W.valuation_eq_one_iff]
  rfl

end Valuation

section EndCases

variable {k E E' : Type*} [Field k] [Field E] [Field E'] [Algebra k E] [Algebra k E']
  [Algebra E E'] [IsScalarTower k E E']

omit [Algebra k E'] [IsScalarTower k E E'] in
/-- Let `A ⊆ V = W ∩ E` and let `R` be a subring of `E` with `R ⊆ T_A`. If `z ^ p = y ∈ R` with `p ≠ 0`, then the image of `rootHom R hy` lies in `W`. The ring `T_A` lies in `V`, and `z ∈ W` because `z ^ p ∈ W`. -/
theorem rootHom_mem {W : ValuationSubring E'} {A : Subalgebra k E}
    (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) {R : Subring E}
    (hRT : R ≤ centerSubring (W.comap (algebraMap E E')) A.toSubring) {p : ℕ} (hp : p ≠ 0)
    {y : R} {z : E'} (hy : algebraMap E E' (y : E) = z ^ p) (b : AdjoinRoot (X ^ p - C y : R[X])) :
    rootHom R hy b ∈ W := by
  have hRW : ∀ r : R, algebraMap E E' r ∈ W := fun r =>
    ValuationSubring.mem_comap.1 (mem_of_mem_centerSubring' (fun a ha => hAV a ha) (hRT r.2))
  have hzW : z ∈ W := (valuationSubring_pow_mem_iff W hp).1 (hy ▸ hRW y)
  exact range_rootHom_le (S := W.toSubring) hRW hzW ⟨b, rfl⟩

/-- **Proposition E, the general form.** Let `A ⊆ V = W ∩ E` be an affine model of `E/k`, and let `R` be a subring of `E` with `A ⊆ R ⊆ T_A`. Let `z ∈ E'` with `E(z) = E'` and `z ^ p = y ∈ R`, where `p ≠ 0` and `X ^ p - y` is irreducible over `E`. Assume that `R[X] / (X ^ p - y)` is a regular local ring and that each element of its maximal ideal maps to an element of `E'` whose value is not `1`. Then `W` has a regular centre on an affine model of `E'/k` that contains `z` and the image of `A`.

The model is `B = k[z, g]`, where `g` generates `A`. The local ring `T_B` at the centre of `W` is the image of `R[X] / (X ^ p - y)` in `E'`. -/
theorem hasRegularCenter_insert_of_rootHom {W : ValuationSubring E'} {A : Subalgebra k E}
    (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) (hA : IsAffineModel A) {R : Subring E}
    (hAR : A.toSubring ≤ R) (hRT : R ≤ centerSubring (W.comap (algebraMap E E')) A.toSubring)
    {p : ℕ} (hp : p ≠ 0) {y : R} {z : E'} (hy : algebraMap E E' (y : E) = z ^ p)
    (hirr : Irreducible (X ^ p - C (y : E))) (hgen : E⟮z⟯ = ⊤)
    [IsRegularLocalRing (AdjoinRoot (X ^ p - C y : R[X]))]
    (hmax : ∀ b ∈ maximalIdeal (AdjoinRoot (X ^ p - C y : R[X])),
      W.valuation (rootHom R hy b) ≠ 1) :
    HasRegularCenter k W (insert z (algebraMap E E' '' (A : Set E))) := by
  classical
  obtain ⟨⟨s, hs⟩, hfrac⟩ := hA
  set φ := rootHom R hy
  set S : Finset E' := insert z (s.image (algebraMap E E'))
  set B : Subalgebra k E' := Algebra.adjoin k (S : Set E')
  have hφW : ∀ b, φ b ∈ W := rootHom_mem hAV hRT hp hy
  -- The image of `A` lies in `B`.
  have hAB : ∀ a ∈ A, algebraMap E E' a ∈ B := by
    have hle : A ≤ B.comap (IsScalarTower.toAlgHom k E E') := by
      rw [← hs]
      refine Algebra.adjoin_le fun a ha => ?_
      exact Algebra.subset_adjoin
        (Finset.mem_coe.2 (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ ha)))
    exact fun a ha => hle ha
  have hzB : z ∈ B := Algebra.subset_adjoin (Finset.mem_coe.2 (Finset.mem_insert_self _ _))
  -- The image `N` of `φ` as a `k`-subalgebra of `E'`.
  let N : Subalgebra k E' :=
    { φ.range with
      algebraMap_mem' := fun c => ⟨AdjoinRoot.of _ ⟨algebraMap k E c, hAR (A.algebraMap_mem c)⟩,
        by rw [rootHom_of]; exact (IsScalarTower.algebraMap_apply k E E' c).symm⟩ }
  have hBN : B ≤ N := by
    refine Algebra.adjoin_le fun w hw => ?_
    rw [Finset.coe_insert, Set.mem_insert_iff] at hw
    rcases hw with hw | hw
    · rw [hw]
      exact ⟨AdjoinRoot.root _, rootHom_root R hy⟩
    · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hw)
      have haA : a ∈ A := hs ▸ Algebra.subset_adjoin ha
      exact ⟨AdjoinRoot.of _ ⟨a, hAR haA⟩, rootHom_of R hy _⟩
  -- The local ring `T_B` is the image of `φ`.
  have hTN : centerSubring W B.toSubring = φ.range := by
    apply le_antisymm
    · refine centerSubring_le_of_inv_mem (fun w hw => hBN hw) ?_
      rintro _ ⟨b, rfl⟩ hb1
      have hb : IsUnit b := by
        by_contra hb
        exact hmax b ((mem_maximalIdeal b).2 hb) hb1
      obtain ⟨c, hc⟩ := isUnit_iff_exists_inv.1 hb
      exact ⟨c, (inv_eq_of_mul_eq_one_right (by rw [← map_mul, hc, map_one])).symm⟩
    · exact range_rootHom_le (fun r => map_mem_centerSubring (fun a ha => hAB a ha) (hRT r.2))
        (le_centerSubring _ hzB)
  -- The fraction field of `B` is `E'`.
  have hFtop : ∀ w : E', w ∈ IntermediateField.adjoin k (S : Set E') := by
    set F := IntermediateField.adjoin k (S : Set E')
    have hEF : ∀ e : E, algebraMap E E' e ∈ F := by
      intro e
      obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := A) e
      rw [map_div₀]
      exact F.div_mem (IntermediateField.algebra_adjoin_le_adjoin k _ (hAB a a.2))
        (IntermediateField.algebra_adjoin_le_adjoin k _ (hAB b b.2))
    let F' : IntermediateField E E' := F.toSubfield.toIntermediateField hEF
    have hzF' : z ∈ F' :=
      IntermediateField.subset_adjoin k _ (Finset.mem_coe.2 (Finset.mem_insert_self _ _))
    intro w
    exact (adjoin_simple_le_iff.2 hzF') (hgen ▸ IntermediateField.mem_top)
  have hfracB : IsFractionRing B E' := by
    refine IsFractionRing.of_field B E' fun w => ?_
    obtain ⟨r, hr, q, hq, rfl⟩ := IntermediateField.mem_adjoin_iff_div.1 (hFtop w)
    exact ⟨⟨r, hr⟩, ⟨q, hq⟩, rfl⟩
  -- The local ring `T_B` is regular.
  have hinj := rootHom_injective R hy hp hirr
  let e : AdjoinRoot (X ^ p - C y : R[X]) ≃+* φ.range :=
    RingEquiv.ofBijective φ.rangeRestrict
      ⟨fun a b h => hinj (congrArg Subtype.val h), φ.rangeRestrict_surjective⟩
  have := IsRegularLocalRing.of_ringEquiv e
  have hreg : IsRegularLocalRing (centerSubring W B.toSubring) :=
    IsRegularLocalRing.of_ringEquiv (RingEquiv.subringCongr hTN.symm)
  refine (hasRegularCenter_iff_centerSubring W _).2
    ⟨B, fun b hb => ?_, ⟨⟨S, rfl⟩, hfracB⟩, ?_, hreg⟩
  · obtain ⟨c, hc⟩ := hBN hb
    rw [← hc]
    exact hφW c
  · rintro w (hw | ⟨a, ha, rfl⟩)
    · rw [hw]
      exact hzB
    · exact hAB a ha

omit [Algebra k E'] [IsScalarTower k E E'] in
/-- Let `R = T_A` be a local ring and let `J` be the ideal of the elements of `R[X] / (X ^ p - y)` whose image in `E'` does not have value `1`. Then `𝔪 R[X] / (X ^ p - y) ⊆ J`, because an element of `𝔪` does not have value `1` for `V`. -/
theorem map_maximalIdeal_le_of_rootHom {W : ValuationSubring E'} {A : Subalgebra k E} {p : ℕ}
    [IsLocalRing (centerSubring (W.comap (algebraMap E E')) A.toSubring)]
    {y : centerSubring (W.comap (algebraMap E E')) A.toSubring} {z : E'}
    (hy : algebraMap E E' (y : E) = z ^ p)
    {J : Ideal (AdjoinRoot (X ^ p - C y :
      (centerSubring (W.comap (algebraMap E E')) A.toSubring)[X]))}
    (hJ : ∀ b, b ∈ J ↔ W.valuation (rootHom _ hy b) ≠ 1) :
    (maximalIdeal (centerSubring (W.comap (algebraMap E E')) A.toSubring)).map
      (algebraMap _ (AdjoinRoot (X ^ p - C y :
        (centerSubring (W.comap (algebraMap E E')) A.toSubring)[X]))) ≤ J := by
  rw [Ideal.map_le_iff_le_comap]
  intro r hr
  rw [Ideal.mem_comap, hJ, AdjoinRoot.algebraMap_eq, rootHom_of]
  exact fun h1 =>
    valuation_ne_one_of_mem_maximalIdeal hr ((valuation_comap_eq_one_iff _ _ _).2 h1)

/-- **The end cases of the monomial step, case (i).** Let `E'/E` be an extension of prime degree `p`, where `E'` has characteristic `p`. Let `A ⊆ V = W ∩ E` be an affine model of `E/k` such that `R = T_A` is a regular local ring. Let `z ∈ E'` with `z ∉ E` and `z ^ p = y ∈ R`, and assume that the class of `y` in the residue field of `R` is not a `p`-th power. Then `W` has a regular centre on an affine model of `E'/k` that contains `z` and the image of `A` (Proposition E of Volume 5, Chapter 4 of the handbook).

The ring `R[X] / (X ^ p - y)` is a regular local ring with maximal ideal `𝔪 R[X] / (X ^ p - y)` (Corollary C). It is the local ring at the centre of `W` on the model `k[z, A]`. -/
theorem hasRegularCenter_insert_of_forall_pow_ne {W : ValuationSubring E'} {A : Subalgebra k E}
    (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) (hA : IsAffineModel A) {p : ℕ}
    (hp : p.Prime) [ExpChar E' p]
    [IsRegularLocalRing (centerSubring (W.comap (algebraMap E E')) A.toSubring)]
    (hfin : finrank E E' = p) {z : E'} (hz : z ∉ Set.range (algebraMap E E'))
    {y : centerSubring (W.comap (algebraMap E E')) A.toSubring}
    (hy : algebraMap E E' (y : E) = z ^ p)
    (hu : ∀ c : ResidueField (centerSubring (W.comap (algebraMap E E')) A.toSubring),
      c ^ p ≠ residue _ y) :
    HasRegularCenter k W (insert z (algebraMap E E' '' (A : Set E))) := by
  have hirr : Irreducible (X ^ p - C (y : E)) :=
    X_pow_sub_C_irreducible_of_prime hp fun b hb => not_exists_pow_eq_of_pow_eq hz hy ⟨b, hb⟩
  have := Singularity.Algebra.isRegularLocalRing_adjoinRoot_X_pow_sub_C_of_forall_pow_ne hp hu
  obtain ⟨J, hJ⟩ := exists_ideal_iff_valuation_ne_one W _ (rootHom_mem hAV le_rfl hp.ne_zero hy)
  refine hasRegularCenter_insert_of_rootHom hAV hA (le_centerSubring _) le_rfl hp.ne_zero hy hirr
    (adjoin_simple_eq_top_of_finrank_eq_prime hp hfin hz) fun b hb => (hJ b).1 ?_
  rw [Singularity.Algebra.maximalIdeal_adjoinRoot_X_pow_sub_C_of_forall_pow_ne hp hu] at hb
  exact map_maximalIdeal_le_of_rootHom hy hJ hb

/-- **The end cases of the monomial step, case (ii).** Let `E'/E` be an extension of prime degree `p`, where `E'` has characteristic `p`. Let `A ⊆ V = W ∩ E` be an affine model of `E/k` such that `R = T_A` is a regular local ring. Let `z ∈ E'` with `z ∉ E` and `z ^ p = y ∈ R`, and assume `y ∈ 𝔪` and `y ∉ 𝔪 ^ 2`. Then `W` has a regular centre on an affine model of `E'/k` that contains `z` and the image of `A` (Proposition E of Volume 5, Chapter 4 of the handbook).

The ring `R[X] / (X ^ p - y)` is a regular local ring with maximal ideal `𝔪 R[X] / (X ^ p - y) + (z)` (Theorem B). The element `z` does not have value `1`, because `z ^ p = y` does not have value `1`. -/
theorem hasRegularCenter_insert_of_mem_maximalIdeal {W : ValuationSubring E'}
    {A : Subalgebra k E} (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) (hA : IsAffineModel A)
    {p : ℕ} (hp : p.Prime) [ExpChar E' p]
    [IsRegularLocalRing (centerSubring (W.comap (algebraMap E E')) A.toSubring)]
    (hfin : finrank E E' = p) {z : E'} (hz : z ∉ Set.range (algebraMap E E'))
    {y : centerSubring (W.comap (algebraMap E E')) A.toSubring}
    (hy : algebraMap E E' (y : E) = z ^ p) (hy1 : y ∈ maximalIdeal _)
    (hy2 : y ∉ maximalIdeal _ ^ 2) :
    HasRegularCenter k W (insert z (algebraMap E E' '' (A : Set E))) := by
  have hirr : Irreducible (X ^ p - C (y : E)) :=
    X_pow_sub_C_irreducible_of_prime hp fun b hb => not_exists_pow_eq_of_pow_eq hz hy ⟨b, hb⟩
  have := Singularity.Algebra.isRegularLocalRing_adjoinRoot_X_pow_sub_C hy1 hy2 hp.ne_zero
  obtain ⟨J, hJ⟩ := exists_ideal_iff_valuation_ne_one W _ (rootHom_mem hAV le_rfl hp.ne_zero hy)
  refine hasRegularCenter_insert_of_rootHom hAV hA (le_centerSubring _) le_rfl hp.ne_zero hy hirr
    (adjoin_simple_eq_top_of_finrank_eq_prime hp hfin hz) fun b hb => (hJ b).1 ?_
  rw [Singularity.Algebra.maximalIdeal_adjoinRoot_X_pow_sub_C hy1 hp.ne_zero] at hb
  refine sup_le (map_maximalIdeal_le_of_rootHom hy hJ)
    ((Ideal.span_singleton_le_iff_mem _).2 ((hJ _).2 ?_)) hb
  rw [rootHom_root]
  intro hz1
  apply valuation_ne_one_of_mem_maximalIdeal hy1
  rw [valuation_comap_eq_one_iff, hy, map_pow, hz1, one_pow]

end EndCases

section MonomialStep

variable {E E' : Type*} [Field E] [Field E'] [Algebra E E']

/-- Let `R` be a subring of `E`, let `θ ∈ E'` with `θ ∉ E` and `θ ^ p = f ∈ R`, where `E'` has characteristic `p`. Let `f = h ^ p + g ^ p * y` with `h, g, y ∈ R` and `g ≠ 0`. Then `z = (θ - h) / g` satisfies `z ∉ E` and `z ^ p = y`, because `(θ - h) ^ p = θ ^ p - h ^ p`. -/
theorem exists_pow_eq_of_eq_add {p : ℕ} [ExpChar E' p] {R : Subring E} {θ : E'}
    (hθ : θ ∉ Set.range (algebraMap E E')) {f h g y : R} (hg : g ≠ 0)
    (hf : algebraMap E E' (f : E) = θ ^ p) (hfy : f = h ^ p + g ^ p * y) :
    ∃ z : E', z ∉ Set.range (algebraMap E E') ∧ algebraMap E E' (y : E) = z ^ p := by
  have hg' : algebraMap E E' (g : E) ≠ 0 := (_root_.map_ne_zero _).2 fun h0 => hg (Subtype.ext h0)
  have hfE : (f : E) = (h : E) ^ p + (g : E) ^ p * y := by
    rw [hfy]
    norm_cast
  refine ⟨(θ - algebraMap E E' h) / algebraMap E E' g, ?_, ?_⟩
  · rintro ⟨e, he⟩
    refine hθ ⟨e * g + h, ?_⟩
    rw [map_add, map_mul, he, div_mul_cancel₀ _ hg', sub_add_cancel]
  · rw [div_pow, sub_pow_expChar, ← hf, hfE, map_add, map_mul, map_pow, map_pow,
      add_sub_cancel_left, mul_div_cancel_left₀ _ (pow_ne_zero _ hg')]

variable {k : Type*} [Field k] [Algebra k E] [Algebra k E'] [IsScalarTower k E E']

/-- **The monomial step for a form of the residual type.** Take the setting of `Singularity.MonomialInseparableStep`: `E'/E` has prime degree `p` and characteristic `p`, `A ⊆ W ∩ E` is an affine model of `E/k` with `T_A` regular, `θ ∉ E` and `θ ^ p = f ∈ T_A`. Let `f = h ^ p + g ^ p * u` with `g ≠ 0`, where the class of `u` in the residue field of `T_A` is not a `p`-th power. This is a form of the residual type. Then `W` has a regular centre on an affine model of `E'/k` that contains the image of `A`.

Put `z = (θ - h) / g`. Then `z ∉ E` and `z ^ p = u`, and case (i) of Proposition E applies. -/
theorem hasRegularCenter_of_eq_add_unit {W : ValuationSubring E'} {A : Subalgebra k E}
    (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) (hA : IsAffineModel A) {p : ℕ}
    (hp : p.Prime) [ExpChar E' p]
    [IsRegularLocalRing (centerSubring (W.comap (algebraMap E E')) A.toSubring)]
    (hfin : finrank E E' = p) {θ : E'} (hθ : θ ∉ Set.range (algebraMap E E'))
    {f h g u : centerSubring (W.comap (algebraMap E E')) A.toSubring}
    (hf : algebraMap E E' (f : E) = θ ^ p) (hg : g ≠ 0) (hfu : f = h ^ p + g ^ p * u)
    (hu : ∀ c : ResidueField (centerSubring (W.comap (algebraMap E E')) A.toSubring),
      c ^ p ≠ residue _ u) :
    HasRegularCenter k W (algebraMap E E' '' (A : Set E)) := by
  obtain ⟨z, hz, hy⟩ := exists_pow_eq_of_eq_add hθ hg hf hfu
  exact (hasRegularCenter_insert_of_forall_pow_ne hAV hA hp hfin hz hy hu).mono
    (Set.subset_insert _ _)

/-- **The monomial step for a form of the ramified type with one parameter.** Take the setting of `Singularity.MonomialInseparableStep`: `E'/E` has prime degree `p` and characteristic `p`, `A ⊆ W ∩ E` is an affine model of `E/k` with `T_A` regular, `θ ∉ E` and `θ ^ p = f ∈ T_A`. Let `f = h ^ p + g ^ p * (u * x)` with `g ≠ 0`, `u` a unit, `x ∈ 𝔪` and `x ∉ 𝔪 ^ 2`. This is a form of the ramified type, where the monomial is one regular parameter with exponent `1`. Then `W` has a regular centre on an affine model of `E'/k` that contains the image of `A`.

Put `z = (θ - h) / g`. Then `z ∉ E` and `z ^ p = u x`. The element `u x` is in `𝔪` and not in `𝔪 ^ 2`, because `x = u⁻¹ (u x)`. So case (ii) of Proposition E applies. -/
theorem hasRegularCenter_of_eq_add_parameter {W : ValuationSubring E'} {A : Subalgebra k E}
    (hAV : ∀ a ∈ A, a ∈ W.comap (algebraMap E E')) (hA : IsAffineModel A) {p : ℕ}
    (hp : p.Prime) [ExpChar E' p]
    [IsRegularLocalRing (centerSubring (W.comap (algebraMap E E')) A.toSubring)]
    (hfin : finrank E E' = p) {θ : E'} (hθ : θ ∉ Set.range (algebraMap E E'))
    {f h g u x : centerSubring (W.comap (algebraMap E E')) A.toSubring}
    (hf : algebraMap E E' (f : E) = θ ^ p) (hg : g ≠ 0) (hu : IsUnit u)
    (hx1 : x ∈ maximalIdeal _) (hx2 : x ∉ maximalIdeal _ ^ 2)
    (hfx : f = h ^ p + g ^ p * (u * x)) :
    HasRegularCenter k W (algebraMap E E' '' (A : Set E)) := by
  obtain ⟨z, hz, hy⟩ := exists_pow_eq_of_eq_add hθ hg hf hfx
  have hy1 : u * x ∈ maximalIdeal _ := Ideal.mul_mem_left _ u hx1
  have hy2 : u * x ∉ maximalIdeal _ ^ 2 := by
    intro h2
    obtain ⟨v, rfl⟩ := hu
    apply hx2
    have hxv : x = ↑v⁻¹ * (↑v * x) := by rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [hxv]
    exact Ideal.mul_mem_left _ _ h2
  exact (hasRegularCenter_insert_of_mem_maximalIdeal hAV hA hp hfin hz hy hy1 hy2).mono
    (Set.subset_insert _ _)

end MonomialStep

end Singularity
