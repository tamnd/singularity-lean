import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Localization.Ideal
import Mathlib.RingTheory.Adjoin.Basic

/-!
# The charts of the blowup of an ideal

Let `R` be a commutative ring, let `I` be an ideal of `R` and let `f ∈ I`. The chart `R[I/f]` of the blowup of `Spec R` along `I` is the `R`-subalgebra of `R_f` generated by the fractions `a/f` with `a ∈ I`. If `I = (f_1, ..., f_r)`, this is the subalgebra generated by `f_1/f, ..., f_r/f`, since each `a ∈ I` is a linear combination of the `f_j`. This file proves the algebraic part of Volume 4, Lemma 1.1.3, part 3 of the handbook, and the main step of the proof of Proposition 1.1.5.

* `Singularity.idealChart`: the chart `R[I/f]`.
* `Singularity.map_idealChart_eq_span`: `I R[I/f] = f R[I/f]`.
* `Singularity.algebraMap_mem_nonZeroDivisors_idealChart`: `f` is a nonzerodivisor of `R[I/f]`.
* `Singularity.coe_mem_map_iff_idealChart`: let `J` be an ideal of `R` and let `B = R[I/f]`. Then `B ∩ J R_f = (J B : f^∞)`. This is the claim in the proof of Proposition 1.1.5.
* `Singularity.mem_saturation_of_mul_mem_idealChart`: `f` is a nonzerodivisor on `B / (J B : f^∞)`.

The file does not prove parts 1 and 2 of Lemma 1.1.3, that is, the open cover of `Proj S` and the isomorphism of `S_(f t)` with `R[I/f]`. It does not prove Proposition 1.1.5, which needs the blowup as a scheme.
-/

namespace Singularity

variable {R : Type*} [CommRing R]

/-- The chart `R[I/f]` of the blowup along `I`: the `R`-subalgebra of `R_f` generated by the fractions `a/f` with `a ∈ I` (Volume 4, Section 1.1 of the handbook). -/
noncomputable def idealChart (I : Ideal R) (f : R) : Subalgebra R (Localization.Away f) :=
  Algebra.adjoin R ((fun a => algebraMap R (Localization.Away f) a *
    IsLocalization.Away.invSelf f) '' (I : Set R))

/-- For `a ∈ I`, the fraction `a/f` is in `R[I/f]`. -/
theorem div_mem_idealChart {I : Ideal R} {f a : R} (ha : a ∈ I) :
    algebraMap R (Localization.Away f) a * IsLocalization.Away.invSelf f ∈ idealChart I f :=
  Algebra.subset_adjoin ⟨a, ha, rfl⟩

/-- In the chart `R[I/f]` with `f ∈ I`, the ideal `I R[I/f]` is `f R[I/f]` (Volume 4, Lemma 1.1.3, part 3 of the handbook). -/
theorem map_idealChart_eq_span {I : Ideal R} {f : R} (hf : f ∈ I) :
    I.map (algebraMap R (idealChart I f)) = Ideal.span {algebraMap R (idealChart I f) f} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, Ideal.mem_span_singleton']
    refine ⟨⟨_, div_mem_idealChart ha⟩, Subtype.val_injective ?_⟩
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf f), IsLocalization.Away.mul_invSelf,
      mul_one]
  · rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.mem_map_of_mem _ hf

/-- The element `f` is a nonzerodivisor of the chart `R[I/f]` (Volume 4, Lemma 1.1.3, part 3 of the handbook). -/
theorem algebraMap_mem_nonZeroDivisors_idealChart (I : Ideal R) (f : R) :
    algebraMap R (idealChart I f) f ∈ nonZeroDivisors (idealChart I f) := by
  rw [mem_nonZeroDivisors_iff_left]
  intro b hb
  apply Subtype.val_injective
  have h := congrArg Subtype.val hb
  simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_zero] at h
  rw [(IsLocalization.Away.algebraMap_isUnit (S := Localization.Away f) f).mul_right_eq_zero] at h
  exact h

/-- Let `B = R[I/f]` and let `J` be an ideal of `R`. An element `b ∈ B` is in `J R_f` if and only if `f^k b ∈ J B` for some `k`. Thus `B ∩ J R_f = (J B : f^∞)`. This is the claim in the proof of Volume 4, Proposition 1.1.5 of the handbook. -/
theorem coe_mem_map_iff_idealChart {I J : Ideal R} {f : R} (b : idealChart I f) :
    (b : Localization.Away f) ∈ J.map (algebraMap R (Localization.Away f)) ↔
      ∃ k : ℕ, algebraMap R (idealChart I f) f ^ k * b ∈ J.map (algebraMap R (idealChart I f)) := by
  constructor
  · intro hb
    obtain ⟨⟨⟨c, hc⟩, ⟨_, n, rfl⟩⟩, hcb⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) (Localization.Away f)).mp hb
    obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, hab⟩ :=
      IsLocalization.surj (Submonoid.powers f) (b : Localization.Away f)
    dsimp only at hcb hab
    obtain ⟨⟨_, t, rfl⟩, hst⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers f) (Localization.Away f)).mp
        (show algebraMap R (Localization.Away f) (a * f ^ n) =
            algebraMap R (Localization.Away f) (c * f ^ m) by
          rw [map_mul, map_mul, ← hab, ← hcb]
          ring)
    dsimp only at hst
    refine ⟨t + n + m, ?_⟩
    have heq : algebraMap R (idealChart I f) f ^ (t + n + m) * b =
        algebraMap R (idealChart I f) (f ^ t * f ^ m * c) := by
      apply Subtype.val_injective
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
      rw [show f ^ t * f ^ m * c = f ^ t * (c * f ^ m) by ring, ← hst, map_mul, map_mul, ← hab]
      simp only [map_pow]
      ring
    rw [heq]
    exact Ideal.mem_map_of_mem _ (J.mul_mem_left _ hc)
  · rintro ⟨k, hk⟩
    have hle : J.map (algebraMap R (idealChart I f)) ≤
        (J.map (algebraMap R (Localization.Away f))).comap (idealChart I f).val := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      exact Ideal.mem_map_of_mem _ ha
    have h := Ideal.mem_comap.mp (hle hk)
    rw [map_mul, map_pow, AlgHom.commutes] at h
    exact (Ideal.unit_mul_mem_iff_mem _
      ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away f) f).pow k)).mp h

/-- Let `B = R[I/f]` and let `J` be an ideal of `R`. If `f^k (f b) ∈ J B`, then `f^(k+1) b ∈ J B`. Thus `f` is a nonzerodivisor on `B / (J B : f^∞)` (Volume 4, proof of Proposition 1.1.5 of the handbook). -/
theorem mem_saturation_of_mul_mem_idealChart {I J : Ideal R} {f : R} {b : idealChart I f}
    (h : ∃ k : ℕ, algebraMap R (idealChart I f) f ^ k * (algebraMap R (idealChart I f) f * b) ∈
      J.map (algebraMap R (idealChart I f))) :
    ∃ k : ℕ, algebraMap R (idealChart I f) f ^ k * b ∈ J.map (algebraMap R (idealChart I f)) := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k + 1, ?_⟩
  rw [pow_succ, mul_assoc]
  exact hk

end Singularity
