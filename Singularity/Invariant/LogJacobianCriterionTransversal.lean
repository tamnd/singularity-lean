import Singularity.Invariant.LogJacobianCriterion

/-!
# The transversal case of the log-Jacobian criterion

Let `R` be a local domain of characteristic `p` over `k`, with coordinates `x i` in the maximal ideal and derivations `D i` dual to them. Let `Δ` be a finite set of indices (the divisor) and let `f : R`. Suppose that the log-Jacobian ideal `derivLogJacobian D x Δ f` is principal, generated by `D j0 f` with `j0 ∉ Δ` and `D j0 f ≠ 0`. This file proves that there is a first integral of the form `ζ * ∏ i ∈ Δ, x i ^ a i`, with `D j0 ζ` a unit and `a i < p`. Each log derivation that kills `f` also kills this element, and `D j0` maps it to `D j0 ζ * ∏ i ∈ Δ, x i ^ a i`.

## Main definitions

* `Singularity.transversalDerivation`: the log derivation `logCoeff x Δ i • D i - c i • D j0` that kills `f`.

## Main results

* `Singularity.exists_first_integral_of_derivLogJacobian_eq_span_transversal`: the transversal case of the log-Jacobian criterion.
* `Singularity.exists_transversal_generator`: there is a common weight vector `ζ` of the derivations `transversalDerivation D x Δ j0 c l` with `l ∈ Δ`, which the derivations with an index outside `Δ` kill, and with `D j0 ζ` a unit.
* `Singularity.apply_eq_sum_transversalDerivation`: each log derivation that kills `f` is a combination of the derivations `transversalDerivation D x Δ j0 c i`.
* `Singularity.exists_origin_first_integral_of_derivLogJacobian_eq_span_transversal`: the criterion for the local ring of a polynomial ring at the origin.

## The proof

From the principal ideal we get coefficients `c i` with `logCoeff x Δ i * D i f = c i * D j0 f`, and `c j0 = 1`. The derivations `E i = transversalDerivation D x Δ j0 c i` kill `f`, and `E j0 = 0`. A derivation that kills `f` and all the coordinates but `x j0` is `g • D j0`, and `g * D j0 f = 0` gives `g = 0`. So the `E i` commute with each other, and in characteristic `p` we have `E i ^ p = E i` for `i ∈ Δ` and `E j ^ p = 0` for `j ∉ Δ`. The `E i` with `i ∈ Δ` give a grading of `R` by `Δ → ZMod p`. Since `D j0 (x j0) = 1` and `R` is local, some component `ζ` of `x j0` has `D j0 ζ` a unit. A Taylor expansion along `x j` for `j ∉ Δ` and `j ≠ j0` keeps the weight and removes the dependence on `x j`. Since `D j0 (x j) = 0` and `x j` is in the maximal ideal, the constant coefficient still has a unit image under `D j0`. Since `j0 ∉ Δ`, each `x i` with `i ∈ Δ` is a common weight vector, of weight the indicator of `i`, and all `E j` with `j ∉ Δ` kill it. So we can multiply `ζ` by a monomial in the `x i` with `i ∈ Δ` to get an element of weight `0` that all the `E i` kill. Each log derivation `δ` that kills `f` is a combination of the `E i`, and this gives the result. The handbook also assumes in Case 2 that no coefficient of an index in `Δ` is a unit. The proof here does not use this assumption. The unit factor `u` of the handbook can be taken to be `1`, so it does not appear in the statement.

## What is not proved

* The statement `f ∈ E^p(t)` is not here.
* The file does not prove that `t` is part of a regular system of parameters. It proves that `D j0 ζ` is a unit, but not that `ζ` is in the maximal ideal.
* The existence of a model with a principal log-Jacobian ideal in dimension 4 is open, and this file does not prove it.
* The file does not prove local uniformization.

## References

* Volume 5, Chapter 4 of the handbook, Theorem 4.4.16.
-/

open IsLocalRing Finset

namespace Singularity

section Transversal

variable {k R ι : Type*} [CommRing k] [CommRing R] [Algebra k R] [DecidableEq ι]
  {D : ι → Derivation k R R} {x : ι → R}

/-- The log derivation `logCoeff x Δ i • D i - c i • D j0`. -/
def transversalDerivation (D : ι → Derivation k R R) (x : ι → R) (Δ : Finset ι) (j0 : ι)
    (c : ι → R) (i : ι) : Derivation k R R :=
  logCoeff x Δ i • D i - c i • D j0

variable {Δ : Finset ι} {j0 : ι} {c : ι → R} {f : R}

/-- The value of `transversalDerivation D x Δ j0 c i`. -/
theorem transversalDerivation_apply (i : ι) (a : R) :
    transversalDerivation D x Δ j0 c i a = logCoeff x Δ i * D i a - c i * D j0 a := by
  simp [transversalDerivation]

/-- The value of `transversalDerivation D x Δ j0 c i` on a coordinate `x j` with `j ≠ j0`. -/
theorem transversalDerivation_apply_of_ne (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    {i j : ι} (hj : j ≠ j0) :
    transversalDerivation D x Δ j0 c i (x j) = if i = j then logCoeff x Δ i else 0 := by
  rw [transversalDerivation_apply, hD, hD, ite_eq_right (Ne.symm hj)]
  split_ifs <;> ring

/-- The value of `transversalDerivation D x Δ j0 c i` on `logCoeff x Δ j` with `j ≠ j0`. -/
theorem transversalDerivation_logCoeff (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    {i j : ι} (hj : j ≠ j0) :
    transversalDerivation D x Δ j0 c i (logCoeff x Δ j) = if i = j ∧ j ∈ Δ then x j else 0 := by
  by_cases hjΔ : j ∈ Δ
  · rw [show logCoeff x Δ j = x j from ite_eq_left hjΔ, transversalDerivation_apply_of_ne hD hj]
    by_cases hij : i = j
    · subst hij
      simp [logCoeff, hjΔ]
    · simp [hij]
  · rw [show logCoeff x Δ j = 1 from ite_eq_right hjΔ, Derivation.map_one_eq_zero]
    simp [hjΔ]

/-- With the coefficients `c` from the principal ideal, `transversalDerivation D x Δ j0 c i` kills `f`. -/
theorem transversalDerivation_apply_eq_zero
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) (i : ι) :
    transversalDerivation D x Δ j0 c i f = 0 := by
  rw [transversalDerivation_apply, hc, sub_self]

/-- The coefficient `c j0` is `1`. -/
theorem transversal_coeff_self [IsDomain R] (hj0 : j0 ∉ Δ) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) : c j0 = 1 := by
  have h := hc j0
  rw [show logCoeff x Δ j0 = 1 from ite_eq_right hj0] at h
  exact (mul_right_cancel₀ hne h).symm

/-- If `c j0 = 1`, then `transversalDerivation D x Δ j0 c j0` is zero. -/
theorem transversalDerivation_self_eq_zero (hj0 : j0 ∉ Δ) (hc0 : c j0 = 1) :
    transversalDerivation D x Δ j0 c j0 = 0 := by
  ext a
  rw [transversalDerivation_apply, hc0, show logCoeff x Δ j0 = 1 from ite_eq_right hj0]
  simp

variable [Fintype ι] [IsDomain R]

/-- Let `D j0 f ≠ 0`. A derivation that kills `f` and all the coordinates but `x j0` is zero. -/
theorem derivation_eq_zero_of_apply_transversal
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) {j0 : ι} {f : R}
    (hne : D j0 f ≠ 0) (δ : Derivation k R R) (h1 : ∀ j, j ≠ j0 → δ (x j) = 0)
    (hf : δ f = 0) : δ = 0 := by
  have hδ : δ = δ (x j0) • D j0 := by
    have h := derivation_eq_sum_smul hD hdet δ
    rwa [Finset.sum_eq_single j0 (fun j _ hj => by rw [h1 j hj, zero_smul])
      (fun h => absurd (mem_univ j0) h)] at h
  have hg0 : δ (x j0) = 0 := by
    have h2 := hf
    rw [hδ, Derivation.smul_apply, smul_eq_mul] at h2
    exact (mul_eq_zero.mp h2).resolve_right hne
  rw [hδ, hg0, zero_smul]

/-- The derivations `transversalDerivation D x Δ j0 c i` commute with each other. -/
theorem transversalDerivation_comm (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) (i l : ι) (a : R) :
    transversalDerivation D x Δ j0 c i (transversalDerivation D x Δ j0 c l a) =
      transversalDerivation D x Δ j0 c l (transversalDerivation D x Δ j0 c i a) := by
  have hP : ⁅transversalDerivation D x Δ j0 c i, transversalDerivation D x Δ j0 c l⁆ = 0 := by
    refine derivation_eq_zero_of_apply_transversal hD hdet hne _ (fun j hj => ?_) ?_
    · rw [Derivation.commutator_apply, transversalDerivation_apply_of_ne hD hj,
        transversalDerivation_apply_of_ne hD hj]
      by_cases hl : l = j <;> by_cases hi : i = j <;>
        simp [hl, hi, transversalDerivation_logCoeff hD hj]
    · rw [Derivation.commutator_apply, transversalDerivation_apply_eq_zero hc,
        transversalDerivation_apply_eq_zero hc, map_zero, map_zero, sub_self]
  have h := DFunLike.congr_fun hP a
  rw [Derivation.commutator_apply] at h
  exact sub_eq_zero.mp h

/-- In characteristic `p`, the `p`-th power of `transversalDerivation D x Δ j0 c i` with `i ∈ Δ` is itself. -/
theorem transversalDerivation_pow_eq_self (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) {i : ι} (hi : i ∈ Δ) :
    (transversalDerivation D x Δ j0 c i).toLinearMap ^ p =
      (transversalDerivation D x Δ j0 c i).toLinearMap := by
  have hp0 := (Fact.out : p.Prime).ne_zero
  have hP : powCharDerivation p (transversalDerivation D x Δ j0 c i) -
      transversalDerivation D x Δ j0 c i = 0 := by
    refine derivation_eq_zero_of_apply_transversal hD hdet hne _ (fun j hj => ?_) ?_
    · rw [Derivation.sub_apply, powCharDerivation_apply]
      by_cases hij : i = j
      · subst hij
        have h1 : transversalDerivation D x Δ j0 c i (x i) = x i := by
          rw [transversalDerivation_apply_of_ne hD hj, ite_eq_left rfl]
          exact ite_eq_left hi
        rw [derivation_pow_apply_of_eq_self _ h1, h1, sub_self]
      · have h1 : transversalDerivation D x Δ j0 c i (x j) = 0 := by
          rw [transversalDerivation_apply_of_ne hD hj, ite_eq_right hij]
        rw [derivation_pow_apply_of_eq_zero _ h1 hp0, h1, sub_self]
    · rw [Derivation.sub_apply, powCharDerivation_apply,
        derivation_pow_apply_of_eq_zero _ (transversalDerivation_apply_eq_zero hc i) hp0,
        transversalDerivation_apply_eq_zero hc i, sub_self]
  refine LinearMap.ext fun a => ?_
  have h := DFunLike.congr_fun hP a
  rw [Derivation.sub_apply, powCharDerivation_apply] at h
  exact sub_eq_zero.mp h

/-- In characteristic `p`, the `p`-th power of `transversalDerivation D x Δ j0 c j` with `j ∉ Δ` is zero. -/
theorem transversalDerivation_pow_eq_zero (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) {j : ι} (hj : j ∉ Δ) :
    (transversalDerivation D x Δ j0 c j).toLinearMap ^ p = 0 := by
  have hp0 := (Fact.out : p.Prime).ne_zero
  have hp2 := (Fact.out : p.Prime).two_le
  have hP : powCharDerivation p (transversalDerivation D x Δ j0 c j) = 0 := by
    refine derivation_eq_zero_of_apply_transversal hD hdet hne _ (fun l hl => ?_) ?_
    · rw [powCharDerivation_apply]
      by_cases hjl : j = l
      · subst hjl
        have h1 : transversalDerivation D x Δ j0 c j (x j) = 1 := by
          rw [transversalDerivation_apply_of_ne hD hl, ite_eq_left rfl]
          exact ite_eq_right hj
        obtain ⟨m, hm⟩ : ∃ m, p = m + 1 + 1 := ⟨p - 2, by omega⟩
        rw [hm, pow_succ, Module.End.mul_apply, pow_succ, Module.End.mul_apply]
        simp only [Derivation.coeFn_coe, h1, Derivation.map_one_eq_zero, map_zero]
      · have h1 : transversalDerivation D x Δ j0 c j (x l) = 0 := by
          rw [transversalDerivation_apply_of_ne hD hl, ite_eq_right hjl]
        rw [derivation_pow_apply_of_eq_zero _ h1 hp0]
    · rw [powCharDerivation_apply,
        derivation_pow_apply_of_eq_zero _ (transversalDerivation_apply_eq_zero hc j) hp0]
  exact LinearMap.ext fun a => DFunLike.congr_fun hP a

/-- There is a common weight vector `ζ` of the derivations `transversalDerivation D x Δ j0 c l` with `l ∈ Δ`, which these derivations with an index outside `Δ` and different from `j0` kill, and with `D j0 ζ` a unit. -/
theorem exists_transversal_generator [IsLocalRing R] (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0)
    (hx : ∀ i, x i ∈ maximalIdeal R) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) :
    ∃ χ : Δ → ZMod p,
      ∃ ζ ∈ commonWeightSpace (fun l : Δ => transversalDerivation D x Δ j0 c l) χ,
        (∀ j, j ∉ Δ → j ≠ j0 → transversalDerivation D x Δ j0 c j ζ = 0) ∧
          IsUnit (D j0 ζ) := by
  set E := transversalDerivation D x Δ j0 c with hE
  obtain ⟨g, hg, hsum⟩ := exists_sum_commonWeightSpace (p := p) (fun l : Δ => E l)
    (fun l j a => transversalDerivation_comm hD hdet hne hc l j a)
    (fun l => transversalDerivation_pow_eq_self p hD hdet hne hc l.2) (x j0)
  have h1 : (1 : R) = ∑ χ, D j0 (g χ) := by
    have h := congrArg (D j0) hsum
    rwa [map_sum, hD, ite_eq_left rfl] at h
  obtain ⟨χ, hχ⟩ : ∃ χ, IsUnit (D j0 (g χ)) := by
    by_contra hcon
    push Not at hcon
    have hm : ∑ χ, D j0 (g χ) ∈ maximalIdeal R :=
      Ideal.sum_mem _ fun χ _ => (mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hcon χ))
    rw [← h1] at hm
    exact (maximalIdeal R).ne_top_iff_one.mp (maximalIdeal.isMaximal R).ne_top hm
  suffices H : ∀ s : Finset ι, (∀ j ∈ s, j ∉ Δ ∧ j ≠ j0) →
      ∃ ζ ∈ commonWeightSpace (fun l : Δ => E l) χ, (∀ j ∈ s, E j ζ = 0) ∧ IsUnit (D j0 ζ) by
    obtain ⟨ζ, h1, h2, h3⟩ := H (univ.filter fun j => j ∉ Δ ∧ j ≠ j0)
      (fun j hj => (mem_filter.mp hj).2)
    exact ⟨χ, ζ, h1, fun j hj hj0 => h2 j (mem_filter.mpr ⟨mem_univ j, hj, hj0⟩), h3⟩
  intro s
  induction s using Finset.induction_on with
  | empty => exact fun _ => ⟨g χ, hg χ, by simp, hχ⟩
  | insert j s hjs ih =>
    intro hs
    obtain ⟨ζ, hζ1, hζ2, hζ3⟩ := ih (fun j' hj' => hs j' (mem_insert_of_mem hj'))
    have hjΔ : j ∉ Δ := (hs j (mem_insert_self j s)).1
    have hj0 : j ≠ j0 := (hs j (mem_insert_self j s)).2
    let S : Submodule k R :=
      { carrier := {a | a ∈ commonWeightSpace (fun l : Δ => E l) χ ∧ (∀ j' ∈ s, E j' a = 0)}
        add_mem' := fun ha hb => ⟨Submodule.add_mem _ ha.1 hb.1,
          fun j' hj' => by rw [map_add, ha.2 j' hj', hb.2 j' hj', add_zero]⟩
        zero_mem' := ⟨Submodule.zero_mem _, fun j' _ => map_zero _⟩
        smul_mem' := fun r a ha => ⟨Submodule.smul_mem _ r ha.1,
          fun j' hj' => by rw [Derivation.map_smul, ha.2 j' hj', smul_zero]⟩ }
    have hS : ∀ b ∈ S, E j b ∈ S := by
      rintro b ⟨hb1, hb2⟩
      refine ⟨?_, fun j' hj' => ?_⟩
      · rw [mem_commonWeightSpace] at hb1 ⊢
        intro l
        have hl : E l b = ZMod.cast (χ l) * b := hb1 l
        show E l (E j b) = ZMod.cast (χ l) * E j b
        rw [transversalDerivation_comm hD hdet hne hc l j, hl, derivation_zmodCast_mul]
      · rw [transversalDerivation_comm hD hdet hne hc j' j, hb2 j' hj', map_zero]
    have hyS : ∀ b ∈ S, x j * b ∈ S := by
      rintro b ⟨hb1, hb2⟩
      refine ⟨?_, fun j' hj' => ?_⟩
      · rw [mem_commonWeightSpace] at hb1 ⊢
        intro l
        have hl : E l b = ZMod.cast (χ l) * b := hb1 l
        have hl' : E l (x j) = 0 := by
          rw [transversalDerivation_apply_of_ne hD hj0,
            ite_eq_right (fun h : (l : ι) = j => hjΔ (h ▸ l.2))]
        show E l (x j * b) = ZMod.cast (χ l) * (x j * b)
        rw [Derivation.leibniz, hl, hl', smul_zero, add_zero, smul_eq_mul]
        ring
      · have hl : E j' (x j) = 0 := by
          rw [transversalDerivation_apply_of_ne hD hj0,
            ite_eq_right (fun h : j' = j => hjs (h ▸ hj'))]
        rw [Derivation.leibniz, hb2 j' hj', hl, smul_zero, smul_zero, add_zero]
    have hy : E j (x j) = 1 := by
      rw [transversalDerivation_apply_of_ne hD hj0, ite_eq_left rfl]
      exact ite_eq_right hjΔ
    obtain ⟨b, hb, hsum⟩ := exists_taylor_of_mem_submodule (E j) p
      (transversalDerivation_pow_eq_zero p hD hdet hne hc hjΔ) hy S hS hyS ⟨hζ1, hζ2⟩
    have hDj : D j0 (x j) = 0 := by rw [hD, ite_eq_right (Ne.symm hj0)]
    have hD0 : D j0 ζ = ∑ i ∈ range p, x j ^ i * D j0 (b i) := by
      rw [hsum, map_sum]
      refine sum_congr rfl fun i _ => ?_
      rw [Derivation.leibniz, Derivation.leibniz_pow, hDj]
      simp only [smul_zero, mul_zero, add_zero, smul_eq_mul]
    obtain ⟨n, hn⟩ : ∃ n, p = n + 1 := ⟨p - 1, by have := (Fact.out : p.Prime).pos; omega⟩
    rw [hn, sum_range_succ', pow_zero, one_mul] at hD0
    have hm : ∑ i ∈ range n, x j ^ (i + 1) * D j0 (b (i + 1)) ∈ maximalIdeal R :=
      Ideal.sum_mem _ fun i _ => by
        rw [pow_succ', mul_assoc]
        exact Ideal.mul_mem_right _ _ (hx j)
    have hunit : IsUnit (D j0 (b 0)) := by
      by_contra hnu
      have h2 : D j0 (b 0) ∈ maximalIdeal R := (mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
      have h3 : D j0 ζ ∈ maximalIdeal R := by
        rw [hD0]
        exact Ideal.add_mem _ hm h2
      exact (mem_nonunits_iff.mp ((mem_maximalIdeal _).mp h3)) hζ3
    refine ⟨b 0, (hb 0).1.1, fun j' hj' => ?_, hunit⟩
    rcases mem_insert.mp hj' with rfl | hj'
    · exact (hb 0).2
    · exact (hb 0).1.2 j' hj'

/-- Each log derivation `δ` that kills `f` is a combination `∑ i, b i * E i` of the derivations `E i = transversalDerivation D x Δ j0 c i`. -/
theorem apply_eq_sum_transversalDerivation (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hne : D j0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * D j0 f) (δ : Derivation k R R)
    (hδΔ : ∀ i ∈ Δ, x i ∣ δ (x i)) (hδf : δ f = 0) :
    ∃ b : ι → R, ∀ y, δ y = ∑ i, b i * transversalDerivation D x Δ j0 c i y := by
  have hb : ∀ i, ∃ bi, δ (x i) = bi * logCoeff x Δ i := by
    intro i
    by_cases hi : i ∈ Δ
    · obtain ⟨q, hq⟩ := hδΔ i hi
      exact ⟨q, by rw [hq, logCoeff, ite_eq_left hi, mul_comm]⟩
    · exact ⟨δ (x i), by rw [logCoeff, ite_eq_right hi, mul_one]⟩
  choose b hb using hb
  have hrep : ∀ y, δ y = ∑ i, b i * transversalDerivation D x Δ j0 c i y +
      (∑ i, b i * c i) * D j0 y := by
    intro y
    conv_lhs => rw [derivation_eq_sum_smul hD hdet δ]
    rw [derivation_finsetSum_apply, sum_mul, ← sum_add_distrib]
    refine sum_congr rfl fun i _ => ?_
    rw [Derivation.smul_apply, smul_eq_mul, hb, transversalDerivation_apply]
    ring
  have hsum : ∑ i, b i * c i = 0 := by
    have h := hrep f
    simp only [transversalDerivation_apply_eq_zero hc, mul_zero, sum_const_zero, zero_add,
      hδf] at h
    exact (mul_eq_zero.mp h.symm).resolve_right hne
  exact ⟨b, fun y => by rw [hrep, hsum, zero_mul, add_zero]⟩

/-- The transversal case of the log-Jacobian criterion (Theorem 4.4.16, Case 2). If `D j0 f` with `j0 ∉ Δ` generates the log-Jacobian ideal, then there is a first integral `ζ * ∏ i ∈ Δ, x i ^ a i` with `D j0 ζ` a unit and `a i < p`. Each log derivation that kills `f` kills it, and `D j0` maps it to `D j0 ζ * ∏ i ∈ Δ, x i ^ a i`. -/
theorem exists_first_integral_of_derivLogJacobian_eq_span_transversal [IsLocalRing R] (p : ℕ)
    [Fact p.Prime] [CharP R p] (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0)
    (hx : ∀ i, x i ∈ maximalIdeal R) (hj0 : j0 ∉ Δ) (hne : D j0 f ≠ 0)
    (hJ : derivLogJacobian D x Δ f = Ideal.span {D j0 f}) :
    ∃ (ζ : R) (a : ι → ℕ), IsUnit (D j0 ζ) ∧ (∀ i, a i < p) ∧
      (∀ δ : Derivation k R R, (∀ i ∈ Δ, x i ∣ δ (x i)) → δ f = 0 →
        δ (ζ * ∏ i ∈ Δ, x i ^ a i) = 0) ∧
      D j0 (ζ * ∏ i ∈ Δ, x i ^ a i) = D j0 ζ * ∏ i ∈ Δ, x i ^ a i := by
  have hcoef : ∀ i, ∃ ci, logCoeff x Δ i * D i f = ci * D j0 f := by
    intro i
    have hmem : logCoeff x Δ i * D i f ∈ derivLogJacobian D x Δ f := by
      unfold logCoeff
      split_ifs with h
      · exact mul_mem_derivLogJacobian D x h f
      · rw [one_mul]
        exact derivation_mem_derivLogJacobian D x h f
    rw [hJ] at hmem
    obtain ⟨ci, hci⟩ := Ideal.mem_span_singleton'.mp hmem
    exact ⟨ci, hci.symm⟩
  choose c hc using hcoef
  have hc0 : c j0 = 1 := transversal_coeff_self hj0 hne hc
  set E := transversalDerivation D x Δ j0 c with hE
  obtain ⟨χ, ζ, hζ1, hζ2, hζ3⟩ := exists_transversal_generator p hD hdet hx hne hc
  let a : ι → ℕ := fun i => if h : i ∈ Δ then (-χ ⟨i, h⟩).val else 0
  set M := ∏ l ∈ Δ, x l ^ a l with hM
  have hEM : ∀ i, E i M = (if i ∈ Δ then (a i : R) else 0) * M := by
    intro i
    rw [hM, derivation_prod_pow _ _ _ _ (fun l => if i = l then 1 else 0) (fun l hl => ?_)]
    · simp only [mul_ite, mul_one, mul_zero, sum_ite_eq]
    · rw [transversalDerivation_apply_of_ne hD (fun h => hj0 (by rw [← h]; exact hl))]
      split_ifs with h
      · subst h
        rw [one_mul]
        exact ite_eq_left hl
      · rw [zero_mul]
  have hEt : ∀ i, E i (ζ * M) = 0 := by
    intro i
    by_cases hi : i ∈ Δ
    · have hw : E i ζ = ZMod.cast (χ ⟨i, hi⟩) * ζ := mem_commonWeightSpace.mp hζ1 ⟨i, hi⟩
      have hai : (a i : R) = -(ZMod.cast (χ ⟨i, hi⟩) : R) := by
        simp only [a, hi, ↓reduceDIte]
        rw [ZMod.natCast_val, ZMod.cast_neg (dvd_refl p)]
      rw [Derivation.leibniz, hEM, ite_eq_left hi, hw, smul_eq_mul, smul_eq_mul]
      linear_combination (ζ * M) * hai
    · by_cases hij : i = j0
      · rw [hij, hE, transversalDerivation_self_eq_zero hj0 hc0]
        rfl
      · rw [Derivation.leibniz, hζ2 i hi hij, hEM, ite_eq_right hi, zero_mul, smul_zero,
          smul_zero, add_zero]
  refine ⟨ζ, a, hζ3, fun i => ?_, fun δ hδΔ hδf => ?_, ?_⟩
  · simp only [a]
    split_ifs
    · exact ZMod.val_lt _
    · exact (Fact.out : p.Prime).pos
  · obtain ⟨b, hb⟩ := apply_eq_sum_transversalDerivation hD hdet hne hc δ hδΔ hδf
    rw [hb]
    exact sum_eq_zero fun i _ => by rw [hEt i, mul_zero]
  · have hD0M : D j0 M = 0 := by
      rw [hM, derivation_prod_pow (D j0) _ _ _ 0 (fun l hl => by
        rw [hD, ite_eq_right (fun h => hj0 (by rw [h]; exact hl)), Pi.zero_apply, zero_mul])]
      simp
    rw [Derivation.leibniz, hD0M, smul_zero, zero_add, smul_eq_mul, mul_comm]

end Transversal

section Origin

open MvPolynomial Singularity.Algebra

variable {σ k : Type*} [Field k]

/-- The transversal case of the log-Jacobian criterion for the local ring of a polynomial ring at the origin. -/
theorem exists_origin_first_integral_of_derivLogJacobian_eq_span_transversal [Fintype σ]
    [DecidableEq σ] (p : ℕ) [Fact p.Prime] [CharP k p] {Δ : Finset σ} {j0 : σ}
    {f : OriginLocalRing σ k} (hj0 : j0 ∉ Δ) (hne : originDerivation j0 f ≠ 0)
    (hJ : derivLogJacobian originDerivation
        (fun i => algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i)) Δ f =
      Ideal.span {originDerivation j0 f}) :
    ∃ (ζ : OriginLocalRing σ k) (a : σ → ℕ), IsUnit (originDerivation j0 ζ) ∧ (∀ i, a i < p) ∧
      (∀ δ : Derivation k (OriginLocalRing σ k) (OriginLocalRing σ k),
        (∀ i ∈ Δ, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ∣
          δ (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i))) → δ f = 0 →
        δ (ζ * ∏ i ∈ Δ, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i) = 0) ∧
      originDerivation j0
          (ζ * ∏ i ∈ Δ, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i) =
        originDerivation j0 ζ *
          ∏ i ∈ Δ, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i := by
  have : CharP (OriginLocalRing σ k) p :=
    charP_of_injective_algebraMap (algebraMap k (OriginLocalRing σ k)).injective p
  exact exists_first_integral_of_derivLogJacobian_eq_span_transversal p originDerivation_X
    originLocalRing_derivation_eq_zero algebraMap_X_mem_maximalIdeal hj0 hne hJ

end Origin

end Singularity
