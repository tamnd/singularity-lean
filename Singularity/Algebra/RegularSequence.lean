import Singularity.Algebra.Regular
import Mathlib.RingTheory.Regular.ProjectiveDimension

/-!
# A regular system of parameters is a regular sequence

Let `R` be a regular local ring of dimension `d` with maximal ideal `𝔪`. This file proves that
`𝔪` is generated by a regular sequence of length `d` ([Mat89, Section 17]).
Then the theorem of Mathlib on the quotient by a regular sequence gives the projective dimension
of the residue field: it is `d` ([Mat89, Theorem 19.2], one direction of the theorem of Serre).

## Main results

* `exists_isRegular_of_ringKrullDim_eq`: a regular local ring of dimension `n` has a regular
  sequence of length `n` that generates `𝔪`.
* `exists_isRegular_ofList_eq_maximalIdeal`: the same result, with the length equal to
  `ringKrullDim R`.
* `projectiveDimension_residueField`: the projective dimension of `R ⧸ 𝔪` is `ringKrullDim R`.

## The proof

The proof is by induction on `n`, as in the proof of `isDomain_of_isRegularLocalRing` ([Mat89,
Theorem 14.3]). Let `x ∈ 𝔪 \ 𝔪²`. Then `R / (x)` is regular of dimension `n - 1`, so by induction
its maximal ideal is generated by a regular sequence `t₁, ..., tₙ₋₁`. Lift each `tᵢ` to `R`. The
element `x` is a nonzerodivisor, because `R` is a domain. Thus `x` followed by the lifts is a
regular sequence of `R`, and it generates `𝔪`.

## References

* [Mat89] H. Matsumura, *Commutative Ring Theory*, Cambridge University Press, 1989.
-/

universe u

open IsLocalRing Ideal RingTheory.Sequence

namespace Singularity.Algebra

/-- In a local ring, the quotient of `R` by `x • ⊤` is the quotient by the ideal `(x)`. -/
noncomputable def quotSMulTopEquivQuotSpan {R : Type u} [CommRing R] (x : R) :
    QuotSMulTop x R ≃ₗ[R] R ⧸ span {x} :=
  Submodule.quotEquivOfEq _ _ (by
    rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top])

/-- A regular local ring of dimension `n` has a regular sequence of length `n` that generates
the maximal ideal ([Mat89, Section 17]). -/
theorem exists_isRegular_of_ringKrullDim_eq (n : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], ringKrullDim R = n →
      ∃ rs : List R, rs.length = n ∧ ofList rs = maximalIdeal R ∧ IsRegular R rs := by
  induction n with
  | zero =>
    intro R _ _ h
    have h0 : (maximalIdeal R).spanFinrank = 0 := by
      have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
      rw [h] at this
      exact_mod_cast this
    have hbot : maximalIdeal R = ⊥ :=
      (Submodule.spanFinrank_eq_zero_iff_eq_bot (maximalIdeal R).fg_of_isNoetherianRing).mp h0
    exact ⟨[], rfl, by rw [ofList_nil, hbot], IsRegular.nil ..⟩
  | succ n ih =>
    intro R _ _ h
    have hpos : 0 < ringKrullDim R := by
      rw [h]; exact_mod_cast Nat.succ_pos n
    obtain ⟨x, mem, nmem, -⟩ :=
      exists_mem_maximalIdeal_notMem_sq_notMem_minimalPrimes hpos
    obtain ⟨hQ, hdim⟩ := quotient_span_singleton mem nmem
    have := hQ
    have hQn : ringKrullDim (R ⧸ span {x}) = n := by
      obtain ⟨m, hm⟩ := exists_ringKrullDim_eq_natCast (R ⧸ span {x})
      rw [hm, h] at hdim
      have : m + 1 = n + 1 := by exact_mod_cast hdim
      rw [hm, Nat.succ_inj.mp this]
    obtain ⟨ts, hlen, hts, hreg⟩ := ih (R ⧸ span {x}) hQn
    have hsurj : Function.Surjective (Ideal.Quotient.mk (span {x})) :=
      Ideal.Quotient.mk_surjective
    obtain ⟨ys, hys⟩ := List.map_surjective_iff.mpr hsurj ts
    -- The ideal generated by `x` and the lifts is `𝔪`.
    have hxle : span {x} ≤ maximalIdeal R := (span_singleton_le_iff_mem _).mpr mem
    have hideal : ofList (x :: ys) = maximalIdeal R := by
      have hmap : (maximalIdeal R).map (Ideal.Quotient.mk (span {x})) =
          (ofList ys).map (Ideal.Quotient.mk (span {x})) := by
        rw [← maximalIdeal_quotient_eq_map, ← hts, map_ofList, hys]
      have hc := congrArg (Ideal.comap (Ideal.Quotient.mk (span {x}))) hmap
      rw [comap_map_of_surjective' _ hsurj, comap_map_of_surjective' _ hsurj, mk_ker,
        sup_eq_left.mpr hxle] at hc
      rw [ofList_cons, sup_comm, hc]
    -- Each element of the sequence is in `𝔪`.
    have hmem : ∀ r ∈ x :: ys, r ∈ maximalIdeal R := by
      intro r hr
      rw [← hideal]
      exact subset_span hr
    refine ⟨x :: ys, ?_, hideal, ?_⟩
    · rw [List.length_cons, ← hlen, ← hys, List.length_map]
    rw [IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hmem,
      isWeaklyRegular_cons_iff]
    have hdom := isDomain_of_isRegularLocalRing R
    have hx0 : x ≠ 0 := by
      rintro rfl
      exact nmem (zero_mem _)
    refine ⟨fun a b hab => mul_left_cancel₀ hx0 (by simpa using hab), ?_⟩
    rw [(quotSMulTopEquivQuotSpan x).isWeaklyRegular_congr,
      ← isWeaklyRegular_map_algebraMap_iff (R ⧸ span {x}) (R ⧸ span {x}) ys,
      Ideal.Quotient.algebraMap_eq, hys]
    exact hreg.toIsWeaklyRegular

/-- The maximal ideal of a regular local ring is generated by a regular sequence whose length
is the dimension ([Mat89, Section 17]). -/
theorem exists_isRegular_ofList_eq_maximalIdeal (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    ∃ rs : List R, (rs.length : WithBot ℕ∞) = ringKrullDim R ∧ ofList rs = maximalIdeal R ∧
      IsRegular R rs := by
  obtain ⟨n, hn⟩ := exists_ringKrullDim_eq_natCast R
  obtain ⟨rs, hlen, hrs, hreg⟩ := exists_isRegular_of_ringKrullDim_eq n R hn
  exact ⟨rs, by rw [hlen, hn], hrs, hreg⟩

/-- The residue field of a regular local ring has projective dimension `dim R`
([Mat89, Theorem 19.2], the first half of the theorem of Serre). -/
theorem projectiveDimension_residueField (R : Type u) [CommRing R] [IsRegularLocalRing R] :
    CategoryTheory.projectiveDimension
        (ModuleCat.of R (Shrink.{u} (R ⧸ maximalIdeal R))) = ringKrullDim R := by
  obtain ⟨rs, hlen, hrs, hreg⟩ := exists_isRegular_ofList_eq_maximalIdeal R
  have := ModuleCat.projectiveDimension_quotient_eq_length rs hreg
  rw [hrs] at this
  rw [this]
  exact hlen

end Singularity.Algebra
