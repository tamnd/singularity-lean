import Singularity.Invariant.LogJacobianDirectrix

/-!
# `τ_ρ` does not go down from case A to case A

Let `k` be a field of characteristic `p`, let `g ≠ 0` be a clean polynomial in `k[x_i : i ∈ σ]`
with `ord g ≥ p`, and let `Δ` give the divisor `E = V(∏_{i ∈ Δ} x_i)`. Write `g = x^r G`, with
`r = divisorExponent Δ g` and `G = residualFactor Δ g`, and let `ρ = logJacobianOrder Δ g`. Let
`d = ord G`, let `F` be the part of degree `d` of `G`, and let `e_i = r_i G + x_i ∂_i G` and
`Φ_i = r_i F + x_i ∂_i F`. This file proves that `τ_ρ` does not go down at the points of a point
blowup where `ρ = d` stays and the old and the new points are of case A, if `|r| + d ≠ 0` in `k`
(Volume 7, Section 3.9 of the handbook, Theorem 3.9.1). The case `|r| + d = 0` in `k` is open.

The proof has three steps.

1. The tangent ideal. If `r` is supported in `Δ`, then `Θ₀(x^r G) = x^r Θ̃₀(G)`, where `Θ̃₀(G)` is
   generated by the `e_i` for `i ∈ Δ` and the `x_m ∂_l G` for `l ∉ Δ`
   (`logJacobianTangent_monomial_mul`). The Euler element `∑_i e_i` has the part
   `(|r| + d) F` of degree `d`. So if `|r| + d ≠ 0` in `k`, then the old point is of case A, and
   `T_ρ(g) ⊆ T(F)` (`ord_sum_smul_add_X_mul_pderiv`).
2. Lemma 3.9.2. If `v ∈ T(F)`, `v ∈ T(Φ_i)` and `v_i ≠ 0`, then `∂_i F = 0`, so `Φ_i = r_i F`
   (`pderiv_eq_zero_of_mem_directrix`). The proof uses the chain rule for the translation by `v`.
3. Lemma 3.9.3, the exact transports. Let the chart be `π = pointChart j t` with the vector `v`.
   For `i ≠ j` with `t_i = 0`, and for the Euler element, the chart sends `x^r e_i` to
   `x_j^p` times an element of `Θ₀(g'_c)`. Since the new point is of case A, the transforms of the
   parts of degree `d` are in the definition of `T_ρ(g'_c)`. So each `w ∈ T_ρ(g'_c)` with
   `w_j = 0` is in `T(F)` and in the `T(Φ_i)` for these `i`
   (`mem_directrix_of_mem_logJacobianDirectrix_cleanPart`). For the other `i ∈ Δ`, `v_i ≠ 0`,
   and step 2 gives `Φ_i = r_i F`. The generators `x_m ∂_l G` with `l ∉ Δ` have order more than
   `d`, since `ord ∂_l G ≥ ρ`. So `w` is in `T_ρ(g)`. The vector `v` is in `T_ρ(g)` with `v_j = 1`
   (`chartVector_mem_directrix_of_logJacobianOrder_eq`). The dimension inequality of
   Proposition 3.8.2 gives the theorem.

The plain transports of the `e_i` are not enough. Over `𝔽₂`, let `g = x z^2 + x^2 y^3` and
`E = V(x)`. In the `y`-chart with `t_x = 1` and `t_z = 0`, the transform of `x e_x = x z^2` is
`y z^2` or `y (x + 1) z^2`, and neither is in `Θ₀(g'_c)` (Example 3.9.4).

## Main results

* `logJacobianTangent_monomial_mul`: `Θ₀(x^r G) = x^r Θ̃₀(G)`.
* `pderiv_eq_zero_of_mem_directrix`: Lemma 3.9.2.
* `pointChart_X_mul_pderiv_of_ne_of_eq_zero`, `pointChart_sum_X_mul_pderiv`: the exact
  transports of Lemma 3.9.3.
* `finrank_logJacobianDirectrix_cleanPart_le_of_caseA`,
  `logJacobianDirectrixCodim_le_cleanPart_of_caseA`: Theorem 3.9.1.
* `tauRhoCaseAExample_hyp`, `tauRhoCaseAExample_not_mem`: Example 3.9.4.

## References

* Volume 7, Section 3.9 of the handbook: Theorem 3.9.1, Lemma 3.9.2, Lemma 3.9.3 and
  Example 3.9.4.
-/

open MvPolynomial Finsupp Module

namespace Singularity

section Tangent

variable {σ k : Type*} [Field k]

/-- The ideal `Θ̃₀(G)` for the exponents `r`: the ideal generated by `r_i G + x_i ∂_i G` for
`i ∈ Δ` and by `x_m ∂_l G` for `l ∉ Δ` and each `m`. If `r` is supported in `Δ`, then
`Θ₀(x^r G) = x^r Θ̃₀(G)` (`logJacobianTangent_monomial_mul`). -/
noncomputable def residualLogJacobianTangent (Δ : Finset σ) (r : σ →₀ ℕ) (G : MvPolynomial σ k) :
    Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun i => (r i : k) • G + X i * pderiv i G) '' (Δ : Set σ) ∪
    (fun a : σ × σ => X a.1 * pderiv a.2 G) '' {a | a.2 ∉ Δ})

/-- The Leibniz rule for `x_i ∂_i` and the monomial `x^r`:
`x_i ∂_i (x^r G) = x^r (r_i G + x_i ∂_i G)`. -/
theorem X_mul_pderiv_monomial_mul (r : σ →₀ ℕ) (i : σ) (G : MvPolynomial σ k) :
    X i * pderiv i (monomial r 1 * G) = monomial r 1 * ((r i : k) • G + X i * pderiv i G) := by
  have h1 : X i * pderiv i (monomial r (1 : k)) = (r i : k) • monomial r 1 := by
    rw [X_mul_pderiv_monomial, Nat.cast_smul_eq_nsmul]
  calc X i * pderiv i (monomial r 1 * G)
      = X i * pderiv i (monomial r 1) * G + monomial r 1 * (X i * pderiv i G) := by
        rw [pderiv_mul]
        ring
    _ = monomial r 1 * ((r i : k) • G + X i * pderiv i G) := by
        rw [h1, smul_mul_assoc, ← mul_smul_comm, ← mul_add]

/-- If `r` is supported in `Δ`, then `Θ₀(x^r G) = (x^r) Θ̃₀(G)`. -/
theorem logJacobianTangent_monomial_mul {Δ : Finset σ} {r : σ →₀ ℕ}
    (hr : ∀ i, i ∉ Δ → r i = 0) (G : MvPolynomial σ k) :
    logJacobianTangent Δ (monomial r 1 * G) =
      Ideal.span {monomial r 1} * residualLogJacobianTangent Δ r G := by
  rw [logJacobianTangent, residualLogJacobianTangent, Ideal.span_mul_span, Set.singleton_mul,
    Set.image_union, Set.image_image, Set.image_image]
  congr 2
  · exact Set.image_congr fun i _ => X_mul_pderiv_monomial_mul r i G
  · refine Set.image_congr fun a ha => ?_
    show X a.1 * pderiv a.2 (monomial r 1 * G) = monomial r 1 * (X a.1 * pderiv a.2 G)
    rw [pderiv_mul, pderiv_monomial, hr a.2 ha, Nat.cast_zero, mul_zero, monomial_zero, zero_mul,
      zero_add]
    ring

/-- If `x^r ψ ∈ Θ₀(g)` with `r = divisorExponent Δ g`, then `ψ ∈ Θ̃₀(G)` with
`G = residualFactor Δ g`. -/
theorem mem_residualLogJacobianTangent {Δ : Finset σ} {g ψ : MvPolynomial σ k}
    (hψ : monomial (divisorExponent Δ g) 1 * ψ ∈ logJacobianTangent Δ g) :
    ψ ∈ residualLogJacobianTangent Δ (divisorExponent Δ g) (residualFactor Δ g) := by
  have heq : logJacobianTangent Δ g = Ideal.span {monomial (divisorExponent Δ g) 1} *
      residualLogJacobianTangent Δ (divisorExponent Δ g) (residualFactor Δ g) := by
    conv_lhs => rw [← monomial_mul_residualFactor Δ g]
    exact logJacobianTangent_monomial_mul (fun _ hi => divisorExponent_eq_zero hi) _
  rw [heq] at hψ
  obtain ⟨z, hz, hzeq⟩ := Ideal.mem_span_singleton_mul.mp hψ
  have hne : (monomial (divisorExponent Δ g) (1 : k)) ≠ 0 := by
    rw [Ne, monomial_eq_zero]
    exact one_ne_zero
  rwa [← mul_left_cancel₀ hne hzeq]

end Tangent

section Lemma392

variable {σ k : Type*} [Field k]

/-- The chain rule for the translation: `∂_{x_i} g(x + s v) = (∂_i g)(x + s v)`. -/
theorem pderiv_some_translate (v : σ → k) (i : σ) (F : MvPolynomial σ k) :
    pderiv (some i) (translate v F) = translate v (pderiv i F) := by
  classical
  induction F using MvPolynomial.induction_on with
  | C a => simp [translate]
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P l hP =>
    have hX : translate v (X l) = X (some l) + C (v l) * X none := by simp [translate]
    have hl' : pderiv (some i) (translate v (X l)) = translate v (pderiv i (X l)) := by
      rw [hX]
      by_cases hl : l = i
      · subst hl
        simp
      · simp [hl, pderiv_X]
    rw [map_mul, pderiv_mul, hP, hl', pderiv_mul, map_add, map_mul, map_mul]

/-- If `v ∈ T(F)`, then `v ∈ T(∂_i F)`. -/
theorem mem_directrix_pderiv {F : MvPolynomial σ k} {v : σ → k} (hF : v ∈ directrix F) (i : σ) :
    v ∈ directrix (pderiv i F) := by
  rw [mem_directrix_iff] at hF ⊢
  rw [← pderiv_some_translate, hF, pderiv_rename (Option.some_injective σ)]

/-- **The directrix conditions give `∂_i F = 0`** (Volume 7, Section 3.9 of the handbook,
Lemma 3.9.2). If `v ∈ T(F)`, `v ∈ T(c F + x_i ∂_i F)` and `v_i ≠ 0`, then `∂_i F = 0`. The proof:
`∂_v (c F + x_i ∂_i F) = c ∂_v F + v_i ∂_i F + x_i ∂_i ∂_v F = v_i ∂_i F`. -/
theorem pderiv_eq_zero_of_mem_directrix {F : MvPolynomial σ k} {v : σ → k} {i : σ} (c : k)
    (hF : v ∈ directrix F) (hΦ : v ∈ directrix (c • F + X i * pderiv i F)) (hv : v i ≠ 0) :
    pderiv i F = 0 := by
  have hd := mem_directrix_iff.mp (mem_directrix_pderiv hF i)
  rw [mem_directrix_iff] at hF hΦ
  rw [map_add, map_add, map_smul, map_smul, hF, map_mul, map_mul, hd, add_right_inj] at hΦ
  have hX : translate v (X i) = rename some (X i) + C (v i) * X none := by
    simp [translate]
  rw [hX, add_mul, add_eq_left, mul_eq_zero] at hΦ
  rcases hΦ with h0 | h0
  · exact absurd h0 (mul_ne_zero ((map_ne_zero_iff _ (C_injective _ _)).mpr hv) (X_ne_zero _))
  · exact rename_injective _ (Option.some_injective σ) (by rw [h0, map_zero])

/-- The part of degree `d` of `r_i G + x_i ∂_i G` is `r_i F + x_i ∂_i F`, with `F = G_d`. -/
theorem homogeneousComponent_smul_add_X_mul_pderiv (d : ℕ) (r : σ →₀ ℕ) (i : σ)
    (G : MvPolynomial σ k) :
    homogeneousComponent d ((r i : k) • G + X i * pderiv i G) =
      (r i : k) • homogeneousComponent d G + X i * pderiv i (homogeneousComponent d G) := by
  ext a
  rw [coeff_homogeneousComponent, coeff_smul_add_X_mul_pderiv, coeff_smul_add_X_mul_pderiv,
    coeff_homogeneousComponent]
  split_ifs <;> simp

end Lemma392

section Euler

variable {σ k : Type*} [Field k] [Fintype σ]

/-- The Euler element `x^r ψ_E = ∑_i x_i ∂_i g` lies in `Θ₀(g)`, with
`ψ_E = ∑_i (r_i G + x_i ∂_i G)`. -/
theorem monomial_mul_sum_smul_add_X_mul_pderiv_mem (Δ : Finset σ) (g : MvPolynomial σ k) :
    monomial (divisorExponent Δ g) 1 * ∑ i, ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) ∈ logJacobianTangent Δ g := by
  rw [← sum_X_mul_pderiv_monomial_mul, monomial_mul_residualFactor]
  exact Ideal.sum_mem _ fun i _ => X_mul_pderiv_mem_logJacobianTangent' Δ i g

/-- The part of degree `d` of the Euler element `∑_i (r_i G + x_i ∂_i G)` is `(|r| + d) G_d`. -/
theorem homogeneousComponent_sum_smul_add_X_mul_pderiv (d : ℕ) (r : σ →₀ ℕ)
    (G : MvPolynomial σ k) :
    homogeneousComponent d (∑ i, ((r i : k) • G + X i * pderiv i G)) =
      ((degree r + d : ℕ) : k) • homogeneousComponent d G := by
  ext a
  rw [coeff_homogeneousComponent, coeff_smul, coeff_homogeneousComponent,
    coeff_sum_smul_add_X_mul_pderiv, smul_eq_mul]
  split_ifs with ha
  · rw [ha]
  · rw [mul_zero]

/-- The order of the Euler element `∑_i (r_i G + x_i ∂_i G)` is `d = ord G` if `|r| + d` is not
`0` in `k`. -/
theorem ord_sum_smul_add_X_mul_pderiv {r : σ →₀ ℕ} {G : MvPolynomial σ k} {d : ℕ}
    (hG : ord G = d) (hpd : ((degree r + d : ℕ) : k) ≠ 0) :
    ord (∑ i, ((r i : k) • G + X i * pderiv i G)) = d := by
  have hcoeff := coeff_sum_smul_add_X_mul_pderiv r G
  have hG0 : G ≠ 0 := by
    rintro rfl
    rw [ord_zero] at hG
    exact ENat.top_ne_natCast d hG
  refine le_antisymm ?_ (le_ord_iff.mpr fun a ha => ?_)
  · obtain ⟨a, ha, had⟩ := exists_coeff_ne_zero_and_ord_eq hG0
    have hda : degree a = d := by
      rw [hG] at had
      exact_mod_cast had.symm
    refine (ord_le (d := a) ?_).trans (le_of_eq (by rw [hda]))
    rw [hcoeff, hda]
    exact mul_ne_zero hpd ha
  · rw [hcoeff, coeff_eq_zero_of_lt_ord (by rw [hG]; exact_mod_cast ha), mul_zero]

end Euler

/-! ### The exact transports -/

section Transport

variable {σ k : Type*} [Field k] [DecidableEq σ] [DecidableEq k] [Fintype σ] (p : ℕ) [CharP k p]
  {Δ : Finset σ} {j : σ} {t : σ → k} {g g' : MvPolynomial σ k}

/-- **The exact transport** (Volume 7, Section 3.9 of the handbook, Lemma 3.9.3). Let `g ≠ 0` be
clean with `ord g ≥ p`, let `π(g) = x_j^p g'`, and let the order of `Θ₀(g)` be `|r| + d`. Let
`ρ(g'_c) = d`, and let the new point be of case A: the order of `Θ₀(g'_c)` is `|r'| + d`, with
`r' = divisorExponent Δ' g'_c`. Let `ord ψ = d` and `x^r ψ ∈ Θ₀(g)`. If `π(x^r ψ) = x_j^p f'` with
`f' ∈ Θ₀(g'_c)`, then the transform `ψ'` of `ψ` has order `d`, and `U ψ'` is in the definition of
`T_ρ(g'_c)`, with `U = chartUnit j t r`. -/
theorem chartUnit_mul_chartTransform_mem_logJacobianDirectrixSet (hg : g ≠ 0) (hc : IsClean p g)
    (hord : (p : ℕ∞) ≤ ord g) (h : pointChart j t g = X j ^ p * g') {d : ℕ}
    (hA : idealOrd (logJacobianTangent Δ g) = ((degree (divisorExponent Δ g) + d : ℕ) : ℕ∞))
    (hρ' : logJacobianOrder (blowupDivisor Δ j t) (cleanPart p g') = d)
    (hA' : idealOrd (logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) =
      ((degree (divisorExponent (blowupDivisor Δ j t) (cleanPart p g')) + d : ℕ) : ℕ∞))
    {ψ f' : MvPolynomial σ k} (hψo : ord ψ = d)
    (hψ : monomial (divisorExponent Δ g) 1 * ψ ∈ logJacobianTangent Δ g)
    (hπ : pointChart j t (monomial (divisorExponent Δ g) 1 * ψ) = X j ^ p * f')
    (hf' : f' ∈ logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) :
    ord (chartTransform j t d ψ) = d ∧
      chartUnit j t (divisorExponent Δ g) * chartTransform j t d ψ ∈
        logJacobianDirectrixSet (blowupDivisor Δ j t) (cleanPart p g') := by
  have hψ' := pointChart_eq_X_pow_mul_chartTransform j t hψo.ge
  have hπ' := pointChart_monomial_mul_eq (r := divisorExponent Δ g) hψ'
  have hle := logJacobianOrder_cleanPart_le_ord_of_pointChart_eq p hg hc hord h hA hψ hπ'
  rw [hρ'] at hle
  have hψ'o : ord (chartTransform j t d ψ) = d := le_antisymm (ord_le_of_pointChart hψo hψ') hle
  obtain ⟨hb, hleI, -⟩ := monomial_mul_mem_logJacobian_cleanPart p hg hord h hA hψ hπ'
  set r' := divisorExponent (blowupDivisor Δ j t) (cleanPart p g')
  set b := single j (degree (divisorExponent Δ g) + d - p) +
    chartExponent j t (divisorExponent Δ g)
  have hpτ : p ≤ degree (divisorExponent Δ g) + d := by
    have := le_idealOrd_logJacobianTangent (Δ := Δ) hord
    rw [hA] at this
    exact_mod_cast this
  have hXb : X j ^ (degree (divisorExponent Δ g) + d) *
      monomial (chartExponent j t (divisorExponent Δ g)) (1 : k) = X j ^ p * monomial b 1 := by
    rw [monomial_single_add, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hpτ]
  have hf'eq : f' = monomial b 1 *
      (chartUnit j t (divisorExponent Δ g) * chartTransform j t d ψ) := by
    refine mul_left_cancel₀ (pow_ne_zero p (X_ne_zero j (R := k))) ?_
    rw [← hπ, hπ', ← mul_assoc, hXb, mul_assoc]
  have hcl := (logJacobianOrder_cleanPart_le p (Δ := Δ) hg hc hord h).1
  have hbr : b ≤ r' := le_divisorExponent_of_logJacobian_le p hcl (isClean_cleanPart p g') hb hleI
  have hdeg : degree r' ≤ degree b := by
    have h1 := idealOrd_le_ord hf'
    rw [hA', hf'eq, ord_mul, ord_mul, ord_monomial one_ne_zero, ord_chartUnit, zero_add,
      hψ'o] at h1
    have h2 : ((degree r' + d : ℕ) : ℕ∞) ≤ ((degree b + d : ℕ) : ℕ∞) := by
      push_cast
      exact h1
    have h3 : degree r' + d ≤ degree b + d := by exact_mod_cast h2
    omega
  have hrb : r' = b := by
    obtain ⟨c, hc⟩ := exists_add_of_le hbr
    have hc0 : degree c = 0 := by
      have := congrArg degree hc
      rw [map_add] at this
      omega
    rw [hc, (Finsupp.degree_eq_zero_iff c).mp hc0, add_zero]
  refine ⟨hψ'o, ?_, ?_⟩
  · rw [ord_mul, ord_chartUnit, zero_add, hψ'o, hρ']
  · rw [logJacobianCaseIdeal_of_eq (by rw [hA', hρ', Nat.cast_add])]
    change monomial r' 1 * _ ∈ _
    rw [hrb, ← hf'eq]
    exact hf'

omit [Fintype σ] in
theorem constantCoeff_chartUnit_ne_zero (j : σ) (t : σ → k) (r : σ →₀ ℕ) :
    constantCoeff (chartUnit j t r) ≠ 0 := fun h0 => by
  have := one_le_ord_iff.mpr h0
  rw [ord_chartUnit] at this
  exact absurd this (by norm_num)

/-- **The directrix from an exact transport** (Volume 7, Section 3.9 of the handbook,
Lemma 3.9.3). With the hypotheses of
`chartUnit_mul_chartTransform_mem_logJacobianDirectrixSet`, each `w ∈ T_ρ(g'_c)` with `w_j = 0`
lies in the directrix of `ψ_d`. -/
theorem mem_directrix_of_mem_logJacobianDirectrix_cleanPart (hg : g ≠ 0) (hc : IsClean p g)
    (hord : (p : ℕ∞) ≤ ord g) (h : pointChart j t g = X j ^ p * g') {d : ℕ}
    (hA : idealOrd (logJacobianTangent Δ g) = ((degree (divisorExponent Δ g) + d : ℕ) : ℕ∞))
    (hρ' : logJacobianOrder (blowupDivisor Δ j t) (cleanPart p g') = d)
    (hA' : idealOrd (logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) =
      ((degree (divisorExponent (blowupDivisor Δ j t) (cleanPart p g')) + d : ℕ) : ℕ∞))
    {ψ f' : MvPolynomial σ k} (hψo : ord ψ = d)
    (hψ : monomial (divisorExponent Δ g) 1 * ψ ∈ logJacobianTangent Δ g)
    (hπ : pointChart j t (monomial (divisorExponent Δ g) 1 * ψ) = X j ^ p * f')
    (hf' : f' ∈ logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) {w : σ → k}
    (hw : w ∈ logJacobianDirectrix (blowupDivisor Δ j t) (cleanPart p g')) (hwj : w j = 0) :
    w ∈ directrix (homogeneousComponent d ψ) := by
  obtain ⟨h1, h2⟩ := chartUnit_mul_chartTransform_mem_logJacobianDirectrixSet p hg hc hord h hA
    hρ' hA' hψo hψ hπ hf'
  have h3 := logJacobianDirectrix_le h2 hw
  rw [hρ', ENat.toNat_natCast, directrix_homogeneousComponent_mul
    (constantCoeff_chartUnit_ne_zero j t _) h1.ge] at h3
  exact mem_directrix_of_mem_directrix_pointChart hψo.ge
    (pointChart_eq_X_pow_mul_chartTransform j t hψo.ge) h1.ge hwj h3

omit [DecidableEq k] [Fintype σ] [CharP k p] in
/-- **The exact transport of `x_i ∂_i`** (Volume 7, Section 3.9 of the handbook, Lemma 3.9.3).
For `i ≠ j` with `t_i = 0`, `π(x_i ∂_i g) = x_j^p (x_i ∂_i g')` if `π(g) = x_j^p g'`. -/
theorem pointChart_X_mul_pderiv_of_ne_of_eq_zero {i : σ} (hij : i ≠ j) (hti : t i = 0)
    (h : pointChart j t g = X j ^ p * g') :
    pointChart j t (X i * pderiv i g) = X j ^ p * (X i * pderiv i g') := by
  rw [pointChart_X_mul_pderiv_of_ne hij, hti, C_0, add_zero, h, pderiv_X_pow_mul_of_ne hij]
  ring

omit [DecidableEq k] in
/-- **The exact transport of the Euler derivation** (Volume 7, Section 3.9 of the handbook,
Lemma 3.9.3). `π(∑_m x_m ∂_m g) = x_j^p (x_j ∂_j g')` if `π(g) = x_j^p g'`: the term
`p x_j^p g'` is `0`. -/
theorem pointChart_sum_X_mul_pderiv (h : pointChart j t g = X j ^ p * g') :
    pointChart j t (∑ i, X i * pderiv i g) = X j ^ p * (X j * pderiv j g') := by
  rw [← X_mul_pderiv_pointChart, h, X_mul_pderiv_X_pow_mul p]

end Transport

/-! ### Theorem 3.9.1 -/

section Theorem

variable {σ k : Type*} [Field k] [DecidableEq σ] [DecidableEq k] [Fintype σ] (p : ℕ) [CharP k p]
  {Δ : Finset σ} {j : σ} {t : σ → k} {g g' : MvPolynomial σ k}

/-- **`τ_ρ` does not go down from case A to case A** (Volume 7, Section 3.9 of the handbook,
Theorem 3.9.1). Let `g ≠ 0` be clean with `ord g ≥ p`, let `π(g) = x_j^p g'` in the chart
`π = pointChart j t`, let `d = ord G` with `G = residualFactor Δ g`, and let
`ρ(g) = ρ(g'_c) = d` for the new divisor `Δ' = blowupDivisor Δ j t`. Let the new point be of
case A: the order of `Θ₀(g'_c)` is `|r'| + d`, with `r' = divisorExponent Δ' g'_c`. If `|r| + d`
is not `0` in `k`, then `dim T_ρ(g'_c) ≤ dim T_ρ(g)`. The old point is then of case A, since the
Euler element gives an element of order `|r| + d` in `Θ₀(g)`. -/
theorem finrank_logJacobianDirectrix_cleanPart_le_of_caseA (hg : g ≠ 0) (hc : IsClean p g)
    (hord : (p : ℕ∞) ≤ ord g) (h : pointChart j t g = X j ^ p * g') {d : ℕ}
    (hG : ord (residualFactor Δ g) = d) (hρ : logJacobianOrder Δ g = d)
    (hρ' : logJacobianOrder (blowupDivisor Δ j t) (cleanPart p g') = d)
    (hA' : idealOrd (logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) =
      ((degree (divisorExponent (blowupDivisor Δ j t) (cleanPart p g')) + d : ℕ) : ℕ∞))
    (hpd : ((degree (divisorExponent Δ g) + d : ℕ) : k) ≠ 0) :
    finrank k (logJacobianDirectrix (blowupDivisor Δ j t) (cleanPart p g')) ≤
      finrank k (logJacobianDirectrix Δ g) := by
  -- The Euler element `ψ_E`.
  have hE := monomial_mul_sum_smul_add_X_mul_pderiv_mem Δ g
  have hEo := ord_sum_smul_add_X_mul_pderiv hG hpd
  -- The old point is of case A.
  have hA : idealOrd (logJacobianTangent Δ g) = ((degree (divisorExponent Δ g) + d : ℕ) : ℕ∞) := by
    refine le_antisymm ((idealOrd_le_ord hE).trans (le_of_eq ?_)) ?_
    · rw [ord_mul, ord_monomial one_ne_zero, hEo, Nat.cast_add]
    · rw [Nat.cast_add, ← hρ, ← idealOrd_logJacobian]
      exact idealOrd_anti (logJacobianTangent_le Δ g)
  have hset : ∀ ψ ∈ logJacobianDirectrixSet Δ g,
      ord ψ = d ∧ monomial (divisorExponent Δ g) 1 * ψ ∈ logJacobianTangent Δ g := by
    intro ψ hψ
    obtain ⟨h1, h2⟩ := hψ
    rw [logJacobianCaseIdeal_of_eq (by rw [hA, hρ, Nat.cast_add])] at h2
    exact ⟨h1.trans hρ, h2⟩
  have hρ0 : idealOrd (residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g)) = d := hρ
  refine finrank_le_finrank_of_mem_of_forall_mem (j := j) (v := chartVector j t) ?_
    (by simp [chartVector]) ?_
  · refine (Submodule.mem_iInf _).mpr fun ψ => (Submodule.mem_iInf _).mpr fun hψ => ?_
    obtain ⟨ho, hm⟩ := hset ψ hψ
    rw [hρ, ENat.toNat_natCast]
    exact chartVector_mem_directrix_of_logJacobianOrder_eq p hg hc hord h hρ hρ' hm ho
  intro w hw hwj
  -- `w ∈ T(F)`, from the exact transport of the Euler element.
  have hwF : w ∈ directrix (homogeneousComponent d (residualFactor Δ g)) := by
    have hπ : pointChart j t (monomial (divisorExponent Δ g) 1 * ∑ i,
        ((divisorExponent Δ g i : k) • residualFactor Δ g +
          X i * pderiv i (residualFactor Δ g))) = X j ^ p * (X j * pderiv j g') := by
      rw [← sum_X_mul_pderiv_monomial_mul, monomial_mul_residualFactor]
      exact pointChart_sum_X_mul_pderiv p h
    have hf' : X j * pderiv j g' ∈ logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g') := by
      rw [← pderiv_cleanPart p]
      exact X_mul_pderiv_mem_logJacobianTangent (mem_blowupDivisor.mpr (Or.inl rfl)) _
    have := mem_directrix_of_mem_logJacobianDirectrix_cleanPart p hg hc hord h hA hρ' hA' hEo hE
      hπ hf' hw hwj
    rwa [homogeneousComponent_sum_smul_add_X_mul_pderiv, directrix_smul hpd] at this
  refine (Submodule.mem_iInf _).mpr fun ψ => (Submodule.mem_iInf _).mpr fun hψ => ?_
  obtain ⟨ho, hm⟩ := hset ψ hψ
  rw [hρ, ENat.toNat_natCast]
  refine le_directrix_homogeneousComponent_of_mem_span (n := d) (W := Submodule.span k {w}) ?_ ?_
    (mem_residualLogJacobianTangent hm) (Submodule.mem_span_singleton_self w)
  · rintro s (⟨i, -, rfl⟩ | ⟨⟨a, l⟩, hl, rfl⟩)
    · exact le_ord_smul_add_X_mul_pderiv hG.ge _ i
    · have h1 := idealOrd_le_ord (pderiv_mem_residualLogJacobian (Δ := Δ) hl
        (divisorExponent Δ g) (residualFactor Δ g))
      rw [hρ0] at h1
      exact le_trans (by exact_mod_cast Nat.le_succ d) (natCast_succ_le_ord_X_mul h1 a)
  rintro s (⟨i, hi, rfl⟩ | ⟨⟨a, l⟩, hl, rfl⟩)
  swap
  · have h1 := idealOrd_le_ord (pderiv_mem_residualLogJacobian (Δ := Δ) hl
      (divisorExponent Δ g) (residualFactor Δ g))
    rw [hρ0] at h1
    dsimp only
    rw [homogeneousComponent_eq_zero_of_lt_ord
      (lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self d) (natCast_succ_le_ord_X_mul h1 a)),
      directrix_zero]
    exact le_top
  dsimp only
  refine (Submodule.span_singleton_le_iff_mem _ _).mpr ?_
  by_cases hΦ : homogeneousComponent d ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) = 0
  · rw [hΦ, directrix_zero]
    exact Submodule.mem_top
  have hio : ord ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) = d :=
    le_antisymm (ord_le_of_homogeneousComponent_ne_zero hΦ) (le_ord_smul_add_X_mul_pderiv hG.ge _ i)
  have hix : monomial (divisorExponent Δ g) 1 * ((divisorExponent Δ g i : k) • residualFactor Δ g +
      X i * pderiv i (residualFactor Δ g)) ∈ logJacobianTangent Δ g := by
    rw [← X_mul_pderiv_monomial_mul, monomial_mul_residualFactor]
    exact X_mul_pderiv_mem_logJacobianTangent hi g
  by_cases hv : i ≠ j ∧ t i = 0
  · -- The exact transport of `e_i`.
    have hπ : pointChart j t (monomial (divisorExponent Δ g) 1 *
        ((divisorExponent Δ g i : k) • residualFactor Δ g +
          X i * pderiv i (residualFactor Δ g))) = X j ^ p * (X i * pderiv i g') := by
      rw [← X_mul_pderiv_monomial_mul, monomial_mul_residualFactor]
      exact pointChart_X_mul_pderiv_of_ne_of_eq_zero p hv.1 hv.2 h
    have hf' : X i * pderiv i g' ∈ logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g') := by
      rw [← pderiv_cleanPart p]
      exact X_mul_pderiv_mem_logJacobianTangent (mem_blowupDivisor.mpr (Or.inr ⟨hi, hv⟩)) _
    exact mem_directrix_of_mem_logJacobianDirectrix_cleanPart p hg hc hord h hA hρ' hA' hio hix
      hπ hf' hw hwj
  · -- `v_i ≠ 0`, so `Φ_i = r_i F` (Lemma 3.9.2).
    have hvi : chartVector j t i ≠ 0 := by
      unfold chartVector
      split_ifs with hij
      · exact one_ne_zero
      · exact fun h0 => hv ⟨hij, h0⟩
    have hvF := chartVector_mem_directrix_initialForm_of_logJacobianOrder_eq p hg hc hord h hG hρ
      hρ' hpd
    have hvΦ := chartVector_mem_directrix_of_logJacobianOrder_eq p hg hc hord h hρ hρ' hix hio
    rw [homogeneousComponent_smul_add_X_mul_pderiv] at hvΦ ⊢
    rw [pderiv_eq_zero_of_mem_directrix _ hvF hvΦ hvi, mul_zero, add_zero]
    exact directrix_le_directrix_smul _ _ hwF

/-- **`τ_ρ` does not go down from case A to case A**, the form with the codimension (Volume 7,
Section 3.9 of the handbook, Theorem 3.9.1). -/
theorem logJacobianDirectrixCodim_le_cleanPart_of_caseA (hg : g ≠ 0) (hc : IsClean p g)
    (hord : (p : ℕ∞) ≤ ord g) (h : pointChart j t g = X j ^ p * g') {d : ℕ}
    (hG : ord (residualFactor Δ g) = d) (hρ : logJacobianOrder Δ g = d)
    (hρ' : logJacobianOrder (blowupDivisor Δ j t) (cleanPart p g') = d)
    (hA' : idealOrd (logJacobianTangent (blowupDivisor Δ j t) (cleanPart p g')) =
      ((degree (divisorExponent (blowupDivisor Δ j t) (cleanPart p g')) + d : ℕ) : ℕ∞))
    (hpd : ((degree (divisorExponent Δ g) + d : ℕ) : k) ≠ 0) :
    logJacobianDirectrixCodim Δ g ≤
      logJacobianDirectrixCodim (blowupDivisor Δ j t) (cleanPart p g') := by
  have := finrank_logJacobianDirectrix_cleanPart_le_of_caseA p hg hc hord h hG hρ hρ' hA' hpd
  unfold logJacobianDirectrixCodim
  omega

end Theorem

/-! ### Example 3.9.4 -/

section Example

/-! The data of Example 3.9.4. The coordinates `(x, y, z)` are `X 0`, `X 1` and `X 2`. -/

local notation "cG" => (X 2 ^ 2 + X 0 * X 1 ^ 3 : MvPolynomial (Fin 3) (ZMod 2))
local notation "cg" => (X 0 * X 2 ^ 2 + X 0 ^ 2 * X 1 ^ 3 : MvPolynomial (Fin 3) (ZMod 2))
local notation "cg'" =>
  (X 1 * ((X 0 + 1) * X 2 ^ 2 + X 1 ^ 2 * (X 0 ^ 2 + 1)) : MvPolynomial (Fin 3) (ZMod 2))
local notation "cH" => (X 1 * X 2 ^ 2 + X 1 ^ 3 : MvPolynomial (Fin 3) (ZMod 2))
local notation "ct" => (![1, 0, 0] : Fin 3 → ZMod 2)

private theorem cex_g_eq : cg = monomial (single 0 1) 1 * cG := by
  rw [show (monomial (single 0 1) 1 : MvPolynomial (Fin 3) (ZMod 2)) = X 0 from rfl]
  ring

private theorem cex_single_mem : (single 2 2 : Fin 3 →₀ ℕ) ∈ (cG).support := by
  have hne : single 0 1 + single 1 3 ≠ (single 2 2 : Fin 3 →₀ ℕ) := by
    intro h
    have := DFunLike.congr_fun h 0
    simp at this
  have hcG : cG = monomial (single 2 2) 1 + monomial (single 0 1 + single 1 3) 1 := by
    rw [X_pow_eq_monomial, X_pow_eq_monomial,
      show (X 0 : MvPolynomial (Fin 3) (ZMod 2)) = monomial (single 0 1) 1 from rfl,
      monomial_mul_monomial, one_mul]
  rw [MvPolynomial.mem_support_iff, hcG]
  simp [coeff_monomial, hne]

private theorem cex_hr : ∀ i, i ∉ ({0} : Finset (Fin 3)) → (single 0 1 : Fin 3 →₀ ℕ) i = 0 := by
  intro i hi
  rw [Finset.mem_singleton] at hi
  simp [Ne.symm hi]

private theorem cex_hG : ∀ i ∈ ({0} : Finset (Fin 3)), ∃ d ∈ (cG).support, d i = 0 := by
  intro i hi
  rw [Finset.mem_singleton] at hi
  subst hi
  exact ⟨_, cex_single_mem, by simp⟩

private theorem cex_residualFactor : residualFactor {0} cg = cG := by
  rw [cex_g_eq]
  exact residualFactor_monomial_mul cex_hr cex_hG

private theorem cex_divisorExponent : divisorExponent {0} cg = single 0 1 := by
  have hG0 : cG ≠ 0 := ne_zero_iff.mpr ⟨_, MvPolynomial.mem_support_iff.mp cex_single_mem⟩
  have h1 : monomial (divisorExponent {0} cg) (1 : ZMod 2) * cG =
      monomial (single 0 1) 1 * cG := by
    calc _ = cg := by
          rw [← cex_residualFactor]
          exact monomial_mul_residualFactor _ _
      _ = _ := cex_g_eq
  exact monomial_left_injective one_ne_zero (mul_right_cancel₀ hG0 h1)

/-- **Example 3.9.4, the old point** (Volume 7, Section 3.9 of the handbook). Over `𝔽₂`, let
`g = x z^2 + x^2 y^3` and `E = V(x)`. Then `r = (1, 0, 0)`, `G = z^2 + x y^3`, and
`e_x = r_x G + x ∂_x G = z^2`. In the `y`-chart with `t_x = 1` and `t_z = 0`, `g` goes to `y^2 g'`
with `g' = y ((x + 1) z^2 + y^2 (x^2 + 1))`, and the new divisor is `V(y)`. -/
theorem tauRhoCaseAExample_hyp :
    divisorExponent {0} cg = single 0 1 ∧ residualFactor {0} cg = cG ∧
      ((divisorExponent {0} cg 0 : ZMod 2) • residualFactor {0} cg +
        X 0 * pderiv 0 (residualFactor {0} cg) = X 2 ^ 2) ∧
      pointChart 1 ct cg = X 1 ^ 2 * cg' ∧ blowupDivisor {0} 1 ct = {1} := by
  refine ⟨cex_divisorExponent, cex_residualFactor, ?_, ?_, ?_⟩
  · rw [cex_divisorExponent, cex_residualFactor]
    simp [pderiv_X]
    linear_combination (X 0 * X 1 ^ 3 : MvPolynomial (Fin 3) (ZMod 2)) *
      two_eq_zero_mvPolynomial_zmod (Fin 3)
  · simp [pointChart]
    linear_combination (X 0 * X 1 ^ 5 : MvPolynomial (Fin 3) (ZMod 2)) *
      two_eq_zero_mvPolynomial_zmod (Fin 3)
  · decide

private theorem cex_X_mul_pd1 : X 1 * pderiv 1 cg' = cg' := by
  conv_lhs => simp [pderiv_X]
  linear_combination (X 1 ^ 3 * (X 0 ^ 2 + 1) : MvPolynomial (Fin 3) (ZMod 2)) *
    two_eq_zero_mvPolynomial_zmod (Fin 3)

private theorem cex_pd0 : pderiv 0 cg' = X 1 * X 2 ^ 2 := by
  conv_lhs => simp [pderiv_X]
  linear_combination (X 0 * X 1 ^ 3 : MvPolynomial (Fin 3) (ZMod 2)) *
    two_eq_zero_mvPolynomial_zmod (Fin 3)

private theorem cex_pd2 : pderiv 2 cg' = 0 := by
  conv_lhs => simp [pderiv_X]
  linear_combination (X 1 * (X 0 + 1) * X 2 : MvPolynomial (Fin 3) (ZMod 2)) *
    two_eq_zero_mvPolynomial_zmod (Fin 3)

private theorem cex_H_hom : IsHomogeneous cH 3 :=
  ((isHomogeneous_X _ 1).mul (isHomogeneous_X_pow 2 2)).add (isHomogeneous_X_pow 1 3)

private theorem cex_ord_XY (i j : Fin 3) :
    ((3 : ℕ) : ℕ∞) ≤ ord (X i * X j ^ 2 : MvPolynomial (Fin 3) (ZMod 2)) := by
  rw [ord_X_mul_X_pow]

private theorem cex_g'_eq : cg' = cH + (X 0 * (X 1 * X 2 ^ 2) + X 0 ^ 2 * X 1 ^ 3) := by
  ring

private theorem cex_ord_rest :
    ((4 : ℕ) : ℕ∞) ≤ ord (X 0 * (X 1 * X 2 ^ 2) + X 0 ^ 2 * X 1 ^ 3 :
      MvPolynomial (Fin 3) (ZMod 2)) := by
  refine le_ord_add (natCast_succ_le_ord_X_mul (cex_ord_XY 1 2) 0) ?_
  rw [ord_mul, ord_X_pow, ord_X_pow]
  norm_num

private theorem cex_ord_H : ((3 : ℕ) : ℕ∞) ≤ ord cH := by
  refine le_ord_add (cex_ord_XY 1 2) ?_
  rw [ord_X_pow]

/-- The generators of `Θ₀(g')` have order at least `3`, and their parts of degree `3` are
multiples of `y z^2 + y^3`. -/
private theorem cex_gen (s : MvPolynomial (Fin 3) (ZMod 2))
    (hs : s ∈ (fun i => X i * pderiv i cg') '' (({1} : Finset (Fin 3)) : Set (Fin 3)) ∪
      (fun a : Fin 3 × Fin 3 => X a.1 * pderiv a.2 cg') '' {a | a.2 ∉ ({1} : Finset (Fin 3))}) :
    ((3 : ℕ) : ℕ∞) ≤ ord s ∧
      homogeneousComponent 3 s ∈ Submodule.span (ZMod 2) {cH} := by
  rcases hs with ⟨i, hi, rfl⟩ | ⟨⟨a, l⟩, hl, rfl⟩
  · obtain rfl : i = 1 := by simpa using hi
    dsimp only
    rw [cex_X_mul_pd1, cex_g'_eq, map_add, homogeneousComponent_eq_self cex_H_hom,
      homogeneousComponent_eq_zero_of_lt_ord (lt_of_lt_of_le (by norm_num) cex_ord_rest),
      add_zero]
    exact ⟨le_ord_add cex_ord_H (le_trans (by norm_num) cex_ord_rest),
      Submodule.mem_span_singleton_self _⟩
  · have hl' : l ≠ 1 := by simpa using hl
    dsimp only
    obtain rfl | rfl : l = 0 ∨ l = 2 := by
      revert hl'
      fin_cases l <;> decide
    · rw [cex_pd0]
      have h4 := natCast_succ_le_ord_X_mul (cex_ord_XY 1 2) a
      refine ⟨le_trans (by norm_num) h4, ?_⟩
      rw [homogeneousComponent_eq_zero_of_lt_ord (lt_of_lt_of_le (by norm_num) h4)]
      exact zero_mem _
    · rw [cex_pd2, mul_zero, ord_zero, map_zero]
      exact ⟨le_top, zero_mem _⟩

/-- Each element of `Θ₀(g')` has a part of degree `3` that vanishes at `(0, 1, 1)`. -/
private theorem cex_eval {f : MvPolynomial (Fin 3) (ZMod 2)}
    (hf : f ∈ logJacobianTangent {1} cg') :
    eval ![0, 1, 1] (homogeneousComponent 3 f) = 0 := by
  obtain ⟨c, hc⟩ :=
    Submodule.mem_span_singleton.mp (homogeneousComponent_mem_of_mem_span cex_gen hf)
  rw [← hc]
  simp [smul_eq_C_mul]
  exact CharTwo.add_self_eq_zero c

private theorem cex_g'_monomials : cg' =
    monomial (single 0 1 + single 1 1 + single 2 2) 1 + monomial (single 1 1 + single 2 2) 1 +
      monomial (single 0 2 + single 1 3) 1 + monomial (single 1 3) 1 := by
  have hm (a b : Fin 3 →₀ ℕ) : monomial (a + b) (1 : ZMod 2) = monomial a 1 * monomial b 1 := by
    rw [monomial_mul_monomial, mul_one]
  simp only [hm, ← X_pow_eq_monomial]
  ring

private theorem cex_isClean : IsClean 2 cg' := by
  intro d hd h
  rw [cex_g'_monomials] at hd
  have h1 := h 1
  rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with hd | hd
  · rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with hd | hd
    · rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with hd | hd
      · rw [Finset.mem_singleton.mp (support_monomial_subset hd)] at h1
        simp at h1
      · rw [Finset.mem_singleton.mp (support_monomial_subset hd)] at h1
        simp at h1
    · rw [Finset.mem_singleton.mp (support_monomial_subset hd)] at h1
      simp at h1
  · rw [Finset.mem_singleton.mp (support_monomial_subset hd)] at h1
    simp at h1

private theorem cex_cleanPart : cleanPart 2 cg' = cg' := cleanPart_eq_self cex_isClean

/-- **Example 3.9.4: the plain transports of `e_x` are not in the new ideal** (Volume 7,
Section 3.9 of the handbook). Over `𝔽₂`, let `g = x z^2 + x^2 y^3` and `E = V(x)`, and let
`g' = y ((x + 1) z^2 + y^2 (x^2 + 1))` be its transform in the `y`-chart with `t_x = 1` and
`t_z = 0`. Then `g'` is clean and `E' = V(y)`. The element `x e_x = x z^2` goes to
`y^3 (x + 1) z^2`. Thus the plain transport of `e_x` is `z^2`, or `(x + 1) z^2` with the unit `x + 1` of the chart.
Neither `y z^2` nor `y (x + 1) z^2` is in `Θ₀(g'_c)`. The proof: the part of degree `3` of each
element of `Θ₀(g'_c)` is a multiple of `y z^2 + y^3`. -/
theorem tauRhoCaseAExample_not_mem :
    IsClean 2 cg' ∧
      X 1 * X 2 ^ 2 ∉ logJacobianTangent (blowupDivisor {0} 1 ct) (cleanPart 2 cg') ∧
      X 1 * ((X 0 + 1) * X 2 ^ 2) ∉
        logJacobianTangent (blowupDivisor {0} 1 ct) (cleanPart 2 cg') := by
  have hΔ : blowupDivisor {0} 1 ct = {1} := by decide
  rw [hΔ, cex_cleanPart]
  have hhom : IsHomogeneous (X 1 * X 2 ^ 2 : MvPolynomial (Fin 3) (ZMod 2)) 3 :=
    (isHomogeneous_X _ 1).mul (isHomogeneous_X_pow 2 2)
  refine ⟨cex_isClean, fun h => ?_, fun h => ?_⟩
  · have := cex_eval h
    rw [homogeneousComponent_eq_self hhom] at this
    simp at this
  · have := cex_eval h
    rw [show (X 1 * ((X 0 + 1) * X 2 ^ 2) : MvPolynomial (Fin 3) (ZMod 2)) =
        X 1 * X 2 ^ 2 + X 0 * (X 1 * X 2 ^ 2) by ring, map_add,
      homogeneousComponent_eq_self hhom, homogeneousComponent_eq_zero_of_lt_ord
        (lt_of_lt_of_le (by norm_num) (natCast_succ_le_ord_X_mul (cex_ord_XY 1 2) 0)),
      add_zero] at this
    simp at this

end Example

end Singularity
