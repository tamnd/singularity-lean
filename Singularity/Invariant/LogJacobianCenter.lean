import Singularity.Invariant.LogJacobianBlowup

/-!
# The log-Jacobian ideal under the blowup of a coordinate center

Let `k` be a commutative ring of characteristic `p`, let `g` be a polynomial in `k[x_i : i ∈ σ]`,
and let `Δ` give the divisor `E = V(∏_{i ∈ Δ} x_i)`. Let `S` give the coordinate center
`C = V(x_i : i ∈ S)`. Look at the `x_j`-chart of the blowup of `C`, for `j ∈ S`, with translations
`t`: `π(x_j) = x_j`, `π(x_i) = x_j (x_i + t_i)` for `i ∈ S`, `i ≠ j`, and `π(x_i) = x_i` for
`i ∉ S` (`centerChart S j t`). For `S` the set of all the variables, this is the chart of the point
blowup (`centerChart_univ`). The new divisor `Δ'` is `{j}` together with the `i ∈ Δ`, `i ≠ j`, with
`i ∉ S` or `t_i = 0` (`centerDivisor Δ S j t`). This file proves the transformation law of the
log-Jacobian ideal for this blowup (Volume 7, Section 3.4 of the handbook).

The derivations that are tangent to `E` and that map the ideal `I_C = (x_i : i ∈ S)` into `I_C`
give the ideal

  `Θ_C(g) = (x_i ∂_i g (i ∈ Δ), ∂_l g (l ∉ Δ, l ∉ S), x_m ∂_l g (l ∉ Δ, l ∈ S, m ∈ S))`.

Then `I_C Θ(g) ⊆ Θ_C(g) ⊆ Θ(g)`. The chain rule gives `∂_i π(h) = π(∂_i h)` for `i ∉ S`,
`∂_i π(h) = x_j π(∂_i h)` for `i ∈ S`, `i ≠ j`, and `x_j ∂_j π(h) = π(∑_{i ∈ S} x_i ∂_i h)`. The
proof of the law compares the generators of `π(Θ_C(g))` and of `Θ'(π(g))`, the log-Jacobian ideal
of `π(g)` for `Δ'`, as for the point blowup. In `k[x]` the unit `u = ∏ (x_i + t_i)` over the
`i ∈ Δ ∩ S`, `i ≠ j`, with `t_i ≠ 0` must be kept, so the law has two inclusions:

  `π(Θ_C(g)) ⊆ Θ'(π(g))` and `u Θ'(π(g)) ⊆ π(Θ_C(g))`.

If `π(g) = x_j^p g'`, then `Θ'(π(g)) = (x_j^p) Θ'(g')` in characteristic `p`, and the law takes the
form `Θ'(g') = x_j^(-p) π(Θ_C(g))`.

The file also proves the lemma on the equimultiple weak transform. Let `k` be a field, let
`f ∈ I_C^s` with `ord f = s`, and let `π(f) = x_j^s f'`. Then `ord f' ≤ s`. The proof: let `κ` be
the substitution `x_i ↦ 0` for `i ∉ S`. The monomials of degree `s` of `f` are in the variables
of `S`, so `κ` keeps them, and `ord κ(f) = s`. Also `κ ∘ π = π₀ ∘ κ`, with `π₀` the chart of the
point blowup with the translations `t_i` for `i ∈ S` and `0` for `i ∉ S`. So `π₀(κ(f)) = x_j^s κ(f')`,
and the result for the point blowup (`ord_le_of_pointChart`) gives `ord κ(f') ≤ s`. The
substitution `κ` does not lower the order, so `ord f' ≤ ord κ(f') ≤ s`.

## Main definitions

* `Singularity.centerChart S j t`: the `x_j`-chart of the blowup of `C = V(x_i : i ∈ S)`.
* `Singularity.logJacobianCenter Δ S g`: the ideal `Θ_C(g)`.
* `Singularity.centerDivisor Δ S j t`: the new divisor `Δ'`.
* `Singularity.centerUnit Δ S j t`: the product `u` of the `x_i + t_i` over the `i ∈ Δ ∩ S`,
  `i ≠ j`, with `t_i ≠ 0`.

## Main results

* `centerChart_univ`, `logJacobianCenter_univ`, `centerDivisor_univ`, `centerUnit_univ`: for
  `S` the set of all the variables, the definitions of the point blowup.
* `logJacobianCenter_le`, `span_X_mul_logJacobian_le`: `I_C Θ(g) ⊆ Θ_C(g) ⊆ Θ(g)`.
* `pderiv_centerChart_of_notMem`, `pderiv_centerChart_of_mem`, `X_mul_pderiv_centerChart`: the
  chain rules.
* `map_centerChart_logJacobianCenter_le`, `span_mul_logJacobian_centerChart_le`: the two
  inclusions for `Θ'(π(g))`.
* `map_centerChart_logJacobianCenter_le_span_mul`, `span_mul_logJacobian_le_map_centerChart`:
  the transformation law for `π(g) = x_j^p g'`: `π(Θ_C(g)) ⊆ (x_j^p) Θ'(g')` and
  `(x_j^p u) Θ'(g') ⊆ π(Θ_C(g))`.
* `exists_centerChart_eq_X_pow_mul`, `ord_le_of_centerChart`: the lemma on the equimultiple weak
  transform. If `f ∈ I_C^s`, then `π(f) = x_j^s f'`, and if also `ord f = s`, then `ord f' ≤ s`.

## References

* [Cos87] V. Cossart, *Polyèdre caractéristique d'une singularité*, thèse d'État, Orsay 1987.
* [Pos24] Q. Posva, arXiv:2405.05735, Appendix A.
* Volume 7, Section 3.4 of the handbook.
-/

open MvPolynomial

namespace Singularity

section Defs

variable {σ k : Type*} [CommSemiring k]

/-- The `x_j`-chart of the blowup of the coordinate center `C = V(x_i : i ∈ S)` with translations
`t`: `x_j ↦ x_j`, `x_i ↦ x_j (x_i + t_i)` for `i ∈ S`, `i ≠ j`, and `x_i ↦ x_i` for `i ∉ S`
(Volume 7, Section 3.4 of the handbook). The results use `j ∈ S`. -/
noncomputable def centerChart [DecidableEq σ] (S : Finset σ) (j : σ) (t : σ → k) :
    MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i => if i = j then X j else if i ∈ S then X j * (X i + C (t i)) else X i

/-- The log-Jacobian ideal tangent to the center `Θ_C(g)`: the ideal generated by `x_i ∂_i g` for
`i ∈ Δ`, by `∂_l g` for `l ∉ Δ`, `l ∉ S`, and by `x_m ∂_l g` for `l ∉ Δ`, `l ∈ S` and `m ∈ S`.
These are the derivatives of `g` along the derivations that are tangent to the divisor and that
map the ideal `(x_i : i ∈ S)` of the center into itself (Volume 7, Section 3.4 of the
handbook). -/
noncomputable def logJacobianCenter (Δ S : Finset σ) (g : MvPolynomial σ k) :
    Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun i => X i * pderiv i g) '' (Δ : Set σ) ∪
    (fun l => pderiv l g) '' {l | l ∉ Δ ∧ l ∉ S} ∪
    (fun a : σ × σ => X a.1 * pderiv a.2 g) '' {a | a.2 ∉ Δ ∧ a.2 ∈ S ∧ a.1 ∈ S})

/-- The transform of the divisor `E = V(∏_{i ∈ Δ} x_i)` under the `x_j`-chart of the blowup of
`C = V(x_i : i ∈ S)` with translations `t`: `{j}` together with the `i ∈ Δ`, `i ≠ j`, with
`i ∉ S` or `t_i = 0`. -/
noncomputable def centerDivisor [DecidableEq σ] [DecidableEq k] (Δ S : Finset σ) (j : σ)
    (t : σ → k) : Finset σ :=
  insert j (Δ.filter fun i => i ≠ j ∧ (i ∉ S ∨ t i = 0))

/-- The unit `u` of the transformation law for the center: the product of `x_i + t_i` over the
`i ∈ Δ` with `i ≠ j`, `i ∈ S` and `t_i ≠ 0`. These are the components of the divisor that do not
pass through the origin of the chart. The polynomial `u` is a unit in the power series ring, but
not in `k[x]`. -/
noncomputable def centerUnit [DecidableEq σ] [DecidableEq k] (Δ S : Finset σ) (j : σ)
    (t : σ → k) : MvPolynomial σ k :=
  ∏ i ∈ Δ.filter (fun i => i ≠ j ∧ i ∈ S ∧ t i ≠ 0), (X i + C (t i))

theorem X_mul_pderiv_mem_logJacobianCenter {Δ : Finset σ} (S : Finset σ) {i : σ} (hi : i ∈ Δ)
    (g : MvPolynomial σ k) : X i * pderiv i g ∈ logJacobianCenter Δ S g :=
  Ideal.subset_span (Or.inl (Or.inl ⟨i, hi, rfl⟩))

theorem pderiv_mem_logJacobianCenter {Δ S : Finset σ} {l : σ} (hlΔ : l ∉ Δ) (hlS : l ∉ S)
    (g : MvPolynomial σ k) : pderiv l g ∈ logJacobianCenter Δ S g :=
  Ideal.subset_span (Or.inl (Or.inr ⟨l, ⟨hlΔ, hlS⟩, rfl⟩))

theorem X_mul_pderiv_mem_logJacobianCenter_of_mem {Δ S : Finset σ} {l m : σ} (hlΔ : l ∉ Δ)
    (hlS : l ∈ S) (hm : m ∈ S) (g : MvPolynomial σ k) :
    X m * pderiv l g ∈ logJacobianCenter Δ S g :=
  Ideal.subset_span (Or.inr ⟨(m, l), ⟨hlΔ, hlS, hm⟩, rfl⟩)

/-- Each `x_m ∂_m g` with `m ∈ S` is in `Θ_C(g)`, for `m ∈ Δ` and for `m ∉ Δ`. -/
theorem X_mul_pderiv_mem_logJacobianCenter' (Δ : Finset σ) {S : Finset σ} {m : σ} (hm : m ∈ S)
    (g : MvPolynomial σ k) : X m * pderiv m g ∈ logJacobianCenter Δ S g := by
  by_cases hmΔ : m ∈ Δ
  · exact X_mul_pderiv_mem_logJacobianCenter S hmΔ g
  · exact X_mul_pderiv_mem_logJacobianCenter_of_mem hmΔ hm hm g

/-- `Θ_C(g) ⊆ Θ(g)`. -/
theorem logJacobianCenter_le (Δ S : Finset σ) (g : MvPolynomial σ k) :
    logJacobianCenter Δ S g ≤ logJacobian Δ g := by
  refine Ideal.span_le.mpr ?_
  rintro s ((⟨i, hi, rfl⟩ | ⟨l, ⟨hl, -⟩, rfl⟩) | ⟨⟨m, l⟩, ⟨hl, -, -⟩, rfl⟩)
  · exact X_mul_pderiv_mem_logJacobian hi g
  · exact pderiv_mem_logJacobian hl g
  · exact Ideal.mul_mem_left _ _ (pderiv_mem_logJacobian hl g)

/-- `I_C Θ(g) ⊆ Θ_C(g)`, with `I_C = (x_i : i ∈ S)` the ideal of the center. -/
theorem span_X_mul_logJacobian_le (Δ S : Finset σ) (g : MvPolynomial σ k) :
    Ideal.span (X '' (S : Set σ)) * logJacobian Δ g ≤ logJacobianCenter Δ S g := by
  rw [logJacobian, Ideal.span_mul_span, Ideal.span_le]
  rintro _ ⟨_, ⟨m, hm, rfl⟩, s, (⟨i, hi, rfl⟩ | ⟨l, hl, rfl⟩), rfl⟩
  · exact Ideal.mul_mem_left _ _ (X_mul_pderiv_mem_logJacobianCenter S hi g)
  · by_cases hlS : l ∈ S
    · exact X_mul_pderiv_mem_logJacobianCenter_of_mem hl hlS hm g
    · exact Ideal.mul_mem_left _ _ (pderiv_mem_logJacobianCenter hl hlS g)

/-- For the center `V(x_i : i ∈ σ)`, the origin, `Θ_C(g)` is the ideal `Θ₀(g)`. -/
theorem logJacobianCenter_univ [Fintype σ] (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobianCenter Δ Finset.univ g = logJacobianTangent Δ g := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro s ((⟨i, hi, rfl⟩ | ⟨l, ⟨-, hl⟩, rfl⟩) | ⟨⟨m, l⟩, ⟨hl, -, -⟩, rfl⟩)
    · exact X_mul_pderiv_mem_logJacobianTangent hi g
    · exact absurd (Finset.mem_univ l) hl
    · exact X_mul_pderiv_mem_logJacobianTangent_of_notMem hl m g
  · rintro s (⟨i, hi, rfl⟩ | ⟨⟨m, l⟩, hl, rfl⟩)
    · exact X_mul_pderiv_mem_logJacobianCenter _ hi g
    · exact X_mul_pderiv_mem_logJacobianCenter_of_mem hl (Finset.mem_univ l) (Finset.mem_univ m) g

variable [DecidableEq σ]

theorem centerChart_X_self (S : Finset σ) (j : σ) (t : σ → k) :
    centerChart S j t (X j) = X j := by
  simp [centerChart]

theorem centerChart_X_of_mem {S : Finset σ} {i j : σ} (t : σ → k) (hi : i ∈ S) (hij : i ≠ j) :
    centerChart S j t (X i) = X j * (X i + C (t i)) := by
  simp [centerChart, hi, hij]

theorem centerChart_X_of_notMem {S : Finset σ} {i j : σ} (t : σ → k) (hi : i ∉ S) (hij : i ≠ j) :
    centerChart S j t (X i) = X i := by
  simp [centerChart, hi, hij]

/-- For `S` the set of all the variables, the chart of the blowup of the center is the chart of
the point blowup. -/
theorem centerChart_univ [Fintype σ] (j : σ) (t : σ → k) :
    centerChart Finset.univ j t = pointChart j t := by
  refine algHom_ext fun i => ?_
  simp [centerChart, pointChart]

/-- For `m ∈ S`, the chart sends `x_m` to `x_j` times a polynomial. -/
theorem exists_centerChart_X_eq_X_mul {S : Finset σ} (j : σ) (t : σ → k) {m : σ} (hm : m ∈ S) :
    ∃ c, centerChart S j t (X m) = X j * c := by
  by_cases hmj : m = j
  · subst hmj
    exact ⟨1, by rw [centerChart_X_self, mul_one]⟩
  · exact ⟨_, centerChart_X_of_mem t hm hmj⟩

variable [DecidableEq k]

theorem mem_centerDivisor {Δ S : Finset σ} {j : σ} {t : σ → k} {i : σ} :
    i ∈ centerDivisor Δ S j t ↔ i = j ∨ (i ∈ Δ ∧ i ≠ j ∧ (i ∉ S ∨ t i = 0)) := by
  simp [centerDivisor, Finset.mem_insert, Finset.mem_filter]

theorem centerDivisor_univ [Fintype σ] (Δ : Finset σ) (j : σ) (t : σ → k) :
    centerDivisor Δ Finset.univ j t = blowupDivisor Δ j t := by
  simp [centerDivisor, blowupDivisor]

theorem centerUnit_univ [Fintype σ] (Δ : Finset σ) (j : σ) (t : σ → k) :
    centerUnit Δ Finset.univ j t = blowupUnit Δ j t := by
  simp [centerUnit, blowupUnit]

end Defs

/-! ### The chain rules -/

section Chain

variable {σ k : Type*} [CommSemiring k] [DecidableEq σ]

/-- **Chain rule** for the center: for `i ∉ S`, `∂_i π(h) = π(∂_i h)`. The chart fixes `x_i`, and
`x_i` does not occur in the images of the other variables. -/
theorem pderiv_centerChart_of_notMem {S : Finset σ} {i j : σ} (hj : j ∈ S) (hi : i ∉ S)
    (t : σ → k) (h : MvPolynomial σ k) :
    pderiv i (centerChart S j t h) = centerChart S j t (pderiv i h) := by
  have hij : i ≠ j := by
    rintro rfl
    exact hi hj
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P l hP =>
    have hl : pderiv i (centerChart S j t (X l)) = centerChart S j t (pderiv i (X l)) := by
      by_cases hlj : l = j
      · subst hlj
        rw [centerChart_X_self, pderiv_X_of_ne (Ne.symm hij), map_zero]
      · by_cases hlS : l ∈ S
        · have hli : l ≠ i := by
            rintro rfl
            exact hi hlS
          rw [centerChart_X_of_mem t hlS hlj, pderiv_mul, pderiv_X_of_ne (Ne.symm hij), zero_mul,
            zero_add, map_add, pderiv_C, add_zero, pderiv_X_of_ne hli, mul_zero, map_zero]
        · rw [centerChart_X_of_notMem t hlS hlj]
          by_cases hli : l = i
          · subst hli
            rw [pderiv_X_self, map_one]
          · rw [pderiv_X_of_ne hli, map_zero]
    rw [map_mul, pderiv_mul, pderiv_mul, hP, hl, map_add, map_mul, map_mul]

/-- **Chain rule** for the center: for `i ∈ S`, `i ≠ j`, `∂_i π(h) = x_j π(∂_i h)`. -/
theorem pderiv_centerChart_of_mem {S : Finset σ} {i j : σ} (hi : i ∈ S) (hij : i ≠ j)
    (t : σ → k) (h : MvPolynomial σ k) :
    pderiv i (centerChart S j t h) = X j * centerChart S j t (pderiv i h) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ, mul_add]
  | mul_X P l hP =>
    have hl : pderiv i (centerChart S j t (X l)) = X j * centerChart S j t (pderiv i (X l)) := by
      by_cases hlj : l = j
      · subst hlj
        rw [centerChart_X_self, pderiv_X_of_ne (Ne.symm hij), map_zero, mul_zero]
      · by_cases hlS : l ∈ S
        · rw [centerChart_X_of_mem t hlS hlj, pderiv_mul, pderiv_X_of_ne (Ne.symm hij), zero_mul,
            zero_add, map_add, pderiv_C, add_zero, pderiv_X]
          by_cases hli : l = i
          · subst hli
            simp
          · simp [hli]
        · have hli : l ≠ i := by
            rintro rfl
            exact hlS hi
          rw [centerChart_X_of_notMem t hlS hlj, pderiv_X_of_ne hli, map_zero, mul_zero]
    rw [map_mul, pderiv_mul, pderiv_mul, hP, hl, map_add, map_mul, map_mul]
    ring

omit [DecidableEq σ] in
/-- `∑_{i ∈ S} x_i ∂_i (x_l) = x_l` for `l ∈ S`. -/
theorem sum_X_mul_pderiv_X_of_mem (S : Finset σ) {l : σ} (hl : l ∈ S) :
    ∑ i ∈ S, X i * pderiv i (X l : MvPolynomial σ k) = X l := by
  rw [Finset.sum_eq_single l (fun i _ hi => by rw [pderiv_X_of_ne (Ne.symm hi), mul_zero])
    (fun h => absurd hl h), pderiv_X_self, mul_one]

omit [DecidableEq σ] in
/-- `∑_{i ∈ S} x_i ∂_i (x_l) = 0` for `l ∉ S`. -/
theorem sum_X_mul_pderiv_X_of_notMem (S : Finset σ) {l : σ} (hl : l ∉ S) :
    ∑ i ∈ S, X i * pderiv i (X l : MvPolynomial σ k) = 0 :=
  Finset.sum_eq_zero fun i hi => by
    rw [pderiv_X_of_ne (by rintro rfl; exact hl hi), mul_zero]

/-- **Chain rule** for the center: `x_j ∂_j π(h) = π(∑_{i ∈ S} x_i ∂_i h)` for `j ∈ S`. -/
theorem X_mul_pderiv_centerChart {S : Finset σ} {j : σ} (hj : j ∈ S) (t : σ → k)
    (h : MvPolynomial σ k) :
    X j * pderiv j (centerChart S j t h) = centerChart S j t (∑ i ∈ S, X i * pderiv i h) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ =>
    simp only [map_add, mul_add, Finset.sum_add_distrib]
    rw [hP, hQ]
  | mul_X P l hP =>
    have hl : X j * pderiv j (centerChart S j t (X l)) =
        centerChart S j t (∑ i ∈ S, X i * pderiv i (X l)) := by
      by_cases hlS : l ∈ S
      · rw [sum_X_mul_pderiv_X_of_mem S hlS]
        by_cases hlj : l = j
        · subst hlj
          rw [centerChart_X_self, pderiv_X_self, mul_one]
        · rw [centerChart_X_of_mem t hlS hlj, pderiv_mul, pderiv_X_self, map_add, pderiv_C,
            add_zero, pderiv_X_of_ne hlj, mul_zero, add_zero, one_mul]
      · have hlj : l ≠ j := by
          rintro rfl
          exact hlS hj
        rw [sum_X_mul_pderiv_X_of_notMem S hlS, map_zero, centerChart_X_of_notMem t hlS hlj,
          pderiv_X_of_ne hlj, mul_zero]
    have hs : ∑ i ∈ S, X i * pderiv i (P * X l) =
        (∑ i ∈ S, X i * pderiv i P) * X l + P * ∑ i ∈ S, X i * pderiv i (X l) := by
      rw [Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [pderiv_mul]; ring
    rw [hs, map_add, map_mul (centerChart S j t) (∑ i ∈ S, X i * pderiv i P),
      map_mul (centerChart S j t) P (∑ i ∈ S, X i * pderiv i (X l)), ← hP, ← hl,
      map_mul (centerChart S j t) P (X l), pderiv_mul]
    ring

end Chain

/-! ### The transformation law -/

section Law

variable {σ k : Type*} [CommRing k] [DecidableEq σ] [DecidableEq k]

omit [DecidableEq k] in
/-- For `m ∈ S`, `m ≠ j`, `π(x_m ∂_m g) = (x_m + t_m) ∂_m π(g)`. -/
theorem centerChart_X_mul_pderiv_of_mem {S : Finset σ} {m j : σ} (hm : m ∈ S) (hmj : m ≠ j)
    (t : σ → k) (g : MvPolynomial σ k) :
    centerChart S j t (X m * pderiv m g) = (X m + C (t m)) * pderiv m (centerChart S j t g) := by
  rw [map_mul, centerChart_X_of_mem t hm hmj, pderiv_centerChart_of_mem hm hmj]
  ring

omit [DecidableEq k] in
/-- For `m ∉ S`, `π(x_m ∂_m g) = x_m ∂_m π(g)`. -/
theorem centerChart_X_mul_pderiv_of_notMem {S : Finset σ} {m j : σ} (hj : j ∈ S) (hm : m ∉ S)
    (t : σ → k) (g : MvPolynomial σ k) :
    centerChart S j t (X m * pderiv m g) = X m * pderiv m (centerChart S j t g) := by
  have hmj : m ≠ j := by
    rintro rfl
    exact hm hj
  rw [map_mul, centerChart_X_of_notMem t hm hmj, pderiv_centerChart_of_notMem hj hm]

omit [DecidableEq k] in
/-- `x_j ∂_j π(g) = ∑_{m ∈ S} π(x_m ∂_m g)`. -/
theorem X_mul_pderiv_centerChart_eq_sum {S : Finset σ} {j : σ} (hj : j ∈ S) (t : σ → k)
    (g : MvPolynomial σ k) :
    X j * pderiv j (centerChart S j t g) = ∑ m ∈ S, centerChart S j t (X m * pderiv m g) := by
  rw [X_mul_pderiv_centerChart hj, map_sum]

/-- Each `π(x_m ∂_m g)` with `m ∈ S` is in `Θ'(π(g))`. -/
theorem centerChart_X_mul_pderiv_mem (Δ : Finset σ) {S : Finset σ} {j : σ} (hj : j ∈ S)
    (t : σ → k) (g : MvPolynomial σ k) {m : σ} (hm : m ∈ S) :
    centerChart S j t (X m * pderiv m g) ∈
      logJacobian (centerDivisor Δ S j t) (centerChart S j t g) := by
  have hne : ∀ m ∈ S, m ≠ j → centerChart S j t (X m * pderiv m g) ∈
      logJacobian (centerDivisor Δ S j t) (centerChart S j t g) := by
    intro m hm hmj
    rw [centerChart_X_mul_pderiv_of_mem hm hmj]
    by_cases hm' : m ∈ centerDivisor Δ S j t
    · have htm : t m = 0 := by
        rcases mem_centerDivisor.mp hm' with h | ⟨-, -, h | h⟩
        · exact absurd h hmj
        · exact absurd hm h
        · exact h
      rw [htm, C_0, add_zero]
      exact X_mul_pderiv_mem_logJacobian hm' _
    · exact Ideal.mul_mem_left _ _ (pderiv_mem_logJacobian hm' _)
  by_cases hmj : m = j
  · subst hmj
    have hj' : m ∈ centerDivisor Δ S m t := mem_centerDivisor.mpr (Or.inl rfl)
    have hsum := X_mul_pderiv_centerChart_eq_sum hj t g
    rw [← Finset.add_sum_erase _ _ hm] at hsum
    rw [← add_sub_cancel_right (centerChart S m t (X m * pderiv m g))
      (∑ l ∈ S.erase m, centerChart S m t (X l * pderiv l g)), ← hsum]
    refine Ideal.sub_mem _ (X_mul_pderiv_mem_logJacobian hj' _) (Ideal.sum_mem _ fun l hl => ?_)
    exact hne l (Finset.mem_of_mem_erase hl) (Finset.ne_of_mem_erase hl)
  · exact hne m hm hmj

/-- For `l ∉ Δ`, `l ∈ S`, `x_j π(∂_l g)` is in `Θ'(π(g))`. -/
theorem X_mul_centerChart_pderiv_mem {Δ S : Finset σ} {l : σ} (hlΔ : l ∉ Δ) (hlS : l ∈ S)
    {j : σ} (hj : j ∈ S) (t : σ → k) (g : MvPolynomial σ k) :
    X j * centerChart S j t (pderiv l g) ∈
      logJacobian (centerDivisor Δ S j t) (centerChart S j t g) := by
  by_cases hlj : l = j
  · subst hlj
    have := centerChart_X_mul_pderiv_mem Δ hj t g hlS
    rwa [map_mul, centerChart_X_self] at this
  · have hl' : l ∉ centerDivisor Δ S j t := by
      rw [mem_centerDivisor]
      rintro (h | ⟨h, -, -⟩)
      · exact hlj h
      · exact hlΔ h
    rw [← pderiv_centerChart_of_mem hlS hlj]
    exact pderiv_mem_logJacobian hl' _

/-- **The transformation law for the center, first inclusion** (Volume 7, Section 3.4 of the
handbook): `π(Θ_C(g)) ⊆ Θ'(π(g))`, with `Θ'` the log-Jacobian ideal for the new divisor
`Δ' = centerDivisor Δ S j t`. -/
theorem map_centerChart_logJacobianCenter_le (Δ S : Finset σ) {j : σ} (hj : j ∈ S) (t : σ → k)
    (g : MvPolynomial σ k) :
    Ideal.map (centerChart S j t) (logJacobianCenter Δ S g) ≤
      logJacobian (centerDivisor Δ S j t) (centerChart S j t g) := by
  rw [logJacobianCenter, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨s, ((⟨i, hi, rfl⟩ | ⟨l, ⟨hlΔ, hlS⟩, rfl⟩) | ⟨⟨m, l⟩, ⟨hlΔ, hlS, hm⟩, rfl⟩), rfl⟩
  · by_cases hiS : i ∈ S
    · exact centerChart_X_mul_pderiv_mem Δ hj t g hiS
    · have hij : i ≠ j := by
        rintro rfl
        exact hiS hj
      have hi' : i ∈ centerDivisor Δ S j t :=
        mem_centerDivisor.mpr (Or.inr ⟨hi, hij, Or.inl hiS⟩)
      show centerChart S j t (X i * pderiv i g) ∈ _
      rw [centerChart_X_mul_pderiv_of_notMem hj hiS]
      exact X_mul_pderiv_mem_logJacobian hi' _
  · have hlj : l ≠ j := by
      rintro rfl
      exact hlS hj
    have hl' : l ∉ centerDivisor Δ S j t := by
      rw [mem_centerDivisor]
      rintro (h | ⟨h, -, -⟩)
      · exact hlj h
      · exact hlΔ h
    show centerChart S j t (pderiv l g) ∈ _
    rw [← pderiv_centerChart_of_notMem hj hlS]
    exact pderiv_mem_logJacobian hl' _
  · obtain ⟨c, hc⟩ := exists_centerChart_X_eq_X_mul j t hm
    show centerChart S j t (X m * pderiv l g) ∈ _
    rw [map_mul, hc, mul_assoc, mul_left_comm]
    exact Ideal.mul_mem_left _ _ (X_mul_centerChart_pderiv_mem hlΔ hlS hj t g)

/-- **The transformation law for the center, second inclusion** (Volume 7, Section 3.4 of the
handbook): `u Θ'(π(g)) ⊆ π(Θ_C(g))`, with `u = centerUnit Δ S j t`. -/
theorem span_mul_logJacobian_centerChart_le (Δ S : Finset σ) {j : σ} (hj : j ∈ S) (t : σ → k)
    (g : MvPolynomial σ k) :
    Ideal.span {centerUnit Δ S j t} * logJacobian (centerDivisor Δ S j t) (centerChart S j t g) ≤
      Ideal.map (centerChart S j t) (logJacobianCenter Δ S g) := by
  set M := Ideal.map (centerChart S j t) (logJacobianCenter Δ S g)
  have hM : ∀ x ∈ logJacobianCenter Δ S g, centerChart S j t x ∈ M :=
    fun x hx => Ideal.mem_map_of_mem _ hx
  rw [logJacobian, Ideal.span_singleton_mul_le_iff]
  intro z hz
  refine Submodule.span_induction (p := fun z _ => centerUnit Δ S j t * z ∈ M) ?_ ?_ ?_ ?_ hz
  · rintro s (⟨i, hi, rfl⟩ | ⟨l, hl, rfl⟩)
    · dsimp only
      refine Ideal.mul_mem_left _ _ ?_
      rcases mem_centerDivisor.mp hi with rfl | ⟨hiΔ, hij, hiS | hti⟩
      · rw [X_mul_pderiv_centerChart_eq_sum hj]
        exact Ideal.sum_mem _ fun m hm => hM _ (X_mul_pderiv_mem_logJacobianCenter' Δ hm g)
      · rw [← centerChart_X_mul_pderiv_of_notMem hj hiS]
        exact hM _ (X_mul_pderiv_mem_logJacobianCenter S hiΔ g)
      · by_cases hiS : i ∈ S
        · have := centerChart_X_mul_pderiv_of_mem hiS hij t g
          rw [hti, C_0, add_zero] at this
          rw [← this]
          exact hM _ (X_mul_pderiv_mem_logJacobianCenter S hiΔ g)
        · rw [← centerChart_X_mul_pderiv_of_notMem hj hiS]
          exact hM _ (X_mul_pderiv_mem_logJacobianCenter S hiΔ g)
    · dsimp only
      have hl' : l ∉ centerDivisor Δ S j t := hl
      have hlj : l ≠ j := fun h => hl' (mem_centerDivisor.mpr (Or.inl h))
      by_cases hlS : l ∈ S
      · by_cases hlΔ : l ∈ Δ
        · have htl : t l ≠ 0 := fun h =>
            hl' (mem_centerDivisor.mpr (Or.inr ⟨hlΔ, hlj, Or.inr h⟩))
          have hmem : l ∈ Δ.filter (fun i => i ≠ j ∧ i ∈ S ∧ t i ≠ 0) :=
            Finset.mem_filter.mpr ⟨hlΔ, hlj, hlS, htl⟩
          rw [centerUnit, ← Finset.mul_prod_erase _ _ hmem, mul_comm (X l + C (t l)), mul_assoc,
            ← centerChart_X_mul_pderiv_of_mem hlS hlj]
          exact Ideal.mul_mem_left _ _ (hM _ (X_mul_pderiv_mem_logJacobianCenter S hlΔ g))
        · refine Ideal.mul_mem_left _ _ ?_
          rw [pderiv_centerChart_of_mem hlS hlj, ← centerChart_X_self S j t, ← map_mul]
          exact hM _ (X_mul_pderiv_mem_logJacobianCenter_of_mem hlΔ hlS hj g)
      · have hlΔ : l ∉ Δ := fun h =>
          hl' (mem_centerDivisor.mpr (Or.inr ⟨h, hlj, Or.inl hlS⟩))
        refine Ideal.mul_mem_left _ _ ?_
        rw [pderiv_centerChart_of_notMem hj hlS]
        exact hM _ (pderiv_mem_logJacobianCenter hlΔ hlS g)
  · rw [mul_zero]
    exact Ideal.zero_mem _
  · intro x y _ _ hx hy
    rw [mul_add]
    exact Ideal.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_eq_mul, mul_left_comm]
    exact Ideal.mul_mem_left _ _ hx

variable (p : ℕ) [CharP k p] {Δ S : Finset σ} {j : σ} {t : σ → k} {g g' : MvPolynomial σ k}

/-- `Θ'(π(g)) = (x_j^p) Θ'(g')` for `π(g) = x_j^p g'`, in characteristic `p`. -/
theorem logJacobian_centerChart_eq (hg : centerChart S j t g = X j ^ p * g') :
    logJacobian (centerDivisor Δ S j t) (centerChart S j t g) =
      Ideal.span {X j ^ p} * logJacobian (centerDivisor Δ S j t) g' := by
  rw [hg, logJacobian_pow_mul]

/-- **The transformation law for the center** (Volume 7, Section 3.4 of the handbook, first
inclusion): if `j ∈ S` and `π(g) = x_j^p g'`, then `π(Θ_C(g)) ⊆ (x_j^p) Θ'(g')`. -/
theorem map_centerChart_logJacobianCenter_le_span_mul (hj : j ∈ S)
    (hg : centerChart S j t g = X j ^ p * g') :
    Ideal.map (centerChart S j t) (logJacobianCenter Δ S g) ≤
      Ideal.span {X j ^ p} * logJacobian (centerDivisor Δ S j t) g' := by
  rw [← logJacobian_centerChart_eq p hg]
  exact map_centerChart_logJacobianCenter_le Δ S hj t g

/-- **The transformation law for the center** (Volume 7, Section 3.4 of the handbook, second
inclusion): if `j ∈ S` and `π(g) = x_j^p g'`, then `(x_j^p u) Θ'(g') ⊆ π(Θ_C(g))`, with
`u = centerUnit Δ S j t`. In the power series ring `u` is a unit, and the two inclusions give
`Θ'(g') = x_j^(-p) π(Θ_C(g))`. -/
theorem span_mul_logJacobian_le_map_centerChart (hj : j ∈ S)
    (hg : centerChart S j t g = X j ^ p * g') :
    Ideal.span {X j ^ p * centerUnit Δ S j t} * logJacobian (centerDivisor Δ S j t) g' ≤
      Ideal.map (centerChart S j t) (logJacobianCenter Δ S g) := by
  rw [← Ideal.span_singleton_mul_span_singleton, mul_comm (Ideal.span {X j ^ p}), mul_assoc,
    ← logJacobian_centerChart_eq p hg]
  exact span_mul_logJacobian_centerChart_le Δ S hj t g

end Law

/-! ### The equimultiple weak transform -/

section Weak

variable {σ k : Type*} [Field k] [DecidableEq σ]

/-- The ideal of the polynomials whose monomials all have degree at least `n` in the variables
`x_i`, `i ∈ S`. It contains `I_C^n` (`span_X_pow_le_centerDegreeIdeal`). -/
noncomputable def centerDegreeIdeal (S : Finset σ) (n : ℕ) : Ideal (MvPolynomial σ k) where
  carrier := {f | ∀ a ∈ f.support, n ≤ ∑ i ∈ S, a i}
  add_mem' := by
    intro f g hf hg a ha
    rcases Finset.mem_union.mp (support_add ha) with h | h
    · exact hf a h
    · exact hg a h
  zero_mem' := by
    intro a ha
    simp at ha
  smul_mem' := by
    intro c f hf a ha
    rw [smul_eq_mul] at ha
    obtain ⟨b, -, d, hd, rfl⟩ := Finset.mem_add.mp (support_mul c f ha)
    refine (hf d hd).trans ?_
    simp only [Finsupp.add_apply, Finset.sum_add_distrib]
    omega

theorem mem_centerDegreeIdeal {S : Finset σ} {n : ℕ} {f : MvPolynomial σ k} :
    f ∈ centerDegreeIdeal S n ↔ ∀ a ∈ f.support, n ≤ ∑ i ∈ S, a i :=
  Iff.rfl

theorem mul_mem_centerDegreeIdeal {S : Finset σ} {n m : ℕ} {f g : MvPolynomial σ k}
    (hf : f ∈ centerDegreeIdeal S n) (hg : g ∈ centerDegreeIdeal S m) :
    f * g ∈ centerDegreeIdeal S (n + m) := by
  intro a ha
  obtain ⟨b, hb, d, hd, rfl⟩ := Finset.mem_add.mp (support_mul f g ha)
  have h1 := hf b hb
  have h2 := hg d hd
  simp only [Finsupp.add_apply, Finset.sum_add_distrib]
  omega

theorem X_mem_centerDegreeIdeal {S : Finset σ} {i : σ} (hi : i ∈ S) :
    (X i : MvPolynomial σ k) ∈ centerDegreeIdeal S 1 := by
  intro a ha
  rw [support_X, Finset.mem_singleton] at ha
  subst ha
  simp [Finsupp.single_apply, hi]

/-- `I_C^n` is contained in the ideal of the polynomials whose monomials have degree at least `n`
in the variables of `S`. -/
theorem span_X_pow_le_centerDegreeIdeal (S : Finset σ) :
    ∀ n, Ideal.span (X '' (S : Set σ)) ^ n ≤ (centerDegreeIdeal S n : Ideal (MvPolynomial σ k))
  | 0 => fun f _ a _ => Nat.zero_le _
  | n + 1 => by
    rw [pow_succ, Ideal.mul_le]
    intro f hf g hg
    have hg' : g ∈ (centerDegreeIdeal S 1 : Ideal (MvPolynomial σ k)) := by
      refine (Ideal.span_le.mpr ?_) hg
      rintro _ ⟨i, hi, rfl⟩
      exact X_mem_centerDegreeIdeal hi
    exact mul_mem_centerDegreeIdeal (span_X_pow_le_centerDegreeIdeal S n hf) hg'

omit [DecidableEq σ] in
theorem sum_le_degree (T : Finset σ) (a : σ →₀ ℕ) : ∑ i ∈ T, a i ≤ Finsupp.degree a := by
  rw [← Finset.sum_filter_ne_zero, Finsupp.degree_apply]
  exact Finset.sum_le_sum_of_subset fun i hi =>
    Finsupp.mem_support_iff.mpr (Finset.mem_filter.mp hi).2

/-- A monomial of degree `n` with degree at least `n` in the variables of `S` has all its variables
in `S`. -/
theorem mem_of_mem_support_of_degree_le {S : Finset σ} {n : ℕ} {a : σ →₀ ℕ}
    (ha : Finsupp.degree a = n) (hn : n ≤ ∑ i ∈ S, a i) : ∀ i ∈ a.support, i ∈ S := by
  intro i hi
  by_contra hiS
  have h1 := sum_le_degree (insert i S) a
  rw [Finset.sum_insert hiS] at h1
  have h2 : a i ≠ 0 := Finsupp.mem_support_iff.mp hi
  omega

/-- The substitution `x_i ↦ 0` for `i ∉ S`, the variables of `S` are fixed. -/
noncomputable def killOutside (S : Finset σ) : MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i => if i ∈ S then X i else 0

theorem killOutside_X_of_mem {S : Finset σ} {i : σ} (hi : i ∈ S) :
    killOutside S (X i : MvPolynomial σ k) = X i := by
  simp [killOutside, hi]

theorem ord_le_ord_killOutside (S : Finset σ) (f : MvPolynomial σ k) :
    ord f ≤ ord (killOutside S f) :=
  ord_le_ord_aeval _ (fun i => by split_ifs <;> simp) f

theorem killOutside_monomial (S : Finset σ) (a : σ →₀ ℕ) (c : k) :
    killOutside S (monomial a c) = if ∀ i ∈ a.support, i ∈ S then monomial a c else 0 := by
  rw [killOutside, aeval_monomial, algebraMap_eq]
  split_ifs with h
  · rw [monomial_eq]
    congr 1
    exact Finsupp.prod_congr fun i hi => by simp [h i hi]
  · simp only [not_forall, exists_prop] at h
    obtain ⟨i, hi, hiS⟩ := h
    rw [Finsupp.prod, Finset.prod_eq_zero hi (by simp [hiS, Finsupp.mem_support_iff.mp hi]),
      mul_zero]

/-- The substitution `x_i ↦ 0` for `i ∉ S` keeps the coefficient of a monomial in the variables of
`S`. -/
theorem coeff_killOutside {S : Finset σ} {a : σ →₀ ℕ} (ha : ∀ i ∈ a.support, i ∈ S)
    (f : MvPolynomial σ k) : (killOutside S f).coeff a = f.coeff a := by
  conv_lhs => rw [f.as_sum]
  rw [map_sum, coeff_sum, Finset.sum_eq_single a]
  · rw [killOutside_monomial]
    split_ifs
    simp [coeff_monomial]
  · intro b _ hba
    rw [killOutside_monomial]
    split_ifs <;> simp [coeff_monomial, hba]
  · intro h
    simp only [MvPolynomial.mem_support_iff, not_not] at h
    simp [h]

/-- If `f ∈ I_C^s` and `ord f = s`, then `ord κ(f) = s` for the substitution `κ` of the variables
outside `S` by `0`: the monomials of degree `s` of `f` are in the variables of `S`. -/
theorem ord_killOutside {S : Finset σ} {s : ℕ} {f : MvPolynomial σ k}
    (hS : f ∈ Ideal.span (X '' (S : Set σ)) ^ s) (hf : ord f = s) : ord (killOutside S f) = s := by
  have hf0 : f ≠ 0 := by
    rintro rfl
    simp at hf
  obtain ⟨a, ha, hdeg⟩ := exists_coeff_ne_zero_and_ord_eq hf0
  have has : Finsupp.degree a = s := by
    rw [hf] at hdeg
    exact_mod_cast hdeg.symm
  have hsupp : ∀ i ∈ a.support, i ∈ S :=
    mem_of_mem_support_of_degree_le has
      (span_X_pow_le_centerDegreeIdeal S s hS a (MvPolynomial.mem_support_iff.mpr ha))
  refine le_antisymm ?_ (by rw [← hf]; exact ord_le_ord_killOutside S f)
  have h := ord_le (f := killOutside S f) (d := a) (by rw [coeff_killOutside hsupp]; exact ha)
  rwa [has] at h

/-- For `j ∈ S`, `κ ∘ π = π₀ ∘ κ`, with `κ` the substitution of the variables outside `S` by `0`
and `π₀` the chart of the point blowup with the translations `t_i` for `i ∈ S` and `0` for
`i ∉ S`. -/
theorem killOutside_comp_centerChart {S : Finset σ} {j : σ} (hj : j ∈ S) (t : σ → k) :
    (killOutside S).comp (centerChart S j t) =
      (pointChart j (fun i => if i ∈ S then t i else 0)).comp (killOutside S) := by
  refine algHom_ext fun i => ?_
  by_cases hij : i = j
  · subst hij
    simp [killOutside, centerChart, pointChart, hj]
  · by_cases hi : i ∈ S
    · simp [killOutside, centerChart, pointChart, hi, hij, hj]
    · simp [killOutside, centerChart, pointChart, hi, hij]

/-- If `f ∈ I_C^s` and `j ∈ S`, then the chart sends `f` to `x_j^s f'` for a polynomial `f'`. -/
theorem exists_centerChart_eq_X_pow_mul {S : Finset σ} {j : σ} (t : σ → k) {s : ℕ}
    {f : MvPolynomial σ k} (hS : f ∈ Ideal.span (X '' (S : Set σ)) ^ s) :
    ∃ f', centerChart S j t f = X j ^ s * f' := by
  have hle : Ideal.map (centerChart S j t) (Ideal.span (X '' (S : Set σ))) ≤
      Ideal.span {X j} := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
    obtain ⟨c, hc⟩ := exists_centerChart_X_eq_X_mul j t (S := S) hi
    exact Ideal.mem_span_singleton'.mpr ⟨c, by rw [hc, mul_comm]⟩
  have h1 : centerChart S j t f ∈
      Ideal.map (centerChart S j t) (Ideal.span (X '' (S : Set σ))) ^ s := by
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hS
  have h2 := Ideal.pow_right_mono hle s h1
  rw [Ideal.span_singleton_pow] at h2
  obtain ⟨f', hf'⟩ := Ideal.mem_span_singleton'.mp h2
  exact ⟨f', by rw [← hf', mul_comm]⟩

/-- **The equimultiple weak transform** (Volume 7, Section 3.4 of the handbook). Let
`f ∈ I_C^s` with `ord f = s`, for the center `C = V(x_i : i ∈ S)`, and let the `x_j`-chart send
`f` to `x_j^s f'`, with `j ∈ S`. Then `ord f' ≤ s` at the origin of the chart. Since the
translations `t` are arbitrary, this holds at each point of the chart over the origin. -/
theorem ord_le_of_centerChart {S : Finset σ} {j : σ} (hj : j ∈ S) {t : σ → k} {s : ℕ}
    {f f' : MvPolynomial σ k} (hS : f ∈ Ideal.span (X '' (S : Set σ)) ^ s) (hf : ord f = s)
    (h : centerChart S j t f = X j ^ s * f') : ord f' ≤ s := by
  have hκ : pointChart j (fun i => if i ∈ S then t i else 0) (killOutside S f) =
      X j ^ s * killOutside S f' := by
    rw [← AlgHom.comp_apply, ← killOutside_comp_centerChart hj t, AlgHom.comp_apply, h, map_mul,
      map_pow, killOutside_X_of_mem hj]
  exact (ord_le_ord_killOutside S f').trans (ord_le_of_pointChart (ord_killOutside hS hf) hκ)

end Weak

end Singularity
