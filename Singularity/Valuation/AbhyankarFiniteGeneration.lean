import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Singularity.Valuation.AbhyankarEquality
import Singularity.Valuation.AbhyankarResidue
import Singularity.Valuation.AbhyankarResidueField
-- The value group file of agent W, renamed from `AbhyankarValueGroup` because the repo already
-- has a module `Singularity.Valuation.AbhyankarValueGroup`.
import Singularity.Valuation.AbhyankarValueGroupSum

/-!
# The case of equality in the inequality of Abhyankar

This file proves Theorem 2.2.2 of Volume 3 of the handbook. Let `(L/K, w)` be an extension of
valued fields with `L/K` finitely generated. Let `x_1, ..., x_r` be units of `L` with values that
are independent modulo `Γ_v`, and `y_1, ..., y_s` elements of the valuation ring of `w` with
residues that are algebraically independent over `Kv`, as in Theorem 2.1.4. If
`trdeg(L/K) ≤ r + s`, then `Γ_w` is generated by `Γ_v` and a finite set, and `Lw/Kv` is finitely
generated (`Singularity.valueGroup_fg_and_residueField_fg_of_trdeg_le`).

The proof follows the handbook. Let `K_0 = K(x, y)`. Then `L/K_0` is finite
(`Singularity.finiteDimensional_adjoin_of_trdeg_le`). Values in different cosets of `Γ_{w_0}`
are linearly independent over `K_0`, so `Γ_w / Γ_{w_0}` is finite
(`Singularity.finite_range_valuation_quotient`), and Lemma 2.2.1 gives
`Γ_{w_0} = Γ_v + ∑ ℤ γ_i` (`Singularity.exists_finset_valueGroup_eq_sup_closure`). The residues
of `K_0` are in `Kv(ȳ)`, so `Lw` is finite over `Kv(ȳ)`
(`Singularity.finiteDimensional_residueField_adjoin_of_hasExtension`,
`Singularity.fg_residueField_of_hasExtension`).

## The form of the statement

* The handbook assumes `rr(Γ_w/Γ_v) + trdeg(Lw/Kv) = trdeg(L/K)` and chooses `x` and `y` with
  `r = rr(Γ_w/Γ_v)` and `s = trdeg(Lw/Kv)`. Here `x` and `y` are hypotheses, and the equality is
  the hypothesis `trdeg(L/K) ≤ r + s`. The choice of `x` and `y` from the rational rank and the
  residue transcendence degree is not formalized.
* "`Γ_w/Γ_v` is finitely generated" is stated as `Γ_w = Γ_v ⊔ closure S` with `S` a finite set
  of units of `Γ₁`, which is equivalent.
-/

namespace Singularity

open IsLocalRing

section AbhyankarFiniteGeneration

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {Γ₀ Γ₁ : Type*}
  [LinearOrderedCommGroupWithZero Γ₀] [LinearOrderedCommGroupWithZero Γ₁]

/-- Let `w` be a valuation of `L`, let `F` be a subfield, and let `z_1, ..., z_m ∈ L` be nonzero
with values in different cosets of the values of `F`. Then the `z_i` are linearly independent
over `F`. -/
theorem linearIndependent_of_valuation_mul_eq_of_valuation (vL : Valuation L Γ₁)
    {F : IntermediateField K L} {m : Type*} [Fintype m] {z : m → L}
    (hz : ∀ i, z i ≠ 0)
    (h : ∀ (i j : m) (c d : F), c ≠ 0 → d ≠ 0 →
      vL ((c : L) * z i) = vL ((d : L) * z j) → i = j) :
    LinearIndependent F z := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  by_contra hne
  simp only [not_forall] at hne
  set s := Finset.univ.filter fun i => g i ≠ 0 with hs
  have hsne : s.Nonempty := by
    obtain ⟨i, hi⟩ := hne
    exact ⟨i, by simp [hs, hi]⟩
  set f : m → L := fun i => (g i : L) * z i with hf
  have hgf : ∀ i, g i • z i = f i := fun i => rfl
  obtain ⟨j, hj, hmax⟩ := s.exists_max_image (fun i => vL (f i)) hsne
  have hgj : g j ≠ 0 := (Finset.mem_filter.mp hj).2
  have hfj : vL (f j) ≠ 0 := by
    rw [Valuation.ne_zero_iff]
    exact mul_ne_zero (by exact_mod_cast hgj) (hz j)
  have hlt : ∀ i ∈ s \ {j}, vL (f i) < vL (f j) := by
    intro i hi
    rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
    refine lt_of_le_of_ne (hmax i hi.1) fun heq => hi.2 ?_
    exact h i j (g i) (g j) (Finset.mem_filter.mp hi.1).2 hgj heq
  have hsum : ∑ i ∈ s, f i = ∑ i, f i := by
    refine Finset.sum_subset (Finset.filter_subset _ _) fun i _ hi => ?_
    have : g i = 0 := by simpa [hs] using hi
    simp [hf, this]
  have h0 : ∑ i, f i = 0 := by
    rw [← hg]
    exact Finset.sum_congr rfl fun i _ => (hgf i).symm
  have := Valuation.map_sum_eq_of_lt vL hj hlt
  rw [hsum, h0, map_zero] at this
  exact hfj this.symm

/-- **The values of a finite extension** (Volume 3, Corollary 2.1.3 of the handbook, the part on
`e`, for a valuation with values in `Γ₁`). Let `F` be a subfield of `L` with `[L : F]` finite, and
let `H` be a subgroup of `Γ₁ˣ` that contains the values of the units of `L` that are in `F`. Then
the values of the units of `L` lie in finitely many cosets of `H`. -/
theorem finite_range_valuation_quotient (vL : Valuation L Γ₁) {F : IntermediateField K L}
    [FiniteDimensional F L] (H : Subgroup Γ₁ˣ)
    (hH : ∀ u : Lˣ, (u : L) ∈ F → Units.map (vL : L →* Γ₁) u ∈ H) :
    (Set.range fun u : Lˣ => (QuotientGroup.mk (Units.map (vL : L →* Γ₁) u) : Γ₁ˣ ⧸ H)).Finite := by
  classical
  by_contra hinf
  obtain ⟨t, hts, htc⟩ := Set.Infinite.exists_subset_card_eq hinf (Module.finrank F L + 1)
  have hu : ∀ q : t, ∃ u : Lˣ,
      (QuotientGroup.mk (Units.map (vL : L →* Γ₁) u) : Γ₁ˣ ⧸ H) = q := fun q => hts q.2
  choose u hu using hu
  have hli : LinearIndependent F fun q : t => (u q : L) := by
    refine linearIndependent_of_valuation_mul_eq_of_valuation vL (fun q => (u q).ne_zero)
      fun i j c d hc hd heq => ?_
    have hc' : (c : L) ≠ 0 := by exact_mod_cast hc
    have hd' : (d : L) ≠ 0 := by exact_mod_cast hd
    have hcH := hH (Units.mk0 _ hc') c.2
    have hdH := hH (Units.mk0 _ hd') d.2
    have hunit : Units.map (vL : L →* Γ₁) (Units.mk0 _ hc') * Units.map (vL : L →* Γ₁) (u i) =
        Units.map (vL : L →* Γ₁) (Units.mk0 _ hd') * Units.map (vL : L →* Γ₁) (u j) := by
      ext
      simpa using heq
    have hq : (QuotientGroup.mk (Units.map (vL : L →* Γ₁) (u i)) : Γ₁ˣ ⧸ H) =
        QuotientGroup.mk (Units.map (vL : L →* Γ₁) (u j)) := by
      rw [QuotientGroup.eq]
      set a := Units.map (vL : L →* Γ₁) (u i)
      set b := Units.map (vL : L →* Γ₁) (u j)
      set c₁ := Units.map (vL : L →* Γ₁) (Units.mk0 _ hc')
      set d₁ := Units.map (vL : L →* Γ₁) (Units.mk0 _ hd')
      have hb : b = d₁⁻¹ * (c₁ * a) := by rw [hunit]; group
      have : a⁻¹ * b = c₁ * d₁⁻¹ := by
        rw [hb, mul_comm d₁⁻¹ (c₁ * a), mul_comm c₁ a, ← mul_assoc, ← mul_assoc, inv_mul_cancel,
          one_mul]
      rw [this]
      exact H.mul_mem hcH (H.inv_mem hdH)
    rw [hu, hu] at hq
    exact Subtype.ext hq
  have := hli.fintype_card_le_finrank
  rw [Fintype.card_coe, htc] at this
  omega

end AbhyankarFiniteGeneration

section AbhyankarTheorem

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {Γ₀ Γ₁ : Type*}
  [LinearOrderedCommGroupWithZero Γ₀] [LinearOrderedCommGroupWithZero Γ₁]


variable (vK : Valuation K Γ₀) (vL : Valuation L Γ₁) [vK.HasExtension vL]

/-- A unit `γ` of `Γ₁` is in the value group of `vL` if and only if `γ` is the value of an
element of `L`. -/
theorem mem_valueGroup_valuation_iff (γ : Γ₁ˣ) :
    γ ∈ (vL : L →*₀ Γ₁).valueGroup ↔ ∃ z : L, vL z = γ := by
  rw [← SetLike.mem_coe, ← MonoidWithZeroHom.valueMonoid_eq_valueGroup',
    SetLike.mem_coe, MonoidWithZeroHom.mem_valueMonoid_iff]
  rfl

/-- **The value group in Theorem 2.2.2** (Volume 3, Theorem 2.2.2 of the handbook, the part on
`Γ_w / Γ_v`). Let `(L/K, w)` be an extension of valued fields, and let `x_1, ..., x_r` and
`y_1, ..., y_s` be as in Theorem 2.1.4. Let `F = K(x, y)` and assume that `[L : F]` is finite.
Then there is a finite set `S` of values such that `Γ_w` is generated by `Γ_v` and `S`. So
`Γ_w / Γ_v` is a finitely generated abelian group. -/
theorem exists_finset_valueGroup_eq_sup_closure {ι κ : Type*} [Fintype ι] (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    (y : κ → vL.valuationSubring)
    (hy : AlgebraicIndependent (IsLocalRing.ResidueField vK.valuationSubring)
      (fun j => IsLocalRing.residue _ (y j)))
    (F : IntermediateField K L)
    (hF : F = IntermediateField.adjoin K
      (Set.range (Sum.elim (fun i => (x i : L)) (fun j => (y j : L)))))
    [FiniteDimensional F L] :
    ∃ S : Finset Γ₁ˣ, (vL : L →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure (S : Set Γ₁ˣ) := by
  classical
  set H := (vL.comap (algebraMap F L) : F →*₀ Γ₁).valueGroup with hHdef
  have hHeq := valueGroup_adjoin_eq vK vL x hx y hy F hF
  have hH : ∀ u : Lˣ, (u : L) ∈ F → Units.map (vL : L →* Γ₁) u ∈ H := fun u hu =>
    (mem_valueGroup_comap_intermediateField_iff vL F _).mpr ⟨u, hu, rfl⟩
  have hfin := finite_range_valuation_quotient vL H hH
  set T := hfin.toFinset
  have hrep : ∀ q : T, ∃ u : Lˣ,
      (QuotientGroup.mk (Units.map (vL : L →* Γ₁) u) : Γ₁ˣ ⧸ H) = q := fun q =>
    (hfin.mem_toFinset.mp q.2)
  choose r hr using hrep
  set γ : ι → Γ₁ˣ := fun i => Units.map (vL : L →* Γ₁) (x i)
  refine ⟨Finset.univ.image (fun q : T => Units.map (vL : L →* Γ₁) (r q)) ∪
    Finset.univ.image γ, le_antisymm ?_ ?_⟩
  · intro g hg
    obtain ⟨z, hz⟩ := (mem_valueGroup_valuation_iff vL g).mp hg
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [map_zero] at hz
      exact g.ne_zero hz.symm
    set u := Units.mk0 z hz0
    have hug : Units.map (vL : L →* Γ₁) u = g := Units.ext (by simpa [u] using hz)
    have hq : (QuotientGroup.mk g : Γ₁ˣ ⧸ H) ∈ T :=
      hfin.mem_toFinset.mpr ⟨u, by simp only [hug]⟩
    set q : T := ⟨_, hq⟩
    have hmem : (Units.map (vL : L →* Γ₁) (r q))⁻¹ * g ∈ H := by
      rw [← QuotientGroup.eq, hr q]
    have hS : Units.map (vL : L →* Γ₁) (r q) ∈ Subgroup.closure
        ((Finset.univ.image (fun q : T => Units.map (vL : L →* Γ₁) (r q)) ∪
          Finset.univ.image γ : Finset Γ₁ˣ) : Set Γ₁ˣ) :=
      Subgroup.subset_closure (by simp)
    have hHle : H ≤ (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure
        ((Finset.univ.image (fun q : T => Units.map (vL : L →* Γ₁) (r q)) ∪
          Finset.univ.image γ : Finset Γ₁ˣ) : Set Γ₁ˣ) := by
      refine le_trans hHeq.le (sup_le_sup_left (Subgroup.closure_mono ?_) _)
      rintro _ ⟨i, rfl⟩
      simp
    have : g = Units.map (vL : L →* Γ₁) (r q) * ((Units.map (vL : L →* Γ₁) (r q))⁻¹ * g) := by
      group
    rw [this]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hS) (hHle hmem)
  · refine sup_le ?_ ?_
    · intro g hg
      obtain ⟨c, hc⟩ := (mem_valueGroup_comap_algebraMap_iff vL g).mp hg
      exact (mem_valueGroup_valuation_iff vL g).mpr ⟨_, hc⟩
    · rw [Subgroup.closure_le]
      intro g hg
      simp only [Finset.coe_union, Finset.coe_image, Finset.coe_univ, Set.image_univ,
        Set.mem_union, Set.mem_range] at hg
      rcases hg with ⟨q, rfl⟩ | ⟨i, rfl⟩
      · exact (mem_valueGroup_valuation_iff vL _).mpr ⟨_, rfl⟩
      · exact (mem_valueGroup_valuation_iff vL _).mpr ⟨_, rfl⟩

/-- **The residue field in Theorem 2.2.2** (Volume 3, Theorem 2.2.2 of the handbook, the part on
`Lw`). With the notation of `Singularity.exists_finset_valueGroup_eq_sup_closure`, assume that
`[L : F]` is finite. Then `Lw` is finite over `Kv(ȳ_1, ..., ȳ_s)`. -/
theorem finiteDimensional_residueField_adjoin_of_hasExtension {ι κ : Type*} (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    (y : κ → vL.valuationSubring)
    (hy : AlgebraicIndependent (ResidueField vK.valuationSubring) (fun j => residue _ (y j)))
    (F : IntermediateField K L)
    (hF : F = IntermediateField.adjoin K
      (Set.range (Sum.elim (fun i => (x i : L)) (fun j => (y j : L)))))
    [FiniteDimensional F L] :
    FiniteDimensional (IntermediateField.adjoin (ResidueField vK.valuationSubring)
      (Set.range fun j => residue _ (y j))) (ResidueField vL.valuationSubring) := by
  refine finiteDimensional_residueField_of_residue_mem (k := K) vL.valuationSubring (E := F)
    fun c hc => ⟨⟨_, residue_mem_adjoin_of_hasExtension vK vL x hx y hy ⟨c, hc⟩ ?_⟩, rfl⟩
  rw [← hF]
  exact c.2

/-- **The residue field in Theorem 2.2.2** (Volume 3, Theorem 2.2.2 of the handbook, the part on
`Lw`). With the notation of `Singularity.exists_finset_valueGroup_eq_sup_closure`, assume that
`[L : F]` is finite and that there are finitely many `y_j`. Then `Lw` is a finitely generated
field extension of `Kv`. -/
theorem fg_residueField_of_hasExtension {ι κ : Type*} [Finite κ] (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    (y : κ → vL.valuationSubring)
    (hy : AlgebraicIndependent (ResidueField vK.valuationSubring) (fun j => residue _ (y j)))
    (F : IntermediateField K L)
    (hF : F = IntermediateField.adjoin K
      (Set.range (Sum.elim (fun i => (x i : L)) (fun j => (y j : L)))))
    [FiniteDimensional F L] :
    (⊤ : IntermediateField (ResidueField vK.valuationSubring)
      (ResidueField vL.valuationSubring)).FG := by
  have := finiteDimensional_residueField_adjoin_of_hasExtension vK vL x hx y hy F hF
  set E := IntermediateField.adjoin (ResidueField vK.valuationSubring)
    (Set.range fun j => residue vL.valuationSubring (y j))
  let b := Module.finBasis E (ResidueField vL.valuationSubring)
  rw [IntermediateField.fg_def]
  refine ⟨Set.range (fun j => residue vL.valuationSubring (y j)) ∪ Set.range b,
    (Set.finite_range _).union (Set.finite_range _), ?_⟩
  rw [eq_top_iff]
  rintro w -
  rw [← b.sum_repr w]
  refine sum_mem fun i _ => ?_
  rw [IntermediateField.smul_def, smul_eq_mul]
  refine mul_mem ?_ (IntermediateField.subset_adjoin _ _ (Or.inr ⟨i, rfl⟩))
  have hle : E ≤ IntermediateField.adjoin (ResidueField vK.valuationSubring)
      (Set.range (fun j => residue vL.valuationSubring (y j)) ∪ Set.range b) :=
    IntermediateField.adjoin_le_iff.mpr
      (Set.subset_union_left.trans (IntermediateField.subset_adjoin _ _))
  exact hle (b.repr w i).2

end AbhyankarTheorem

section FiniteSubfield

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- Let `L/K` be a finitely generated field extension, and let `f` be an algebraically
independent family in `L` with as many elements as the transcendence degree of `L/K`. Then `L`
is finite over `K(f)`. This is the step of the proof of Theorem 2.2.2 of Volume 3 of the
handbook that shows that `L/K_0` is finite. -/
theorem finiteDimensional_adjoin_of_trdeg_le {m : Type*} [Finite m] {f : m → L}
    (hfg : (⊤ : IntermediateField K L).FG) (hf : AlgebraicIndependent K f)
    (htr : Algebra.trdeg K L ≤ Nat.card m) :
    FiniteDimensional (IntermediateField.adjoin K (Set.range f)) L := by
  classical
  have hB : IsTranscendenceBasis K f := by
    refine hf.isTranscendenceBasis_of_lift_trdeg_le_of_finite ?_
    exact (Cardinal.lift_le.mpr htr).trans_eq
      (by rw [Cardinal.lift_natCast, ← Nat.cast_card, Cardinal.lift_natCast])
  have := hB.isAlgebraic_field
  set F := IntermediateField.adjoin K (Set.range f)
  obtain ⟨S, hS⟩ := hfg
  have hint : ∀ s ∈ (S : Set L), IsIntegral F s := fun s _ =>
    (Algebra.IsAlgebraic.isAlgebraic (R := F) s).isIntegral
  have : FiniteDimensional F (IntermediateField.adjoin F (S : Set L)) :=
    IntermediateField.finiteDimensional_adjoin hint
  have htop : IntermediateField.adjoin F (S : Set L) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have hz : z ∈ IntermediateField.adjoin K (S : Set L) := by rw [hS]; trivial
    have hle : IntermediateField.adjoin K (S : Set L) ≤
        (IntermediateField.adjoin F (S : Set L)).restrictScalars K :=
      IntermediateField.adjoin_le_iff.mpr (IntermediateField.subset_adjoin F _)
    exact hle hz
  rw [htop] at this
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

end FiniteSubfield

section TheoremTwoTwoTwo

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {Γ₀ Γ₁ : Type*}
  [LinearOrderedCommGroupWithZero Γ₀] [LinearOrderedCommGroupWithZero Γ₁]


variable (vK : Valuation K Γ₀) (vL : Valuation L Γ₁) [vK.HasExtension vL]

/-- **Theorem 2.2.2 of Volume 3 of the handbook**, in the form with the elements of
Theorem 2.1.4. Let `(L/K, w)` be an extension of valued fields with `L/K` finitely generated.
Let `x_1, ..., x_r` be units of `L` with values that are independent modulo `Γ_v`, and let
`y_1, ..., y_s` be in the valuation ring of `w`, with residues that are algebraically
independent over `Kv`. Assume `trdeg(L/K) ≤ r + s`, which is the case of equality in the
inequality of Abhyankar. Then `Γ_w` is generated by `Γ_v` and a finite set, and `Lw` is a
finitely generated field extension of `Kv`. -/
theorem valueGroup_fg_and_residueField_fg_of_trdeg_le {ι κ : Type*} [Fintype ι] [Finite κ]
    (hfg : (⊤ : IntermediateField K L).FG) (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    (y : κ → vL.valuationSubring)
    (hy : AlgebraicIndependent (ResidueField vK.valuationSubring) (fun j => residue _ (y j)))
    (htr : Algebra.trdeg K L ≤ Nat.card ι + Nat.card κ) :
    (∃ S : Finset Γ₁ˣ, (vL : L →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure (S : Set Γ₁ˣ)) ∧
    (⊤ : IntermediateField (ResidueField vK.valuationSubring)
      (ResidueField vL.valuationSubring)).FG := by
  have hind := algebraicIndependent_sumElim_of_hasExtension vK vL x hx y hy
  have := finiteDimensional_adjoin_of_trdeg_le hfg hind (by
    rw [Nat.card_sum]
    exact_mod_cast htr)
  exact ⟨exists_finset_valueGroup_eq_sup_closure vK vL x hx y hy _ rfl,
    fg_residueField_of_hasExtension vK vL x hx y hy _ rfl⟩

end TheoremTwoTwoTwo

end Singularity
