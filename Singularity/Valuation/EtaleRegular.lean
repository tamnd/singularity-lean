import Mathlib.RingTheory.Etale.StandardEtale
import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.RingTheory.Unramified.Locus
import Mathlib.RingTheory.AdjoinRoot

/-!
# Regularity along a standard étale extension

Let `A` be a Noetherian ring, let `P ∈ A[X]` be monic, and let `S = A[X]/(P)`. Let `Q` be a prime of `S` with `P' ∉ Q`, and let `p = Q ∩ A`. This file proves that `S_Q` is regular if `A_p` is regular. This is the regularity step in the proof of Volume 5, Theorem 1.3.4 of the handbook (node SG0000004C).

The proof has three steps.

1. The ring `S[1/P']` is a standard étale `A`-algebra, so `S` is unramified over `A` at `Q`. Thus `p S_Q` is the maximal ideal of `S_Q`.
2. The ring `S` is free of finite rank over `A`, so it is flat, and going down holds. Thus `ht p ≤ ht Q`.
3. The maximal ideal of `S_Q` is generated by the images of the generators of the maximal ideal of `A_p`. Their number is `dim A_p = ht p ≤ ht Q = dim S_Q`. So `S_Q` is regular.

## Main results

* `Singularity.isRegularLocalRing_localization_adjoinRoot`: if `P` is monic, `P' ∉ Q` and the localization of `A` at `Q ∩ A` is regular, then the localization of `A[X]/(P)` at `Q` is regular.
-/

open Polynomial IsLocalRing

namespace Singularity

variable {A : Type*} [CommRing A] [IsNoetherianRing A]

/-- Let `P ∈ A[X]` be monic and let `Q` be a prime of `A[X]/(P)` with `P' ∉ Q`. If the localization of `A` at `p = Q ∩ A` is regular, then the localization of `A[X]/(P)` at `Q` is regular. -/
theorem isRegularLocalRing_localization_adjoinRoot {P : A[X]} (hP : P.Monic)
    (Q : Ideal (AdjoinRoot P)) [Q.IsPrime]
    (hQ : AdjoinRoot.mk P (derivative P) ∉ Q) (p : Ideal A) [p.IsPrime]
    (hp : Q.comap (algebraMap A (AdjoinRoot P)) = p)
    (hreg : IsRegularLocalRing (Localization.AtPrime p)) :
    IsRegularLocalRing (Localization.AtPrime Q) := by
  subst hp
  set S := AdjoinRoot P
  set p := Q.comap (algebraMap A S) with hp
  set g : S := AdjoinRoot.mk P (derivative P)
  let E : StandardEtalePair A := ⟨P, hP, derivative P, ⟨1, 0, 1, by ring⟩⟩
  have h1 : Algebra.FormallyUnramified A (Localization.Away g) :=
    Algebra.FormallyUnramified.of_equiv E.equivAwayAdjoinRoot
  have h2 : Algebra.IsUnramifiedAt A Q :=
    (Algebra.basicOpen_subset_unramifiedLocus_iff (R := A) (f := g)).mpr h1
      (show (⟨Q, inferInstance⟩ : PrimeSpectrum S) ∈ PrimeSpectrum.basicOpen g from hQ)
  have : Q.LiesOver p := ⟨rfl⟩
  let := Localization.AtPrime.algebraOfLiesOver p Q
  have : Module.Free A S := Module.Free.of_basis (AdjoinRoot.powerBasis' hP).basis
  have : Module.Finite A S := (AdjoinRoot.powerBasis' hP).finite
  have : Algebra.EssFiniteType A S := inferInstance
  obtain ⟨-, hmax⟩ := (Algebra.isUnramifiedAt_iff_map_eq A p Q).mp h2
  have : IsNoetherianRing S := inferInstance
  have hht : p.height ≤ Q.height := by
    rw [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p Q]
    exact le_self_add
  have hm : (maximalIdeal (Localization.AtPrime p)).map
      (algebraMap (Localization.AtPrime p) (Localization.AtPrime Q)) =
      maximalIdeal (Localization.AtPrime Q) := by
    rw [← hmax, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq]
  have hreg' : IsRegularLocalRing (Localization.AtPrime p) := hreg
  have e2 : (((maximalIdeal (Localization.AtPrime p)).spanFinrank : ℕ∞) : WithBot ℕ∞) =
      (p.height : WithBot ℕ∞) := by
    rw [← IsLocalization.AtPrime.ringKrullDim_eq_height p (Localization.AtPrime p)]
    exact_mod_cast hreg'.spanFinrank_maximalIdeal
  have e3 : ((maximalIdeal (Localization.AtPrime p)).spanFinrank : ℕ∞) = p.height :=
    WithBot.coe_injective e2
  have e1 := Ideal.spanFinrank_map_le_of_fg
    (algebraMap (Localization.AtPrime p) (Localization.AtPrime Q))
    (maximalIdeal (Localization.AtPrime p)).fg_of_isNoetherianRing
  rw [hm] at e1
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q)]
  refine WithBot.coe_le_coe.mpr (le_trans ?_ hht)
  rw [← e3]
  exact_mod_cast e1

end Singularity
