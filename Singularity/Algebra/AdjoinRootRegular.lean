import Singularity.Algebra.Regular
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Ideal.GoingUp
import Mathlib.RingTheory.Ideal.HasGoingUp
import Mathlib.FieldTheory.KummerPolynomial

/-!
# Adjoining a root to a regular local ring

Let `(R, 𝔪, κ)` be a regular local ring of dimension `d` and let `P ∈ R[X]` be a monic polynomial of positive degree. Let `B = R[X] / (P)` and let `z` be the class of `X`. This file gives two cases where `B` is again a regular local ring of dimension `d`. These are the two end cases of a purely inseparable step of degree `p` over a regular centre: the equation `z^p = f` where `f` is a regular parameter, or a unit whose residue is not a `p`-th power.

## Main results

* `ringKrullDim_adjoinRoot`: if `P` is monic of positive degree, then `dim B = dim R`.
* `maximalIdeal_map_le_of_isMaximal`: if `R` is local and `P` is monic, then each maximal ideal of `B` contains `𝔪B`.
* `isRegularLocalRing_adjoinRoot_of_irreducible_map`: if the image of `P` in `κ[X]` is irreducible, then `B` is a regular local ring with maximal ideal `𝔪B`.
* `isRegularLocalRing_adjoinRoot_X_pow_sub_C`: if `x ∈ 𝔪 \ 𝔪²` and `m ≠ 0`, then `R[X] / (X^m - x)` is a regular local ring with maximal ideal `𝔪B + zB`.
* `isRegularLocalRing_adjoinRoot_X_pow_sub_C_of_forall_pow_ne`: if `p` is a prime and `u` is a unit of `R` whose residue is not a `p`-th power, then `R[X] / (X^p - u)` is a regular local ring.

## The proof

The ring `B` is integral over `R` and `R → B` is injective. Going up and incomparability give `dim B = dim R`. The inverse image of a maximal ideal of `B` is a maximal ideal of `R`, thus it is `𝔪`. So each maximal ideal of `B` contains `𝔪B`. If `P̄` is irreducible, then `B / 𝔪B = κ[X] / (P̄)` is a field, so `𝔪B` is the only maximal ideal. It has at most `d` generators. If `P = X^m - x`, then each maximal ideal contains `z`, because `z^m = x`. Each element of `B` is `r + z b` with `r ∈ R`, so each element outside `𝔫 = 𝔪B + zB` is a unit. Thus `𝔫` is the only maximal ideal. Write `𝔪 = (x) + (t)` with `t.card + 1 = d`. Then `𝔫` is generated by `z` and the image of `t`, which are at most `d` elements.

## References

* [Mat89] H. Matsumura, *Commutative ring theory*, 1989, Section 14.
* Volume 5, Chapter 4 of the handbook.
-/

open IsLocalRing Ideal Polynomial

universe u

namespace Singularity.Algebra

variable {R : Type u} [CommRing R]

/-! ### 1. Integral extensions -/

section Integral

variable {B : Type*} [CommRing B] [Algebra R B] [Algebra.IsIntegral R B]

/-- **Dimension of an integral extension.** If `B` is integral over `R` and `R → B` is injective, then `dim B = dim R`. -/
theorem ringKrullDim_eq_of_isIntegral [FaithfulSMul R B] : ringKrullDim B = ringKrullDim R := by
  apply le_antisymm
  · exact Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap R B))
      fun P Q h => Ideal.IsIntegral.under_lt_under (R := R) (A := B) (I := P.asIdeal)
        (J := Q.asIdeal) h
  · refine iSup_le fun l => ?_
    obtain ⟨⟨Q, hQ, hQl⟩⟩ := Ideal.nonempty_primesOver (S := B) l.head.asIdeal
    obtain ⟨L, hlen, -, -⟩ := Ideal.exists_ltSeries_of_hasGoingUp l Q
    have := Order.LTSeries.length_le_krullDim L
    rw [hlen] at this
    exact this

/-- If `R` is local and `B` is integral over `R`, then each maximal ideal of `B` contains `𝔪B`. -/
theorem map_maximalIdeal_le_of_isMaximal [IsLocalRing R] (M : Ideal B) [M.IsMaximal] :
    (maximalIdeal R).map (algebraMap R B) ≤ M := by
  have : (M.under R).IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal M
  rw [Ideal.map_le_iff_le_comap, ← IsLocalRing.eq_maximalIdeal this]

end Integral

/-! ### 2. A criterion for a local ring -/

section Local

variable {B : Type*} [CommRing B]

/-- If an ideal `𝔫` is maximal and each maximal ideal contains `𝔫`, then each maximal ideal is `𝔫`. -/
theorem eq_of_isMaximal_of_forall_le {𝔫 : Ideal B} (h𝔫 : 𝔫.IsMaximal)
    (hle : ∀ M : Ideal B, M.IsMaximal → 𝔫 ≤ M) (M : Ideal B) (hM : M.IsMaximal) : M = 𝔫 :=
  (h𝔫.eq_of_le hM.ne_top (hle M hM)).symm

/-- If each maximal ideal contains `𝔫` and each element outside `𝔫` is a unit, then each maximal ideal is `𝔫`. -/
theorem eq_of_forall_isUnit_of_forall_le {𝔫 : Ideal B} (hu : ∀ b ∉ 𝔫, IsUnit b)
    (hle : ∀ M : Ideal B, M.IsMaximal → 𝔫 ≤ M) (M : Ideal B) (hM : M.IsMaximal) : M = 𝔫 := by
  refine le_antisymm (fun b hb => ?_) (hle M hM)
  by_contra hb'
  exact hM.ne_top (M.eq_top_of_isUnit_mem hb (hu b hb'))

/-- A nontrivial ring where each maximal ideal is `𝔫` is a local ring. -/
theorem isLocalRing_of_forall_eq [Nontrivial B] {𝔫 : Ideal B}
    (h : ∀ M : Ideal B, M.IsMaximal → M = 𝔫) : IsLocalRing B := by
  obtain ⟨M, hM⟩ := Ideal.exists_maximal B
  have h𝔫 : 𝔫.IsMaximal := h M hM ▸ hM
  exact IsLocalRing.of_unique_max_ideal ⟨𝔫, h𝔫, fun J hJ => h J hJ⟩

/-- In a local ring where each maximal ideal is `𝔫`, the maximal ideal is `𝔫`. -/
theorem maximalIdeal_eq_of_forall_eq [IsLocalRing B] {𝔫 : Ideal B}
    (h : ∀ M : Ideal B, M.IsMaximal → M = 𝔫) : maximalIdeal B = 𝔫 :=
  h _ (maximalIdeal.isMaximal B)

end Local

/-! ### 3. Adjoining a root of a monic polynomial -/

section AdjoinRoot

/-- **Dimension of `R[X] / (P)`.** If `P` is monic of positive degree, then `dim R[X] / (P) = dim R`. -/
theorem ringKrullDim_adjoinRoot {P : R[X]} (hP : P.Monic) (hdeg : P.natDegree ≠ 0) :
    ringKrullDim (AdjoinRoot P) = ringKrullDim R := by
  have hpos : 0 < P.degree := natDegree_pos_iff_degree_pos.mp (Nat.pos_of_ne_zero hdeg)
  have := AdjoinRoot.isIntegral_of_monic hP
  have := AdjoinRoot.faithfulSMul_of_monic_of_degree_pos hP hpos
  exact ringKrullDim_eq_of_isIntegral

/-- If `R` is local and `P` is monic, then each maximal ideal of `R[X] / (P)` contains `𝔪 R[X] / (P)`. -/
theorem maximalIdeal_map_le_of_isMaximal [IsLocalRing R] {P : R[X]} (hP : P.Monic)
    (M : Ideal (AdjoinRoot P)) [M.IsMaximal] :
    (maximalIdeal R).map (algebraMap R (AdjoinRoot P)) ≤ M := by
  have := AdjoinRoot.isIntegral_of_monic hP
  exact map_maximalIdeal_le_of_isMaximal M

/-! #### Theorem A: the residue polynomial is irreducible -/

section Irreducible

variable {P : R[X]}

/-- If `P` is monic and its image in `κ[X]` is irreducible, then `P` has positive degree. -/
theorem natDegree_ne_zero_of_irreducible_map [IsLocalRing R] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue R))) : P.natDegree ≠ 0 := by
  intro h
  rw [← hP.natDegree_map (residue R)] at h
  rw [(Polynomial.Monic.natDegree_eq_zero (hP.map (residue R))).mp h] at hirr
  exact hirr.not_isUnit isUnit_one

/-- If `P` is monic and its image in `κ[X]` is irreducible, then `𝔪 R[X] / (P)` is a maximal ideal. -/
theorem isMaximal_map_maximalIdeal_of_irreducible_map [IsLocalRing R]
    (hirr : Irreducible (P.map (residue R))) :
    ((maximalIdeal R).map (algebraMap R (AdjoinRoot P))).IsMaximal := by
  rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
  let e : AdjoinRoot P ⧸ (maximalIdeal R).map (algebraMap R (AdjoinRoot P)) ≃+*
      AdjoinRoot (P.map (residue R)) :=
    AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot (maximalIdeal R) P
  exact e.toMulEquiv.isField (AdjoinRoot.isField_iff_irreducible.mpr hirr)

/-- If `P` is monic and its image in `κ[X]` is irreducible, then each maximal ideal of `R[X] / (P)` is `𝔪 R[X] / (P)`. -/
theorem eq_map_maximalIdeal_of_irreducible_map [IsLocalRing R] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue R))) (M : Ideal (AdjoinRoot P)) (hM : M.IsMaximal) :
    M = (maximalIdeal R).map (algebraMap R (AdjoinRoot P)) :=
  eq_of_isMaximal_of_forall_le (isMaximal_map_maximalIdeal_of_irreducible_map hirr)
    (fun M _ => maximalIdeal_map_le_of_isMaximal hP M) M hM

/-- If `P` is monic and its image in `κ[X]` is irreducible, then `R[X] / (P)` is a local ring. -/
theorem isLocalRing_adjoinRoot_of_irreducible_map [IsLocalRing R] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue R))) : IsLocalRing (AdjoinRoot P) := by
  have := AdjoinRoot.nontrivial_iff_of_monic hP |>.mpr <| natDegree_pos_iff_degree_pos.mp
    (Nat.pos_of_ne_zero (natDegree_ne_zero_of_irreducible_map hP hirr))
  exact isLocalRing_of_forall_eq (eq_map_maximalIdeal_of_irreducible_map hP hirr)

/-- If `P` is monic and its image in `κ[X]` is irreducible, then the maximal ideal of `R[X] / (P)` is `𝔪 R[X] / (P)`. -/
theorem maximalIdeal_adjoinRoot_of_irreducible_map [IsLocalRing R] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue R))) [IsLocalRing (AdjoinRoot P)] :
    maximalIdeal (AdjoinRoot P) = (maximalIdeal R).map (algebraMap R (AdjoinRoot P)) :=
  maximalIdeal_eq_of_forall_eq (eq_map_maximalIdeal_of_irreducible_map hP hirr)

/-- **Theorem A.** Let `R` be a regular local ring and let `P` be a monic polynomial whose image in `κ[X]` is irreducible. Then `R[X] / (P)` is a regular local ring. Its maximal ideal is `𝔪 R[X] / (P)` (`maximalIdeal_adjoinRoot_of_irreducible_map`) and its dimension is `dim R` (`ringKrullDim_adjoinRoot_of_irreducible_map`). -/
theorem isRegularLocalRing_adjoinRoot_of_irreducible_map [IsRegularLocalRing R]
    (hP : P.Monic) (hirr : Irreducible (P.map (residue R))) :
    IsRegularLocalRing (AdjoinRoot P) := by
  have := isLocalRing_adjoinRoot_of_irreducible_map hP hirr
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [maximalIdeal_adjoinRoot_of_irreducible_map hP hirr,
    ringKrullDim_adjoinRoot hP (natDegree_ne_zero_of_irreducible_map hP hirr),
    ← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)]
  exact_mod_cast Ideal.spanFinrank_map_le_of_fg _ (maximalIdeal R).fg_of_isNoetherianRing

/-- In Theorem A, the dimension of `R[X] / (P)` is the dimension of `R`. -/
theorem ringKrullDim_adjoinRoot_of_irreducible_map [IsLocalRing R] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue R))) :
    ringKrullDim (AdjoinRoot P) = ringKrullDim R :=
  ringKrullDim_adjoinRoot hP (natDegree_ne_zero_of_irreducible_map hP hirr)

end Irreducible

/-! #### Theorem B: a root of a regular parameter -/

section RegularParameter

variable {x : R} {m : ℕ}

/-- In `R[X] / (X^m - x)` the class `z` of `X` satisfies `z^m = x`. -/
theorem root_pow_eq_algebraMap (m : ℕ) (x : R) :
    AdjoinRoot.root (X ^ m - C x : R[X]) ^ m =
      algebraMap R (AdjoinRoot (X ^ m - C x : R[X])) x := by
  have h := AdjoinRoot.mk_self (f := (X ^ m - C x : R[X]))
  rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
  exact h

/-- The ideal `𝔪B + zB` of `B = R[X] / (X^m - x)`. -/
noncomputable abbrev rootIdeal [IsLocalRing R] (m : ℕ) (x : R) :
    Ideal (AdjoinRoot (X ^ m - C x : R[X])) :=
  (maximalIdeal R).map (algebraMap R _) ⊔ Ideal.span {AdjoinRoot.root (X ^ m - C x : R[X])}

/-- If `x ∈ 𝔪` and `m ≠ 0`, then each maximal ideal of `R[X] / (X^m - x)` contains `𝔪B + zB`. -/
theorem rootIdeal_le_of_isMaximal [IsLocalRing R] (hx : x ∈ maximalIdeal R) (hm : m ≠ 0)
    (M : Ideal (AdjoinRoot (X ^ m - C x : R[X]))) (hM : M.IsMaximal) : rootIdeal m x ≤ M := by
  have h𝔪 := maximalIdeal_map_le_of_isMaximal (monic_X_pow_sub_C x hm) M
  refine sup_le h𝔪 ((Ideal.span_singleton_le_iff_mem _).mpr ?_)
  apply hM.isPrime.mem_of_pow_mem m
  rw [root_pow_eq_algebraMap]
  exact h𝔪 (Ideal.mem_map_of_mem _ hx)

/-- In `R[X] / (X^m - x)`, each element outside `𝔪B + zB` is a unit, if `x ∈ 𝔪` and `m ≠ 0`. -/
theorem isUnit_of_notMem_rootIdeal [IsLocalRing R] (hx : x ∈ maximalIdeal R) (hm : m ≠ 0)
    (b : AdjoinRoot (X ^ m - C x : R[X])) (hb : b ∉ rootIdeal m x) : IsUnit b := by
  obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective b
  obtain ⟨h, hh⟩ := X_dvd_sub_C (p := g)
  set P : R[X] := X ^ m - C x
  have hg : AdjoinRoot.mk P g =
      algebraMap R (AdjoinRoot P) (g.coeff 0) + AdjoinRoot.root P * AdjoinRoot.mk P h := by
    rw [← AdjoinRoot.mk_X, ← map_mul, ← hh, map_sub, AdjoinRoot.mk_C, AdjoinRoot.algebraMap_eq]
    ring
  have hz : AdjoinRoot.root P * AdjoinRoot.mk P h ∈ rootIdeal m x :=
    Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
  have hc : g.coeff 0 ∉ maximalIdeal R := by
    intro hc
    apply hb
    rw [hg]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hc)) hz
  have hu : IsUnit (algebraMap R (AdjoinRoot P) (g.coeff 0)) :=
    ((IsLocalRing.notMem_maximalIdeal).mp hc).map _
  by_contra hnu
  obtain ⟨M, hM, hgM⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
  have hle := rootIdeal_le_of_isMaximal hx hm M hM
  apply hM.ne_top (M.eq_top_of_isUnit_mem _ hu)
  have : algebraMap R (AdjoinRoot P) (g.coeff 0) =
      AdjoinRoot.mk P g - AdjoinRoot.root P * AdjoinRoot.mk P h := by
    rw [hg]
    ring
  rw [this]
  exact M.sub_mem hgM (hle hz)

/-- If `x ∈ 𝔪` and `m ≠ 0`, then each maximal ideal of `R[X] / (X^m - x)` is `𝔪B + zB`. -/
theorem eq_rootIdeal_of_isMaximal [IsLocalRing R] (hx : x ∈ maximalIdeal R) (hm : m ≠ 0)
    (M : Ideal (AdjoinRoot (X ^ m - C x : R[X]))) (hM : M.IsMaximal) : M = rootIdeal m x :=
  eq_of_forall_isUnit_of_forall_le (isUnit_of_notMem_rootIdeal hx hm)
    (rootIdeal_le_of_isMaximal hx hm) M hM

/-- If `x ∈ 𝔪` and `m ≠ 0`, then `R[X] / (X^m - x)` is a local ring. -/
theorem isLocalRing_adjoinRoot_X_pow_sub_C [IsLocalRing R] (hx : x ∈ maximalIdeal R) (hm : m ≠ 0) :
    IsLocalRing (AdjoinRoot (X ^ m - C x : R[X])) := by
  have := AdjoinRoot.nontrivial_iff_of_monic (monic_X_pow_sub_C x hm) |>.mpr <| by
    rw [degree_X_pow_sub_C (Nat.pos_of_ne_zero hm)]
    exact_mod_cast Nat.pos_of_ne_zero hm
  exact isLocalRing_of_forall_eq (eq_rootIdeal_of_isMaximal hx hm)

/-- If `x ∈ 𝔪` and `m ≠ 0`, then the maximal ideal of `R[X] / (X^m - x)` is `𝔪B + zB`. -/
theorem maximalIdeal_adjoinRoot_X_pow_sub_C [IsLocalRing R] (hx : x ∈ maximalIdeal R) (hm : m ≠ 0)
    [IsLocalRing (AdjoinRoot (X ^ m - C x : R[X]))] :
    maximalIdeal (AdjoinRoot (X ^ m - C x : R[X])) =
      (maximalIdeal R).map (algebraMap R _) ⊔ Ideal.span {AdjoinRoot.root (X ^ m - C x : R[X])} :=
  maximalIdeal_eq_of_forall_eq (eq_rootIdeal_of_isMaximal hx hm)

/-- **Theorem B.** Let `R` be a regular local ring, let `x ∈ 𝔪 \ 𝔪²` and let `m ≠ 0`. Then `R[X] / (X^m - x)` is a regular local ring. Its maximal ideal is `𝔪B + zB` (`maximalIdeal_adjoinRoot_X_pow_sub_C`) and its dimension is `dim R` (`ringKrullDim_adjoinRoot_X_pow_sub_C`). -/
theorem isRegularLocalRing_adjoinRoot_X_pow_sub_C [IsRegularLocalRing R]
    (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2) (hm : m ≠ 0) :
    IsRegularLocalRing (AdjoinRoot (X ^ m - C x : R[X])) := by
  classical
  have := isLocalRing_adjoinRoot_X_pow_sub_C hx hm
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [maximalIdeal_adjoinRoot_X_pow_sub_C hx hm,
    ringKrullDim_adjoinRoot (monic_X_pow_sub_C x hm) (by rwa [natDegree_X_pow_sub_C]),
    ← IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)]
  obtain ⟨t, -, hcard, hspan⟩ := exists_span_insert_eq_maximalIdeal hx hx2
  set f := algebraMap R (AdjoinRoot (X ^ m - C x : R[X]))
  set z := AdjoinRoot.root (X ^ m - C x : R[X])
  set s : Set (AdjoinRoot (X ^ m - C x : R[X])) := insert z (f '' (t : Set R))
  have heq : (maximalIdeal R).map f ⊔ Ideal.span {z} = Ideal.span s := by
    apply le_antisymm
    · refine sup_le ?_ ((Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.subset_span (Set.mem_insert _ _)))
      rw [hspan, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨y, hy, rfl⟩
      rcases hy with rfl | hy
      · rw [← root_pow_eq_algebraMap]
        exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (Set.mem_insert _ _)) m
          (Nat.pos_of_ne_zero hm)
      · exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨y, hy, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ (rfl | ⟨y, hy, rfl⟩)
      · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
      · refine Ideal.mem_sup_left (Ideal.mem_map_of_mem _ ?_)
        rw [hspan]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ hy)
  rw [heq, ← hcard]
  have hfin : s.Finite := ((t.finite_toSet.image f).insert z)
  have : (Ideal.span s).spanFinrank ≤ t.card + 1 :=
    calc (Ideal.span s).spanFinrank ≤ s.ncard := Submodule.spanFinrank_span_le_ncard_of_finite hfin
      _ ≤ (f '' (t : Set R)).ncard + 1 := Set.ncard_insert_le _ _
      _ ≤ (t : Set R).ncard + 1 := Nat.add_le_add_right (Set.ncard_image_le t.finite_toSet) 1
      _ = t.card + 1 := by rw [Set.ncard_coe_finset]
  exact_mod_cast this

/-- In Theorem B, the dimension of `R[X] / (X^m - x)` is the dimension of `R`. -/
theorem ringKrullDim_adjoinRoot_X_pow_sub_C [Nontrivial R] (hm : m ≠ 0) :
    ringKrullDim (AdjoinRoot (X ^ m - C x : R[X])) = ringKrullDim R :=
  ringKrullDim_adjoinRoot (monic_X_pow_sub_C x hm) (by rwa [natDegree_X_pow_sub_C])

end RegularParameter

/-! #### Corollary C: a root of a unit -/

section Unit

/-- The image of `X^p - u` in `κ[X]` is `X^p - ū`. -/
theorem map_X_pow_sub_C [IsLocalRing R] (p : ℕ) (u : R) :
    (X ^ p - C u : R[X]).map (residue R) = X ^ p - C (residue R u) := by
  simp

/-- **Corollary C.** Let `R` be a regular local ring, let `p` be a prime number and let `u ∈ R` be an element whose residue is not a `p`-th power in `κ`. Then `R[X] / (X^p - u)` is a regular local ring. Its maximal ideal is `𝔪 R[X] / (X^p - u)` (`maximalIdeal_adjoinRoot_X_pow_sub_C_of_forall_pow_ne`) and its dimension is `dim R` (`ringKrullDim_adjoinRoot_X_pow_sub_C`). The element `u` is then a unit, because `0` is a `p`-th power. No hypothesis on the characteristic is needed. -/
theorem isRegularLocalRing_adjoinRoot_X_pow_sub_C_of_forall_pow_ne [IsRegularLocalRing R] {p : ℕ}
    (hp : p.Prime) {u : R} (hu : ∀ b : ResidueField R, b ^ p ≠ residue R u) :
    IsRegularLocalRing (AdjoinRoot (X ^ p - C u : R[X])) := by
  refine isRegularLocalRing_adjoinRoot_of_irreducible_map (monic_X_pow_sub_C u hp.ne_zero) ?_
  rw [map_X_pow_sub_C]
  exact X_pow_sub_C_irreducible_of_prime hp hu

/-- In Corollary C, the maximal ideal of `R[X] / (X^p - u)` is `𝔪 R[X] / (X^p - u)`. -/
theorem maximalIdeal_adjoinRoot_X_pow_sub_C_of_forall_pow_ne [IsLocalRing R] {p : ℕ}
    (hp : p.Prime) {u : R} (hu : ∀ b : ResidueField R, b ^ p ≠ residue R u)
    [IsLocalRing (AdjoinRoot (X ^ p - C u : R[X]))] :
    maximalIdeal (AdjoinRoot (X ^ p - C u : R[X])) =
      (maximalIdeal R).map (algebraMap R (AdjoinRoot (X ^ p - C u : R[X]))) :=
  maximalIdeal_adjoinRoot_of_irreducible_map (monic_X_pow_sub_C u hp.ne_zero)
    (by rw [map_X_pow_sub_C]; exact X_pow_sub_C_irreducible_of_prime hp hu)

end Unit

end AdjoinRoot

end Singularity.Algebra
