import Singularity.Algebra.BlowupChart
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Ideal.Height
import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.Algebra.Polynomial.FieldDivision

/-!
# The quadratic transform of a regular local ring of dimension 2

This file is Volume 5, Proposition 1.1.3 and Lemma 1.1.5 of the handbook, for the chart
`B = R[𝔪/x]` of Volume 1.

Let `R` be a regular local ring of dimension 2 with residue field `κ`, and let `x, y` generate the
maximal ideal `𝔪`. Let `B = R[𝔪/x]`. The map `quadraticChartResidue` is the map
`B → B/xB ≅ κ[Y]`. It sends `y/x` to `Y`.

## Main results

* `quadraticChart_prime_cases`: Proposition 1.1.3, the two cases. Let `𝔫` be a prime of `B` that
  contains `x`. Then `𝔫 = xB`, or `𝔫 = xB + h̃B` with `h̃ ∈ B` that maps to a monic irreducible
  polynomial `h ∈ κ[Y]`.
* `isDiscreteValuationRing_quadraticChart`: case 1. If `𝔫 = xB`, then `B_𝔫` is a discrete
  valuation ring.
* `isRegularLocalRing_quadraticChart`, `maximalIdeal_quadraticChart`,
  `ringKrullDim_quadraticChart` and `quadraticChartQuotientEquiv`: case 2. If `𝔫 = xB + h̃B`,
  then `B_𝔫` is a regular local ring of dimension 2, its maximal ideal is generated by `x` and
  `h̃`, and `B/𝔫 ≅ κ[Y]/(h)`.
* `quadraticStrictTransform`: for `f ∈ 𝔪^a`, the element `f' = f/x^a` of `B`, with
  `f = x^a f'` (`algebraMap_eq_pow_mul_quadraticStrictTransform`).
* `quadraticStrictTransform_mul`: Lemma 1.1.5 (2), `(fg)' = f'g'`.
* `quadraticStrictTransform_notMem_span`: Lemma 1.1.5 (1). If `f ∉ 𝔪^(a+1)`, then `f' ∉ xB`.
* `quadraticChartResidue_quadraticStrictTransform`: Lemma 1.1.5 (1). If `f = P(x, y)` for a
  homogeneous polynomial `P` of degree `a`, and `F` is the image of `P` over `κ`, then the image
  of `f'` in `κ[Y]` is `F(1, Y)` (`dehomogenizeResidue P`).
* `natDegree_dehomogenizeResidue_le`, `pow_dvd_of_quadraticStrictTransform_mem_maximalIdeal_pow`
  and `le_of_quadraticStrictTransform_mem_maximalIdeal_pow`: Lemma 1.1.5 (3) without the length.
  `F(1, Y)` has degree at most `a`. If `f'` is in the `n`-th power of the maximal ideal of `B_𝔫`,
  then `h^n` divides `F(1, Y)`, and so `n ≤ a`.

## What is not in this file

The file uses a prime `𝔫` of `B` that contains `x`, and not a valuation that dominates `R`. The
equality `R_1 = 𝒪_v` in case 1 is not in this file. In Lemma 1.1.5 (3), the equality of the
length of `R_1/(x, f')` with the order of `h` in `F(1, Y)` is not in this file.
-/

universe u

namespace Singularity.Algebra

open IsLocalRing Ideal

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

section Setup

variable {x : R} {y : Fin 1 → R}

theorem mem_maximalIdeal_of_span_fin_cons
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (1 + 1) → R))) (i : Fin 1) :
    y i ∈ maximalIdeal R :=
  hg ▸ subset_span ⟨i.succ, Fin.cons_succ _ _ _⟩

theorem x_mem_maximalIdeal_of_span_fin_cons
    (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (1 + 1) → R))) :
    x ∈ maximalIdeal R :=
  hg ▸ subset_span ⟨0, Fin.cons_zero _ _⟩

variable (hd : ringKrullDim R = (1 + 1 : ℕ))
  (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (1 + 1) → R)))
include hd hg

theorem x_notMem_maximalIdeal_sq_of_span : x ∉ maximalIdeal R ^ 2 :=
  notMem_maximalIdeal_sq_of_span hd hg 0

theorem x_ne_zero_of_span : x ≠ 0 := by
  intro h
  apply x_notMem_maximalIdeal_sq_of_span hd hg
  rw [h]
  exact Ideal.zero_mem _

theorem isDomain_quadraticChart : IsDomain (blowupChart R x) :=
  have := isDomain_of_isRegularLocalRing R
  isDomain_blowupChart (x_ne_zero_of_span hd hg)

theorem isRegularRing_quadraticChart : IsRegularRing (blowupChart R x) :=
  isRegularRing_blowupChart (x_mem_maximalIdeal_of_span_fin_cons hg)
    (x_notMem_maximalIdeal_sq_of_span hd hg)

theorem algebraMap_x_ne_zero : algebraMap R (blowupChart R x) x ≠ 0 := by
  have := isDomain_of_isRegularLocalRing R
  intro h
  exact x_ne_zero_of_span hd hg (algebraMap_away_injective (x_ne_zero_of_span hd hg)
    (by rw [map_zero]; exact congrArg Subtype.val h))

theorem blowupChartQuotientEquiv_apply_quotientHom (F : MvPolynomial (Fin 1) R) :
    blowupChartQuotientEquiv hd hg
      (blowupChartQuotientHom x (mem_maximalIdeal_of_span_fin_cons hg) F) =
        MvPolynomial.map (residue R) F := by
  have hs : Function.Surjective
      (blowupChartQuotientHom x (mem_maximalIdeal_of_span_fin_cons hg)) :=
    Ideal.Quotient.mk_surjective.comp (blowupChartAeval_surjective hg)
  have h1 : (RingHom.quotientKerEquivOfSurjective hs).symm
      (blowupChartQuotientHom x (mem_maximalIdeal_of_span_fin_cons hg) F) =
        Ideal.Quotient.mk _ F := by
    rw [RingEquiv.symm_apply_eq]
    rfl
  unfold blowupChartQuotientEquiv
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply]
  erw [h1]
  rfl

/-- The map `B = R[𝔪/x] → B/xB ≅ κ[Y]`. -/
noncomputable def quadraticChartResidue : blowupChart R x →+* Polynomial (ResidueField R) :=
  ((MvPolynomial.uniqueAlgEquiv (ResidueField R) (Fin 1)).toRingEquiv.toRingHom.comp
    (blowupChartQuotientEquiv hd hg).toRingHom).comp (Ideal.Quotient.mk _)

theorem quadraticChartResidue_blowupChartAeval (F : MvPolynomial (Fin 1) R) :
    quadraticChartResidue hd hg (blowupChartAeval x (mem_maximalIdeal_of_span_fin_cons hg) F) =
      MvPolynomial.uniqueAlgEquiv (ResidueField R) (Fin 1) (MvPolynomial.map (residue R) F) := by
  have := blowupChartQuotientEquiv_apply_quotientHom hd hg F
  simp only [quadraticChartResidue, RingHom.comp_apply]
  erw [← this]
  rfl

theorem quadraticChartResidue_algebraMap (c : R) :
    quadraticChartResidue hd hg (algebraMap R (blowupChart R x) c) =
      Polynomial.C (residue R c) := by
  rw [← (blowupChartAeval x (mem_maximalIdeal_of_span_fin_cons hg)).commutes c,
    MvPolynomial.algebraMap_eq, quadraticChartResidue_blowupChartAeval, MvPolynomial.map_C]
  simp [MvPolynomial.uniqueAlgEquiv]

/-- The element `y/x` of `B`. -/
noncomputable def quadraticChartY : blowupChart R x :=
  ⟨_, div_mem_blowupChart (mem_maximalIdeal_of_span_fin_cons hg 0)⟩

theorem quadraticChartResidue_Y :
    quadraticChartResidue hd hg (quadraticChartY hg) = Polynomial.X := by
  have : quadraticChartY hg =
      blowupChartAeval x (mem_maximalIdeal_of_span_fin_cons hg) (MvPolynomial.X 0) := by
    rw [blowupChartAeval, MvPolynomial.aeval_X]
    rfl
  rw [this, quadraticChartResidue_blowupChartAeval, MvPolynomial.map_X]
  simp [MvPolynomial.uniqueAlgEquiv]

theorem quadraticChartResidue_surjective : Function.Surjective (quadraticChartResidue hd hg) :=
  ((MvPolynomial.uniqueAlgEquiv (ResidueField R) (Fin 1)).surjective.comp
    (blowupChartQuotientEquiv hd hg).surjective).comp Ideal.Quotient.mk_surjective

theorem quadraticChartResidue_eq_zero_iff (b : blowupChart R x) :
    quadraticChartResidue hd hg b = 0 ↔ b ∈ span {algebraMap R (blowupChart R x) x} := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  show MvPolynomial.uniqueAlgEquiv (ResidueField R) (Fin 1)
      (blowupChartQuotientEquiv hd hg (Ideal.Quotient.mk _ b)) = 0 ↔ _
  rw [map_eq_zero_iff _ (MvPolynomial.uniqueAlgEquiv (ResidueField R) (Fin 1)).injective,
    map_eq_zero_iff _ (blowupChartQuotientEquiv hd hg).injective]

theorem ker_quadraticChartResidue :
    RingHom.ker (quadraticChartResidue hd hg) = span {algebraMap R (blowupChart R x) x} := by
  ext b
  exact quadraticChartResidue_eq_zero_iff hd hg b

theorem mem_span_pair_iff_quadraticChartResidue (h : blowupChart R x) (b : blowupChart R x) :
    b ∈ span {algebraMap R (blowupChart R x) x, h} ↔
      quadraticChartResidue hd hg b ∈ span {quadraticChartResidue hd hg h} := by
  constructor
  · intro hb
    obtain ⟨c, d, rfl⟩ := Ideal.mem_span_pair.mp hb
    rw [map_add, map_mul, map_mul,
      (quadraticChartResidue_eq_zero_iff hd hg _).mpr (Ideal.mem_span_singleton_self _),
      mul_zero, zero_add]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · intro hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hb
    obtain ⟨c', rfl⟩ := quadraticChartResidue_surjective hd hg c
    have h0 : quadraticChartResidue hd hg (b - c' * h) = 0 := by
      rw [map_sub, map_mul, hc, sub_self]
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp
      ((quadraticChartResidue_eq_zero_iff hd hg _).mp h0)
    exact Ideal.mem_span_pair.mpr ⟨e, c', by rw [he]; ring⟩

/-- **Volume 5, Proposition 1.1.3, the two cases.** Let `𝔫` be a prime of `B = R[𝔪/x]` that
contains `x`. Then `𝔫 = xB`, or `𝔫 = xB + h̃B` for an element `h̃ ∈ B` whose image `h` in `κ[Y]`
is monic and irreducible. -/
theorem quadraticChart_prime_cases (𝔫 : Ideal (blowupChart R x)) [𝔫.IsPrime]
    (hx𝔫 : algebraMap R (blowupChart R x) x ∈ 𝔫) :
    𝔫 = span {algebraMap R (blowupChart R x) x} ∨
      ∃ h : blowupChart R x, 𝔫 = span {algebraMap R (blowupChart R x) x, h} ∧
        (quadraticChartResidue hd hg h).Monic ∧ Irreducible (quadraticChartResidue hd hg h) := by
  set ψ := quadraticChartResidue hd hg
  have hψ := quadraticChartResidue_surjective hd hg
  have hker : RingHom.ker ψ ≤ 𝔫 := by
    rw [ker_quadraticChartResidue, Ideal.span_le, Set.singleton_subset_iff]
    exact hx𝔫
  have hP : (𝔫.map ψ).IsPrime := Ideal.map_isPrime_of_surjective hψ hker
  have hcomap : (𝔫.map ψ).comap ψ = 𝔫 := by
    rw [Ideal.comap_map_of_surjective _ hψ, ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hker]
  obtain ⟨g, hg'⟩ := (IsPrincipalIdealRing.principal (𝔫.map ψ)).principal
  rw [Ideal.submodule_span_eq] at hg'
  by_cases hg0 : g = 0
  · left
    rw [← hcomap, hg', hg0, Ideal.span_singleton_eq_bot.mpr rfl, ← RingHom.ker_eq_comap_bot,
      ker_quadraticChartResidue]
  · right
    have hprime : Prime g := (Ideal.span_singleton_prime hg0).mp (hg' ▸ hP)
    set u := g * Polynomial.C g.leadingCoeff⁻¹
    have hu : u.Monic := Polynomial.monic_mul_leadingCoeff_inv hg0
    have hassoc : Associated g u :=
      associated_mul_unit_right _ _ (Polynomial.isUnit_C.mpr
        (isUnit_iff_ne_zero.mpr (inv_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hg0))))
    have hspan : span {u} = 𝔫.map ψ := by
      rw [hg']
      exact (Ideal.span_singleton_eq_span_singleton.mpr hassoc).symm
    obtain ⟨h, hh⟩ := hψ u
    refine ⟨h, ?_, hh ▸ hu, hh ▸ hassoc.irreducible hprime.irreducible⟩
    ext b
    rw [mem_span_pair_iff_quadraticChartResidue hd hg, hh, hspan, ← Ideal.mem_comap, hcomap]

/-- **Volume 5, Proposition 1.1.3, case 1.** If `𝔫 = xB` is prime, then `B_𝔫` is a discrete
valuation ring. -/
theorem isDiscreteValuationRing_quadraticChart (𝔫 : Ideal (blowupChart R x)) [𝔫.IsPrime]
    (h𝔫 : 𝔫 = span {algebraMap R (blowupChart R x) x}) :
    letI := isDomain_quadraticChart hd hg
    IsDiscreteValuationRing (Localization.AtPrime 𝔫) := by
  have := isDomain_quadraticChart hd hg
  have := isNoetherianRing_blowupChart (x_mem_maximalIdeal_of_span_fin_cons hg)
    (x_notMem_maximalIdeal_sq_of_span hd hg)
  have hmax : maximalIdeal (Localization.AtPrime 𝔫) =
      span {(algebraMap (blowupChart R x) (Localization.AtPrime 𝔫)
        (algebraMap R (blowupChart R x) x))} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal,
      congrArg (Ideal.map (algebraMap (blowupChart R x) (Localization.AtPrime 𝔫))) h𝔫,
      Ideal.map_span, Set.image_singleton]
  have hne : algebraMap (blowupChart R x) (Localization.AtPrime 𝔫)
      (algebraMap R (blowupChart R x) x) ≠ 0 := by
    intro h0
    apply algebraMap_x_ne_zero hd hg
    exact IsLocalization.injective (Localization.AtPrime 𝔫)
      (Ideal.primeCompl_le_nonZeroDivisors 𝔫) (h0.trans (map_zero _).symm)
  have hnf : ¬ IsField (Localization.AtPrime 𝔫) := by
    rw [isField_iff_maximalIdeal_eq, hmax, Ideal.span_singleton_eq_bot]
    exact hne
  have hp : (maximalIdeal (Localization.AtPrime 𝔫)).IsPrincipal := ⟨⟨_, hmax⟩⟩
  exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime 𝔫) hnf).out 1 5).mpr hp

/-- Case 2 of Proposition 1.1.3, first part. For each prime `𝔫` of `B`, the ring `B_𝔫` is a
regular local ring. -/
theorem isRegularLocalRing_quadraticChart (𝔫 : Ideal (blowupChart R x)) [𝔫.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime 𝔫) := by
  have := isNoetherianRing_blowupChart (x_mem_maximalIdeal_of_span_fin_cons hg)
    (x_notMem_maximalIdeal_sq_of_span hd hg)
  exact isRegularRing_iff.mp (isRegularRing_quadraticChart hd hg) 𝔫

omit hd hg in
/-- Case 2 of Proposition 1.1.3, second part. If `𝔫 = xB + h̃B`, then the maximal ideal of
`B_𝔫` is generated by `x` and `h̃`. -/
theorem maximalIdeal_quadraticChart (h : blowupChart R x) (𝔫 : Ideal (blowupChart R x))
    [𝔫.IsPrime] (h𝔫 : 𝔫 = span {algebraMap R (blowupChart R x) x, h}) :
    maximalIdeal (Localization.AtPrime 𝔫) =
      span {(algebraMap _ (Localization.AtPrime 𝔫) (algebraMap R (blowupChart R x) x)),
        (algebraMap _ (Localization.AtPrime 𝔫) h)} := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal,
    congrArg (Ideal.map (algebraMap (blowupChart R x) (Localization.AtPrime 𝔫))) h𝔫,
    Ideal.map_span, Set.image_pair]

theorem span_x_isPrime : (span {algebraMap R (blowupChart R x) x}).IsPrime := by
  rw [← ker_quadraticChartResidue hd hg]
  exact RingHom.ker_isPrime _

/-- Case 2 of Proposition 1.1.3, third part. If `𝔫 = xB + h̃B` is prime and the image of `h̃`
in `κ[Y]` is not zero, then `B_𝔫` has dimension 2. -/
theorem ringKrullDim_quadraticChart (h : blowupChart R x) (𝔫 : Ideal (blowupChart R x))
    [𝔫.IsPrime] (h𝔫 : 𝔫 = span {algebraMap R (blowupChart R x) x, h})
    (hh : quadraticChartResidue hd hg h ≠ 0) :
    ringKrullDim (Localization.AtPrime 𝔫) = 2 := by
  have hreg := isRegularLocalRing_quadraticChart hd hg 𝔫
  have := isDomain_quadraticChart hd hg
  apply le_antisymm
  · refine hreg.spanFinrank_maximalIdeal.symm.le.trans ?_
    rw [maximalIdeal_quadraticChart h 𝔫 h𝔫]
    have h1 := Submodule.spanFinrank_span_le_ncard_of_finite (R := Localization.AtPrime 𝔫)
      (Set.toFinite {(algebraMap _ (Localization.AtPrime 𝔫) (algebraMap R (blowupChart R x) x)),
        (algebraMap _ (Localization.AtPrime 𝔫) h)})
    have h2 := h1.trans ((Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton]))
    exact_mod_cast h2
  · refine le_of_le_of_eq ?_
      (IsLocalization.AtPrime.ringKrullDim_eq_height 𝔫 (Localization.AtPrime 𝔫)).symm
    have := span_x_isPrime hd hg
    have hlt1 : (⊥ : Ideal (blowupChart R x)) < span {algebraMap R (blowupChart R x) x} :=
      bot_lt_iff_ne_bot.mpr (by
        rw [Ne, Ideal.span_singleton_eq_bot]
        exact algebraMap_x_ne_zero hd hg)
    have hlt2 : span {algebraMap R (blowupChart R x) x} < 𝔫 := by
      rw [h𝔫]
      exact lt_of_le_of_ne (Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)))
        (fun he => hh ((quadraticChartResidue_eq_zero_iff hd hg h).mpr
          (he ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))
    have e1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt1
    have e2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt2
    have e3 : (1 : ℕ∞) ≤ (span {algebraMap R (blowupChart R x) x}).height :=
      le_trans le_add_self e1
    have e4 : (2 : ℕ∞) ≤ 𝔫.height := by
      rw [← one_add_one_eq_two]
      exact le_trans (add_le_add e3 le_rfl) e2
    exact le_trans (le_of_eq (by rfl)) (WithBot.coe_le_coe.mpr e4)

/-- Case 2 of Proposition 1.1.3: the quotient `B/𝔫` is `κ[Y]/(h)`. -/
noncomputable def quadraticChartQuotientEquiv (h : blowupChart R x) :
    blowupChart R x ⧸ span {algebraMap R (blowupChart R x) x, h} ≃+*
      Polynomial (ResidueField R) ⧸ span {quadraticChartResidue hd hg h} :=
  have hs : Function.Surjective ((Ideal.Quotient.mk (span {quadraticChartResidue hd hg h})).comp
      (quadraticChartResidue hd hg)) :=
    Ideal.Quotient.mk_surjective.comp (quadraticChartResidue_surjective hd hg)
  (Ideal.quotEquivOfEq (by
    ext b
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
      mem_span_pair_iff_quadraticChartResidue hd hg])).trans
    (RingHom.quotientKerEquivOfSurjective hs)

theorem quadraticChartQuotientEquiv_mk (h b : blowupChart R x) :
    quadraticChartQuotientEquiv hd hg h (Ideal.Quotient.mk _ b) =
      Ideal.Quotient.mk _ (quadraticChartResidue hd hg b) :=
  rfl

end Setup

section StrictTransform

/-- For `f ∈ 𝔪^a`, the element `f' = f/x^a` of `B = R[𝔪/x]`. If `f` has order `a`, this is the
strict transform of `f`. -/
noncomputable def quadraticStrictTransform (x : R) (a : ℕ) {f : R} (hf : f ∈ maximalIdeal R ^ a) :
    blowupChart R x :=
  ⟨_, div_pow_mem_blowupChart a hf⟩

theorem algebraMap_eq_pow_mul_quadraticStrictTransform (x : R) (a : ℕ) {f : R}
    (hf : f ∈ maximalIdeal R ^ a) :
    algebraMap R (blowupChart R x) f =
      algebraMap R (blowupChart R x) x ^ a * quadraticStrictTransform x a hf := by
  apply Subtype.ext
  show algebraMap R (Localization.Away x) f =
    algebraMap R (Localization.Away x) x ^ a *
      (algebraMap R (Localization.Away x) f * IsLocalization.Away.invSelf x ^ a)
  rw [mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]

/-- **Volume 5, Lemma 1.1.5 (2).** The strict transform of a product is the product of the
strict transforms. -/
theorem quadraticStrictTransform_mul (x : R) {a b : ℕ} {f g : R} (hf : f ∈ maximalIdeal R ^ a)
    (hg : g ∈ maximalIdeal R ^ b) (hfg : f * g ∈ maximalIdeal R ^ (a + b)) :
    quadraticStrictTransform x (a + b) hfg = quadraticStrictTransform x a hf * quadraticStrictTransform x b hg := by
  apply Subtype.ext
  show algebraMap R (Localization.Away x) (f * g) * IsLocalization.Away.invSelf x ^ (a + b) =
    algebraMap R (Localization.Away x) f * IsLocalization.Away.invSelf x ^ a *
      (algebraMap R (Localization.Away x) g * IsLocalization.Away.invSelf x ^ b)
  rw [map_mul, pow_add]
  ring

theorem mul_mem_maximalIdeal_pow_add {a b : ℕ} {f g : R} (hf : f ∈ maximalIdeal R ^ a)
    (hg : g ∈ maximalIdeal R ^ b) : f * g ∈ maximalIdeal R ^ (a + b) := by
  rw [pow_add]
  exact Ideal.mul_mem_mul hf hg

/-- The polynomial `F(1, Y)` for a polynomial `P` in two variables over `R`, with `F` the image
of `P` over the residue field. -/
noncomputable def dehomogenizeResidue (P : MvPolynomial (Fin (1 + 1)) R) :
    Polynomial (ResidueField R) :=
  MvPolynomial.aeval ![1, Polynomial.X] (MvPolynomial.map (residue R) P)

theorem dehomogenizeResidue_eq_sum (P : MvPolynomial (Fin (1 + 1)) R) :
    dehomogenizeResidue P = ∑ s ∈ P.support,
      Polynomial.C (residue R (P.coeff s)) * Polynomial.X ^ (s 1) := by
  rw [dehomogenizeResidue, MvPolynomial.aeval_def, MvPolynomial.eval₂_map,
    MvPolynomial.eval₂_eq']
  refine Finset.sum_congr rfl fun s _ => ?_
  simp [Fin.prod_univ_two, Polynomial.algebraMap_eq]

/-- Lemma 1.1.5 (3), the degree bound. If `P` is homogeneous of degree `a`, then `F(1, Y)` has
degree at most `a`. -/
theorem natDegree_dehomogenizeResidue_le {a : ℕ} {P : MvPolynomial (Fin (1 + 1)) R}
    (hP : P.IsHomogeneous a) : (dehomogenizeResidue P).natDegree ≤ a := by
  rw [dehomogenizeResidue_eq_sum]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro s hs
  have hs' := Finset.mem_finsuppAntidiag.mp
    (mem_finsuppAntidiag_of_coeff_ne_zero hP (MvPolynomial.mem_support_iff.mp hs))
  rw [Fin.sum_univ_two] at hs'
  exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (by omega)

/-- If `q` is irreducible and `q^n` divides a polynomial `p ≠ 0` of degree at most `a`, then
`n ≤ a`. -/
theorem le_of_pow_dvd_of_natDegree_le {K : Type*} [Field K] {p q : Polynomial K} {n a : ℕ}
    (hq : Irreducible q) (hp : p ≠ 0) (hpa : p.natDegree ≤ a) (hdvd : q ^ n ∣ p) : n ≤ a := by
  have h1 := Polynomial.natDegree_le_of_dvd hdvd hp
  rw [Polynomial.natDegree_pow] at h1
  have h2 := Irreducible.natDegree_pos hq
  nlinarith

variable {x : R} {y : Fin 1 → R} (hd : ringKrullDim R = (1 + 1 : ℕ))
  (hg : maximalIdeal R = span (Set.range (Fin.cons x y : Fin (1 + 1) → R)))
include hd hg

theorem eq_quadraticStrictTransform_of_mul {a : ℕ} {f : R} (hf : f ∈ maximalIdeal R ^ a)
    {c : blowupChart R x}
    (hc : algebraMap R (blowupChart R x) f = algebraMap R (blowupChart R x) x ^ a * c) :
    c = quadraticStrictTransform x a hf :=
  have := isDomain_quadraticChart hd hg
  mul_left_cancel₀ (pow_ne_zero a (algebraMap_x_ne_zero hd hg))
    (hc.symm.trans (algebraMap_eq_pow_mul_quadraticStrictTransform x a hf))

/-- **Volume 5, Lemma 1.1.5 (1), first part.** If `f` has order exactly `a`, then `x` does not
divide the strict transform `f'` in `B`. -/
theorem quadraticStrictTransform_notMem_span {a : ℕ} {f : R} (hf : f ∈ maximalIdeal R ^ a)
    (hf' : f ∉ maximalIdeal R ^ (a + 1)) :
    quadraticStrictTransform x a hf ∉ span {algebraMap R (blowupChart R x) x} := by
  intro hmem
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
  obtain ⟨n, b, hb, hcb⟩ :=
    (mem_blowupChart_iff (x_mem_maximalIdeal_of_span_fin_cons hg)).mp c.2
  have key : algebraMap R (Localization.Away x) (x ^ n * f) =
      algebraMap R (Localization.Away x) (x ^ (a + 1) * b) := by
    have h1 := congrArg Subtype.val (algebraMap_eq_pow_mul_quadraticStrictTransform x a hf)
    rw [← hc] at h1
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap] at h1
    rw [map_mul, map_mul, map_pow, map_pow, h1, ← hcb]
    ring
  have := isDomain_of_isRegularLocalRing R
  have key' := algebraMap_away_injective (x_ne_zero_of_span hd hg) key
  apply hf'
  apply mem_pow_of_pow_mul_mem_pow_add_of_span hd hg (n := n)
  show x ^ n * f ∈ _
  rw [key', pow_add (maximalIdeal R) (a + 1) n]
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (x_mem_maximalIdeal_of_span_fin_cons hg) _) hb

theorem quadraticChartResidue_quadraticStrictTransform_ne_zero {a : ℕ} {f : R}
    (hf : f ∈ maximalIdeal R ^ a) (hf' : f ∉ maximalIdeal R ^ (a + 1)) :
    quadraticChartResidue hd hg (quadraticStrictTransform x a hf) ≠ 0 := fun h0 =>
  quadraticStrictTransform_notMem_span hd hg hf hf' ((quadraticChartResidue_eq_zero_iff hd hg _).mp h0)

theorem quadraticStrictTransform_eq_sum {a : ℕ} {f : R} (hf : f ∈ maximalIdeal R ^ a)
    {P : MvPolynomial (Fin (1 + 1)) R} (hP : P.IsHomogeneous a)
    (hPf : MvPolynomial.aeval (Fin.cons x y : Fin (1 + 1) → R) P = f) :
    quadraticStrictTransform x a hf = ∑ s ∈ P.support,
      algebraMap R (blowupChart R x) (P.coeff s) * quadraticChartY hg ^ (s 1) := by
  refine (eq_quadraticStrictTransform_of_mul hd hg hf ?_).symm
  have hxy : algebraMap R (blowupChart R x) x * quadraticChartY hg =
      algebraMap R (blowupChart R x) (y 0) := by
    apply Subtype.ext
    show algebraMap R (Localization.Away x) x *
      (algebraMap R (Localization.Away x) (y 0) * IsLocalization.Away.invSelf x) =
        algebraMap R (Localization.Away x) (y 0)
    rw [mul_left_comm, IsLocalization.Away.mul_invSelf, mul_one]
  rw [← hPf, MvPolynomial.aeval_def, MvPolynomial.eval₂_eq', map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun s hs => ?_
  have hs' := Finset.mem_finsuppAntidiag.mp
    (mem_finsuppAntidiag_of_coeff_ne_zero hP (MvPolynomial.mem_support_iff.mp hs))
  rw [Fin.sum_univ_two] at hs'
  rw [Fin.prod_univ_two, ← hs'.1]
  simp only [Algebra.algebraMap_self, RingHom.id_apply, map_mul, map_pow]
  rw [show (Fin.cons x y : Fin (1 + 1) → R) 0 = x from rfl,
    show (Fin.cons x y : Fin (1 + 1) → R) 1 = y 0 from rfl, ← hxy]
  ring

/-- **Volume 5, Lemma 1.1.5 (1), second part.** Let `f = P(x, y)` with `P` homogeneous of
degree `a`, and let `F` be the image of `P` over `κ`. Then the image of the strict transform
`f'` in `B/xB ≅ κ[Y]` is `F(1, Y)`. -/
theorem quadraticChartResidue_quadraticStrictTransform {a : ℕ} {f : R} (hf : f ∈ maximalIdeal R ^ a)
    {P : MvPolynomial (Fin (1 + 1)) R} (hP : P.IsHomogeneous a)
    (hPf : MvPolynomial.aeval (Fin.cons x y : Fin (1 + 1) → R) P = f) :
    quadraticChartResidue hd hg (quadraticStrictTransform x a hf) = dehomogenizeResidue P := by
  rw [quadraticStrictTransform_eq_sum hd hg hf hP hPf, map_sum, dehomogenizeResidue_eq_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [map_mul, map_pow, quadraticChartResidue_algebraMap, quadraticChartResidue_Y]

/-- Lemma 1.1.5 (3), the divisibility. Let `𝔫 = xB + h̃B` be prime with `h = ψ(h̃)`
irreducible. If `f'` is in the `n`-th power of the maximal ideal of `B_𝔫`, then `h^n` divides
the image of `f'` in `κ[Y]`. -/
theorem pow_dvd_of_quadraticStrictTransform_mem_maximalIdeal_pow (h : blowupChart R x)
    (𝔫 : Ideal (blowupChart R x)) [𝔫.IsPrime]
    (h𝔫 : 𝔫 = span {algebraMap R (blowupChart R x) x, h})
    (hirr : Irreducible (quadraticChartResidue hd hg h)) {a n : ℕ} {f : R}
    (hf : f ∈ maximalIdeal R ^ a)
    (hmem : algebraMap _ (Localization.AtPrime 𝔫) (quadraticStrictTransform x a hf) ∈
      maximalIdeal (Localization.AtPrime 𝔫) ^ n) :
    quadraticChartResidue hd hg h ^ n ∣ quadraticChartResidue hd hg (quadraticStrictTransform x a hf) := by
  have := isDomain_quadraticChart hd hg
  rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow] at hmem
  obtain ⟨⟨⟨z, hz⟩, ⟨s, hs⟩⟩, hzs⟩ :=
    (IsLocalization.mem_map_algebraMap_iff 𝔫.primeCompl (Localization.AtPrime 𝔫)).mp hmem
  have heq : quadraticStrictTransform x a hf * s = z :=
    IsLocalization.injective (Localization.AtPrime 𝔫) (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
      (by rw [map_mul]; exact hzs)
  have hmap : Ideal.map (quadraticChartResidue hd hg) 𝔫 ≤
      span {quadraticChartResidue hd hg h} := by
    rw [Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap, ← mem_span_pair_iff_quadraticChartResidue hd hg, ← h𝔫]
    exact hb
  have hzmem : quadraticChartResidue hd hg z ∈ span {quadraticChartResidue hd hg h ^ n} := by
    rw [← Ideal.span_singleton_pow]
    have h1 : quadraticChartResidue hd hg z ∈ Ideal.map (quadraticChartResidue hd hg) (𝔫 ^ n) :=
      Ideal.mem_map_of_mem _ hz
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hmap n h1
  have hsn : ¬ quadraticChartResidue hd hg h ∣ quadraticChartResidue hd hg s := by
    rw [← Ideal.mem_span_singleton, ← mem_span_pair_iff_quadraticChartResidue hd hg, ← h𝔫]
    exact hs
  rw [Ideal.mem_span_singleton, ← heq, map_mul] at hzmem
  exact hirr.prime.pow_dvd_of_dvd_mul_right n hsn hzmem

/-- **Volume 5, Lemma 1.1.5 (3), the bound.** Let `f = P(x, y)` have order exactly `a`, with `P`
homogeneous of degree `a`. Let `𝔫 = xB + h̃B` be prime with `ψ(h̃)` irreducible. If `f'` is in
the `n`-th power of the maximal ideal of `B_𝔫`, then `n ≤ a`. -/
theorem le_of_quadraticStrictTransform_mem_maximalIdeal_pow (h : blowupChart R x)
    (𝔫 : Ideal (blowupChart R x)) [𝔫.IsPrime]
    (h𝔫 : 𝔫 = span {algebraMap R (blowupChart R x) x, h})
    (hirr : Irreducible (quadraticChartResidue hd hg h)) {a n : ℕ} {f : R}
    (hf : f ∈ maximalIdeal R ^ a) (hf' : f ∉ maximalIdeal R ^ (a + 1))
    {P : MvPolynomial (Fin (1 + 1)) R} (hP : P.IsHomogeneous a)
    (hPf : MvPolynomial.aeval (Fin.cons x y : Fin (1 + 1) → R) P = f)
    (hmem : algebraMap _ (Localization.AtPrime 𝔫) (quadraticStrictTransform x a hf) ∈
      maximalIdeal (Localization.AtPrime 𝔫) ^ n) :
    n ≤ a :=
  le_of_pow_dvd_of_natDegree_le hirr (quadraticChartResidue_quadraticStrictTransform_ne_zero hd hg hf hf')
    (by
      rw [quadraticChartResidue_quadraticStrictTransform hd hg hf hP hPf]
      exact natDegree_dehomogenizeResidue_le hP)
    (pow_dvd_of_quadraticStrictTransform_mem_maximalIdeal_pow hd hg h 𝔫 h𝔫 hirr hf hmem)

end StrictTransform

