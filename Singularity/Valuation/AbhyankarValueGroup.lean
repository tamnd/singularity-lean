import Singularity.Valuation.AbhyankarSubfield
import Singularity.Valuation.DegreePTowers

/-!
# The value group of an Abhyankar valuation is free

Let `V` be an Abhyankar valuation of a function field `K/k`, and let `r` be the rational rank of its value group `Γ`. This file proves that `Γ` is a free abelian group of finite rank (Volume 3, Corollary 2.2.4 of the handbook). Its rank is `r`, because `ℚ ⊗ Γ` has dimension `r` over `ℚ`.

The proof follows the handbook. Choose the subfield `K₀ = k(x, y)` of `Singularity.IsAbhyankarValuation.exists_isMonomialValuation_comap`. The restriction of `V` to `K₀` is monomial over `k(y)`, so each nonzero `c ∈ K₀` has the value of a Laurent monomial `x^a` (`Singularity.exists_valuation_eq_laurentMonomial_of_mem_adjoin_sumElim`). Thus the values of `K₀` are in the subgroup `Γ₀` that the values `v(x_1), ..., v(x_r)` generate.

1. Let `z_1, ..., z_m ∈ K` be nonzero, with values in different cosets of the group of values of `K₀`. Then the `z_i` are linearly independent over `K₀` (`Singularity.linearIndependent_of_valuation_mul_eq`). In a sum `∑ c_i z_i` the nonzero terms have different values, so the term with the largest value gives the value of the sum. This is the first half of the proof of the fundamental inequality (Volume 3, Corollary 2.1.3).
2. So the quotient `Γ / Γ₀` is finite (`Singularity.finite_quotient_of_valuation_mem`). The proof shows that it has at most `[K : K₀]` elements, but the statement gives only the finiteness.
3. The group `Γ` is generated by the generators of `Γ₀` and by one element of each coset of `Γ₀`. So `Γ` is finitely generated. An ordered group has no torsion, and a finitely generated abelian group with no torsion is free.

## Main results

* `Singularity.IsAbhyankarValuation.free_valueGroup`: the value group of an Abhyankar valuation is free and finitely generated over `ℤ`.
* `Singularity.IsAbhyankarValuation.exists_basis_valueGroup`: it has a basis with `r` elements.
* `Singularity.finite_quotient_of_valuation_mem`: the index of the values of a subfield `E` with `[K : E]` finite.
* `Singularity.linearIndependent_of_valuation_mul_eq`: elements with values in different cosets are linearly independent.
-/

open IsLocalRing TensorProduct

namespace Singularity

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-! ### Elements with values in different cosets -/

section Cosets

variable (V : ValuationSubring K) {E : IntermediateField k K}

/-- Let `z_1, ..., z_m ∈ K` be nonzero. Assume that `v(c z_i) = v(d z_j)` for nonzero `c, d ∈ E` only if `i = j`, that is, the values of the `z_i` are in different cosets of the values of `E`. Then the `z_i` are linearly independent over `E`. -/
theorem linearIndependent_of_valuation_mul_eq {m : Type*} [Fintype m] {z : m → K}
    (hz : ∀ i, z i ≠ 0)
    (h : ∀ (i j : m) (c d : E), c ≠ 0 → d ≠ 0 →
      V.valuation ((c : K) * z i) = V.valuation ((d : K) * z j) → i = j) :
    LinearIndependent E z := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro g hg
  by_contra hne
  simp only [not_forall] at hne
  set s := Finset.univ.filter fun i => g i ≠ 0 with hs
  have hsne : s.Nonempty := by
    obtain ⟨i, hi⟩ := hne
    exact ⟨i, by simp [hs, hi]⟩
  set f : m → K := fun i => (g i : K) * z i with hf
  have hgf : ∀ i, g i • z i = f i := fun i => rfl
  obtain ⟨j, hj, hmax⟩ := s.exists_max_image (fun i => V.valuation (f i)) hsne
  have hgj : g j ≠ 0 := (Finset.mem_filter.mp hj).2
  have hfj : V.valuation (f j) ≠ 0 := by
    rw [Valuation.ne_zero_iff]
    exact mul_ne_zero (by exact_mod_cast hgj) (hz j)
  have hlt : ∀ i ∈ s \ {j}, V.valuation (f i) < V.valuation (f j) := by
    intro i hi
    rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
    refine lt_of_le_of_ne (hmax i hi.1) fun heq => hi.2 ?_
    exact h i j (g i) (g j) (Finset.mem_filter.mp hi.1).2 hgj heq
  have hsum : ∑ i ∈ s, f i = ∑ i, f i := by
    refine Finset.sum_subset (Finset.filter_subset _ _) fun i _ hi => ?_
    have : g i = 0 := by simpa [hs] using hi
    simp [hf, this]
  have h0 : ∑ i, f i = 0 := by
    rw [← hg]
    exact Finset.sum_congr rfl fun i _ => (hgf i).symm
  have := Valuation.map_sum_eq_of_lt V.valuation hj hlt
  rw [hsum, h0, map_zero] at this
  exact hfj this.symm

/-- The value of a nonzero element, as a unit of the value group. -/
theorem valuation_ne_zero_of_ne_zero {z : K} (hz : z ≠ 0) : V.valuation z ≠ 0 :=
  (Valuation.ne_zero_iff _).mpr hz

/-- **The index of the values of a subfield** (Volume 3, Corollary 2.1.3 of the handbook, the part on `e`). Let `E` be a subfield of `K` with `[K : E]` finite, and let `H` be a subgroup of the value group `Γ` of `V` that contains the values of the nonzero elements of `E`. Then `Γ / H` is finite. -/
theorem finite_quotient_of_valuation_mem [FiniteDimensional E K] (H : Subgroup V.ValueGroupˣ)
    (hH : ∀ (c : E) (hc : (c : K) ≠ 0),
      Units.mk0 (V.valuation (c : K)) (valuation_ne_zero_of_ne_zero V hc) ∈ H) :
    Finite (V.ValueGroupˣ ⧸ H) := by
  by_contra hinf
  rw [not_finite_iff_infinite] at hinf
  set n := Module.finrank E K
  let e : ℕ ↪ V.ValueGroupˣ ⧸ H := Infinite.natEmbedding _
  let γ : Fin (n + 1) → V.ValueGroupˣ := fun i => (e i).out
  have hz : ∀ i, ∃ z : K, V.valuation z = (γ i : V.ValueGroup) := fun i =>
    V.valuation_surjective _
  choose z hzγ using hz
  have hz0 : ∀ i, z i ≠ 0 := fun i h0 => by
    have := hzγ i
    rw [h0, map_zero] at this
    exact (γ i).ne_zero this.symm
  have hli : LinearIndependent E z := by
    refine linearIndependent_of_valuation_mul_eq V hz0 fun i j c d hc hd heq => ?_
    have hc' : (c : K) ≠ 0 := by exact_mod_cast hc
    have hd' : (d : K) ≠ 0 := by exact_mod_cast hd
    have hu : Units.mk0 (V.valuation (c : K)) (valuation_ne_zero_of_ne_zero V hc') * γ i =
        Units.mk0 (V.valuation (d : K)) (valuation_ne_zero_of_ne_zero V hd') * γ j := by
      ext
      simp only [Units.val_mul, Units.val_mk0, ← hzγ, ← map_mul]
      exact heq
    have hmem : (γ i)⁻¹ * γ j ∈ H := by
      have key : γ j = (Units.mk0 (V.valuation (d : K)) (valuation_ne_zero_of_ne_zero V hd'))⁻¹ *
          (Units.mk0 (V.valuation (c : K)) (valuation_ne_zero_of_ne_zero V hc') * γ i) := by
        rw [hu]
        group
      rw [key, mul_comm (Units.mk0 (V.valuation (c : K)) _) (γ i), mul_left_comm,
        inv_mul_cancel_left]
      exact H.mul_mem (H.inv_mem (hH d hd')) (hH c hc')
    have hq : (QuotientGroup.mk (γ i) : V.ValueGroupˣ ⧸ H) = QuotientGroup.mk (γ j) :=
      QuotientGroup.eq.mpr hmem
    have hγ : ∀ i, (QuotientGroup.mk (γ i) : V.ValueGroupˣ ⧸ H) = e i := fun i =>
      QuotientGroup.out_eq' (e i)
    rw [hγ, hγ] at hq
    exact Fin.ext (e.injective hq)
  have := hli.fintype_card_le_finrank
  rw [Fintype.card_fin] at this
  omega

end Cosets

/-! ### The values of `k(x, y)` -/

section Values

variable {ι κ : Type*} [Fintype ι] {V : ValuationSubring K}

/-- Let `x_1, ..., x_r` be nonzero elements of `K` whose values are linearly independent over `ℤ`, and let `y_1, ..., y_t ∈ K` be such that `k(y)` is in the valuation ring of the restriction of `V` to `K₀ = k(x, y)`. Then each nonzero `c ∈ K₀` has the value of a Laurent monomial `x^a`. -/
theorem exists_valuation_eq_laurentMonomial_of_mem_adjoin_sumElim {x : ι → K} {y : κ → K}
    (hx0 : ∀ i, x i ≠ 0)
    (hx : ∀ a : ι → ℤ, V.valuation (laurentMonomial x a) = 1 → a = 0)
    (hyV : ∀ c ∈ IntermediateField.adjoin k
        (Set.range fun j => adjoinRangeElem k (Sum.elim x y) (.inr j)),
      c ∈ V.comap (algebraMap (IntermediateField.adjoin k (Set.range (Sum.elim x y))) K))
    {c : IntermediateField.adjoin k (Set.range (Sum.elim x y))} (hc : c ≠ 0) :
    ∃ a : ι → ℤ, V.valuation (c : K) = V.valuation (laurentMonomial x a) := by
  let F := IntermediateField.adjoin k
    (Set.range fun j => adjoinRangeElem k (Sum.elim x y) (.inr j))
  let W := V.comap (algebraMap (IntermediateField.adjoin k (Set.range (Sum.elim x y))) K)
  let _ : Algebra F W :=
    ((algebraMap F (IntermediateField.adjoin k (Set.range (Sum.elim x y)))).codRestrict W
      fun c => hyV c c.2).toAlgebra
  have _ : IsScalarTower F W (IntermediateField.adjoin k (Set.range (Sum.elim x y))) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hV := isMonomialValuation_comap_adjoin_sumElim (k := k) (V := V) (y := y) hx0 hx
  obtain ⟨a, ha⟩ := MonomialValuation.exists_valuation_eq hV hc
  refine ⟨a, ?_⟩
  have hm : laurentMonomial (fun i => adjoinRangeElem k (Sum.elim x y) (.inl i)) a ≠ 0 :=
    laurentMonomial_ne_zero (fun i h => hx0 i (congrArg Subtype.val h)) a
  have hmK : algebraMap (IntermediateField.adjoin k (Set.range (Sum.elim x y))) K
      (laurentMonomial (fun i => adjoinRangeElem k (Sum.elim x y) (.inl i)) a) =
        laurentMonomial x a := by
    simp [laurentMonomial, map_prod, map_zpow₀]
  have h1 : (V.comap (algebraMap (IntermediateField.adjoin k (Set.range (Sum.elim x y))) K)).valuation
      (c * (laurentMonomial (fun i => adjoinRangeElem k (Sum.elim x y) (.inl i)) a)⁻¹) = 1 := by
    rw [map_mul, map_inv₀, ha, mul_inv_cancel₀ ((Valuation.ne_zero_iff _).mpr hm)]
  rw [valuation_comap_eq_one_iff, map_mul, map_inv₀, hmK] at h1
  have hmK0 : V.valuation (laurentMonomial x a) ≠ 0 :=
    (Valuation.ne_zero_iff _).mpr (laurentMonomial_ne_zero hx0 a)
  rw [map_mul, map_inv₀, mul_inv_eq_one₀ hmK0] at h1
  exact h1

end Values

/-! ### The value group -/

section ValueGroup

variable {V : ValuationSubring K} [Algebra k V] [IsScalarTower k V K]

/-- **The value group of an Abhyankar valuation is free** (Volume 3, Corollary 2.2.4 of the handbook). Let `V` be an Abhyankar valuation of the function field `K/k`. Then the value group of `V` is a free abelian group of finite rank.

Let `K₀ = k(x, y)` be the subfield of `Singularity.IsAbhyankarValuation.exists_isMonomialValuation_comap`, and let `Γ₀` be the subgroup that the values of the `x_i` generate. It contains the values of `K₀`, and `[K : K₀]` is finite, so `Γ / Γ₀` is finite (`Singularity.finite_quotient_of_valuation_mem`). Then the generators of `Γ₀` and one element of each coset generate `Γ`. -/
theorem IsAbhyankarValuation.free_valueGroup (hK : IsFunctionField k K)
    (hV : IsAbhyankarValuation k V) :
    Module.Finite ℤ (Additive V.ValueGroupˣ) ∧ Module.Free ℤ (Additive V.ValueGroupˣ) := by
  classical
  obtain ⟨r, t, x, y, -, -, hx0, hx, -, -, hfin, hyV, -⟩ :=
    hV.exists_isMonomialValuation_comap hK
  set E := IntermediateField.adjoin k (Set.range (Sum.elim x fun j => (y j : K)))
  let u : Fin r → V.ValueGroupˣ := fun i =>
    Units.mk0 (V.valuation (x i)) (valuation_ne_zero_of_ne_zero V (hx0 i))
  set H := Subgroup.closure (Set.range u)
  have hlm : ∀ a : Fin r → ℤ, ∀ h,
      Units.mk0 (V.valuation (laurentMonomial x a)) h = ∏ i, u i ^ a i := by
    intro a h
    ext
    simp [u, laurentMonomial, map_prod, map_zpow₀, Units.coe_prod]
  have hH : ∀ (c : E) (hc : (c : K) ≠ 0),
      Units.mk0 (V.valuation (c : K)) (valuation_ne_zero_of_ne_zero V hc) ∈ H := by
    intro c hc
    have hc' : c ≠ 0 := fun h => hc (by rw [h]; rfl)
    obtain ⟨a, ha⟩ := exists_valuation_eq_laurentMonomial_of_mem_adjoin_sumElim hx0 hx hyV hc'
    have : Units.mk0 (V.valuation (c : K)) (valuation_ne_zero_of_ne_zero V hc) =
        Units.mk0 (V.valuation (laurentMonomial x a))
          (valuation_ne_zero_of_ne_zero V (laurentMonomial_ne_zero hx0 a)) := by
      ext
      exact ha
    rw [this, hlm]
    exact H.prod_mem fun i _ => H.zpow_mem (Subgroup.subset_closure ⟨i, rfl⟩) _
  haveI := finite_quotient_of_valuation_mem V H hH
  haveI : Fintype (V.ValueGroupˣ ⧸ H) := Fintype.ofFinite _
  have hfg : Group.FG V.ValueGroupˣ := by
    rw [Group.fg_iff]
    refine ⟨Set.range u ∪ Set.range fun q : V.ValueGroupˣ ⧸ H => q.out, ?_,
      (Set.finite_range _).union (Set.finite_range _)⟩
    rw [eq_top_iff]
    intro γ _
    have hHS : H ≤ Subgroup.closure
        (Set.range u ∪ Set.range fun q : V.ValueGroupˣ ⧸ H => q.out) :=
      Subgroup.closure_mono Set.subset_union_left
    set q : V.ValueGroupˣ ⧸ H := QuotientGroup.mk γ
    have hq : q.out ∈ Subgroup.closure
        (Set.range u ∪ Set.range fun q : V.ValueGroupˣ ⧸ H => q.out) :=
      Subgroup.subset_closure (Set.mem_union_right _ ⟨q, rfl⟩)
    have hmem : q.out⁻¹ * γ ∈ H := QuotientGroup.eq.mp (QuotientGroup.out_eq' q)
    have : γ = q.out * (q.out⁻¹ * γ) := by group
    rw [this]
    exact Subgroup.mul_mem _ hq (hHS hmem)
  have : Module.Finite ℤ (Additive V.ValueGroupˣ) :=
    Module.Finite.iff_addGroup_fg.mpr (AddGroup.fg_iff_mul_fg.mpr hfg)
  exact ⟨this, inferInstance⟩

/-- **A basis of the value group of an Abhyankar valuation** (Volume 3, Corollary 2.2.4 of the handbook). Let `V` be an Abhyankar valuation of the function field `K/k`, and let `r` be the rational rank of its value group `Γ`. Then `Γ` has a basis over `ℤ` with `r` elements. -/
theorem IsAbhyankarValuation.exists_basis_valueGroup (hK : IsFunctionField k K)
    (hV : IsAbhyankarValuation k V) {r : ℕ}
    (hr : Module.rank ℚ (ℚ ⊗[ℤ] Additive V.ValueGroupˣ) = r) :
    Nonempty (Module.Basis (Fin r) ℤ (Additive V.ValueGroupˣ)) := by
  obtain ⟨_, _⟩ := hV.free_valueGroup hK
  rw [(TensorProduct.isBaseChange ℤ (Additive V.ValueGroupˣ) ℚ).rank_eq] at hr
  have hfr : Module.finrank ℤ (Additive V.ValueGroupˣ) = r := Module.finrank_eq_of_rank_eq hr
  exact ⟨Module.finBasisOfFinrankEq ℤ _ hfr⟩

end ValueGroup

end Singularity
