import Singularity.Invariant.MaxOrderChart
import Singularity.Invariant.CoefficientIdealOrder

/-!
# The transform of a sum of powers of marked ideals

This file proves Volume 2, Lemma 3.2.2 (2) of the handbook for one blowup of the origin of affine space, in one chart. Let `k` be a field, let `N ≥ 1`, let `B_j` be ideals of `k[x_i : i ∈ σ]`, and let `c_j` be integers that divide `N`. Let `B = ∑_j B_j^(N / c_j)`. Assume that each `B_j` has order at least `c_j` at the origin. Then the origin is in the cosupport of `(B, N)` (`le_idealOrd_iSup_pow_iff`). In the `x_j`-chart of the blowup of the origin with translations `t`, the controlled transform of `(B, N)` is the sum of the powers `(B_j')^(N / c_j)`, where `B_j'` is the controlled transform of `(B_j, c_j)` (`chartTransformIdeal_iSup_pow`).

* `Singularity.map_pointChart_eq_span_mul_chartTransformIdeal`: if `ord I ≥ m`, then the ideal generated by the image of `I` is `x_j^m` times the controlled transform of `(I, m)`.
* `Singularity.colon_span_singleton_mul_eq`: in a domain, `(x J) : x = J` for `x ≠ 0`.
* `Singularity.chartTransformIdeal_iSup_pow`: Lemma 3.2.2 (2) in one chart.

The handbook states the lemma for the blowup of a smooth center in the cosupport. This file proves the case of the blowup of a point, in one chart.
-/

open MvPolynomial

namespace Singularity

/-- In a domain, let `x ≠ 0` and let `J` be an ideal. Then the colon ideal of `x J` by `x` is `J`. -/
theorem colon_span_singleton_mul_eq {A : Type*} [CommRing A] [IsDomain A] {x : A} (hx : x ≠ 0)
    (J : Ideal A) : (Ideal.span {x} * J).colon {x} = J := by
  ext g
  rw [Submodule.mem_colon_singleton, smul_eq_mul, mul_comm g x, Ideal.mem_span_singleton_mul]
  constructor
  · rintro ⟨h, hh, he⟩
    rwa [mul_left_cancel₀ hx he] at hh
  · intro hg
    exact ⟨g, hg, rfl⟩

variable {σ k : Type*} [Field k] [DecidableEq σ]

/-- Let `I` be an ideal with order at least `m` at the origin. Then in the `x_j`-chart of the blowup of the origin, the ideal generated by the image of `I` is `x_j^m` times the controlled transform of `(I, m)`. -/
theorem map_pointChart_eq_span_mul_chartTransformIdeal (j : σ) (t : σ → k) {m : ℕ}
    {I : Ideal (MvPolynomial σ k)} (hI : (m : ℕ∞) ≤ idealOrd I) :
    I.map (pointChart j t) = Ideal.span {X j ^ m} * chartTransformIdeal j t m I := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro f hf
    rw [Ideal.mem_comap, pointChart_eq_X_pow_mul_chartTransform j t (hI.trans (idealOrd_le_ord hf))]
    refine Ideal.mem_span_singleton_mul.mpr ⟨_, ?_, rfl⟩
    rw [mem_chartTransformIdeal, ← pointChart_eq_X_pow_mul_chartTransform j t
      (hI.trans (idealOrd_le_ord hf))]
    exact Ideal.mem_map_of_mem _ hf
  · intro g hg
    obtain ⟨h, hh, rfl⟩ := Ideal.mem_span_singleton_mul.mp hg
    exact mem_chartTransformIdeal.mp hh

/-- **Volume 2, Lemma 3.2.2 (2) of the handbook**, for the blowup of the origin, in the `x_j`-chart. Let `N ≥ 1`, let `c_j` divide `N`, and let `B_j` have order at least `c_j` at the origin. Then the controlled transform of `(∑_j B_j^(N / c_j), N)` is `∑_j (B_j')^(N / c_j)`, where `B_j'` is the controlled transform of `(B_j, c_j)`. -/
theorem chartTransformIdeal_iSup_pow {ι : Type*} (j : σ) (t : σ → k)
    (B : ι → Ideal (MvPolynomial σ k)) (c : ι → ℕ) {N : ℕ} (hc : ∀ i, c i ∣ N)
    (hB : ∀ i, (c i : ℕ∞) ≤ idealOrd (B i)) :
    chartTransformIdeal j t N (⨆ i, B i ^ (N / c i)) =
      ⨆ i, chartTransformIdeal j t (c i) (B i) ^ (N / c i) := by
  have hmap : (⨆ i, B i ^ (N / c i)).map (pointChart j t) =
      Ideal.span {X j ^ N} * ⨆ i, chartTransformIdeal j t (c i) (B i) ^ (N / c i) := by
    rw [Ideal.map_iSup, Submodule.mul_iSup]
    refine iSup_congr fun i => ?_
    rw [Ideal.map_pow, map_pointChart_eq_span_mul_chartTransformIdeal j t (hB i), mul_pow,
      Ideal.span_singleton_pow, ← pow_mul, Nat.mul_div_cancel' (hc i)]
  rw [chartTransformIdeal, hmap]
  exact colon_span_singleton_mul_eq (pow_ne_zero _ (X_ne_zero j)) _

end Singularity
