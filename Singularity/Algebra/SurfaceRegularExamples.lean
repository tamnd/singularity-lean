import Mathlib.Algebra.Module.SpanRankOperations
import Mathlib.Algebra.DualNumber
import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.RegularLocalRing.Polynomial
import Singularity.Algebra.NodeRegular

/-!
# The surfaces `A_m` over a field

This file proves Volume 1, Example 1.2.11 of the handbook in part: the surfaces `A_m` and the
ramified discrete valuation ring.

Let `k` be a field, let `𝔪 = (X 0, X 1, X 2)` in `k[X 0, X 1, X 2]` and let `S` be the
localization at `𝔪`. Put `f_m = X 0 * X 1 - X 2 ^ (m + 1)`.

* `Singularity.Algebra.SurfaceA.equation_mem_maximalIdeal_sq`: if `1 ≤ m`, then
  `f_m ∈ 𝔪_S²`.
* `Singularity.Algebra.SurfaceA.not_isRegularLocalRing_quotient`: if `1 ≤ m`, then `S / (f_m)`
  is not a regular local ring.
* `Singularity.Algebra.SurfaceA.equation_zero_not_mem_maximalIdeal_sq`: `f_0 ∉ 𝔪_S²`.
* `Singularity.Algebra.SurfaceA.isRegularLocalRing_quotient_zero`: `S / (f_0)` is a regular
  local ring.

Let `p` be a prime and let `S = ℤ[x]_(p, x)`.

* `Singularity.Algebra.RamifiedDVR.ramifiedEquation_not_mem_maximalIdeal_sq`: `x^2 - p ∉ 𝔪_S²`.
* `Singularity.Algebra.RamifiedDVR.isRegularLocalRing_quotient`: `S / (x^2 - p)` is regular.
* `Singularity.Algebra.RamifiedDVR.isDiscreteValuationRing_quotient`: `S / (x^2 - p)` is a
  discrete valuation ring, and its maximal ideal is generated by the class of `x`.

The rings `S` are regular by the Mathlib instances for polynomial rings over a regular ring.
The criterion "`S / (f)` is regular if and only if `f ∉ 𝔪_S²`" is
`Singularity.Algebra.isRegularLocalRing_quotient_span_singleton_iff` in
`Singularity/Algebra/NodeRegular.lean`. To show
`f_0 ∉ 𝔪_S²` we use the map `S → k[ε]` with `X 0, X 1 ↦ 0` and `X 2 ↦ ε`. It kills `𝔪_S²` and
sends `f_0` to `-ε`. To show `x^2 - p ∉ 𝔪_S²` we take constant coefficients: `𝔪²` goes into
`p² ℤ`, while `(x^2 - p) s` has constant coefficient `-p s(0)` with `p ∤ s(0)`. The class of
`x` in `S / (x^2 - p)` is not zero, because the map `x ↦ ε` to `𝔽_p[ε]` kills `x^2 - p`.

Not proved here: the dimension statements, the isomorphism `S / (f_0) ≅ k[x, y]_(x, y)`, the
arithmetic regular local ring `ℤ[x]_(p, x)` of dimension 2 (beyond its regularity, which comes
from Mathlib), the statement that `R / (p)` is not regular, and the arithmetic cusp.
-/

open IsLocalRing Ideal

namespace Singularity.Algebra.SurfaceA

universe u

open MvPolynomial

variable (k : Type u) [Field k]

/-- The ideal `(X 0, X 1, X 2)` of `k[X 0, X 1, X 2]`. -/
noncomputable def originIdeal : Ideal (MvPolynomial (Fin 3) k) := Ideal.span (Set.range X)

/-- The ideal `(X 0, X 1, X 2)` is the kernel of the constant coefficient map. -/
theorem originIdeal_eq_ker :
    originIdeal k = RingHom.ker (constantCoeff (σ := Fin 3) (R := k)) := by
  ext p
  rw [originIdeal, ← Set.image_univ, mem_ideal_span_X_image, RingHom.mem_ker]
  constructor
  · intro h
    by_contra hp
    obtain ⟨i, -, hi⟩ := h 0 (by rwa [mem_support_iff, ← constantCoeff_eq])
    exact hi rfl
  · intro h n hn
    by_contra hc
    push Not at hc
    have : n = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
    subst this
    exact (mem_support_iff.mp hn) (by rwa [← constantCoeff_eq])

theorem mem_originIdeal_iff (p : MvPolynomial (Fin 3) k) :
    p ∈ originIdeal k ↔ constantCoeff p = 0 := by
  rw [originIdeal_eq_ker, RingHom.mem_ker]

instance originIdeal_isMaximal : (originIdeal k).IsMaximal := by
  rw [originIdeal_eq_ker]
  exact RingHom.ker_isMaximal_of_surjective _ fun a => ⟨C a, constantCoeff_C _ _⟩

/-- The local ring `S = k[X 0, X 1, X 2]` localized at `(X 0, X 1, X 2)`. -/
abbrev LocalRingAtOrigin := Localization.AtPrime (originIdeal k)

/-- The equation `X 0 * X 1 - X 2 ^ (m + 1)` of the surface `A_m`, as an element of `S`. -/
noncomputable def equation (m : ℕ) : LocalRingAtOrigin k :=
  algebraMap (MvPolynomial (Fin 3) k) _ (X 0 * X 1 - X 2 ^ (m + 1))

theorem X_mem_originIdeal (i : Fin 3) : (X i : MvPolynomial (Fin 3) k) ∈ originIdeal k :=
  Ideal.subset_span ⟨i, rfl⟩

theorem maximalIdeal_eq_map :
    maximalIdeal (LocalRingAtOrigin k) = (originIdeal k).map (algebraMap _ _) :=
  (Localization.AtPrime.map_eq_maximalIdeal).symm

theorem equation_mem_maximalIdeal (m : ℕ) :
    equation k m ∈ maximalIdeal (LocalRingAtOrigin k) := by
  rw [maximalIdeal_eq_map]
  refine Ideal.mem_map_of_mem _ (sub_mem (mul_mem_right _ _ (X_mem_originIdeal k 0)) ?_)
  exact Ideal.pow_mem_of_mem _ (X_mem_originIdeal k 2) _ (Nat.succ_pos m)

theorem equation_ne_zero (m : ℕ) : equation k m ≠ 0 := by
  intro h
  have hinj := IsLocalization.injective (LocalRingAtOrigin k)
    (M := (originIdeal k).primeCompl) (primeCompl_le_nonZeroDivisors _)
  have h0 : (X 0 * X 1 - X 2 ^ (m + 1) : MvPolynomial (Fin 3) k) = 0 :=
    hinj (by rw [map_zero]; exact h)
  have := congrArg (eval ![1, 1, 0]) h0
  simp at this

/-- Volume 1, Example 1.2.11: for `m ≥ 1`, the equation of `A_m` is in `𝔪_S²`. -/
theorem equation_mem_maximalIdeal_sq {m : ℕ} (hm : 1 ≤ m) :
    equation k m ∈ maximalIdeal (LocalRingAtOrigin k) ^ 2 := by
  rw [maximalIdeal_eq_map, ← Ideal.map_pow]
  refine Ideal.mem_map_of_mem _ (sub_mem ?_ ?_)
  · rw [sq]
    exact Ideal.mul_mem_mul (X_mem_originIdeal k 0) (X_mem_originIdeal k 1)
  · obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le hm
    rw [show 1 + n + 1 = 2 + n by omega, pow_add]
    exact mul_mem_right _ _ (Ideal.pow_mem_pow (X_mem_originIdeal k 2) 2)

/-- Volume 1, Example 1.2.11: for `m ≥ 1`, the local ring `S / (xy - z^(m+1))` of `A_m` is not a
regular local ring. -/
theorem not_isRegularLocalRing_quotient {m : ℕ} (hm : 1 ≤ m) :
    ¬ IsRegularLocalRing (LocalRingAtOrigin k ⧸ span {equation k m}) := by
  rw [isRegularLocalRing_quotient_span_singleton_iff _ (equation_mem_maximalIdeal k m)
    (equation_ne_zero k m), not_not]
  exact equation_mem_maximalIdeal_sq k hm

/-- The map `k[X 0, X 1, X 2] → k[ε]` with `X 0, X 1 ↦ 0` and `X 2 ↦ ε`. -/
noncomputable def toDualNumber : MvPolynomial (Fin 3) k →+* DualNumber k :=
  (aeval fun i : Fin 3 => if i = 2 then (DualNumber.eps : DualNumber k) else 0).toRingHom

theorem fst_toDualNumber (p : MvPolynomial (Fin 3) k) :
    (toDualNumber k p).fst = constantCoeff p := by
  have : (TrivSqZeroExt.fstHom k k k).toRingHom.comp (toDualNumber k) = constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [toDualNumber]
    · intro i
      by_cases hi : i = 2 <;> simp [toDualNumber, hi]
  exact congrArg (fun g : MvPolynomial (Fin 3) k →+* k => g p) this

theorem isUnit_toDualNumber (y : (originIdeal k).primeCompl) : IsUnit (toDualNumber k y) := by
  rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, fst_toDualNumber, isUnit_iff_ne_zero]
  have : (y : MvPolynomial (Fin 3) k) ∉ originIdeal k := y.2
  exact fun h => this ((mem_originIdeal_iff k _).mpr h)

/-- The extension of `toDualNumber` to the local ring `S`. -/
noncomputable def liftDualNumber : LocalRingAtOrigin k →+* DualNumber k :=
  IsLocalization.lift (M := (originIdeal k).primeCompl) (isUnit_toDualNumber k)

/-- Volume 1, Example 1.2.11: the element `xy - z` is not in `𝔪_S²`. -/
theorem equation_zero_not_mem_maximalIdeal_sq :
    equation k 0 ∉ maximalIdeal (LocalRingAtOrigin k) ^ 2 := by
  intro h
  let J : Ideal (DualNumber k) := RingHom.ker (TrivSqZeroExt.fstHom k k k)
  have hJ : J ^ 2 = ⊥ := by
    rw [sq, eq_bot_iff]
    refine Ideal.mul_le.mpr fun a ha b hb => ?_
    simp only [J, RingHom.mem_ker, TrivSqZeroExt.fstHom_apply] at ha hb
    rw [Ideal.mem_bot]
    ext <;> simp [ha, hb]
  have hmap : (maximalIdeal (LocalRingAtOrigin k) ^ 2).map (liftDualNumber k) ≤ J ^ 2 := by
    rw [Ideal.map_pow]
    refine Ideal.pow_right_mono ?_ 2
    rw [maximalIdeal_eq_map, Ideal.map_map, liftDualNumber, IsLocalization.lift_comp,
      Ideal.map_le_iff_le_comap]
    intro p hp
    rw [mem_originIdeal_iff] at hp
    simp [J, RingHom.mem_ker, fst_toDualNumber, hp]
  have h1 := hmap (Ideal.mem_map_of_mem _ h)
  rw [hJ, Ideal.mem_bot, equation, liftDualNumber, IsLocalization.lift_eq] at h1
  have h2 := congrArg TrivSqZeroExt.snd h1
  simp [toDualNumber] at h2

/-- Volume 1, Example 1.2.11: for `m = 0`, the local ring `S / (xy - z)` is a regular local
ring. -/
theorem isRegularLocalRing_quotient_zero :
    IsRegularLocalRing (LocalRingAtOrigin k ⧸ span {equation k 0}) :=
  (isRegularLocalRing_quotient_span_singleton_iff _ (equation_mem_maximalIdeal k 0)
    (equation_ne_zero k 0)).mpr (equation_zero_not_mem_maximalIdeal_sq k)

end Singularity.Algebra.SurfaceA

namespace Singularity.Algebra.RamifiedDVR

open Polynomial

variable (p : ℕ) [hp : Fact p.Prime]

/-- The ideal `(p, x)` of `ℤ[x]`. -/
noncomputable def primeXIdeal : Ideal ℤ[X] := Ideal.span {C (p : ℤ), X}

/-- The reduction map `ℤ[x] → 𝔽_p` with `x ↦ 0`. -/
noncomputable def reduction : ℤ[X] →+* ZMod p :=
  (Int.castRingHom (ZMod p)).comp (constantCoeff)

theorem reduction_apply (q : ℤ[X]) : reduction p q = ((q.coeff 0 : ℤ) : ZMod p) := by
  simp [reduction]

theorem mem_primeXIdeal_iff (q : ℤ[X]) : q ∈ primeXIdeal p ↔ (p : ℤ) ∣ q.coeff 0 := by
  constructor
  · intro hq
    have hle : primeXIdeal p ≤ RingHom.ker (reduction p) := by
      rw [primeXIdeal, Ideal.span_le]
      rintro _ (rfl | rfl) <;> simp [reduction]
    have := hle hq
    rwa [RingHom.mem_ker, reduction_apply, ZMod.intCast_zmod_eq_zero_iff_dvd] at this
  · rintro ⟨c, hc⟩
    obtain ⟨r, hr⟩ := X_dvd_sub_C (p := q)
    have hq : q = C (p : ℤ) * C c + X * r := by
      rw [← C_mul, ← hc, ← hr]; ring
    rw [hq, primeXIdeal]
    exact add_mem (mul_mem_right _ _ (Ideal.subset_span (by simp)))
      (mul_mem_right _ _ (Ideal.subset_span (by simp)))

omit hp in
theorem map_primeXIdeal {T : Type*} [Semiring T] (g : ℤ[X] →+* T) :
    (primeXIdeal p).map g = span {g (C (p : ℤ)), g X} := by
  rw [primeXIdeal, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]

include hp in
instance primeXIdeal_isMaximal : (primeXIdeal p).IsMaximal := by
  have : primeXIdeal p = RingHom.ker (reduction p) := by
    ext q
    rw [mem_primeXIdeal_iff, RingHom.mem_ker, reduction_apply, ZMod.intCast_zmod_eq_zero_iff_dvd]
  rw [this]
  exact RingHom.ker_isMaximal_of_surjective _ fun a : ZMod p =>
    ⟨C ((a.val : ℕ) : ℤ), by
      rw [reduction_apply, coeff_C_zero, Int.cast_natCast, ZMod.natCast_zmod_val]⟩

/-- The local ring `S = ℤ[x]_(p, x)`. -/
abbrev LocalRingAtPX := Localization.AtPrime (primeXIdeal p)

/-- The element `x^2 - p` of `S`. -/
noncomputable def ramifiedEquation : LocalRingAtPX p :=
  algebraMap ℤ[X] _ (X ^ 2 - C (p : ℤ))

theorem maximalIdeal_eq_map :
    maximalIdeal (LocalRingAtPX p) = (primeXIdeal p).map (algebraMap _ _) :=
  (Localization.AtPrime.map_eq_maximalIdeal).symm

theorem ramifiedEquation_mem_maximalIdeal :
    ramifiedEquation p ∈ maximalIdeal (LocalRingAtPX p) := by
  rw [maximalIdeal_eq_map]
  refine Ideal.mem_map_of_mem _ (sub_mem ?_ ?_)
  · exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (by simp)) _ two_pos
  · exact Ideal.subset_span (by simp)

/-- The element `x^2 - p` is not in `𝔪_S²`. -/
theorem ramifiedEquation_not_mem_maximalIdeal_sq :
    ramifiedEquation p ∉ maximalIdeal (LocalRingAtPX p) ^ 2 := by
  intro h
  rw [maximalIdeal_eq_map, ← Ideal.map_pow, ramifiedEquation,
    IsLocalization.mem_map_algebraMap_iff (M := (primeXIdeal p).primeCompl)] at h
  obtain ⟨⟨⟨a, ha⟩, ⟨s, hs⟩⟩, hsa⟩ := h
  have hinj := IsLocalization.injective (LocalRingAtPX p)
    (M := (primeXIdeal p).primeCompl) (primeCompl_le_nonZeroDivisors _)
  have heq : (X ^ 2 - C (p : ℤ)) * s = a := hinj (by simpa [map_mul] using hsa)
  have hmap : (primeXIdeal p ^ 2).map (constantCoeff : ℤ[X] →+* ℤ) ≤
      Ideal.span {((p : ℤ) ^ 2)} := by
    rw [Ideal.map_pow, ← Ideal.span_singleton_pow]
    refine Ideal.pow_right_mono ?_ 2
    rw [Ideal.map_le_iff_le_comap]
    intro q hq
    rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    simpa using (mem_primeXIdeal_iff p q).mp hq
  have h1 := hmap (Ideal.mem_map_of_mem constantCoeff ha)
  rw [← heq, Ideal.mem_span_singleton] at h1
  have hs' : ¬ (p : ℤ) ∣ s.coeff 0 := fun hd => hs ((mem_primeXIdeal_iff p s).mpr hd)
  apply hs'
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  simp only [map_mul, map_sub, map_pow, constantCoeff_apply, coeff_X_zero, coeff_C_zero] at h1
  obtain ⟨c, hc⟩ := h1
  refine ⟨-c, ?_⟩
  have : (p : ℤ) * (-(s.coeff 0)) = (p : ℤ) * ((p : ℤ) * c) := by
    linear_combination hc
  have := mul_left_cancel₀ hp0 this
  linear_combination -this

theorem ramifiedEquation_ne_zero : ramifiedEquation p ≠ 0 := fun h =>
  ramifiedEquation_not_mem_maximalIdeal_sq p (h ▸ zero_mem _)

/-- The map `ℤ[x] → 𝔽_p[ε]` with `x ↦ ε`. -/
noncomputable def toDualNumber : ℤ[X] →+* DualNumber (ZMod p) :=
  eval₂RingHom (Int.castRingHom _) DualNumber.eps

theorem fst_toDualNumber (q : ℤ[X]) : (toDualNumber p q).fst = reduction p q := by
  have : (TrivSqZeroExt.fstHom (ZMod p) (ZMod p) (ZMod p)).toRingHom.comp (toDualNumber p) =
      reduction p := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [toDualNumber, reduction]
    · simp [toDualNumber, reduction]
  exact congrArg (fun g : ℤ[X] →+* ZMod p => g q) this

theorem isUnit_toDualNumber (y : (primeXIdeal p).primeCompl) : IsUnit (toDualNumber p y) := by
  rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, fst_toDualNumber, reduction_apply]
  have : (y : ℤ[X]) ∉ primeXIdeal p := y.2
  rw [mem_primeXIdeal_iff, ← ZMod.intCast_zmod_eq_zero_iff_dvd] at this
  exact isUnit_iff_ne_zero.mpr this

/-- The extension of `toDualNumber` to `S`. -/
noncomputable def liftDualNumber : LocalRingAtPX p →+* DualNumber (ZMod p) :=
  IsLocalization.lift (M := (primeXIdeal p).primeCompl) (isUnit_toDualNumber p)

/-- The ring `R = S / (x^2 - p)`. -/
abbrev RamifiedRing := LocalRingAtPX p ⧸ span {ramifiedEquation p}

/-- Volume 1, Example 1.2.11: `S / (x^2 - p)` is a regular local ring. -/
theorem isRegularLocalRing_quotient :
    IsRegularLocalRing (LocalRingAtPX p ⧸ span {ramifiedEquation p}) :=
  (isRegularLocalRing_quotient_span_singleton_iff _ (ramifiedEquation_mem_maximalIdeal p)
    (ramifiedEquation_ne_zero p)).mpr (ramifiedEquation_not_mem_maximalIdeal_sq p)

theorem liftDualNumber_algebraMap (q : ℤ[X]) :
    liftDualNumber p (algebraMap _ _ q) = toDualNumber p q :=
  IsLocalization.lift_eq _ _

omit hp in
theorem span_pair_sq_eq {T : Type*} [CommRing T] (a : T) : span {a ^ 2, a} = span {a} := by
  apply le_antisymm
  · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    have ha : a ∈ span ({a} : Set T) := Ideal.subset_span (Set.mem_singleton a)
    exact ⟨Ideal.pow_mem_of_mem _ ha 2 two_pos, ha⟩
  · exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ rfl))

include hp in
/-- A regular local ring is a domain, so `S / (x^2 - p)` is a domain. -/
instance isDomain_quotient : IsDomain (RamifiedRing p) :=
  @isDomain_of_isRegularLocalRing _ _ (isRegularLocalRing_quotient p)

/-- Volume 1, Example 1.2.11: `S / (x^2 - p)` is a discrete valuation ring, with uniformizer the
class of `x`. -/
theorem isDiscreteValuationRing_quotient :
    IsDiscreteValuationRing (RamifiedRing p) := by
  have hreg : IsRegularLocalRing (RamifiedRing p) := isRegularLocalRing_quotient p
  have := hreg.toIsLocalRing
  have : IsNoetherianRing (RamifiedRing p) := inferInstance
  let xb : RamifiedRing p := Ideal.Quotient.mk _ (algebraMap ℤ[X] (LocalRingAtPX p) X)
  have hpx : Ideal.Quotient.mk (span {ramifiedEquation p})
      (algebraMap ℤ[X] (LocalRingAtPX p) (C (p : ℤ))) = xb ^ 2 := by
    rw [← map_pow, ← map_pow, eq_comm, Ideal.Quotient.eq, ← map_sub]
    exact Ideal.subset_span rfl
  have hmax : maximalIdeal (RamifiedRing p) = span {xb} := by
    rw [maximalIdeal_quotient_eq_map, maximalIdeal_eq_map, Ideal.map_map, map_primeXIdeal]
    simp only [RingHom.comp_apply]
    rw [hpx]
    exact span_pair_sq_eq xb
  have hxb : xb ≠ 0 := by
    intro h0
    let L : RamifiedRing p →+* DualNumber (ZMod p) :=
      Ideal.Quotient.lift _ (liftDualNumber p) (by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, ramifiedEquation, liftDualNumber_algebraMap]
      have hp0 : ((p : ℕ) : DualNumber (ZMod p)) = 0 := by
        ext <;> simp [TrivSqZeroExt.fst_natCast, TrivSqZeroExt.snd_natCast]
      simp [toDualNumber, hp0])
    have h1 : L xb = toDualNumber p X := by
      rw [← liftDualNumber_algebraMap]
      exact Ideal.Quotient.lift_mk _ _ _
    rw [h0, map_zero] at h1
    have := congrArg TrivSqZeroExt.snd h1
    simp [toDualNumber] at this
  refine ((IsDiscreteValuationRing.TFAE (RamifiedRing p) ?hF).out 1 5).mpr ?hP
  case hP => exact ⟨⟨xb, hmax⟩⟩
  intro hfield
  have h1 := IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield
  rw [hmax, Ideal.span_singleton_eq_bot] at h1
  exact hxb h1

end Singularity.Algebra.RamifiedDVR
