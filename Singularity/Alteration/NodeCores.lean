/-!
# The algebra of nodes and of an inseparable curve

This file proves algebraic parts of Volume 8 of the handbook, Section 1.2 and Section 2.1.

The ring `R[v]/(a v - b)` is written as `AdjoinRoot (C a * X - C b)`. The variable `v` is
`AdjoinRoot.root`. With `R = k[u, t]`, `a = u` and `b = t^n`, this is the ring
`P_n = k[u, v, t]/(uv - t^n)` of Example 2.1.6. We do not write the isomorphism with a quotient
of a polynomial ring in three variables. It is the regrouping of the variables.

## Main results

* `prime_C_mul_X_sub_C_of_not_dvd`: over a unique factorization domain `R`, if `a` is
  irreducible and `a ∤ b`, then `a v - b` is prime in `R[v]`. So `R[v]/(a v - b)` is a domain
  (`isDomain_adjoinRoot_node`).
* Proposition 2.1.2, polynomial model: `isDomain_node_polynomialModel`. For a unique
  factorization domain `A` and `h ≠ 0`, the ring `A[u, v]/(uv - h)` is a domain.
* Example 2.1.6: `isDomain_curveNode` (`P_n` is a domain), `curveNode_t_mem_of_u_mem` and
  `curveNode_t_mem_of_v_mem` (a prime that contains `u` or `v` contains `t`),
  `curveNodePoly_mem_origin_sq` (for `n ≥ 2` the equation lies in the square of the ideal of
  the origin), `isUnit_u_fibre` (for `c ≠ 0` the fibre `uv = c^n` has `u` invertible), and the
  chart identities `curveNode_chart_t` and `curveNode_chart_u` of the blowup of the origin.
* Example 2.1.7: `isDomain_divisorNode` (`Q_r` is a domain),
  `divisorNodePoly_mem_sq` (the equation lies in the square of the ideal of
  `u = v = t_i = t_j = 0` for `i ≠ j`), and the chart identity `divisorNode_chart`.
* Example 1.2.4: for `k = 𝔽_p(a)`, `irreducible_inseparablePoly` (`x^p - a` is irreducible),
  `not_separable_inseparablePoly`, `finrank_inseparableField` (`[k(a^{1/p}) : k] = p`),
  `isPurelyInseparable_inseparableField`, `not_isSeparable_inseparableField`,
  `isDomain_inseparableCurve` (`k[x, y]/(y^2 - x^p + a)` is a domain),
  `span_inseparableCurve_point` (the ideal `(x^p - a, y)` is generated by `y`), and
  `inseparableCurve_mem_sq` (over a field with `b^p = a`, the equation lies in the square of
  `(x - b, y)`).

## What is not proved

* Definition 2.1.1 and Theorem 2.1.8: semistable curves, splitness, the blowups and the regular
  model are not formalized. Mathlib has no curves with ordinary double points.
* Proposition 2.1.2: the complete local ring and the isomorphism with `A[[u, v]]/(uv - h)` are
  not proved. Only the polynomial model is treated.
* Example 2.1.6: the regularity of `P_n[1/u]`, the dimension and the cotangent space of the local
  ring at the origin, the regularity for `n = 1`, and the statement that the charts are the
  blowup charts are not proved. We do not prove that `uv - t` is not in the square of the ideal
  of the origin.
* Example 2.1.7: the fact that the singular locus is exactly the union of the subspaces
  `u = v = t_i = t_j = 0`, and the blowups, are not proved.
* Example 1.2.4: the regularity of the curve, the étale projection where `y ≠ 0`, and the
  statement that the local ring at the point is a discrete valuation ring are not proved. Only the
  ideal identity is proved. The singular point over `k'` is stated as the ideal membership, not as
  a statement on smoothness.
* Theorem 1.2.5 is not treated.
-/

namespace Singularity

open Polynomial

/-! ### The ring `R[v]/(a v - b)` -/

section NodeModel

/-- Over a unique factorization domain `R`, let `a` be irreducible with `a ∤ b`. Then
`a v - b` is a prime element of `R[v]`. -/
theorem prime_C_mul_X_sub_C_of_not_dvd {R : Type*} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] {a b : R} (ha : Irreducible a) (hab : ¬ a ∣ b) :
    Prime (C a * X - C b : R[X]) := by
  have hirr : Irreducible (C a * X + C (-b) : R[X]) :=
    irreducible_C_mul_X_add_C ha.ne_zero (ha.isRelPrime_iff_not_dvd.2 (by rwa [dvd_neg]))
  rw [map_neg, ← sub_eq_add_neg] at hirr
  exact UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr

/-- Over a unique factorization domain `R`, let `a` be irreducible with `a ∤ b`. Then
`R[v]/(a v - b)` is a domain. -/
theorem isDomain_adjoinRoot_node {R : Type*} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] {a b : R} (ha : Irreducible a) (hab : ¬ a ∣ b) :
    IsDomain (AdjoinRoot (C a * X - C b : R[X])) :=
  AdjoinRoot.isDomain_of_prime (prime_C_mul_X_sub_C_of_not_dvd ha hab)

variable {R : Type*} [CommRing R]

/-- In `R[v]/(a v - b)` we have `a v = b`. -/
theorem adjoinRoot_node_rel (a b : R) :
    AdjoinRoot.of (C a * X - C b) a * AdjoinRoot.root (C a * X - C b) =
      AdjoinRoot.of (C a * X - C b) b := by
  have h := AdjoinRoot.mk_self (f := (C a * X - C b : R[X]))
  rw [map_sub, map_mul, sub_eq_zero, AdjoinRoot.mk_C, AdjoinRoot.mk_C, AdjoinRoot.mk_X] at h
  exact h

/-- In `R[v]/(a v - b)`, if `b` is a unit, then `a` is a unit. -/
theorem isUnit_of_isUnit_adjoinRoot_node {a b : R} (hb : IsUnit b) :
    IsUnit (AdjoinRoot.of (C a * X - C b) a) := by
  have h := hb.map (AdjoinRoot.of (C a * X - C b))
  rw [← adjoinRoot_node_rel] at h
  exact isUnit_of_mul_isUnit_left h

/-- In `R[v]/(a v - b)`, an ideal that contains `a` contains `b`. -/
theorem adjoinRoot_node_mem_of_mem_left {a b : R} (I : Ideal (AdjoinRoot (C a * X - C b)))
    (h : AdjoinRoot.of (C a * X - C b) a ∈ I) : AdjoinRoot.of (C a * X - C b) b ∈ I := by
  rw [← adjoinRoot_node_rel]
  exact I.mul_mem_right _ h

/-- In `R[v]/(a v - b)`, an ideal that contains `v` contains `b`. -/
theorem adjoinRoot_node_mem_of_mem_right {a b : R} (I : Ideal (AdjoinRoot (C a * X - C b)))
    (h : AdjoinRoot.root (C a * X - C b) ∈ I) : AdjoinRoot.of (C a * X - C b) b ∈ I := by
  rw [← adjoinRoot_node_rel]
  exact I.mul_mem_left _ h

end NodeModel

/-! ### Proposition 2.1.2: the polynomial model `A[u, v]/(uv - h)` -/

/-- Volume 8, Proposition 2.1.2 of the handbook, the polynomial model. Let `A` be a unique
factorization domain and `h ≠ 0`. Then `A[u, v]/(uv - h)` is a domain. Here `u` is the
variable of `A[u]` and `v` is the root. -/
theorem isDomain_node_polynomialModel {A : Type*} [CommRing A] [IsDomain A]
    [UniqueFactorizationMonoid A] {h : A} (hh : h ≠ 0) :
    IsDomain (AdjoinRoot (C (X : A[X]) * X - C (C h))) := by
  refine isDomain_adjoinRoot_node Polynomial.prime_X.irreducible ?_
  rw [Polynomial.X_dvd_iff, coeff_C_zero]
  exact hh

/-! ### Example 2.1.6: the ring `k[u, v, t]/(uv - t^n)` -/

section CurveNode

variable (k : Type*) [Field k]

/-- A variable `X i` does not divide `g` if `g` does not vanish at a point with `i`-th
coordinate `0`. -/
theorem not_X_dvd_of_eval_ne_zero {σ : Type*} {i : σ} {g : MvPolynomial σ k} (x : σ → k)
    (hx : x i = 0) (hg : MvPolynomial.eval x g ≠ 0) : ¬ MvPolynomial.X i ∣ g := by
  rintro ⟨q, rfl⟩
  apply hg
  simp [hx]

/-- The polynomial `uv - t^n` in `k[u, t][v]`, where `u = X 0` and `t = X 1`. -/
noncomputable abbrev curveNodePoly (n : ℕ) : (MvPolynomial (Fin 2) k)[X] :=
  C (MvPolynomial.X 0) * X - C (MvPolynomial.X 1 ^ n)

/-- Volume 8, Example 2.1.6 of the handbook: `uv - t^n` is a prime element. -/
theorem prime_curveNodePoly (n : ℕ) : Prime (curveNodePoly k n) := by
  refine prime_C_mul_X_sub_C_of_not_dvd (MvPolynomial.X_prime).irreducible ?_
  exact not_X_dvd_of_eval_ne_zero k ![0, 1] (by simp) (by simp)

/-- Volume 8, Example 2.1.6 of the handbook: `P_n = k[u, v, t]/(uv - t^n)` is a domain. -/
theorem isDomain_curveNode (n : ℕ) : IsDomain (AdjoinRoot (curveNodePoly k n)) :=
  AdjoinRoot.isDomain_of_prime (prime_curveNodePoly k n)

/-- Volume 8, Example 2.1.6 of the handbook: a prime ideal of `P_n` that contains `u` contains
`t`. -/
theorem curveNode_t_mem_of_u_mem {n : ℕ} (𝔭 : Ideal (AdjoinRoot (curveNodePoly k n)))
    [𝔭.IsPrime] (hu : AdjoinRoot.of _ (MvPolynomial.X 0) ∈ 𝔭) :
    AdjoinRoot.of _ (MvPolynomial.X 1) ∈ 𝔭 := by
  refine ‹𝔭.IsPrime›.mem_of_pow_mem n ?_
  rw [← map_pow]
  exact adjoinRoot_node_mem_of_mem_left 𝔭 hu

/-- Volume 8, Example 2.1.6 of the handbook: a prime ideal of `P_n` that contains `v` contains
`t`. -/
theorem curveNode_t_mem_of_v_mem {n : ℕ} (𝔭 : Ideal (AdjoinRoot (curveNodePoly k n)))
    [𝔭.IsPrime] (hv : AdjoinRoot.root _ ∈ 𝔭) :
    AdjoinRoot.of _ (MvPolynomial.X 1) ∈ 𝔭 := by
  refine ‹𝔭.IsPrime›.mem_of_pow_mem n ?_
  rw [← map_pow]
  exact adjoinRoot_node_mem_of_mem_right 𝔭 hv

/-- The ideal `(u, v, t)` of the origin in `k[u, t][v]`. -/
noncomputable abbrev curveNodeOrigin : Ideal (MvPolynomial (Fin 2) k)[X] :=
  Ideal.span {C (MvPolynomial.X 0), X, C (MvPolynomial.X 1)}

/-- Volume 8, Example 2.1.6 of the handbook: for `n ≥ 2`, the equation `uv - t^n` lies in the
square of the ideal `(u, v, t)` of the origin. Its linear part is `0`. -/
theorem curveNodePoly_mem_origin_sq {n : ℕ} (hn : 2 ≤ n) :
    curveNodePoly k n ∈ curveNodeOrigin k ^ 2 := by
  have hu : C (MvPolynomial.X 0) ∈ curveNodeOrigin k := Ideal.subset_span (by simp)
  have hv : (X : (MvPolynomial (Fin 2) k)[X]) ∈ curveNodeOrigin k := Ideal.subset_span (by simp)
  have ht : C (MvPolynomial.X 1) ∈ curveNodeOrigin k := Ideal.subset_span (by simp)
  refine Ideal.sub_mem _ ?_ ?_
  · rw [pow_two]
    exact Ideal.mul_mem_mul hu hv
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn
    rw [map_pow, pow_add]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow ht 2)

/-- Volume 8, Example 2.1.6 of the handbook: for `c ≠ 0`, in the fibre `k[u, v]/(uv - c^n)`
the function `u` is a unit. So the fibre is the torus `𝔾_m`, with coordinate `u`. -/
theorem isUnit_u_fibre {c : k} (hc : c ≠ 0) (n : ℕ) :
    IsUnit (AdjoinRoot.of (C (X : k[X]) * X - C (C (c ^ n))) X) :=
  isUnit_of_isUnit_adjoinRoot_node (Polynomial.isUnit_C.mpr (pow_ne_zero n hc).isUnit)

/-- Volume 8, Example 2.1.6 of the handbook, the chart `t` of the blowup of the origin: with
`u = t u'` and `v = t v'`, the equation `uv - t^(n+2)` is `t^2 (u'v' - t^n)`. -/
theorem curveNode_chart_t {A : Type*} [CommRing A] (n : ℕ) (t u' v' : A) :
    (t * u') * (t * v') - t ^ (n + 2) = t ^ 2 * (u' * v' - t ^ n) := by
  ring

/-- Volume 8, Example 2.1.6 of the handbook, the chart `u` of the blowup of the origin: the
values `t = u t'` and `v = u^(n+1) t'^(n+2)` satisfy `uv = t^(n+2)`. -/
theorem curveNode_chart_u {A : Type*} [CommRing A] (n : ℕ) (u t' : A) :
    u * (u ^ (n + 1) * t' ^ (n + 2)) - (u * t') ^ (n + 2) = 0 := by
  ring

end CurveNode

/-! ### Example 2.1.7: the ring `k[u, v, t_1, ..., t_m]/(uv - t_1 ⋯ t_r)` -/

section DivisorNode

variable (k : Type*) [Field k] {ι : Type*}

/-- The polynomial `uv - ∏_{i ∈ s} t_i` in `k[u, t][v]`, where `u = X none` and
`t_i = X (some i)`. For `s = {1, ..., r}` this is the equation of `Q_r`. -/
noncomputable abbrev divisorNodePoly (s : Finset ι) : (MvPolynomial (Option ι) k)[X] :=
  C (MvPolynomial.X none) * X - C (∏ i ∈ s, MvPolynomial.X (some i))

/-- Volume 8, Example 2.1.7 of the handbook: `uv - t_1 ⋯ t_r` is a prime element. -/
theorem prime_divisorNodePoly (s : Finset ι) : Prime (divisorNodePoly k s) := by
  refine prime_C_mul_X_sub_C_of_not_dvd (MvPolynomial.X_prime).irreducible ?_
  exact not_X_dvd_of_eval_ne_zero k (fun o => Option.elim o 0 fun _ => 1) rfl (by simp)

/-- Volume 8, Example 2.1.7 of the handbook: `Q_r` is a domain. -/
theorem isDomain_divisorNode (s : Finset ι) : IsDomain (AdjoinRoot (divisorNodePoly k s)) :=
  AdjoinRoot.isDomain_of_prime (prime_divisorNodePoly k s)

/-- Volume 8, Example 2.1.7 of the handbook: for `i ≠ j` in `s`, the equation `uv - ∏ t_l` lies
in the square of the ideal `(u, v, t_i, t_j)`. So `Q_r` is not regular along the subspace
`u = v = t_i = t_j = 0`. -/
theorem divisorNodePoly_mem_sq [DecidableEq ι] {s : Finset ι} {i j : ι} (hi : i ∈ s)
    (hj : j ∈ s) (hij : i ≠ j) :
    divisorNodePoly k s ∈ Ideal.span {C (MvPolynomial.X none), X,
      C (MvPolynomial.X (some i)), C (MvPolynomial.X (some j))} ^ 2 := by
  set J : Ideal (MvPolynomial (Option ι) k)[X] := Ideal.span {C (MvPolynomial.X none), X,
      C (MvPolynomial.X (some i)), C (MvPolynomial.X (some j))}
  have hu : C (MvPolynomial.X none) ∈ J := Ideal.subset_span (by simp)
  have hv : (X : (MvPolynomial (Option ι) k)[X]) ∈ J := Ideal.subset_span (by simp)
  have hti : C (MvPolynomial.X (some i)) ∈ J := Ideal.subset_span (by simp)
  have htj : C (MvPolynomial.X (some j)) ∈ J := Ideal.subset_span (by simp)
  have hj' : j ∈ s.erase i := Finset.mem_erase.mpr ⟨hij.symm, hj⟩
  refine Ideal.sub_mem _ ?_ ?_
  · rw [pow_two]
    exact Ideal.mul_mem_mul hu hv
  · rw [← Finset.mul_prod_erase s _ hi, ← Finset.mul_prod_erase _ _ hj', map_mul, map_mul,
      ← mul_assoc, pow_two]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul hti htj)

/-- Volume 8, Example 2.1.7 of the handbook, the chart of the blowup of `(u, t_1)`: with
`u = u' t_1`, the equation `uv - t_1 g` is `t_1 (u'v - g)`. -/
theorem divisorNode_chart {A : Type*} [CommRing A] (u' v t₁ g : A) :
    (u' * t₁) * v - t₁ * g = t₁ * (u' * v - g) := by
  ring

end DivisorNode

/-! ### Example 1.2.4: a regular curve that is not smooth -/

section Inseparable

/-- The polynomial `x^p - a` over `k = 𝔽_p(a)`. -/
noncomputable abbrev inseparablePoly (p : ℕ) [Fact p.Prime] : (RatFunc (ZMod p))[X] :=
  X ^ p - C RatFunc.X

variable (p : ℕ) [hp : Fact p.Prime]

/-- Volume 8, Example 1.2.4 of the handbook: `x^p - a` is irreducible over `𝔽_p(a)`, since `a` is
not a `p`-th power. -/
theorem irreducible_inseparablePoly : Irreducible (inseparablePoly p) :=
  X_pow_sub_C_irreducible_of_prime hp.out fun b => Example.X_ne_pow hp.out.two_le b

/-- Volume 8, Example 1.2.4 of the handbook: `x^p - a` is not separable. Its derivative is `0`.
-/
theorem not_separable_inseparablePoly : ¬ (inseparablePoly p).Separable := by
  rw [separable_iff_derivative_ne_zero (irreducible_inseparablePoly p)]
  simp [derivative_X_pow]

instance : Fact (Irreducible (inseparablePoly p)) := ⟨irreducible_inseparablePoly p⟩

/-- The field `k(a^{1/p})`, with `k = 𝔽_p(a)`. -/
abbrev InseparableField (p : ℕ) [Fact p.Prime] : Type := AdjoinRoot (inseparablePoly p)

theorem inseparablePoly_ne_zero : inseparablePoly p ≠ 0 :=
  (irreducible_inseparablePoly p).ne_zero

theorem monic_inseparablePoly : (inseparablePoly p).Monic :=
  monic_X_pow_sub_C _ hp.out.ne_zero

/-- Volume 8, Example 1.2.4 of the handbook: `[k(a^{1/p}) : k] = p`. -/
theorem finrank_inseparableField :
    Module.finrank (RatFunc (ZMod p)) (InseparableField p) = p := by
  rw [(AdjoinRoot.powerBasis (inseparablePoly_ne_zero p)).finrank,
    AdjoinRoot.powerBasis_dim, natDegree_X_pow_sub_C]

/-- The root `b = a^{1/p}` satisfies `b^p = a`. -/
theorem root_pow_inseparableField :
    AdjoinRoot.root (inseparablePoly p) ^ p = AdjoinRoot.of _ RatFunc.X := by
  have h := AdjoinRoot.mk_self (f := inseparablePoly p)
  rw [map_sub, map_pow, sub_eq_zero, AdjoinRoot.mk_C, AdjoinRoot.mk_X] at h
  exact h

/-- Volume 8, Example 1.2.4 of the handbook: `k(a^{1/p})/k` is purely inseparable. -/
theorem isPurelyInseparable_inseparableField :
    IsPurelyInseparable (RatFunc (ZMod p)) (InseparableField p) := by
  rw [isPurelyInseparable_iff_perfectClosure_eq_top]
  have hroot : AdjoinRoot.root (inseparablePoly p) ∈ perfectClosure (RatFunc (ZMod p))
      (InseparableField p) := by
    rw [mem_perfectClosure_iff_pow_mem p]
    exact ⟨1, by rw [pow_one, root_pow_inseparableField]; exact ⟨_, rfl⟩⟩
  have hle : Algebra.adjoin (RatFunc (ZMod p)) {AdjoinRoot.root (inseparablePoly p)} ≤
      (perfectClosure (RatFunc (ZMod p)) (InseparableField p)).toSubalgebra :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr hroot)
  rw [AdjoinRoot.adjoinRoot_eq_top] at hle
  exact eq_top_iff.mpr fun x _ => hle Algebra.mem_top

/-- Volume 8, Example 1.2.4 of the handbook: `k(a^{1/p})/k` is not separable. -/
theorem not_isSeparable_inseparableField :
    ¬ Algebra.IsSeparable (RatFunc (ZMod p)) (InseparableField p) := by
  intro h
  have hs := Algebra.IsSeparable.isSeparable (RatFunc (ZMod p))
    (AdjoinRoot.root (inseparablePoly p))
  rw [IsSeparable, AdjoinRoot.minpoly_root (inseparablePoly_ne_zero p),
    (monic_inseparablePoly p).leadingCoeff, inv_one, C_1, mul_one] at hs
  exact not_separable_inseparablePoly p hs

/-- Eisenstein: for a prime `f` of a domain `R`, the polynomial `y^2 - f` is irreducible. -/
theorem irreducible_X_sq_sub_C_of_prime {R : Type*} [CommRing R] [IsDomain R] {f : R}
    (hf : Prime f) : Irreducible (X ^ 2 - C f : R[X]) := by
  have hP : (Ideal.span {f}).IsPrime := (Ideal.span_singleton_prime hf.ne_zero).mpr hf
  have hdeg : degree (X ^ 2 - C f : R[X]) = 2 := degree_X_pow_sub_C (by norm_num) f
  refine irreducible_of_eisenstein_criterion hP ?_ ?_ ?_ ?_
    (monic_X_pow_sub_C f two_ne_zero).isPrimitive
  · rw [(monic_X_pow_sub_C f two_ne_zero).leadingCoeff]
    exact fun h => hP.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  · intro n hn
    rw [hdeg] at hn
    have hn' : n < 2 := by exact_mod_cast hn
    interval_cases n
    · simp
    · simp
  · rw [hdeg]; norm_num
  · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    simp only [coeff_sub, coeff_X_pow, coeff_C_zero, OfNat.zero_ne_ofNat, ite_false, zero_sub]
    rintro ⟨q, hq⟩
    apply hf.not_isUnit
    refine IsUnit.of_mul_eq_one (-q) ?_
    have : f * (1 + f * q) = 0 := by linear_combination (-1 : R) * hq
    rcases mul_eq_zero.mp this with h | h
    · exact absurd h hf.ne_zero
    · linear_combination -h

/-- The polynomial `y^2 - (x^p - a)` in `k[x][y]`, with `k = 𝔽_p(a)`. -/
noncomputable abbrev inseparableCurvePoly (p : ℕ) [Fact p.Prime] :
    (RatFunc (ZMod p))[X][X] :=
  X ^ 2 - C (inseparablePoly p)

/-- Volume 8, Example 1.2.4 of the handbook: `y^2 - (x^p - a)` is irreducible. -/
theorem irreducible_inseparableCurvePoly : Irreducible (inseparableCurvePoly p) :=
  irreducible_X_sq_sub_C_of_prime
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp (irreducible_inseparablePoly p))

/-- Volume 8, Example 1.2.4 of the handbook: `k[x, y]/(y^2 - x^p + a)` is a domain, so `X` is an
integral curve. -/
theorem isDomain_inseparableCurve : IsDomain (AdjoinRoot (inseparableCurvePoly p)) :=
  AdjoinRoot.isDomain_of_prime
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp (irreducible_inseparableCurvePoly p))

/-- Volume 8, Example 1.2.4 of the handbook: in `k[x, y]/(y^2 - x^p + a)` the ideal
`(x^p - a, y)` is generated by `y`, since `x^p - a = y^2`. -/
theorem span_inseparableCurve_point :
    Ideal.span {AdjoinRoot.of (inseparableCurvePoly p) (inseparablePoly p),
      AdjoinRoot.root (inseparableCurvePoly p)} =
      Ideal.span {AdjoinRoot.root (inseparableCurvePoly p)} := by
  have h := AdjoinRoot.mk_self (f := inseparableCurvePoly p)
  rw [map_sub, map_pow, sub_eq_zero, AdjoinRoot.mk_C, AdjoinRoot.mk_X] at h
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono (by simp))
  rintro z (rfl | rfl)
  · rw [← h]
    exact Ideal.mem_span_singleton.mpr (dvd_pow_self _ two_ne_zero)
  · exact Ideal.subset_span rfl

/-- Volume 8, Example 1.2.4 of the handbook, the singular point. Let `K` be a ring of prime
characteristic `p` and `b ∈ K`. In `K[x, y]` the polynomial `y^2 - (x^p - b^p)` lies in the
square of the ideal `(x - b, y)`. Over `k' = k(a^{1/p})` with `b^p = a`, this is the equation of
`X`, so the point `x = b`, `y = 0` is singular. -/
theorem inseparableCurve_mem_sq (K : Type*) [CommRing K] [CharP K p] (b : K) :
    (MvPolynomial.X 1 ^ 2 - (MvPolynomial.X 0 ^ p - MvPolynomial.C (b ^ p)) :
      MvPolynomial (Fin 2) K) ∈
      Ideal.span {MvPolynomial.X 0 - MvPolynomial.C b, MvPolynomial.X 1} ^ 2 := by
  set I : Ideal (MvPolynomial (Fin 2) K) :=
    Ideal.span {MvPolynomial.X 0 - MvPolynomial.C b, MvPolynomial.X 1}
  have hx : MvPolynomial.X 0 - MvPolynomial.C b ∈ I := Ideal.subset_span (by simp)
  have hy : MvPolynomial.X 1 ∈ I := Ideal.subset_span (by simp)
  have e : (MvPolynomial.X 0 ^ p - MvPolynomial.C (b ^ p) : MvPolynomial (Fin 2) K) =
      (MvPolynomial.X 0 - MvPolynomial.C b) ^ 2 *
        (MvPolynomial.X 0 - MvPolynomial.C b) ^ (p - 2) := by
    rw [← pow_add, Nat.add_sub_cancel' hp.out.two_le, sub_pow_char, map_pow]
  rw [e]
  exact Ideal.sub_mem _ (Ideal.pow_mem_pow hy 2)
    (Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hx 2))

end Inseparable

end Singularity
