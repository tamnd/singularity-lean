import Mathlib.RingTheory.Valuation.ValuationSubring
import Mathlib.Topology.Bases
import Mathlib.Topology.Compactness.Compact

/-!
# The Zariski-Riemann space

This file defines the Zariski-Riemann space of a field and proves that it is quasi-compact (node SG0000000X, Theorem 1.5.3 of Volume 3 of the handbook).

Let `K` be a field and let `A` be a commutative ring with an algebra map `A → K`. The Zariski-Riemann space `ZR(K/A)` is the set of valuation subrings `V` of `K` that contain the image of `A`. For a finite subset `F` of `K`, the set `U(F)` is the set of `V` with `F ⊆ V`. The Zariski topology is the topology with the sets `U(F)` as a basis of open sets.

If `A` is a subring of `K`, then the algebra map is the inclusion, and `ZR(K/A)` is the set of valuation rings of `K` that contain `A`. If `K` is a function field over a field `k`, then `ZR(K/k)` is the set of valuation rings of `K/k`.

## Main definitions

* `Singularity.ZariskiRiemann A K`: the space `ZR(K/A)`.
* `Singularity.ZariskiRiemann.basicOpen F`: the set `U(F)` for a finite set `F` of `K`.
* `Singularity.ZariskiRiemann.instTopologicalSpace`: the Zariski topology, generated by the sets `U(F)`.

## Main results

* `Singularity.ZariskiRiemann.isOpen_basicOpen`: each set `U(F)` is open.
* `Singularity.ZariskiRiemann.isTopologicalBasis_basicOpen`: the sets `U(F)` are a basis of the topology.
* `Singularity.ZariskiRiemann.compactSpace`: the theorem of Zariski. The space `ZR(K/A)` is quasi-compact.
* `Singularity.ZariskiRiemann.instNonempty`: the space is not empty, because it contains `K`.

## The proof

The handbook embeds `ZR(K/A)` as a closed subset of the compact space `2^K` and compares the topologies. Here we use the equivalent form of this argument with ultrafilters. Let `𝒰` be an ultrafilter on `ZR(K/A)`. Let `V` be the set of `x` in `K` such that the set of `W` with `x ∈ W` is in `𝒰`. Each ring axiom for `V` follows from the ring axioms for each `W`, because `𝒰` is closed under finite intersections. For each `x`, the union of the sets of `W` with `x ∈ W` and with `x⁻¹ ∈ W` is the whole space, so one of the two sets is in `𝒰`. Thus `V` is a valuation subring of `K` that contains `A`. By the definition of `V`, each set `U(F)` with `F ⊆ V` is in `𝒰`. So `𝒰` converges to `V`, and the space is compact.

## References

* [ZS2] O. Zariski and P. Samuel, Commutative Algebra II, Chapter VI, Section 17, Theorem 40.
* [Zar44b] O. Zariski, The compactness of the Riemann manifold of an abstract field of algebraic functions.
-/

universe u v

namespace Singularity

open Topology Filter TopologicalSpace

/-- The Zariski-Riemann space `ZR(K/A)` (Definition 1.5.1 of Volume 3 of the handbook). Let `K` be a field and let `A` be a commutative ring with an algebra map `A → K`. A point of `ZR(K/A)` is a valuation subring `V` of `K` that contains the image of each element of `A`. For a subring `A` of `K`, these are the valuation rings of `K` that contain `A`. -/
def ZariskiRiemann (A : Type u) (K : Type v) [CommRing A] [Field K] [Algebra A K] : Type v :=
  {V : ValuationSubring K // ∀ a : A, algebraMap A K a ∈ V}

namespace ZariskiRiemann

variable {A : Type u} {K : Type v} [CommRing A] [Field K] [Algebra A K]

/-- The valuation subring of `K` that is a point of `ZR(K/A)`. -/
def toValuationSubring (V : ZariskiRiemann A K) : ValuationSubring K :=
  Subtype.val (p := fun V : ValuationSubring K => ∀ a : A, algebraMap A K a ∈ V) V

/-- Each point of `ZR(K/A)` contains the image of `A`. -/
theorem algebraMap_mem (V : ZariskiRiemann A K) (a : A) :
    algebraMap A K a ∈ V.toValuationSubring :=
  Subtype.property (p := fun V : ValuationSubring K => ∀ a : A, algebraMap A K a ∈ V) V a

/-- The point of `ZR(K/A)` given by a valuation subring `V` of `K` that contains the image of `A`. -/
def mk (V : ValuationSubring K) (hV : ∀ a : A, algebraMap A K a ∈ V) : ZariskiRiemann A K :=
  ⟨V, hV⟩

/-- The valuation subring of the point `mk V hV` is `V`. -/
@[simp]
theorem toValuationSubring_mk (V : ValuationSubring K) (hV : ∀ a : A, algebraMap A K a ∈ V) :
    (mk V hV).toValuationSubring = V :=
  rfl

/-- Two points of `ZR(K/A)` are equal if their valuation subrings are equal. -/
@[ext]
theorem ext {V W : ZariskiRiemann A K} (h : V.toValuationSubring = W.toValuationSubring) :
    V = W :=
  Subtype.ext h

variable (A K) in
/-- The point `K` of `ZR(K/A)`: the field `K` is a valuation subring of itself. -/
def top : ZariskiRiemann A K :=
  mk ⊤ fun _ => ValuationSubring.mem_top _

/-- The space `ZR(K/A)` is not empty, because it contains `K`. -/
instance instNonempty : Nonempty (ZariskiRiemann A K) :=
  ⟨top A K⟩

/-- The basic open set `U(F)` of `ZR(K/A)` for a finite set `F` of `K`. It is the set of the points `V` with `F ⊆ V`. -/
def basicOpen (F : Finset K) : Set (ZariskiRiemann A K) :=
  {V | ∀ x ∈ F, x ∈ V.toValuationSubring}

/-- A point `V` is in `U(F)` if and only if each element of `F` is in `V`. -/
theorem mem_basicOpen {F : Finset K} {V : ZariskiRiemann A K} :
    V ∈ basicOpen F ↔ ∀ x ∈ F, x ∈ V.toValuationSubring :=
  Iff.rfl

/-- The set `U(∅)` is the whole space. -/
@[simp]
theorem basicOpen_empty : basicOpen (∅ : Finset K) = (Set.univ : Set (ZariskiRiemann A K)) := by
  ext V
  simp [mem_basicOpen]

/-- The intersection of `U(F)` and `U(G)` is `U(F ∪ G)`. -/
theorem basicOpen_union [DecidableEq K] (F G : Finset K) :
    (basicOpen (F ∪ G) : Set (ZariskiRiemann A K)) = basicOpen F ∩ basicOpen G := by
  ext V
  simp only [mem_basicOpen, Finset.mem_union, Set.mem_inter_iff]
  exact ⟨fun h => ⟨fun x hx => h x (Or.inl hx), fun x hx => h x (Or.inr hx)⟩,
    fun h x hx => hx.elim (h.1 x) (h.2 x)⟩

/-- The set `U(F)` is the intersection of the sets `U({x})` for `x ∈ F`. -/
theorem basicOpen_eq_biInter (F : Finset K) :
    (basicOpen F : Set (ZariskiRiemann A K)) =
      ⋂ x ∈ F, {V : ZariskiRiemann A K | x ∈ V.toValuationSubring} := by
  ext V
  simp [mem_basicOpen]

/-- The Zariski topology on `ZR(K/A)`. It is the topology generated by the sets `U(F)` for the finite sets `F` of `K`. -/
instance instTopologicalSpace : TopologicalSpace (ZariskiRiemann A K) :=
  generateFrom (Set.range basicOpen)

/-- Each basic set `U(F)` is open in the Zariski topology. -/
theorem isOpen_basicOpen (F : Finset K) : IsOpen (basicOpen F : Set (ZariskiRiemann A K)) :=
  isOpen_generateFrom_of_mem ⟨F, rfl⟩

/-- For each `x` in `K`, the set of the points `V` with `x ∈ V` is open. -/
theorem isOpen_setOf_mem (x : K) :
    IsOpen {V : ZariskiRiemann A K | x ∈ V.toValuationSubring} := by
  simpa [basicOpen_eq_biInter] using isOpen_basicOpen (A := A) ({x} : Finset K)

/-- The sets `U(F)` are a basis of the Zariski topology. -/
theorem isTopologicalBasis_basicOpen :
    IsTopologicalBasis (Set.range (basicOpen : Finset K → Set (ZariskiRiemann A K))) := by
  classical
  refine isTopologicalBasis_of_subbasis_of_finiteInter rfl ⟨⟨∅, basicOpen_empty⟩, ?_⟩
  rintro _ ⟨F, rfl⟩ _ ⟨G, rfl⟩
  exact ⟨F ∪ G, basicOpen_union F G⟩

/-- The limit of an ultrafilter `𝒰` on `ZR(K/A)`. It is the set of the elements `x` of `K` such that the set of the points `W` with `x ∈ W` is in `𝒰`. This set is a valuation subring of `K` that contains the image of `A`. -/
def limit (𝒰 : Ultrafilter (ZariskiRiemann A K)) : ZariskiRiemann A K :=
  mk
    { carrier := {x | {W : ZariskiRiemann A K | x ∈ W.toValuationSubring} ∈ 𝒰}
      mul_mem' := fun {x y} hx hy => mem_of_superset (inter_mem hx hy)
        fun W (hW : x ∈ W.toValuationSubring ∧ y ∈ W.toValuationSubring) =>
          show x * y ∈ W.toValuationSubring from MulMemClass.mul_mem hW.1 hW.2
      one_mem' := mem_of_superset univ_mem fun W _ => W.toValuationSubring.one_mem
      add_mem' := fun {x y} hx hy => mem_of_superset (inter_mem hx hy)
        fun W (hW : x ∈ W.toValuationSubring ∧ y ∈ W.toValuationSubring) =>
          show x + y ∈ W.toValuationSubring from AddMemClass.add_mem hW.1 hW.2
      zero_mem' := mem_of_superset univ_mem fun W _ => W.toValuationSubring.zero_mem
      neg_mem' := fun {x} hx => mem_of_superset hx fun W (hW : x ∈ W.toValuationSubring) =>
        show -x ∈ W.toValuationSubring from NegMemClass.neg_mem hW
      mem_or_inv_mem' := fun x => Ultrafilter.union_mem_iff.1 <|
        mem_of_superset univ_mem fun W _ => W.toValuationSubring.mem_or_inv_mem x }
    fun a => mem_of_superset univ_mem fun W _ => W.algebraMap_mem a

/-- An element `x` is in the limit of `𝒰` if and only if the set of the points `W` with `x ∈ W` is in `𝒰`. -/
theorem mem_limit {𝒰 : Ultrafilter (ZariskiRiemann A K)} {x : K} :
    x ∈ (limit 𝒰).toValuationSubring ↔
      {W : ZariskiRiemann A K | x ∈ W.toValuationSubring} ∈ 𝒰 :=
  Iff.rfl

/-- Each ultrafilter `𝒰` on `ZR(K/A)` converges to its limit `limit 𝒰`. -/
theorem le_nhds_limit (𝒰 : Ultrafilter (ZariskiRiemann A K)) : (𝒰 : Filter _) ≤ 𝓝 (limit 𝒰) := by
  rw [nhds_generateFrom]
  refine le_iInf₂ fun s hs => ?_
  obtain ⟨hV, F, rfl⟩ := hs
  rw [le_principal_iff, basicOpen_eq_biInter]
  exact (biInter_finset_mem F).2 fun x hx => mem_limit.1 (hV x hx)

/-- The theorem of Zariski (Theorem 1.5.3 of Volume 3 of the handbook, node SG0000000X). Let `K` be a field and let `A` be a commutative ring with an algebra map `A → K`. Then the Zariski-Riemann space `ZR(K/A)` is quasi-compact. For a subring `A` of `K`, this is [ZS2, Chapter VI, Section 17, Theorem 40]. -/
instance compactSpace : CompactSpace (ZariskiRiemann A K) :=
  ⟨isCompact_iff_ultrafilter_le_nhds.2 fun 𝒰 _ => ⟨limit 𝒰, Set.mem_univ _, le_nhds_limit 𝒰⟩⟩

end ZariskiRiemann

end Singularity
