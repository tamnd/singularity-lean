/-!
# The theorem of Hilbert and Serre

Let `R` be a commutative ring and let `S` be a commutative Noetherian `R`-algebra that is
generated by `r` elements `x_1, ..., x_r`. Let `N` be a Noetherian `S`-module with a grading
`N = ⊕ N_n` by `R`-submodules, such that `x_i N_n ⊆ N_(n+1)` and each `N_n` has finite length over
`R`. The theorem of Hilbert and Serre says that `n ↦ ℓ_R(N_n)` is eventually a polynomial of
degree less than `r`.

The proof is the standard induction on `r` with the kernel and the cokernel of the multiplication
by `x_r`. To make the induction possible with a fixed ring `S`, we prove the statement for modules
on which `x_i` acts as zero for `i ≥ s`, by induction on `s`.

We do not use the graded modules of Mathlib. A grading is a family `𝒩 : ℕ → Submodule R N` that
is independent and whose supremum is `⊤`.

For the Hilbert-Samuel function we apply the theorem to the associated graded module
`gr M = ⊕ I^n M / I^(n+1) M`. The ring `S` is the subalgebra of `End_R(gr M)` generated by the
multiplications by the generators `x_i` of `I`. These maps commute, thus `S` is commutative, and
`S` is Noetherian by the basis theorem of Hilbert. Then `ℓ(M / I^n M)` is the sum of the lengths
of the pieces of degree less than `n`.

## Main results

* `Singularity.Algebra.isEventuallyPolynomial_length_of_grading`: the theorem of Hilbert and
  Serre.
* `Singularity.Algebra.isEventuallyPolynomial_hilbertSamuel`: if `R` is Noetherian, `M` is a
  finite `R`-module, `I` is generated by `r` elements and `ℓ(M / I M)` is finite, then
  `n ↦ ℓ(M / I^n M)` is eventually a polynomial of degree at most `r`.
* `Singularity.Algebra.exists_hilbertSamuel_polynomial`: the same statement with an explicit
  polynomial over `ℚ`.
* `Singularity.Algebra.hilbertSamuel_ne_top_of_length_ne_top`: under the same hypotheses each
  value of the Hilbert-Samuel function is finite.

## References

* [AM69] M. F. Atiyah, I. G. Macdonald, *Introduction to Commutative Algebra*, Theorem 11.1,
  Corollary 11.2 and Proposition 11.4.
* [Mat89] H. Matsumura, *Commutative Ring Theory*, Theorem 13.2.
-/

universe u v w

namespace Singularity.Algebra

open Module Filter Finset

section Grading

variable {R : Type u} [CommRing R] {N : Type v} [AddCommGroup N] [Module R N]

/-- The family `π` of linear maps is a family of projections for the family of submodules `𝒩`:
`π n` maps into `𝒩 n`, is the identity on `𝒩 n`, is zero on `𝒩 m` for `m ≠ n`, and each element is
the sum of its finitely many components. -/
structure IsGradingProj (𝒩 : ℕ → Submodule R N) (π : ℕ → N →ₗ[R] N) : Prop where
  mem : ∀ n y, π n y ∈ 𝒩 n
  eq_self : ∀ n, ∀ y ∈ 𝒩 n, π n y = y
  eq_zero : ∀ n m, ∀ y ∈ 𝒩 m, m ≠ n → π n y = 0
  sum : ∀ y, ∃ D, (∀ n, D < n → π n y = 0) ∧ y = ∑ n ∈ range (D + 1), π n y

/-- An independent family of submodules with supremum `⊤` has a family of projections. -/
theorem exists_isGradingProj {𝒩 : ℕ → Submodule R N} (hind : iSupIndep 𝒩)
    (htop : ⨆ n, 𝒩 n = ⊤) : ∃ π, IsGradingProj 𝒩 π := by
  classical
  let _ : DirectSum.Decomposition 𝒩 :=
    (DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hind htop).chooseDecomposition
  refine ⟨fun n => (𝒩 n).subtype ∘ₗ DirectSum.component R ℕ (fun n => 𝒩 n) n ∘ₗ
    (DirectSum.decomposeLinearEquiv 𝒩).toLinearMap, ⟨?_, ?_, ?_, ?_⟩⟩
  · intro n y
    exact Submodule.coe_mem _
  · intro n y hy
    change ((DirectSum.decompose 𝒩 y n : 𝒩 n) : N) = y
    exact DirectSum.decompose_of_mem_same 𝒩 hy
  · intro n m y hy hmn
    change ((DirectSum.decompose 𝒩 y n : 𝒩 n) : N) = 0
    exact DirectSum.decompose_of_mem_ne 𝒩 hy hmn
  · intro y
    let s := (DirectSum.decompose 𝒩 y).support
    have hzero : ∀ n, n ∉ s → ((DirectSum.decompose 𝒩 y n : 𝒩 n) : N) = 0 := fun n hn => by
      rw [DFinsupp.notMem_support_iff.mp hn, Submodule.coe_zero]
    refine ⟨s.sup id, fun n hn => hzero n fun hs => ?_, ?_⟩
    · exact absurd (Finset.le_sup (f := id) hs) (not_le.mpr hn)
    · change y = ∑ n ∈ range (s.sup id + 1), ((DirectSum.decompose 𝒩 y n : 𝒩 n) : N)
      conv_lhs => rw [← DirectSum.sum_support_decompose 𝒩 y]
      refine Finset.sum_subset (fun n hn => ?_) fun n _ hn => hzero n hn
      exact mem_range.mpr (Nat.lt_succ_of_le (Finset.le_sup (f := id) hn))

variable {𝒩 : ℕ → Submodule R N} {π : ℕ → N →ₗ[R] N}

/-- The projection `π n` is zero on the sum of the pieces `𝒩 m` with `m ≠ n`. -/
theorem IsGradingProj.eq_zero_of_mem_iSup (h : IsGradingProj 𝒩 π) {n : ℕ} {y : N}
    (hy : y ∈ ⨆ m, ⨆ (_ : m ≠ n), 𝒩 m) : π n y = 0 := by
  have : (⨆ m, ⨆ (_ : m ≠ n), 𝒩 m) ≤ LinearMap.ker (π n) :=
    iSup₂_le fun m hm z hz => h.eq_zero n m z hz hm
  exact this hy

/-- A linear map of degree one commutes with the projections. -/
theorem IsGradingProj.apply_succ (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (μ : N →ₗ[R] N) (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (n : ℕ) (y : N) :
    π (n + 1) (μ y) = μ (π n y) := by
  have hy : y ∈ ⨆ m, 𝒩 m := htop ▸ Submodule.mem_top
  refine Submodule.iSup_induction 𝒩 (motive := fun y => π (n + 1) (μ y) = μ (π n y)) hy
    (fun m z hz => ?_) (by simp) (fun a b ha hb => by simp only [map_add, ha, hb])
  by_cases hmn : m = n
  · subst hmn
    rw [h.eq_self _ _ (hμ _ _ hz), h.eq_self _ _ hz]
  · rw [h.eq_zero (n + 1) (m + 1) _ (hμ _ _ hz) (by omega), h.eq_zero n m _ hz hmn, map_zero]

/-- A linear map of degree one has no component in degree zero. -/
theorem IsGradingProj.apply_zero (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (μ : N →ₗ[R] N) (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (y : N) : π 0 (μ y) = 0 := by
  have hy : y ∈ ⨆ m, 𝒩 m := htop ▸ Submodule.mem_top
  refine Submodule.iSup_induction 𝒩 (motive := fun y => π 0 (μ y) = 0) hy
    (fun m z hz => h.eq_zero 0 (m + 1) _ (hμ _ _ hz) (by omega)) (by simp)
    (fun a b ha hb => by simp only [map_add, ha, hb, add_zero])

end Grading

section Step

variable {R : Type u} [CommRing R] {S : Type w} [CommRing S] [Algebra R S]
  {N : Type v} [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N]

/-- The grading of the kernel of a map `μ`. -/
def kerGrading (μ : N →ₗ[S] N) (𝒩 : ℕ → Submodule R N) (n : ℕ) :
    Submodule R (LinearMap.ker μ) :=
  (𝒩 n).comap ((LinearMap.ker μ).subtype.restrictScalars R)

/-- The grading of the cokernel of a map `μ`. -/
def cokerGrading (μ : N →ₗ[S] N) (𝒩 : ℕ → Submodule R N) (n : ℕ) :
    Submodule R (N ⧸ LinearMap.range μ) :=
  (𝒩 n).map ((LinearMap.range μ).mkQ.restrictScalars R)

variable {𝒩 : ℕ → Submodule R N} {π : ℕ → N →ₗ[R] N} (μ : N →ₗ[S] N)

/-- The grading of the kernel is independent. -/
theorem iSupIndep_kerGrading (hind : iSupIndep 𝒩) : iSupIndep (kerGrading μ 𝒩) := by
  intro n
  rw [disjoint_iff_inf_le]
  rintro y ⟨hy1, hy2⟩
  have hle : (⨆ m, ⨆ (_ : m ≠ n), kerGrading μ 𝒩 m) ≤
      (⨆ m, ⨆ (_ : m ≠ n), 𝒩 m).comap ((LinearMap.ker μ).subtype.restrictScalars R) :=
    iSup₂_le fun m hm => Submodule.comap_mono (le_iSup₂ (f := fun m (_ : m ≠ n) => 𝒩 m) m hm)
  have h0 := (disjoint_iff_inf_le.mp (hind n)) ⟨hy1, hle hy2⟩
  rw [Submodule.mem_bot] at h0 ⊢
  exact Subtype.ext h0

/-- The pieces of the grading of the kernel of a map of degree one span the kernel. -/
theorem iSup_kerGrading (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) : ⨆ n, kerGrading μ 𝒩 n = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨y, hy⟩ -
  have hK : ∀ n, π n y ∈ LinearMap.ker μ := fun n => by
    have := h.apply_succ htop (μ.restrictScalars R) hμ n y
    rw [LinearMap.restrictScalars_apply, LinearMap.restrictScalars_apply,
      LinearMap.mem_ker.mp hy, map_zero] at this
    exact LinearMap.mem_ker.mpr this.symm
  obtain ⟨D, -, hD⟩ := h.sum y
  have : (⟨y, hy⟩ : LinearMap.ker μ) = ∑ n ∈ range (D + 1), ⟨π n y, hK n⟩ := by
    ext
    rw [Submodule.coe_sum]
    exact hD
  rw [this]
  exact Submodule.sum_mem _ fun n _ => Submodule.mem_iSup_of_mem n (h.mem n y)

/-- An element of degree one maps the kernel pieces into the next piece. -/
theorem smul_mem_kerGrading {t : S} (ht : ∀ n, ∀ y ∈ 𝒩 n, t • y ∈ 𝒩 (n + 1)) (n : ℕ)
    (y : LinearMap.ker μ) (hy : y ∈ kerGrading μ 𝒩 n) : t • y ∈ kerGrading μ 𝒩 (n + 1) :=
  ht n _ hy

/-- The inclusion of the kernel piece into `𝒩 n`. -/
def kerGradingIncl (n : ℕ) : kerGrading μ 𝒩 n →ₗ[R] 𝒩 n :=
  ((LinearMap.ker μ).subtype.restrictScalars R).restrict fun _ hy => hy

/-- The inclusion of the kernel piece is injective. -/
theorem kerGradingIncl_injective (n : ℕ) : Function.Injective (kerGradingIncl μ (𝒩 := 𝒩) n) :=
  fun a b hab => by
    have : ((a : LinearMap.ker μ) : N) = ((b : LinearMap.ker μ) : N) :=
      congrArg (fun z : 𝒩 n => (z : N)) hab
    exact Subtype.ext (Subtype.ext this)

/-- The restriction of `μ` to a map `𝒩 n → 𝒩 (n + 1)`. -/
def gradedMap (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (n : ℕ) : 𝒩 n →ₗ[R] 𝒩 (n + 1) :=
  (μ.restrictScalars R).restrict fun y hy => hμ n y hy

/-- The exact sequence `0 → K_n → N_n → μ(N_n) → 0` gives
`ℓ(N_n) = ℓ(K_n) + ℓ(μ(N_n))`. -/
theorem length_eq_kerGrading_add (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (n : ℕ) :
    length R (𝒩 n) = length R (kerGrading μ 𝒩 n) +
      length R (LinearMap.range (gradedMap μ hμ n)) := by
  refine length_eq_add_of_exact (kerGradingIncl μ n) (gradedMap μ hμ n).rangeRestrict
    (kerGradingIncl_injective μ n) (LinearMap.surjective_rangeRestrict _) ?_
  intro y
  constructor
  · intro hy
    have h1 : μ y = 0 :=
      congrArg (fun z : LinearMap.range (gradedMap μ hμ n) => ((z : 𝒩 (n + 1)) : N)) hy
    exact ⟨⟨⟨y, h1⟩, y.2⟩, rfl⟩
  · rintro ⟨z, rfl⟩
    exact Subtype.ext (Subtype.ext (LinearMap.mem_ker.mp z.1.2))

/-- The map from `𝒩 n` onto the cokernel piece. -/
def cokerGradingMk (n : ℕ) : 𝒩 n →ₗ[R] cokerGrading μ 𝒩 n :=
  ((LinearMap.range μ).mkQ.restrictScalars R).restrict fun _ hy => Submodule.mem_map_of_mem hy

/-- The map onto the cokernel piece is surjective. -/
theorem cokerGradingMk_surjective (n : ℕ) :
    Function.Surjective (cokerGradingMk μ (𝒩 := 𝒩) n) := by
  rintro ⟨c, hc⟩
  obtain ⟨y, hy, rfl⟩ := hc
  exact ⟨⟨y, hy⟩, rfl⟩

/-- Each component of an element of the range of `μ` is in the range of `μ`, if `μ` has
degree one. -/
theorem IsGradingProj.proj_mem_range (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (n : ℕ) (w : N) :
    π n (μ w) ∈ LinearMap.range μ := by
  cases n with
  | zero =>
    rw [show μ w = μ.restrictScalars R w from rfl, h.apply_zero htop _ hμ]
    exact zero_mem _
  | succ n =>
    rw [show μ w = μ.restrictScalars R w from rfl, h.apply_succ htop _ hμ]
    exact ⟨_, rfl⟩

/-- The exact sequence `0 → μ(N_n) → N_(n+1) → C_(n+1) → 0` gives
`ℓ(N_(n+1)) = ℓ(μ(N_n)) + ℓ(C_(n+1))`. -/
theorem length_succ_eq_add_cokerGrading (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (n : ℕ) :
    length R (𝒩 (n + 1)) = length R (LinearMap.range (gradedMap μ hμ n)) +
      length R (cokerGrading μ 𝒩 (n + 1)) := by
  refine length_eq_add_of_exact (LinearMap.range (gradedMap μ hμ n)).subtype
    (cokerGradingMk μ (n + 1)) (Submodule.subtype_injective _)
    (cokerGradingMk_surjective μ (n + 1)) ?_
  intro y
  constructor
  · intro hy
    have h1 : (y : N) ∈ LinearMap.range μ := by
      have := congrArg (fun z : cokerGrading μ 𝒩 (n + 1) => (z : N ⧸ LinearMap.range μ)) hy
      simp only [cokerGradingMk, Submodule.coe_zero] at this
      exact (Submodule.Quotient.mk_eq_zero _).mp this
    obtain ⟨w, hw⟩ := h1
    have h2 : (y : N) = μ (π n w) := by
      rw [← h.eq_self _ _ y.2, ← hw, show μ w = μ.restrictScalars R w from rfl,
        h.apply_succ htop _ hμ]
      rfl
    refine ⟨⟨y, ⟨π n w, h.mem n w⟩, Subtype.ext h2.symm⟩, rfl⟩
  · rintro ⟨⟨z, ⟨w, rfl⟩⟩, rfl⟩
    apply Subtype.ext
    simp only [cokerGradingMk, Submodule.coe_zero, Submodule.coe_subtype]
    exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨w, rfl⟩

/-- The grading of the cokernel of a map of degree one is independent. -/
theorem iSupIndep_cokerGrading (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) : iSupIndep (cokerGrading μ 𝒩) := by
  intro n
  rw [disjoint_iff_inf_le]
  rintro c ⟨hc1, hc2⟩
  obtain ⟨y, hy, rfl⟩ := hc1
  have hle : (⨆ m, ⨆ (_ : m ≠ n), cokerGrading μ 𝒩 m) ≤
      (⨆ m, ⨆ (_ : m ≠ n), 𝒩 m).map ((LinearMap.range μ).mkQ.restrictScalars R) :=
    iSup₂_le fun m hm => Submodule.map_mono (le_iSup₂ (f := fun m (_ : m ≠ n) => 𝒩 m) m hm)
  obtain ⟨z, hz, hzy⟩ := hle hc2
  have hyz : y - z ∈ LinearMap.range μ := (Submodule.Quotient.eq _).mp hzy.symm
  obtain ⟨w, hw⟩ := hyz
  have hy' : y = π n (μ w) := by
    rw [show μ w = μ.restrictScalars R w from rfl]
    simp only [LinearMap.restrictScalars_apply]
    rw [hw, map_sub, h.eq_self _ _ hy, h.eq_zero_of_mem_iSup hz, sub_zero]
  rw [Submodule.mem_bot]
  simp only [LinearMap.restrictScalars_apply, Submodule.mkQ_apply]
  rw [Submodule.Quotient.mk_eq_zero, hy']
  exact h.proj_mem_range μ htop hμ n w

/-- The pieces of the grading of the cokernel span the cokernel. -/
theorem iSup_cokerGrading (htop : ⨆ n, 𝒩 n = ⊤) : ⨆ n, cokerGrading μ 𝒩 n = ⊤ := by
  change (⨆ n, (𝒩 n).map ((LinearMap.range μ).mkQ.restrictScalars R)) = ⊤
  rw [← Submodule.map_iSup, htop, Submodule.map_top, LinearMap.range_eq_top]
  intro c
  obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range μ) c
  exact ⟨y, rfl⟩

/-- An element of degree one maps the cokernel pieces into the next piece. -/
theorem smul_mem_cokerGrading {t : S} (ht : ∀ n, ∀ y ∈ 𝒩 n, t • y ∈ 𝒩 (n + 1)) (n : ℕ)
    (c : N ⧸ LinearMap.range μ) (hc : c ∈ cokerGrading μ 𝒩 n) :
    t • c ∈ cokerGrading μ 𝒩 (n + 1) := by
  obtain ⟨y, hy, rfl⟩ := hc
  exact ⟨t • y, ht n y hy, rfl⟩

/-- The kernel pieces have finite length if the pieces of `N` have finite length. -/
theorem length_kerGrading_ne_top (hlen : ∀ n, length R (𝒩 n) ≠ ⊤) (n : ℕ) :
    length R (kerGrading μ 𝒩 n) ≠ ⊤ :=
  ne_top_of_le_ne_top (hlen n) (length_le_of_injective _ (kerGradingIncl_injective μ n))

/-- The cokernel pieces have finite length if the pieces of `N` have finite length. -/
theorem length_cokerGrading_ne_top (hlen : ∀ n, length R (𝒩 n) ≠ ⊤) (n : ℕ) :
    length R (cokerGrading μ 𝒩 n) ≠ ⊤ :=
  ne_top_of_le_ne_top (hlen n) (length_le_of_surjective _ (cokerGradingMk_surjective μ n))

/-- The inductive step: if the lengths of the pieces of the kernel and the cokernel of `μ` are
eventually polynomial of degree less than `s`, then the lengths of the pieces of `N` are
eventually polynomial of degree less than `s + 1`. -/
theorem isEventuallyPolynomial_of_ker_coker (h : IsGradingProj 𝒩 π) (htop : ⨆ n, 𝒩 n = ⊤)
    (hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1)) (hlen : ∀ n, length R (𝒩 n) ≠ ⊤) {s : ℕ}
    (hK : IsEventuallyPolynomial (fun n => ((length R (kerGrading μ 𝒩 n)).toNat : ℤ)) s)
    (hC : IsEventuallyPolynomial (fun n => ((length R (cokerGrading μ 𝒩 n)).toNat : ℤ)) s) :
    IsEventuallyPolynomial (fun n => ((length R (𝒩 n)).toNat : ℤ)) (s + 1) := by
  rw [← isEventuallyPolynomial_fwdDiff_iff]
  have key : fwdDiff 1 (fun n => ((length R (𝒩 n)).toNat : ℤ)) =
      (fun n => ((length R (cokerGrading μ 𝒩 (n + 1))).toNat : ℤ)) -
        (fun n => ((length R (kerGrading μ 𝒩 n)).toNat : ℤ)) := by
    ext n
    have e1 := length_eq_kerGrading_add μ hμ n
    have e2 := length_succ_eq_add_cokerGrading μ h htop hμ n
    have hR : length R (LinearMap.range (gradedMap μ hμ n)) ≠ ⊤ := by
      intro h'; apply hlen n; rw [e1, h', add_top]
    have hKn := length_kerGrading_ne_top μ hlen n
    have hCn := length_cokerGrading_ne_top μ hlen (n + 1)
    simp only [fwdDiff, Pi.sub_apply]
    rw [e1, e2, ENat.toNat_add hKn hR, ENat.toNat_add hR hCn]
    push_cast
    ring
  rw [key]
  exact (hC.comp_add 1).sub hK

end Step

section Main

variable {R : Type u} [CommRing R] {S : Type w} [CommRing S] [Algebra R S]

/-- If the generators of `S` act as zero on a finite `S`-module `N`, then a grading of `N` has
only finitely many nonzero pieces. -/
theorem eventually_eq_bot_of_smul_eq_zero {N : Type v} [AddCommGroup N] [Module S N]
    [Module R N] [IsScalarTower R S N] [Module.Finite S N] {r : ℕ} (x : Fin r → S)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (hzero : ∀ i (y : N), x i • y = 0)
    {𝒩 : ℕ → Submodule R N} {π : ℕ → N →ₗ[R] N} (h : IsGradingProj 𝒩 π) :
    ∀ᶠ n in atTop, 𝒩 n = ⊥ := by
  have hS : ∀ t : S, ∃ a : R, ∀ y : N, t • y = a • y := by
    intro t
    have ht : t ∈ Algebra.adjoin R (Set.range x) := hx ▸ Algebra.mem_top
    induction ht using Algebra.adjoin_induction with
    | mem t ht =>
      obtain ⟨i, rfl⟩ := ht
      exact ⟨0, fun y => by rw [hzero, zero_smul]⟩
    | algebraMap a => exact ⟨a, fun y => algebraMap_smul S a y⟩
    | add t t' _ _ h1 h2 =>
      obtain ⟨a, ha⟩ := h1
      obtain ⟨b, hb⟩ := h2
      exact ⟨a + b, fun y => by rw [add_smul, add_smul, ha, hb]⟩
    | mul t t' _ _ h1 h2 =>
      obtain ⟨a, ha⟩ := h1
      obtain ⟨b, hb⟩ := h2
      exact ⟨b * a, fun y => by rw [mul_smul, hb, smul_comm, ha, ← mul_smul]⟩
  obtain ⟨G, hG⟩ := (Module.Finite.fg_top : (⊤ : Submodule S N).FG)
  have hR : ∀ y : N, y ∈ Submodule.span R (G : Set N) := by
    intro y
    have hy : y ∈ Submodule.span S (G : Set N) := hG ▸ Submodule.mem_top
    induction hy using Submodule.span_induction with
    | mem z hz => exact Submodule.subset_span hz
    | zero => exact zero_mem _
    | add a b _ _ ha hb => exact add_mem ha hb
    | smul t z _ hz =>
      obtain ⟨a, ha⟩ := hS t
      rw [ha]
      exact Submodule.smul_mem _ a hz
  choose D hD using h.sum
  rw [eventually_atTop]
  refine ⟨G.sup D + 1, fun n hn => ?_⟩
  rw [eq_bot_iff]
  intro y hy
  have hle : Submodule.span R (G : Set N) ≤ LinearMap.ker (π n) :=
    Submodule.span_le.mpr fun g hg =>
      (hD g).1 n (lt_of_le_of_lt (Finset.le_sup (f := D) hg) (by omega))
  rw [Submodule.mem_bot, ← h.eq_self n y hy]
  exact hle (hR y)

/-- The theorem of Hilbert and Serre for modules on which `x_i` acts as zero for `i ≥ s`. -/
theorem isEventuallyPolynomial_length_aux {r : ℕ} (x : Fin r → S)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (s : ℕ) :
    ∀ (N : Type v) [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N]
      [IsNoetherian S N] (𝒩 : ℕ → Submodule R N), iSupIndep 𝒩 → ⨆ n, 𝒩 n = ⊤ →
      (∀ i n, ∀ y ∈ 𝒩 n, x i • y ∈ 𝒩 (n + 1)) → (∀ n, length R (𝒩 n) ≠ ⊤) →
      (∀ i : Fin r, s ≤ (i : ℕ) → ∀ y : N, x i • y = 0) →
      IsEventuallyPolynomial (fun n => ((length R (𝒩 n)).toNat : ℤ)) s := by
  induction s with
  | zero =>
    intro N _ _ _ _ _ 𝒩 hind htop _ _ hzero
    obtain ⟨π, hπ⟩ := exists_isGradingProj hind htop
    refine isEventuallyPolynomial_of_eventually_zero ?_
    refine (eventually_eq_bot_of_smul_eq_zero x hx (fun i y => hzero i (Nat.zero_le _) y)
      hπ).mono fun n hn => ?_
    rw [hn, length_bot]
    rfl
  | succ s ih =>
    intro N _ _ _ _ _ 𝒩 hind htop hsmul hlen hzero
    by_cases hs : s < r
    swap
    · refine (ih N 𝒩 hind htop hsmul hlen fun i hi => ?_).mono (Nat.le_succ s)
      exact absurd i.2 (by omega)
    let j : Fin r := ⟨s, hs⟩
    let μ : N →ₗ[S] N := LinearMap.lsmul S N (x j)
    obtain ⟨π, hπ⟩ := exists_isGradingProj hind htop
    have hμ : ∀ n, ∀ y ∈ 𝒩 n, μ y ∈ 𝒩 (n + 1) := hsmul j
    refine isEventuallyPolynomial_of_ker_coker μ hπ htop hμ hlen ?_ ?_
    · refine ih (LinearMap.ker μ) (kerGrading μ 𝒩) (iSupIndep_kerGrading μ hind)
        (iSup_kerGrading μ hπ htop hμ) (fun i => smul_mem_kerGrading μ (hsmul i))
        (length_kerGrading_ne_top μ hlen) fun i hi y => ?_
      apply Subtype.ext
      rw [Submodule.coe_smul, Submodule.coe_zero]
      rcases (Nat.lt_or_ge s i).symm with hi' | hi'
      · have : i = j := Fin.ext (le_antisymm (by omega) hi)
        rw [this]
        exact LinearMap.mem_ker.mp y.2
      · exact hzero i hi' y
    · refine ih (N ⧸ LinearMap.range μ) (cokerGrading μ 𝒩) (iSupIndep_cokerGrading μ hπ htop hμ)
        (iSup_cokerGrading μ htop) (fun i => smul_mem_cokerGrading μ (hsmul i))
        (length_cokerGrading_ne_top μ hlen) fun i hi c => ?_
      induction c using Submodule.Quotient.induction_on with | _ y => ?_
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      rcases (Nat.lt_or_ge s i).symm with hi' | hi'
      · have : i = j := Fin.ext (le_antisymm (by omega) hi)
        rw [this]
        exact ⟨y, rfl⟩
      · rw [hzero i hi' y]
        exact zero_mem _

/-- **The theorem of Hilbert and Serre.** Let `S` be a commutative `R`-algebra generated by
`x_1, ..., x_r`, and let `N` be a Noetherian `S`-module with a grading `𝒩` by `R`-submodules such
that `x_i 𝒩_n ⊆ 𝒩_(n+1)` and each `𝒩_n` has finite length. Then `n ↦ ℓ_R(𝒩_n)` is eventually a
polynomial of degree less than `r`. -/
theorem isEventuallyPolynomial_length_of_grading {N : Type v} [AddCommGroup N] [Module S N]
    [Module R N] [IsScalarTower R S N] [IsNoetherian S N] {r : ℕ} (x : Fin r → S)
    (hx : Algebra.adjoin R (Set.range x) = ⊤) (𝒩 : ℕ → Submodule R N) (hind : iSupIndep 𝒩)
    (htop : ⨆ n, 𝒩 n = ⊤) (hsmul : ∀ i n, ∀ y ∈ 𝒩 n, x i • y ∈ 𝒩 (n + 1))
    (hlen : ∀ n, length R (𝒩 n) ≠ ⊤) :
    IsEventuallyPolynomial (fun n => ((length R (𝒩 n)).toNat : ℤ)) r :=
  isEventuallyPolynomial_length_aux x hx r N 𝒩 hind htop hsmul hlen fun i hi =>
    absurd i.2 (by omega)

end Main

section Graded

variable {R : Type u} [CommRing R] (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]

/-- The piece `I^n M / I^(n+1) M` of the associated graded module of `M` with respect to `I`. -/
def grPiece (n : ℕ) : Type v :=
  (I ^ n • ⊤ : Submodule R M) ⧸
    (I ^ (n + 1) • ⊤ : Submodule R M).comap (I ^ n • ⊤ : Submodule R M).subtype

/- We give `grPiece` its instances by hand. Then its additive monoid structure comes only from its
group structure, and the ring structure on the endomorphisms of the direct sum is found. -/
instance (n : ℕ) : AddCommGroup (grPiece I M n) := inferInstanceAs (AddCommGroup (_ ⧸ _))

instance (n : ℕ) : Module R (grPiece I M n) := inferInstanceAs (Module R (_ ⧸ _))

/-- The map `I^n M → gr_n`. -/
def grMk (n : ℕ) : (I ^ n • ⊤ : Submodule R M) →ₗ[R] grPiece I M n := Submodule.mkQ _

/-- The map `I^n M → gr_n` is surjective. -/
theorem grMk_surjective (n : ℕ) : Function.Surjective (grMk I M n) :=
  Submodule.mkQ_surjective _

variable {I M}

/-- If `a ∈ I` and `y ∈ I^n M`, then `a y ∈ I^(n+1) M`. -/
theorem smul_mem_pow_smul {a : R} (ha : a ∈ I) {n : ℕ} {y : M}
    (hy : y ∈ (I ^ n • ⊤ : Submodule R M)) : a • y ∈ (I ^ (n + 1) • ⊤ : Submodule R M) := by
  rw [pow_succ', Submodule.mul_smul]
  exact Submodule.smul_mem_smul ha hy

/-- The multiplication by `a ∈ I` as a map `I^n M → I^(n+1) M`. -/
def powSmul {a : R} (ha : a ∈ I) (n : ℕ) :
    (I ^ n • ⊤ : Submodule R M) →ₗ[R] (I ^ (n + 1) • ⊤ : Submodule R M) :=
  (LinearMap.lsmul R M a).restrict fun _ hy => smul_mem_pow_smul ha hy

/-- The value of `powSmul`. -/
theorem coe_powSmul {a : R} (ha : a ∈ I) (n : ℕ) (y : (I ^ n • ⊤ : Submodule R M)) :
    (powSmul ha n y : M) = a • (y : M) :=
  rfl

/-- The multiplication by `a ∈ I` as a map `gr_n → gr_(n+1)` of the associated graded module. -/
def grMul {a : R} (ha : a ∈ I) (n : ℕ) : grPiece I M n →ₗ[R] grPiece I M (n + 1) :=
  Submodule.mapQ _ _ (powSmul ha n) fun y hy => by
    change a • (y : M) ∈ (I ^ (n + 1 + 1) • ⊤ : Submodule R M)
    exact smul_mem_pow_smul ha hy

/-- The value of `grMul` on the class of an element. -/
theorem grMul_mk {a : R} (ha : a ∈ I) (n : ℕ) (y : (I ^ n • ⊤ : Submodule R M)) :
    grMul ha n (grMk I M n y) = grMk I M (n + 1) (powSmul ha n y) :=
  rfl

/-- The maps `grMul` for two elements of `I` commute. -/
theorem grMul_comm {a b : R} (ha : a ∈ I) (hb : b ∈ I) (n : ℕ) (z : grPiece I M n) :
    grMul ha (n + 1) (grMul hb n z) = grMul hb (n + 1) (grMul ha n z) := by
  obtain ⟨y, rfl⟩ := grMk_surjective I M n z
  rw [grMul_mk, grMul_mk, grMul_mk, grMul_mk]
  congr 1
  exact Subtype.ext (smul_comm a b (y : M))

/-- The generators of `I` are elements of `I`. -/
theorem mem_of_eq_span {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x)) (i : Fin r) :
    x i ∈ I := by
  rw [hI]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- The sum of the maps `x_i : gr_n → gr_(n+1)`. -/
def grMulSum {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x)) (n : ℕ) :
    (Fin r → grPiece I M n) →ₗ[R] grPiece I M (n + 1) :=
  ∑ i, (grMul (mem_of_eq_span hI i) n).comp (LinearMap.proj i)

/-- The value of `grMulSum`. -/
theorem grMulSum_apply {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x)) (n : ℕ)
    (f : Fin r → grPiece I M n) : grMulSum hI n f = ∑ i, grMul (mem_of_eq_span hI i) n (f i) := by
  simp [grMulSum]

/-- If `x` generates `I`, then the maps `x_i : gr_n → gr_(n+1)` together are surjective. -/
theorem grMulSum_surjective {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x))
    (n : ℕ) : Function.Surjective (grMulSum (M := M) hI n) := by
  intro z
  obtain ⟨y, rfl⟩ := grMk_surjective I M (n + 1) z
  have hy : (y : M) ∈ I • (I ^ n • ⊤ : Submodule R M) := by
    rw [← Submodule.mul_smul, ← pow_succ']
    exact y.2
  obtain ⟨f, hf⟩ : ∃ f : Fin r → (I ^ n • ⊤ : Submodule R M), (y : M) = ∑ i, x i • (f i : M) := by
    refine Submodule.smul_induction_on hy (fun c hc w hw => ?_) fun a b ha hb => ?_
    · rw [hI] at hc
      obtain ⟨g, hg⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hc
      refine ⟨fun i => ⟨g i • w, Submodule.smul_mem _ _ hw⟩, ?_⟩
      rw [← hg, Finset.sum_smul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, mul_smul, smul_comm]
    · obtain ⟨f, rfl⟩ := ha
      obtain ⟨g, rfl⟩ := hb
      exact ⟨f + g, by simp [smul_add, Finset.sum_add_distrib]⟩
  refine ⟨fun i => grMk I M n (f i), ?_⟩
  rw [grMulSum_apply]
  simp only [grMul_mk]
  rw [← map_sum]
  have : ∑ i, powSmul (mem_of_eq_span hI i) n (f i) = y := by
    apply Subtype.ext
    rw [Submodule.coe_sum, hf]
    rfl
  rw [this]


variable (I M) in
/-- The lengths of the pieces of the associated graded module add up to the Hilbert-Samuel
function. -/
theorem hilbertSamuel_eq_sum_length (n : ℕ) :
    hilbertSamuel I M n = ∑ k ∈ range n, length R (grPiece I M k) := by
  induction n with
  | zero => rw [hilbertSamuel_zero, sum_range_zero]
  | succ n ih =>
    rw [hilbertSamuel_succ, ih, sum_range_succ]
    rfl

/-- If `I` is finitely generated and `ℓ(M / I M)` is finite, then each piece of the associated
graded module has finite length. -/
theorem length_grPiece_ne_top {r : ℕ} {x : Fin r → R} (hI : I = Ideal.span (Set.range x))
    (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) (n : ℕ) :
    length R (grPiece I M n) ≠ ⊤ := by
  induction n with
  | zero =>
    have h := hilbertSamuel_eq_sum_length I M 1
    have h1 : hilbertSamuel I M 1 = length R (M ⧸ (I • ⊤ : Submodule R M)) := by
      rw [hilbertSamuel, pow_one]
    rw [sum_range_one, h1] at h
    rwa [← h]
  | succ n ih =>
    refine ne_top_of_le_ne_top ?_ (length_le_of_surjective _ (grMulSum_surjective hI n))
    rw [length_pi_of_fintype, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
    exact WithTop.mul_ne_top (WithTop.natCast_ne_top r) ih

/-- If `I` is finitely generated and `ℓ(M / I M)` is finite, then each value of the
Hilbert-Samuel function is finite. -/
theorem hilbertSamuel_ne_top_of_length_ne_top {r : ℕ} {x : Fin r → R}
    (hI : I = Ideal.span (Set.range x)) (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤)
    (n : ℕ) : hilbertSamuel I M n ≠ ⊤ := by
  rw [hilbertSamuel_eq_sum_length]
  exact ENat.sum_ne_top.mpr fun k _ => length_grPiece_ne_top hI hfin k

variable (I M) in
/-- The associated graded module `⊕ I^n M / I^(n+1) M`. -/
abbrev GrMod : Type v := DirectSum ℕ (grPiece I M)

/-- The multiplication by `a ∈ I` on the associated graded module. It has degree one. -/
def grShift {a : R} (ha : a ∈ I) : Module.End R (GrMod I M) :=
  DirectSum.toModule R ℕ _ fun n => DirectSum.lof R ℕ (grPiece I M) (n + 1) ∘ₗ grMul ha n

/-- The value of `grShift` on an element of degree `n`. -/
theorem grShift_lof {a : R} (ha : a ∈ I) (n : ℕ) (z : grPiece I M n) :
    grShift ha (DirectSum.lof R ℕ (grPiece I M) n z) =
      DirectSum.lof R ℕ (grPiece I M) (n + 1) (grMul ha n z) :=
  DirectSum.toModule_lof R n z

/-- The maps `grShift` for two elements of `I` commute. -/
theorem grShift_commute {a b : R} (ha : a ∈ I) (hb : b ∈ I) :
    grShift (M := M) ha * grShift hb = grShift hb * grShift ha := by
  refine DirectSum.linearMap_ext R fun n => LinearMap.ext fun z => ?_
  rw [LinearMap.comp_apply, LinearMap.comp_apply, Module.End.mul_apply, Module.End.mul_apply,
    grShift_lof, grShift_lof, grShift_lof, grShift_lof, grMul_comm]

/-- The pieces of the associated graded module are independent. -/
theorem iSupIndep_range_lof :
    iSupIndep fun n => LinearMap.range (DirectSum.lof R ℕ (grPiece I M) n) := by
  classical
  intro n
  rw [disjoint_iff_inf_le]
  rintro y ⟨⟨z, rfl⟩, hy⟩
  have hle : (⨆ m, ⨆ (_ : m ≠ n), LinearMap.range (DirectSum.lof R ℕ (grPiece I M) m)) ≤
      LinearMap.ker (DirectSum.component R ℕ (grPiece I M) n) := by
    refine iSup₂_le fun m hm => ?_
    rintro _ ⟨w, rfl⟩
    rw [LinearMap.mem_ker, DirectSum.component.of]
    simp [hm]
  have h0 := hle hy
  rw [LinearMap.mem_ker, DirectSum.component.lof_self] at h0
  rw [h0, map_zero]
  exact zero_mem _


variable {r : ℕ} {x : Fin r → R}

variable (M) in
/-- The subalgebra of `End_R(gr M)` generated by the maps `x_i`. -/
def grAlgebra (hI : I = Ideal.span (Set.range x)) : Subalgebra R (Module.End R (GrMod I M)) :=
  Algebra.adjoin R (Set.range fun i => grShift (mem_of_eq_span hI i))

/-- The algebra `grAlgebra` is commutative. -/
instance isMulCommutative_grAlgebra (hI : I = Ideal.span (Set.range x)) :
    IsMulCommutative (grAlgebra M hI) :=
  Algebra.isMulCommutative_adjoin R (by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ -
    exact grShift_commute _ _)

/-- The commutative ring structure on `grAlgebra`. -/
noncomputable instance (hI : I = Ideal.span (Set.range x)) :
    CommRing (grAlgebra M hI) :=
  { (inferInstance : Ring (grAlgebra M hI)) with
    mul_comm := (isMulCommutative_grAlgebra hI).is_comm.comm }

variable (M) in
/-- The generators `x_i` of `grAlgebra`. -/
def grGen (hI : I = Ideal.span (Set.range x)) (i : Fin r) : grAlgebra M hI :=
  ⟨grShift (M := M) (mem_of_eq_span hI i), Algebra.subset_adjoin ⟨i, rfl⟩⟩

/-- The generator `x_i` of `grAlgebra` acts on `gr M` as `grShift`. -/
theorem grGen_smul (hI : I = Ideal.span (Set.range x)) (i : Fin r) (z : GrMod I M) :
    grGen M hI i • z = grShift (M := M) (mem_of_eq_span hI i) z :=
  rfl

/-- The elements `x_i` generate `grAlgebra`. -/
theorem adjoin_range_grGen (hI : I = Ideal.span (Set.range x)) :
    Algebra.adjoin R (Set.range (grGen M hI)) = ⊤ := by
  have h := Algebra.adjoin_adjoin_coe_preimage (R := R)
    (s := Set.range fun i => grShift (M := M) (mem_of_eq_span hI i))
  have hs : Set.range (grGen M hI) =
      ((↑) : grAlgebra M hI → Module.End R (GrMod I M)) ⁻¹'
        Set.range fun i => grShift (M := M) (mem_of_eq_span hI i) := by
    ext f
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, hi⟩
      exact ⟨i, Subtype.ext hi⟩
  rw [hs]
  exact h

/-- The associated graded module is a finite module over `grAlgebra`. It is generated by the
elements of degree zero. -/
theorem module_finite_grAlgebra [IsNoetherianRing R] [Module.Finite R M]
    (hI : I = Ideal.span (Set.range x)) : Module.Finite (grAlgebra M hI) (GrMod I M) := by
  classical
  have : Module.Finite R (grPiece I M 0) := Module.Finite.of_surjective _ (grMk_surjective I M 0)
  obtain ⟨G, hG⟩ := (Module.Finite.fg_top : (⊤ : Submodule R (grPiece I M 0)).FG)
  refine ⟨⟨G.image (DirectSum.lof R ℕ (grPiece I M) 0), ?_⟩⟩
  rw [eq_top_iff]
  let T := Submodule.span (grAlgebra M hI)
    ((G.image (DirectSum.lof R ℕ (grPiece I M) 0) : Finset (GrMod I M)) : Set (GrMod I M))
  have key : ∀ n (z : grPiece I M n), DirectSum.lof R ℕ (grPiece I M) n z ∈ T := by
    intro n
    induction n with
    | zero =>
      intro z
      have hz : z ∈ Submodule.span R (G : Set (grPiece I M 0)) := hG ▸ Submodule.mem_top
      have hle : Submodule.span R (G : Set (grPiece I M 0)) ≤
          (T.restrictScalars R).comap (DirectSum.lof R ℕ (grPiece I M) 0) :=
        Submodule.span_le.mpr fun g hg =>
          Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hg))
      exact hle hz
    | succ n ih =>
      intro z
      obtain ⟨f, rfl⟩ := grMulSum_surjective hI n z
      rw [grMulSum_apply, map_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [← grShift_lof, ← grGen_smul]
      exact T.smul_mem _ (ih (f i))
  rintro z -
  induction z using DirectSum.induction_on with
  | zero => exact zero_mem _
  | of n w => exact key n w
  | add a b ha hb => exact add_mem ha hb

/-- **The Hilbert-Samuel polynomial.** Let `R` be Noetherian, let `M` be a finite `R`-module and
let `I` be generated by `r` elements, with `ℓ(M / I M)` finite. Then `n ↦ ℓ(M / I^n M)` is
eventually a polynomial of degree less than `r + 1`. -/
theorem isEventuallyPolynomial_hilbertSamuel [IsNoetherianRing R] [Module.Finite R M]
    (hI : I = Ideal.span (Set.range x)) (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) :
    IsEventuallyPolynomial (fun n => ((hilbertSamuel I M n).toNat : ℤ)) (r + 1) := by
  have : Algebra.FiniteType R (grAlgebra M hI) :=
    ⟨Subalgebra.fg_def.mpr ⟨_, Set.finite_range _, adjoin_range_grGen hI⟩⟩
  have : IsNoetherianRing (grAlgebra M hI) := Algebra.FiniteType.isNoetherianRing R _
  have : Module.Finite (grAlgebra M hI) (GrMod I M) := module_finite_grAlgebra hI
  have : IsNoetherian (grAlgebra M hI) (GrMod I M) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  have hlen : ∀ n, length R (LinearMap.range (DirectSum.lof R ℕ (grPiece I M) n)) =
      length R (grPiece I M n) := fun n =>
    (LinearEquiv.ofInjective _ (DirectSum.of_injective (β := grPiece I M) n)).length_eq.symm
  have hsmul : ∀ i n, ∀ z ∈ LinearMap.range (DirectSum.lof R ℕ (grPiece I M) n),
      grGen M hI i • z ∈ LinearMap.range (DirectSum.lof R ℕ (grPiece I M) (n + 1)) := by
    rintro i n _ ⟨w, rfl⟩
    exact ⟨grMul _ n w, (grShift_lof _ n w).symm⟩
  have h := isEventuallyPolynomial_length_of_grading (grGen M hI) (adjoin_range_grGen hI)
    (fun n => LinearMap.range (DirectSum.lof R ℕ (grPiece I M) n)) iSupIndep_range_lof
    DFinsupp.iSup_range_lsingle hsmul fun n => by
      rw [hlen]
      exact length_grPiece_ne_top hI hfin n
  have h2 : IsEventuallyPolynomial (fun n => ((length R (grPiece I M n)).toNat : ℤ)) r :=
    h.congr (Eventually.of_forall fun n => by simp only [hlen])
  refine h2.sum_range.congr (Eventually.of_forall fun n => ?_)
  rw [hilbertSamuel_eq_sum_length, ENat.toNat_sum fun k _ => length_grPiece_ne_top hI hfin k]
  push_cast
  rfl

/-- The Hilbert-Samuel function agrees at all large `n` with a polynomial `P` over `ℚ` of degree
at most `r`, if `I` is generated by `r` elements and `ℓ(M / I M)` is finite. -/
theorem exists_hilbertSamuel_polynomial [IsNoetherianRing R] [Module.Finite R M]
    (hI : I = Ideal.span (Set.range x)) (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) :
    ∃ P : Polynomial ℚ, P.natDegree ≤ r ∧
      ∀ᶠ n in atTop, ((hilbertSamuel I M n).toNat : ℚ) = P.eval (n : ℚ) := by
  obtain ⟨P, hP, h⟩ :=
    isEventuallyPolynomial_succ_iff.mp (isEventuallyPolynomial_hilbertSamuel hI hfin)
  exact ⟨P, hP, h.mono fun n hn => by exact_mod_cast hn⟩

/-- The Hilbert-Samuel function is eventually a polynomial of degree at most the number of
elements of a finite generating set of `I`. -/
theorem isEventuallyPolynomial_hilbertSamuel_of_span [IsNoetherianRing R] [Module.Finite R M]
    (s : Finset R) (hs : I = Ideal.span (s : Set R))
    (hfin : length R (M ⧸ (I • ⊤ : Submodule R M)) ≠ ⊤) :
    IsEventuallyPolynomial (fun n => ((hilbertSamuel I M n).toNat : ℤ)) (s.card + 1) := by
  have hrange : Set.range (fun i : Fin s.card => (s.equivFin.symm i : R)) = s := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
    · intro ha
      exact ⟨s.equivFin ⟨a, ha⟩, by simp⟩
  exact isEventuallyPolynomial_hilbertSamuel (hs.trans (congrArg Ideal.span hrange.symm)) hfin

end Graded

