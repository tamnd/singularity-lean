import Singularity.Algebra.Regular

/-!
# Regular systems of parameters

This file proves Volume 1, Corollary 1.2.7 of the handbook. Let `(R, 𝔪)` be a regular local ring of dimension `d`, and let `x₁, ..., x_d` generate `𝔪`. Then for each `i ≤ d` the ring `R / (x₁, ..., x_i)` is a regular local ring of dimension `d - i`.

* `Singularity.Algebra.isRegularLocalRing_quotient_span_range`: Corollary 1.2.7 of the handbook.

The proof is the proof of the handbook. The maximal ideal of `R_i = R / (x₁, ..., x_i)` is generated by the classes of `x_{i+1}, ..., x_d`, so `edim R_i ≤ d - i`. The ideal `(x₁, ..., x_i)` has `i` generators, so `d = dim R ≤ dim R_i + i`. Since `dim R_i ≤ edim R_i`, all these bounds are equalities.
-/

open IsLocalRing Ideal

universe u

namespace Singularity.Algebra

variable {R : Type u} [CommRing R]

theorem spanFinrank_span_range_le {ι : Type*} [Fintype ι] (f : ι → R) :
    (span (Set.range f)).spanFinrank ≤ Fintype.card ι := by
  classical
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range f)).trans ?_
  rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
  exact Finset.card_image_le.trans_eq Finset.card_univ

/-- Let `(R, 𝔪)` be a regular local ring of dimension `d` and let `x₁, ..., x_d` generate `𝔪`. Then for each `i ≤ d` the ring `R / (x₁, ..., x_i)` is a regular local ring of dimension `d - i` (Volume 1, Corollary 1.2.7 of the handbook). -/
theorem isRegularLocalRing_quotient_span_range [IsRegularLocalRing R] {d : ℕ} (x : Fin d → R)
    (hx : span (Set.range x) = maximalIdeal R) (hd : ringKrullDim R = d) {i : ℕ} (hi : i ≤ d) :
    IsRegularLocalRing (R ⧸ span (Set.range fun j : Fin i => x ⟨j, by omega⟩)) ∧
      ringKrullDim (R ⧸ span (Set.range fun j : Fin i => x ⟨j, by omega⟩)) = (d - i : ℕ) := by
  set u : Fin i → R := fun j => x ⟨j, by omega⟩ with hu
  set v : Fin (d - i) → R := fun j => x ⟨i + j, by omega⟩ with hv
  set I := span (Set.range u) with hI
  have hIm : I ≤ maximalIdeal R := by
    rw [hI, span_le, ← hx]
    rintro _ ⟨j, rfl⟩
    exact subset_span ⟨_, rfl⟩
  have : IsLocalRing (R ⧸ I) := isLocalRing_quotient_of_le_maximalIdeal hIm
  have hmQ : maximalIdeal (R ⧸ I) = span (Set.range (Ideal.Quotient.mk I ∘ v)) := by
    rw [maximalIdeal_quotient_eq_map, ← hx, Ideal.map_span]
    refine le_antisymm (span_le.mpr ?_) (span_mono ?_)
    · rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      by_cases hj : (j : ℕ) < i
      · have : Ideal.Quotient.mk I (x j) = 0 := by
          rw [Ideal.Quotient.eq_zero_iff_mem, hI]
          exact subset_span ⟨⟨j, hj⟩, rfl⟩
        rw [this]
        exact zero_mem _
      · refine subset_span ⟨⟨j - i, by omega⟩, ?_⟩
        simp only [Function.comp_apply, hv]
        congr 2
        ext
        simp only
        omega
    · rintro _ ⟨j, rfl⟩
      exact ⟨x ⟨i + j, by omega⟩, ⟨_, rfl⟩, rfl⟩
  have hedim : (maximalIdeal (R ⧸ I)).spanFinrank ≤ d - i := by
    rw [hmQ]
    exact (spanFinrank_span_range_le _).trans_eq (Fintype.card_fin _)
  have hIfin : I.spanFinrank ≤ i := (spanFinrank_span_range_le u).trans_eq (Fintype.card_fin _)
  have hle : ringKrullDim R ≤ ringKrullDim (R ⧸ I) + I.spanFinrank := by
    refine ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I ?_
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal R]
    exact hIm
  have hQle : ringKrullDim (R ⧸ I) ≤ ((maximalIdeal (R ⧸ I)).spanFinrank : WithBot ℕ∞) :=
    ringKrullDim_le_spanFinrank_maximalIdeal _
  obtain ⟨m, hm⟩ := exists_ringKrullDim_eq_natCast (R ⧸ I)
  rw [hm, hd] at hle
  rw [hm] at hQle
  have h1 : d ≤ m + I.spanFinrank := by exact_mod_cast hle
  have h2 : m ≤ (maximalIdeal (R ⧸ I)).spanFinrank := by exact_mod_cast hQle
  have h3 : m = d - i := by omega
  have h4 : (maximalIdeal (R ⧸ I)).spanFinrank = d - i := by omega
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, ?_⟩
  · rw [hm, h4, h3]
  · rw [hm, h3]

end Singularity.Algebra
