import Singularity.Statements.Principalization
import Singularity.Fidelity.Embedded

/-!
# Fidelity of the statements of principalization and embedded resolution of 3-folds

The definitions of `Singularity/Statements/Principalization.lean` must not be empty, and they must not hold for each ideal sheaf. This file checks both, in the style of spec 06.3, and it proves the implications between them that have short proofs.

* `isWeakPrincipalization_id_top`: on a regular scheme the identity is a weak principalization of the unit ideal sheaf.
* `not_isVeryWeakPrincipalization_bot`: on a nonempty scheme the zero ideal sheaf has no very weak principalization. Thus the hypothesis that `I` is not zero on an open set is necessary in `Princ_4^vw` and `Princ_4^w`.
* `isVeryWeakPrincipalization_of_isWeakPrincipalization`, `veryWeakPrincipalizationFour_of_weakPrincipalizationFour`: `Princ_4^w` implies `Princ_4^vw`.
* `isBoundaryResolutionIso_id_top`: on a regular scheme with a divisor `E` with simple normal crossings, the identity is an embedded resolution of the empty hypersurface with boundary `E`, and it is an isomorphism everywhere.
* `embeddedResolutionThreefoldBoundary_of_iso`: `Emb_3^bd,iso` implies `Emb_3^bd`.
-/

open AlgebraicGeometry CategoryTheory IsLocalRing

universe u

namespace Singularity.Fidelity

section Ring

variable {R : Type*} [CommRing R]

/-- The unit ideal is invertible: it is generated by `1`. -/
theorem isInvertibleAt_top : IsInvertibleAt (⊤ : Ideal R) :=
  ⟨1, one_mem _, Ideal.span_singleton_one.symm⟩

/-- In a nonzero ring the zero ideal is not invertible: its only generator is `0`, a zero divisor. -/
theorem not_isInvertibleAt_bot [Nontrivial R] : ¬ IsInvertibleAt (⊥ : Ideal R) := by
  rintro ⟨f, hf, h⟩
  have h0 : f = 0 := Ideal.span_singleton_eq_bot.mp h.symm
  exact zero_notMem_nonZeroDivisors (h0 ▸ hf)

end Ring

section Scheme

variable {U : Scheme.{u}}

@[simp]
theorem invertibleLocus_top : invertibleLocus (⊤ : U.IdealSheafData) = Set.univ :=
  Set.eq_univ_of_forall fun u =>
    show IsInvertibleAt (stalkIdeal ⊤ u) by rw [stalkIdeal_top]; exact isInvertibleAt_top

@[simp]
theorem pullbackStalkIdeal_top {W : Scheme.{u}} (σ : W ⟶ U) (w : W) :
    pullbackStalkIdeal (⊤ : U.IdealSheafData) σ w = ⊤ := by
  simp [pullbackStalkIdeal, Ideal.map_top]

@[simp]
theorem pullbackStalkIdeal_bot {W : Scheme.{u}} (σ : W ⟶ U) (w : W) :
    pullbackStalkIdeal (⊥ : U.IdealSheafData) σ w = ⊥ := by
  simp [pullbackStalkIdeal]

/-- On a regular scheme the identity is a weak principalization of the unit ideal sheaf. -/
theorem isWeakPrincipalization_id_top (hU : IsRegularScheme U) :
    IsWeakPrincipalization (⊤ : U.IdealSheafData) (𝟙 U) where
  regular := hU
  proper := inferInstance
  surjective := Function.surjective_id
  isIso_over := ⟨⊤, by simp, inferInstance⟩
  dense := by simp
  invertible w := by
    rw [pullbackStalkIdeal_top]
    exact isInvertibleAt_top

/-- A weak principalization is a very weak principalization. -/
theorem isVeryWeakPrincipalization_of_isWeakPrincipalization {W : Scheme.{u}}
    {I : U.IdealSheafData} {σ : W ⟶ U} (h : IsWeakPrincipalization I σ) :
    IsVeryWeakPrincipalization I σ :=
  ⟨h.regular, h.proper, h.surjective, h.invertible⟩

/-- On a nonempty scheme the zero ideal sheaf has no very weak principalization: `W` is not empty, because `σ` is surjective, and the inverse image of the zero ideal is zero. -/
theorem not_isVeryWeakPrincipalization_bot {W : Scheme.{u}} (σ : W ⟶ U) (u : U) :
    ¬ IsVeryWeakPrincipalization (⊥ : U.IdealSheafData) σ := by
  intro h
  obtain ⟨w, -⟩ := h.surjective u
  have hw := h.invertible w
  rw [pullbackStalkIdeal_bot] at hw
  exact not_isInvertibleAt_bot hw

/-- On a regular scheme `Y` with a divisor `E` with simple normal crossings, the identity is an embedded resolution of the empty hypersurface with boundary `E`, with `U = Y` and `E' = E`. -/
theorem isBoundaryResolutionIso_id_top {Y : Scheme.{u}} (hY : IsRegularScheme Y)
    {E : Y.IdealSheafData} (hE : IsSncDivisor E) :
    IsBoundaryResolutionIso (⊤ : Y.IdealSheafData) E (𝟙 Y) ⊤ E where
  regular := hY
  proper := inferInstance
  compl_subset := by simp
  isIso_over := inferInstance
  support_eq := by simp
  snc y := by
    rw [strictTransform_top, stalkIdeal_top, Ideal.top_mul]
    exact hE y
  sncLocus_subset := by simp

end Scheme

/-- `Princ_4^w` implies `Princ_4^vw` over each field. -/
theorem veryWeakPrincipalizationFour_of_weakPrincipalizationFour (k : Type u) [Field k]
    (h : WeakPrincipalizationFour k) : VeryWeakPrincipalizationFour k := by
  intro U f _ _ _ hU hdim I hI
  obtain ⟨W, σ, hσ⟩ := h U f hU hdim I hI
  exact ⟨W, σ, isVeryWeakPrincipalization_of_isWeakPrincipalization hσ⟩

/-- `Emb_3^bd,iso` implies `Emb_3^bd` over each field. -/
theorem embeddedResolutionThreefoldBoundary_of_iso (k : Type u) [Field k]
    (h : EmbeddedResolutionThreefoldBoundaryIso k) : EmbeddedResolutionThreefoldBoundary k := by
  intro Y f _ _ _ hY hdim X E hE hX hXinv hXE
  obtain ⟨Y', π, U, E', hπ⟩ := h Y f hY hdim X E hE hX hXinv hXE
  exact ⟨Y', π, U, E', hπ.toIsBoundaryResolution⟩

end Singularity.Fidelity
