/-!
# The log-Jacobian ideal of a purely inseparable equation

Let `k` be a field of characteristic `p` and let `f = z^p + g(x)` be a purely inseparable
equation. Let `E = V(∏_{i ∈ Δ} x_i)` be a normal crossings divisor. The coordinates `x_i` with
`i ∈ Δ` are the boundary coordinates, and the other coordinates are free. The derivations that
are tangent to `E` form a free module with the basis `x_i ∂_i` for `i ∈ Δ` and `∂_j` for
`j ∉ Δ`. The log-Jacobian ideal of `g` is the ideal of the derivatives of `g` along these
derivations:

  `Θ(g) = (x_i ∂_i g (i ∈ Δ), ∂_j g (j ∉ Δ))`.

Cossart uses this ideal for a base of dimension 3 in his thesis (1987), where it is called the
Jacobian ideal. Posva gives a modern account in arXiv:2405.05735, Appendix A. This file gives
the definition for any number of variables, and it proves the dichotomy of Volume 7, Chapter 3 of
the handbook (to be written).

The derivative of a `p`-th power is `p h^(p-1) ∂h = 0`. So `Θ(g + h^p) = Θ(g)`, and `Θ(g)` does
not see the choice of `z` (`logJacobian_add_pow`).

Write `g = x^r G`, with `x^r` the monomial factor of `g` along `Δ` (`divisorExponent`) and `G`
the residual factor (`residualFactor`). The Leibniz rule gives `x_i ∂_i g = x^r (r_i G + x_i ∂_i G)`
and `∂_j g = x^r ∂_j G` for `j ∉ Δ`. So `Θ(g) = x^r Θ̃(G)` (`logJacobian_monomial_mul`), with
the residual log-Jacobian ideal

  `Θ̃(G) = (r_i G + x_i ∂_i G (i ∈ Δ), ∂_j G (j ∉ Δ))`.

Its order is `ρ = logJacobianOrder Δ g`.

The proofs look at one monomial `x^a` at a time. The operator `x_i ∂_i` keeps the degree of `x^a`
and multiplies the monomial by the exponent `a_i`. The operator `∂_j` lowers the degree by one
and multiplies by `a_j`. In characteristic `p` both operators can kill a monomial: they kill
`x^a` when `p` divides the exponent. A clean `g` has no monomial with all its exponents divisible
by `p`. So for each monomial of `G` some generator does not kill it. This is the whole argument:
cleanness stops the operators from killing all the monomials of the initial form of `G`.

## Main definitions

* `Singularity.logJacobian Δ g`: the log-Jacobian ideal `Θ(g)`.
* `Singularity.residualLogJacobian Δ r G`: the residual log-Jacobian ideal `Θ̃(G)`.
* `Singularity.logJacobianOrder Δ g`: the order `ρ` of `Θ̃(G)` for `g = x^r G`.

## Main results

* `logJacobian_add_pow`: `Θ(g + h^p) = Θ(g)`.
* `logJacobian_pow_mul`, `logJacobian_C_mul`: `Θ(u^p g) = (u^p) Θ(g)`, and `Θ(c g) = Θ(g)` for
  a unit `c` of `k`.
* `logJacobian_monomial_mul`, `logJacobian_eq_mul`: `Θ(x^r G) = (x^r) Θ̃(G)`.
* `residualLogJacobian_not_le_span_X`: for a clean `g ≠ 0`, `Θ̃(G) ⊄ (x_i)` for each `i ∈ Δ`.
  So `x^r` is the monomial factor of `Θ(g)` (`logJacobian_le_span_monomial`,
  `le_divisorExponent_of_logJacobian_le`).
* `logJacobianOrder_le_residualOrderAlong`, `residualOrderAlong_le_logJacobianOrder_add_one`,
  `logJacobianOrder_eq_or`: the dichotomy `ρ ∈ {d - 1, d}` for the residual order `d`.
* `logJacobianOrder_lt_iff`, `logJacobianOrder_add_one_eq_iff`: `ρ = d - 1` if and only if
  `∂_j in(G) ≠ 0` for some free coordinate `x_j`, with `in(G)` the initial form of `G`.

## References

* V. Cossart, *Polyèdre caractéristique d'une singularité*, thèse d'État, Orsay 1987.
* V. Cossart, O. Piltant, *Resolution of singularities of threefolds in positive characteristic
  I*, J. Algebra 320 (2008).
* Q. Posva, arXiv:2405.05735, Appendix A.
* Volume 7, Chapter 3 of the handbook (to be written): Definitions 3.4 and 3.5, Lemma 3.6 and
  Theorem 3.7.
-/

open MvPolynomial Finsupp

namespace Singularity

section Defs

variable {σ k : Type*} [CommSemiring k]

/-- The log-Jacobian ideal `Θ(g)` of `g` along the divisor `E = V(∏_{i ∈ Δ} x_i)`: the ideal
generated by `x_i ∂_i g` for `i ∈ Δ` and by `∂_j g` for `j ∉ Δ`. These are the derivatives of `g`
along a basis of the derivations tangent to `E` (Volume 7, Chapter 3 of the handbook,
Definition 3.5). -/
noncomputable def logJacobian (Δ : Finset σ) (g : MvPolynomial σ k) : Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun i => X i * pderiv i g) '' (Δ : Set σ) ∪ (fun j => pderiv j g) '' (Δ : Set σ)ᶜ)

/-- The residual log-Jacobian ideal `Θ̃(G)` for the exponents `r`: the ideal generated by
`r_i G + x_i ∂_i G` for `i ∈ Δ` and by `∂_j G` for `j ∉ Δ`. If `r` is supported in `Δ`, then
`Θ(x^r G) = x^r Θ̃(G)` (`logJacobian_monomial_mul`). -/
noncomputable def residualLogJacobian (Δ : Finset σ) (r : σ →₀ ℕ) (G : MvPolynomial σ k) :
    Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun i => (r i : k) • G + X i * pderiv i G) '' (Δ : Set σ) ∪
    (fun j => pderiv j G) '' (Δ : Set σ)ᶜ)

/-- The order `ρ` of the log-Jacobian ideal of `g`, after the removal of its monomial factor:
the order of `Θ̃(G)`, for `g = x^r G` with `r = divisorExponent Δ g` and `G = residualFactor Δ g`
(Volume 7, Chapter 3 of the handbook, Definition 3.5). For a clean `g ≠ 0`, `x^r` is the monomial
factor of `Θ(g)` (`le_divisorExponent_of_logJacobian_le`), so `ρ` is the residual order of the
ideal `Θ(g)`. -/
noncomputable def logJacobianOrder (Δ : Finset σ) (g : MvPolynomial σ k) : ℕ∞ :=
  idealOrd (residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g))

theorem X_mul_pderiv_mem_logJacobian {Δ : Finset σ} {i : σ} (hi : i ∈ Δ) (g : MvPolynomial σ k) :
    X i * pderiv i g ∈ logJacobian Δ g :=
  Ideal.subset_span (Or.inl ⟨i, hi, rfl⟩)

theorem pderiv_mem_logJacobian {Δ : Finset σ} {j : σ} (hj : j ∉ Δ) (g : MvPolynomial σ k) :
    pderiv j g ∈ logJacobian Δ g :=
  Ideal.subset_span (Or.inr ⟨j, hj, rfl⟩)

theorem smul_add_X_mul_pderiv_mem_residualLogJacobian {Δ : Finset σ} {i : σ} (hi : i ∈ Δ)
    (r : σ →₀ ℕ) (G : MvPolynomial σ k) :
    (r i : k) • G + X i * pderiv i G ∈ residualLogJacobian Δ r G :=
  Ideal.subset_span (Or.inl ⟨i, hi, rfl⟩)

theorem pderiv_mem_residualLogJacobian {Δ : Finset σ} {j : σ} (hj : j ∉ Δ) (r : σ →₀ ℕ)
    (G : MvPolynomial σ k) : pderiv j G ∈ residualLogJacobian Δ r G :=
  Ideal.subset_span (Or.inr ⟨j, hj, rfl⟩)

end Defs

/-! ### Invariance and the monomial factor -/

section Invariance

variable {σ k : Type*} [CommSemiring k]

/-- If all the partial derivatives of `u` vanish, then `Θ(u g) = (u) Θ(g)`. -/
theorem logJacobian_mul_of_pderiv_eq_zero (Δ : Finset σ) {u : MvPolynomial σ k}
    (hu : ∀ i, pderiv i u = 0) (g : MvPolynomial σ k) :
    logJacobian Δ (u * g) = Ideal.span {u} * logJacobian Δ g := by
  rw [logJacobian, logJacobian, Ideal.span_mul_span, Set.singleton_mul, Set.image_union,
    Set.image_image, Set.image_image]
  congr 2
  · refine Set.image_congr fun i _ => ?_
    show X i * pderiv i (u * g) = u * (X i * pderiv i g)
    rw [pderiv_mul, hu i, zero_mul, zero_add, mul_left_comm]
  · refine Set.image_congr fun j _ => ?_
    show pderiv j (u * g) = u * pderiv j g
    rw [pderiv_mul, hu j, zero_mul, zero_add]

/-- `Θ(c g) = Θ(g)` for a unit `c` of `k`. -/
theorem logJacobian_C_mul (Δ : Finset σ) {c : k} (hc : IsUnit c) (g : MvPolynomial σ k) :
    logJacobian Δ (C c * g) = logJacobian Δ g := by
  rw [logJacobian_mul_of_pderiv_eq_zero Δ (fun i => pderiv_C) g,
    Ideal.span_singleton_eq_top.mpr (hc.map C), Ideal.top_mul]

/-- If `r` is supported in `Δ`, then `Θ(x^r G) = (x^r) Θ̃(G)`: the Leibniz rule gives
`x_i ∂_i (x^r G) = x^r (r_i G + x_i ∂_i G)` and `∂_j (x^r G) = x^r ∂_j G` for `j ∉ Δ`. -/
theorem logJacobian_monomial_mul {Δ : Finset σ} {r : σ →₀ ℕ} (hr : ∀ i, i ∉ Δ → r i = 0)
    (G : MvPolynomial σ k) :
    logJacobian Δ (monomial r 1 * G) = Ideal.span {monomial r 1} * residualLogJacobian Δ r G := by
  rw [logJacobian, residualLogJacobian, Ideal.span_mul_span, Set.singleton_mul, Set.image_union,
    Set.image_image, Set.image_image]
  congr 2
  · refine Set.image_congr fun i _ => ?_
    have h1 : X i * pderiv i (monomial r (1 : k)) = (r i : k) • monomial r 1 := by
      rw [X_mul_pderiv_monomial, Nat.cast_smul_eq_nsmul]
    calc X i * pderiv i (monomial r 1 * G)
        = X i * pderiv i (monomial r 1) * G + monomial r 1 * (X i * pderiv i G) := by
          rw [pderiv_mul]
          ring
      _ = monomial r 1 * ((r i : k) • G + X i * pderiv i G) := by
          rw [h1, smul_mul_assoc, ← mul_smul_comm, ← mul_add]
  · refine Set.image_congr fun j hj => ?_
    show pderiv j (monomial r 1 * G) = monomial r 1 * pderiv j G
    rw [pderiv_mul, pderiv_monomial, hr j hj, Nat.cast_zero, mul_zero, monomial_zero, zero_mul,
      zero_add]

end Invariance

section FieldFactor

variable {σ k : Type*} [Field k]

/-- The factorization `g = x^r G` with `r = divisorExponent Δ g` and `G = residualFactor Δ g`. -/
theorem monomial_mul_residualFactor (Δ : Finset σ) (g : MvPolynomial σ k) :
    monomial (divisorExponent Δ g) 1 * residualFactor Δ g = g :=
  monomial_mul_divMonomial fun _ hβ => divisorExponent_le hβ

/-- `Θ(g) = (x^r) Θ̃(G)` for `g = x^r G` (Volume 7, Chapter 3 of the handbook, §3.4). -/
theorem logJacobian_eq_mul (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobian Δ g = Ideal.span {monomial (divisorExponent Δ g) 1} *
      residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g) := by
  conv_lhs => rw [← monomial_mul_residualFactor Δ g]
  exact logJacobian_monomial_mul (fun _ hi => divisorExponent_eq_zero hi) _

/-- The monomial `x^r` divides `Θ(g)`. -/
theorem logJacobian_le_span_monomial (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobian Δ g ≤ Ideal.span {monomial (divisorExponent Δ g) 1} := by
  rw [logJacobian_eq_mul]
  exact Ideal.mul_le_left

/-- The order of `Θ(g)` is `|r| + ρ`. -/
theorem idealOrd_logJacobian (Δ : Finset σ) (g : MvPolynomial σ k) :
    idealOrd (logJacobian Δ g) = degree (divisorExponent Δ g) + logJacobianOrder Δ g := by
  rw [logJacobian_eq_mul, idealOrd_mul, idealOrd_span_singleton, ord_monomial one_ne_zero,
    logJacobianOrder]

end FieldFactor

section CharP

variable {σ k : Type*} [CommSemiring k] (p : ℕ) [CharP k p]

/-- **Invariance under the choice of `z`** (Volume 7, Chapter 3 of the handbook, Lemma 3.6 (1)):
`Θ(g + h^p) = Θ(g)`, since `∂_i (h^p) = p h^(p-1) ∂_i h = 0`. -/
theorem logJacobian_add_pow (Δ : Finset σ) (g h : MvPolynomial σ k) :
    logJacobian Δ (g + h ^ p) = logJacobian Δ g := by
  have hD : ∀ i, pderiv i (g + h ^ p) = pderiv i g := fun i => by
    simp only [map_add, pderiv_pow, CharP.cast_eq_zero (MvPolynomial σ k) p, zero_mul, add_zero]
  simp only [logJacobian, hD]

/-- `Θ(u^p g) = (u^p) Θ(g)` (Volume 7, Chapter 3 of the handbook, Lemma 3.6 (2)). -/
theorem logJacobian_pow_mul (Δ : Finset σ) (u g : MvPolynomial σ k) :
    logJacobian Δ (u ^ p * g) = Ideal.span {u ^ p} * logJacobian Δ g :=
  logJacobian_mul_of_pderiv_eq_zero Δ
    (fun i => by simp only [pderiv_pow, CharP.cast_eq_zero (MvPolynomial σ k) p, zero_mul]) g

end CharP

/-! ### Coefficients of the generators -/

section Coeff

variable {σ k : Type*} [CommSemiring k]

/-- The operator `x_i ∂_i` multiplies the monomial `x^a` by `a_i`. -/
theorem coeff_X_mul_pderiv (i : σ) (G : MvPolynomial σ k) (a : σ →₀ ℕ) :
    (X i * pderiv i G).coeff a = (a i : k) * G.coeff a := by
  classical
  induction G using MvPolynomial.induction_on' with
  | add P Q hP hQ => rw [map_add, mul_add, coeff_add_apply, hP, hQ, coeff_add_apply, mul_add]
  | monomial m c =>
    rw [X_mul_pderiv_monomial, ← Nat.cast_smul_eq_nsmul k, coeff_smul, coeff_monomial,
      smul_eq_mul]
    split_ifs with h
    · rw [h]
    · rw [mul_zero, mul_zero]

/-- The generator `r_i G + x_i ∂_i G` multiplies the monomial `x^a` of `G` by `r_i + a_i`. -/
theorem coeff_smul_add_X_mul_pderiv (r : σ →₀ ℕ) (i : σ) (G : MvPolynomial σ k) (a : σ →₀ ℕ) :
    ((r i : k) • G + X i * pderiv i G).coeff a = ((r i + a i : ℕ) : k) * G.coeff a := by
  rw [coeff_add_apply, coeff_smul, smul_eq_mul, coeff_X_mul_pderiv, Nat.cast_add, add_mul]

end Coeff

/-! ### Lower bounds for the order -/

section Lower

variable {σ k : Type*} [CommSemiring k]

/-- If each generator of an ideal has order at least `n`, then the ideal has order at least
`n`. -/
theorem le_idealOrd_span {S : Set (MvPolynomial σ k)} {n : ℕ∞} (h : ∀ s ∈ S, n ≤ ord s) :
    n ≤ idealOrd (Ideal.span S) := by
  refine le_idealOrd fun f hf => ?_
  induction hf using Submodule.span_induction with
  | mem x hx => exact h x hx
  | zero => simp
  | add x y _ _ hx hy => exact le_ord_add hx hy
  | smul a x _ hx => exact hx.trans (le_add_self.trans (le_ord_mul a x))

/-- The generator `r_i G + x_i ∂_i G` does not lower the order. -/
theorem le_ord_smul_add_X_mul_pderiv {G : MvPolynomial σ k} {d : ℕ} (hd : (d : ℕ∞) ≤ ord G)
    (r : σ →₀ ℕ) (i : σ) : (d : ℕ∞) ≤ ord ((r i : k) • G + X i * pderiv i G) := by
  refine le_ord_iff.mpr fun b hb => ?_
  rw [coeff_smul_add_X_mul_pderiv, coeff_eq_zero_of_lt_ord
    (lt_of_lt_of_le (by exact_mod_cast hb) hd), mul_zero]

/-- The derivative `∂_j` lowers the order by at most one. -/
theorem le_ord_pderiv {G : MvPolynomial σ k} {d : ℕ} (hd : (d : ℕ∞) ≤ ord G) (j : σ) :
    ((d - 1 : ℕ) : ℕ∞) ≤ ord (pderiv j G) := by
  refine le_ord_iff.mpr fun b hb => ?_
  rw [coeff_pderiv, coeff_eq_zero_of_lt_ord, zero_mul]
  refine lt_of_lt_of_le ?_ hd
  rw [map_add, degree_single]
  exact_mod_cast (by omega : degree b + 1 < d)

/-- The residual order of `G` is at most `ord Θ̃(G) + 1`. -/
theorem ord_le_idealOrd_residualLogJacobian_add_one (Δ : Finset σ) (r : σ →₀ ℕ)
    (G : MvPolynomial σ k) : ord G ≤ idealOrd (residualLogJacobian Δ r G) + 1 := by
  refine ENat.forall_natCast_le_iff_le.mp fun d hd => ?_
  have h : ((d - 1 : ℕ) : ℕ∞) ≤ idealOrd (residualLogJacobian Δ r G) := by
    refine le_idealOrd_span ?_
    rintro s (⟨i, -, rfl⟩ | ⟨j, -, rfl⟩)
    · exact le_trans (by exact_mod_cast Nat.sub_le d 1) (le_ord_smul_add_X_mul_pderiv hd r i)
    · exact le_ord_pderiv hd j
  calc (d : ℕ∞) ≤ ((d - 1 : ℕ) : ℕ∞) + 1 := by exact_mod_cast (by omega : d ≤ d - 1 + 1)
    _ ≤ _ := add_le_add h le_rfl

/-- **Type 1** (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (3)): if `ord G = d`, then
`ord Θ̃(G) < d` if and only if `∂_j in(G) ≠ 0` for some `j ∉ Δ`, with `in(G)` the homogeneous
component of degree `d` of `G`. -/
theorem idealOrd_residualLogJacobian_lt_iff {Δ : Finset σ} (r : σ →₀ ℕ) {G : MvPolynomial σ k}
    {d : ℕ} (hd : ord G = d) :
    idealOrd (residualLogJacobian Δ r G) < d ↔
      ∃ j ∉ Δ, pderiv j (homogeneousComponent d G) ≠ 0 := by
  constructor
  · intro hlt
    by_contra hne
    push Not at hne
    refine absurd hlt (not_lt.mpr (le_idealOrd_span ?_))
    rintro s (⟨i, -, rfl⟩ | ⟨j, hj, rfl⟩)
    · exact le_ord_smul_add_X_mul_pderiv hd.ge r i
    · refine le_ord_iff.mpr fun b hb => ?_
      by_cases hb1 : degree b + 1 < d
      · rw [coeff_pderiv, coeff_eq_zero_of_lt_ord, zero_mul]
        rw [hd, map_add, degree_single]
        exact_mod_cast hb1
      · have hdeg : degree (b + single j 1) = d := by
          rw [map_add, degree_single]
          omega
        have := congrArg (fun q => q.coeff b) (hne j hj)
        simp only [coeff_pderiv, coeff_homogeneousComponent, hdeg, ↓reduceIte] at this
        rw [coeff_pderiv, this]
        simp
  · rintro ⟨j, hj, hne⟩
    obtain ⟨b, hb⟩ := MvPolynomial.ne_zero_iff.mp hne
    rw [coeff_pderiv, coeff_homogeneousComponent] at hb
    split_ifs at hb with hdeg
    · rw [← coeff_pderiv] at hb
      rw [map_add, degree_single] at hdeg
      refine lt_of_le_of_lt ((idealOrd_le_ord (pderiv_mem_residualLogJacobian hj r G)).trans
        (ord_le hb)) ?_
      exact_mod_cast (by omega : degree b < d)
    · rw [zero_mul] at hb
      exact absurd rfl hb

end Lower

/-! ### The dichotomy -/

section Dichotomy

variable {σ k : Type*} [Field k] (p : ℕ) [CharP k p] {Δ : Finset σ} {g : MvPolynomial σ k}

/-- For `i ∈ Δ`, some monomial of the residual factor `G` does not contain `x_i`: this is the
maximality of `r_i`. -/
theorem exists_mem_support_residualFactor_apply_eq_zero (hg : g ≠ 0) {i : σ} (hi : i ∈ Δ) :
    ∃ a ∈ (residualFactor Δ g).support, a i = 0 := by
  classical
  have hne : ((fun d : σ →₀ ℕ => d i) '' (g.support : Set (σ →₀ ℕ))).Nonempty := by
    obtain ⟨b, hb⟩ := Finset.nonempty_iff_ne_empty.mpr (mt MvPolynomial.support_eq_empty.mp hg)
    exact ⟨_, b, hb, rfl⟩
  obtain ⟨b, hb, hbi⟩ := Nat.sInf_mem hne
  have hri : divisorExponent Δ g i = b i := by
    simp only [divisorExponent_apply, hi, ↓reduceIte]
    exact hbi.symm
  have hrb : divisorExponent Δ g ≤ b := divisorExponent_le hb
  refine ⟨b - divisorExponent Δ g, ?_, ?_⟩
  · rw [MvPolynomial.mem_support_iff, residualFactor, coeff_divMonomial,
      add_tsub_cancel_of_le hrb]
    exact MvPolynomial.mem_support_iff.mp hb
  · rw [Finsupp.tsub_apply, hri, Nat.sub_self]

/-- The key step: for a clean `g` and a monomial `x^a` of `G`, some generator of `Θ̃(G)` does not
kill `x^a`. Either `r_l + a_l` is prime to `p` for some `l ∈ Δ`, and `r_l G + x_l ∂_l G` has the
monomial `x^a`, or `a_l` is prime to `p` for some `l ∉ Δ`, and `∂_l G` has the monomial
`x^(a - e_l)`. -/
theorem exists_coeff_generator_ne_zero (hc : IsClean p g) {a : σ →₀ ℕ}
    (ha : a ∈ (residualFactor Δ g).support) :
    (∃ l ∈ Δ, ((divisorExponent Δ g l : k) • residualFactor Δ g +
        X l * pderiv l (residualFactor Δ g)).coeff a ≠ 0) ∨
      ∃ l ∉ Δ, (pderiv l (residualFactor Δ g)).coeff (a - single l 1) ≠ 0 := by
  set r := divisorExponent Δ g
  set G := residualFactor Δ g
  have hGa : G.coeff a ≠ 0 := MvPolynomial.mem_support_iff.mp ha
  have hga : r + a ∈ g.support := MvPolynomial.mem_support_iff.mpr hGa
  obtain ⟨l, hl⟩ := not_forall.mp (hc _ hga)
  rw [Finsupp.add_apply] at hl
  by_cases hlΔ : l ∈ Δ
  · refine Or.inl ⟨l, hlΔ, ?_⟩
    rw [coeff_smul_add_X_mul_pderiv]
    exact mul_ne_zero ((CharP.cast_eq_zero_iff k p _).not.mpr hl) hGa
  · refine Or.inr ⟨l, hlΔ, ?_⟩
    have hrl : r l = 0 := divisorExponent_eq_zero hlΔ
    rw [hrl, zero_add] at hl
    have hal0 : a l ≠ 0 := fun h => hl (by rw [h]; exact dvd_zero p)
    have h1 : 1 ≤ a l := Nat.one_le_iff_ne_zero.mpr hal0
    have hle : single l 1 ≤ a := Finsupp.single_le_iff.mpr h1
    rw [coeff_pderiv, tsub_add_cancel_of_le hle]
    refine mul_ne_zero hGa ?_
    rw [Finsupp.tsub_apply, single_eq_same, ← Nat.cast_succ, Nat.succ_eq_add_one,
      Nat.sub_add_cancel h1]
    exact (CharP.cast_eq_zero_iff k p _).not.mpr hl

/-- **The monomial factor of `Θ(g)`** (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (1)): for
a clean `g ≠ 0` and `i ∈ Δ`, the residual log-Jacobian ideal is not contained in `(x_i)`. -/
theorem residualLogJacobian_not_le_span_X (hg : g ≠ 0) (hc : IsClean p g) {i : σ} (hi : i ∈ Δ) :
    ¬ residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g) ≤ Ideal.span {X i} := by
  intro hle
  obtain ⟨a, ha, hai⟩ := exists_mem_support_residualFactor_apply_eq_zero hg hi
  have hX : (({X i} : Set (MvPolynomial σ k))) = X '' {i} := Set.image_singleton.symm
  have key : ∀ s ∈ residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g),
      ∀ b ∈ s.support, b i ≠ 0 := by
    intro s hs b hb
    have hs' := hle hs
    rw [hX, mem_ideal_span_X_image] at hs'
    obtain ⟨i', hi', hb'⟩ := hs' b hb
    rw [Set.mem_singleton_iff] at hi'
    rw [← hi']
    exact hb'
  rcases exists_coeff_generator_ne_zero p hc ha with ⟨l, hl, hne⟩ | ⟨l, hl, hne⟩
  · exact key _ (smul_add_X_mul_pderiv_mem_residualLogJacobian hl _ _) a
      (MvPolynomial.mem_support_iff.mpr hne) hai
  · refine key _ (pderiv_mem_residualLogJacobian hl _ _) _
      (MvPolynomial.mem_support_iff.mpr hne) ?_
    rw [Finsupp.tsub_apply, hai, Nat.zero_sub]

/-- **The monomial factor of `Θ(g)` is `x^r`** (Volume 7, Chapter 3 of the handbook,
Theorem 3.7 (1)): for a clean `g ≠ 0`, if `x^s` divides `Θ(g)` with `s` supported in `Δ`, then
`s ≤ r`. With `logJacobian_le_span_monomial`, `x^r` is the largest such monomial. -/
theorem le_divisorExponent_of_logJacobian_le (hg : g ≠ 0) (hc : IsClean p g) {s : σ →₀ ℕ}
    (hs : ∀ i, i ∉ Δ → s i = 0) (h : logJacobian Δ g ≤ Ideal.span {monomial s 1}) :
    s ≤ divisorExponent Δ g := by
  intro i
  by_cases hi : i ∈ Δ
  swap
  · rw [hs i hi]
    exact Nat.zero_le _
  obtain ⟨f, hf, hfX⟩ : ∃ f ∈ residualLogJacobian Δ (divisorExponent Δ g) (residualFactor Δ g),
      f ∉ Ideal.span {X i} := by
    by_contra hcon
    push Not at hcon
    exact residualLogJacobian_not_le_span_X p hg hc hi fun f hf => hcon f hf
  have hX : (({X i} : Set (MvPolynomial σ k))) = X '' {i} := Set.image_singleton.symm
  rw [hX, mem_ideal_span_X_image] at hfX
  push Not at hfX
  obtain ⟨a, ha, hai⟩ := hfX
  have hmem : monomial (divisorExponent Δ g) 1 * f ∈ logJacobian Δ g := by
    rw [logJacobian_eq_mul]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hf
  have hM : (({monomial s (1 : k)} : Set (MvPolynomial σ k))) =
      (fun s' => monomial s' (1 : k)) '' {s} := by rw [Set.image_singleton]
  have h2 := h hmem
  rw [hM, mem_ideal_span_monomial_image] at h2
  obtain ⟨s', hs', hle⟩ := h2 (divisorExponent Δ g + a) (by
    rw [MvPolynomial.mem_support_iff, coeff_monomial_mul, one_mul]
    exact MvPolynomial.mem_support_iff.mp ha)
  rw [Set.mem_singleton_iff] at hs'
  subst hs'
  have := hle i
  rwa [Finsupp.add_apply, hai i rfl, add_zero] at this

/-- **The upper bound** `ρ ≤ d` (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (2)): for a
clean `g`, the order of `Θ̃(G)` is at most the order of `G`. -/
theorem logJacobianOrder_le (hc : IsClean p g) :
    logJacobianOrder Δ g ≤ ord (residualFactor Δ g) := by
  by_cases hG : residualFactor Δ g = 0
  · rw [hG, ord_zero]
    exact le_top
  obtain ⟨a, ha, hdeg⟩ := exists_coeff_ne_zero_and_ord_eq hG
  rw [hdeg]
  rcases exists_coeff_generator_ne_zero p hc (MvPolynomial.mem_support_iff.mpr ha) with
    ⟨l, hl, hne⟩ | ⟨l, hl, hne⟩
  · exact (idealOrd_le_ord (smul_add_X_mul_pderiv_mem_residualLogJacobian hl _ _)).trans
      (ord_le hne)
  · refine (idealOrd_le_ord (pderiv_mem_residualLogJacobian hl _ _)).trans
      ((ord_le hne).trans ?_)
    exact_mod_cast degree_mono tsub_le_self

/-- **The lower bound** `d ≤ ρ + 1` (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (2)). -/
theorem ord_residualFactor_le_logJacobianOrder_add_one (Δ : Finset σ) (g : MvPolynomial σ k) :
    ord (residualFactor Δ g) ≤ logJacobianOrder Δ g + 1 :=
  ord_le_idealOrd_residualLogJacobian_add_one Δ _ _

/-- `ρ ≤ d` with `d` the residual order of `z^p + g` along `Δ`, for a clean `g`. -/
theorem logJacobianOrder_le_residualOrderAlong (hc : IsClean p g) :
    logJacobianOrder Δ g ≤ residualOrderAlong Δ p g := by
  rw [residualOrderAlong, cleanPart_eq_self hc]
  exact logJacobianOrder_le p hc

omit [CharP k p] in
/-- `d ≤ ρ + 1` with `d` the residual order of `z^p + g` along `Δ`, for a clean `g`. -/
theorem residualOrderAlong_le_logJacobianOrder_add_one (hc : IsClean p g) :
    residualOrderAlong Δ p g ≤ logJacobianOrder Δ g + 1 := by
  rw [residualOrderAlong, cleanPart_eq_self hc]
  exact ord_residualFactor_le_logJacobianOrder_add_one Δ g

/-- **The dichotomy** `ρ ∈ {d - 1, d}` (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (2)):
for a clean `g`, either `ρ = d` or `ρ + 1 = d`, with `d` the residual order along `Δ`. -/
theorem logJacobianOrder_eq_or (hc : IsClean p g) :
    logJacobianOrder Δ g = residualOrderAlong Δ p g ∨
      logJacobianOrder Δ g + 1 = residualOrderAlong Δ p g := by
  have h1 := logJacobianOrder_le_residualOrderAlong p (Δ := Δ) hc
  have h2 := residualOrderAlong_le_logJacobianOrder_add_one p (Δ := Δ) hc
  cases hρ : logJacobianOrder Δ g using ENat.recTopCoe with
  | top =>
    rw [hρ, top_le_iff] at h1
    exact Or.inl h1.symm
  | coe m =>
    rw [hρ] at h1 h2
    cases hd : residualOrderAlong Δ p g using ENat.recTopCoe with
    | top =>
      rw [hd] at h2
      exact absurd h2 (not_le.mpr (by exact_mod_cast ENat.natCast_lt_top (m + 1)))
    | coe d =>
      rw [hd] at h1 h2
      have h1' : m ≤ d := by exact_mod_cast h1
      have h2' : d ≤ m + 1 := by exact_mod_cast h2
      rcases (by omega : m = d ∨ m + 1 = d) with h | h
      · exact Or.inl (by rw [h])
      · exact Or.inr (by exact_mod_cast h)

/-- **Type 1** (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (3)): if `ord G = d`, then
`ρ < d` if and only if `∂_j in(G) ≠ 0` for some free coordinate `x_j`, `j ∉ Δ`, with `in(G)` the
homogeneous component of degree `d` of `G`. -/
theorem logJacobianOrder_lt_iff {d : ℕ} (hd : ord (residualFactor Δ g) = d) :
    logJacobianOrder Δ g < d ↔
      ∃ j ∉ Δ, pderiv j (homogeneousComponent d (residualFactor Δ g)) ≠ 0 :=
  idealOrd_residualLogJacobian_lt_iff _ hd

/-- **Type 1** (Volume 7, Chapter 3 of the handbook, Theorem 3.7 (3)): for a clean `g` with
`ord G = d`, `ρ + 1 = d` if and only if `∂_j in(G) ≠ 0` for some `j ∉ Δ`. -/
theorem logJacobianOrder_add_one_eq_iff (hc : IsClean p g) {d : ℕ}
    (hd : ord (residualFactor Δ g) = d) :
    logJacobianOrder Δ g + 1 = d ↔
      ∃ j ∉ Δ, pderiv j (homogeneousComponent d (residualFactor Δ g)) ≠ 0 := by
  rw [← logJacobianOrder_lt_iff hd]
  have h1 := logJacobianOrder_le p (Δ := Δ) hc
  have h2 := ord_residualFactor_le_logJacobianOrder_add_one Δ g
  rw [hd] at h1 h2
  cases hρ : logJacobianOrder Δ g using ENat.recTopCoe with
  | top =>
    rw [hρ, top_le_iff] at h1
    exact absurd h1 (ENat.natCast_ne_top d)
  | coe m =>
    rw [hρ] at h2
    have h2' : d ≤ m + 1 := by exact_mod_cast h2
    constructor
    · intro h
      have h' : m + 1 = d := by exact_mod_cast h
      exact_mod_cast (by omega : m < d)
    · intro h
      have h' : m < d := by exact_mod_cast h
      exact_mod_cast (by omega : m + 1 = d)

/-- **Type 0**: for a clean `g` with `ord G = d`, `ρ = d` if and only if `∂_j in(G) = 0` for each
`j ∉ Δ`. -/
theorem logJacobianOrder_eq_iff (hc : IsClean p g) {d : ℕ} (hd : ord (residualFactor Δ g) = d) :
    logJacobianOrder Δ g = d ↔
      ∀ j ∉ Δ, pderiv j (homogeneousComponent d (residualFactor Δ g)) = 0 := by
  have h1 := logJacobianOrder_le p (Δ := Δ) hc
  rw [hd] at h1
  rw [← not_iff_not]
  push Not
  rw [← logJacobianOrder_lt_iff hd]
  exact ⟨fun h => lt_of_le_of_ne h1 h, ne_of_lt⟩

end Dichotomy

end Singularity
