/-!
# The blowup of `z^2 = x^4 + y^4` and its normalization

Let `f = z^2 - x^4 - y^4`. Volume 4, Example 2.3.6 of the handbook shows that the blowup of `V(f)` at the origin is not normal, and that its normalization is regular. This file proves the algebraic steps of the proof.

* `Singularity.quartic_xChart`, `Singularity.quartic_yChart` and `Singularity.quartic_zChart`: the three charts. With `y = x y_1` and `z = x z_1`, `f = x^2 (z_1^2 - x^2 h)` with `h = 1 + y_1^4`.
* `Singularity.quarticNormHom` and `Singularity.quarticNormHom_equation`: the map `B → C` with `x ↦ x`, `y_1 ↦ y_1`, `z_1 ↦ x w`, where `C = k[x, y_1, w]/(w^2 - h)`, sends the equation `z_1^2 - x^2 h` of `B` to `0`. The induced map of the quotient is `Singularity.quarticNormQuot`.
* `Singularity.quartic_normalization_regular`: if `2` is a unit, the ideal `(w^2 - h, 4 y_1^3, 2 w)` of the equation of `C` and its partial derivatives is the unit ideal. Thus `C` is regular by the Jacobian criterion.
* `Singularity.separable_one_add_X_pow_four` and `Singularity.card_roots_one_add_X_pow_four`: if `2` is a unit, `h` is separable, and over an algebraically closed field it has four distinct roots.
* `Singularity.quartic_exceptional_ideal`: the ideal `(x, x y_1, x^2 w)` of the origin in `C` is `(x)`.
* `Singularity.quartic_overlap`: on the overlap of the charts, `z / y^2 = (z / x^2) (x / y)^2`, that is, `w' = w / y_1^2`.
* `Singularity.quartic_charTwo`: in characteristic `2`, `z^2 - x^4 - y^4 = (z + x^2 + y^2)^2`.

The identities hold in each commutative ring. The file does not prove that `C` is the integral closure of `B`, the claims on normality, the computation of `H^1` of the exceptional curve, or the claim that the singularity is not rational.
-/

open MvPolynomial

namespace Singularity

section Charts

variable {R : Type*} [CommRing R]

/-- The `x`-chart: `y = x y_1` and `z = x z_1` give `f = x^2 (z_1^2 - x^2 (1 + y_1^4))` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_xChart (x y₁ z₁ : R) :
    (x * z₁) ^ 2 - x ^ 4 - (x * y₁) ^ 4 = x ^ 2 * (z₁ ^ 2 - x ^ 2 * (1 + y₁ ^ 4)) := by
  ring

/-- The `y`-chart: `x = y x_1` and `z = y z_1` give `f = y^2 (z_1^2 - y^2 (1 + x_1^4))` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_yChart (y x₁ z₁ : R) :
    (y * z₁) ^ 2 - (y * x₁) ^ 4 - y ^ 4 = y ^ 2 * (z₁ ^ 2 - y ^ 2 * (1 + x₁ ^ 4)) := by
  ring

/-- The `z`-chart: `x = z x_1` and `y = z y_1` give `f = z^2 (1 - z^2 (x_1^4 + y_1^4))` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_zChart (z x₁ y₁ : R) :
    z ^ 2 - (z * x₁) ^ 4 - (z * y₁) ^ 4 = z ^ 2 * (1 - z ^ 2 * (x₁ ^ 4 + y₁ ^ 4)) := by
  ring

/-- The substitution `z_1 = x w` sends `z_1^2 - x^2 h` to `x^2 (w^2 - h)` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_normalization_identity (x y₁ w : R) :
    (x * w) ^ 2 - x ^ 2 * (1 + y₁ ^ 4) = x ^ 2 * (w ^ 2 - (1 + y₁ ^ 4)) := by
  ring

/-- If `2` is a unit, the equation `w^2 - (1 + y_1^4)` of `C` and its partial derivatives `-4 y_1^3` and `2 w` generate the unit ideal. Thus `C` is regular (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_normalization_regular {u : R} (hu : 2 * u = 1) (y₁ w : R) :
    Ideal.span {w ^ 2 - (1 + y₁ ^ 4), 4 * y₁ ^ 3, 2 * w} = ⊤ := by
  have hmem : (-1) * (w ^ 2 - (1 + y₁ ^ 4)) + (u * w) * (2 * w) +
      (-(u * u * y₁)) * (4 * y₁ ^ 3) ∈ Ideal.span {w ^ 2 - (1 + y₁ ^ 4), 4 * y₁ ^ 3, 2 * w} := by
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_ <;>
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
  have e : (-1) * (w ^ 2 - (1 + y₁ ^ 4)) + (u * w) * (2 * w) +
      (-(u * u * y₁)) * (4 * y₁ ^ 3) = 1 := by
    linear_combination (w ^ 2 - y₁ ^ 4 * (1 + 2 * u)) * hu
  rw [e] at hmem
  exact (Ideal.eq_top_iff_one _).mpr hmem

/-- The ideal of the origin in `C` is generated by `x`: `(x, x y_1, x^2 w) = (x)` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_exceptional_ideal (x y₁ w : R) :
    Ideal.span {x, x * y₁, x ^ 2 * w} = Ideal.span {x} := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl | rfl) <;> simp only [SetLike.mem_coe, Ideal.mem_span_singleton]
    exacts [dvd_rfl, dvd_mul_right _ _, dvd_mul_of_dvd_left (dvd_pow_self _ two_ne_zero) _]
  · rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.subset_span (Set.mem_insert _ _)

/-- In characteristic `2`, `z^2 - x^4 - y^4 = (z + x^2 + y^2)^2`, so `V(f)` is not reduced (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_charTwo (h2 : (2 : R) = 0) (x y z : R) :
    z ^ 2 - x ^ 4 - y ^ 4 = (z + x ^ 2 + y ^ 2) ^ 2 := by
  linear_combination (-(x ^ 4 + y ^ 4 + z * x ^ 2 + z * y ^ 2 + x ^ 2 * y ^ 2)) * h2

end Charts

/-- On the overlap of the `x`-chart and the `y`-chart, `w' = z / y^2` is `w (x / y)^2` with `w = z / x^2`, that is, `w' = w / y_1^2` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quartic_overlap {K : Type*} [Field K] {x : K} (hx : x ≠ 0) (y z : K) :
    z / y ^ 2 = z / x ^ 2 * (x / y) ^ 2 := by
  rw [div_pow, div_mul_div_comm, mul_comm (x ^ 2) (y ^ 2),
    mul_div_mul_right _ _ (pow_ne_zero 2 hx)]

section Normalization

variable (k : Type*) [CommRing k]

/-- The map `k[x, y_1, z_1] → C = k[x, y_1, w]/(w^2 - (1 + y_1^4))` with `z_1 ↦ x w`. The variables are `X 0, X 1, X 2` (Volume 4, Example 2.3.6 of the handbook). -/
noncomputable def quarticNormHom :
    MvPolynomial (Fin 3) k →ₐ[k]
      MvPolynomial (Fin 3) k ⧸ Ideal.span {(X 2 ^ 2 - (1 + X 1 ^ 4) : MvPolynomial (Fin 3) k)} :=
  (Ideal.Quotient.mkₐ k _).comp (aeval (![X 0, X 1, X 0 * X 2] : Fin 3 → MvPolynomial (Fin 3) k))

variable {k}

/-- The map `B → C` is well defined: it sends `z_1^2 - x^2 (1 + y_1^4)` to `0` (Volume 4, Example 2.3.6 of the handbook). -/
theorem quarticNormHom_equation :
    quarticNormHom k (X 2 ^ 2 - X 0 ^ 2 * (1 + X 1 ^ 4)) = 0 := by
  have h := quartic_normalization_identity (R := MvPolynomial (Fin 3) k) (X 0) (X 1) (X 2)
  have e : aeval (![X 0, X 1, X 0 * X 2] : Fin 3 → MvPolynomial (Fin 3) k)
      (X 2 ^ 2 - X 0 ^ 2 * (1 + X 1 ^ 4) : MvPolynomial (Fin 3) k) =
      X 0 ^ 2 * (X 2 ^ 2 - (1 + X 1 ^ 4)) := by
    simp only [map_sub, map_mul, map_pow, map_add, map_one, aeval_X, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    exact h
  rw [quarticNormHom, AlgHom.comp_apply, e, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

variable (k)

/-- The map `B = k[x, y_1, z_1]/(z_1^2 - x^2 (1 + y_1^4)) → C` of Volume 4, Example 2.3.6 of the handbook. -/
noncomputable def quarticNormQuot :
    (MvPolynomial (Fin 3) k ⧸
        Ideal.span {(X 2 ^ 2 - X 0 ^ 2 * (1 + X 1 ^ 4) : MvPolynomial (Fin 3) k)}) →ₐ[k]
      MvPolynomial (Fin 3) k ⧸ Ideal.span {(X 2 ^ 2 - (1 + X 1 ^ 4) : MvPolynomial (Fin 3) k)} :=
  Ideal.Quotient.liftₐ _ (quarticNormHom k) fun a ha => by
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, quarticNormHom_equation, mul_zero]

end Normalization

section Roots

open Polynomial

/-- If `2` is a unit, the polynomial `h = 1 + Y^4` is separable (Volume 4, Example 2.3.6 of the handbook). -/
theorem separable_one_add_X_pow_four {R : Type*} [CommRing R] {u : R} (hu : 2 * u = 1) :
    (1 + Polynomial.X ^ 4 : R[X]).Separable := by
  rw [separable_def, derivative_add, derivative_one, zero_add, derivative_X_pow]
  refine ⟨1, -(Polynomial.C (u * u) * Polynomial.X), ?_⟩
  have h4 : Polynomial.C (u * u) * Polynomial.C ((4 : ℕ) : R) = (1 : R[X]) := by
    rw [← Polynomial.C_mul, ← Polynomial.C_1]
    congr 1
    push_cast
    linear_combination (2 * u + 1) * hu
  have e : (4 - 1 : ℕ) = 3 := rfl
  rw [e]
  linear_combination (-(Polynomial.X : R[X]) ^ 4) * h4

/-- Over an algebraically closed field of characteristic not `2`, the polynomial `h = 1 + Y^4` has exactly four distinct roots (Volume 4, Example 2.3.6 of the handbook). -/
theorem card_roots_one_add_X_pow_four {k : Type*} [Field k] [DecidableEq k] [IsAlgClosed k]
    (h2 : (2 : k) ≠ 0) : (1 + Polynomial.X ^ 4 : k[X]).roots.toFinset.card = 4 := by
  have h : (1 + Polynomial.X ^ 4 : k[X]) = Polynomial.X ^ 4 + Polynomial.C 1 := by
    rw [Polynomial.C_1]
    ring
  rw [Multiset.toFinset_card_of_nodup
      (nodup_roots (separable_one_add_X_pow_four (mul_inv_cancel₀ h2))),
    IsAlgClosed.card_roots_eq_natDegree, h, natDegree_X_pow_add_C]

end Roots

end Singularity
