import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Polynomial.Quotient
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.Algebra.Algebra.Subalgebra.Tower
import Mathlib.Tactic.LinearCombination

/-!
# Two charts of the blowup of `uv = t₁ ⋯ t_μ` along `(u, v, t₁, t₂)`

This file proves the algebraic part of Volume 8, Proposition 2.4.3 of the handbook, for the charts
`u` and `t₁`.

Let `R` be a commutative ring and let `c, d ∈ R`. Let
`P = R[u, v, t₁, t₂] / (u v - t₁ t₂ c)`, and let `I = (u, v, t₁, t₂)`. The handbook case is
`R = k[t₃, ..., t_m]`, `c = t₃ ⋯ t_μ` and `d = t₃ ⋯ t_r`. Then `P` is the ring
`k[u, v, t₁, ..., t_m] / (u v - t₁ ⋯ t_μ)` of the handbook, and the set `Z` is `t₁ t₂ d = 0`.
We do not prove this identification of rings. It is the regrouping of the variables.

For `x ∈ I`, the chart `P[I/x]` of the blowup is the `P`-subalgebra of `P_x` generated by the
fractions `a/x` for the generators `a` of `I`. This is the convention of
`Singularity.Algebra.blowupChart`. We need no hypothesis on `x`.

## Main declarations

* `NodeBlowupRing c`: the ring `P`.
* `nodeBlowupChartU c`: the chart `P[I/u]`, generated by `v/u`, `t₁/u` and `t₂/u`.
* `nodeBlowupChartUEquiv c`: the chart `P[I/u]` is isomorphic to the polynomial ring
  `R[u, t₁', t₂']`. The variable `t₁'` goes to `t₁/u` and `t₂'` goes to `t₂/u`.
* `nodeBlowupChartUHom_v`, `nodeBlowupChartUHom_t₁`, `nodeBlowupChartUHom_t₂`: in this chart
  `v = u t₁' t₂' c`, `t₁ = u t₁'` and `t₂ = u t₂'`.
* `nodeBlowupChartUHom_Z`: the function `t₁ t₂ d` of `Z` becomes `u² t₁' t₂' d`.
* `nodeBlowupChartT c`: the chart `P[I/t₁]`, generated by `u/t₁`, `v/t₁` and `t₂/t₁`.
* `nodeBlowupChartTEquiv c`: the chart `P[I/t₁]` is isomorphic to the ring
  `Q = R[u', v', t₁, t₂'] / (u' v' - t₂' c)`. The variables `u'`, `v'`, `t₂'` go to `u/t₁`,
  `v/t₁` and `t₂/t₁`.
* `nodeBlowupChartTHom_u`, `nodeBlowupChartTHom_v`, `nodeBlowupChartTHom_t₂`: in this chart
  `u = t₁ u'`, `v = t₁ v'` and `t₂ = t₁ t₂'`.
* `nodeBlowupChartTHom_Z`: the function `t₁ t₂ d` of `Z` becomes `t₁² t₂' d`.
* `nodeBlowupQEquiv c`: `Q` is the polynomial ring in `t₁` over `R[u', v', t₂'] / (u' v' - t₂' c)`.
* `nodeBlowupQ_t₁_isRegular`: `t₁` is a nonzerodivisor of `Q`.

## The proof

For the chart `u`, the map `R[u, t₁', t₂'] → P_u` has the chart as its image. Its composite with
the map `P_u → R[u, t₁', t₂']_u`, `v ↦ u t₁' t₂' c`, `tᵢ ↦ u tᵢ'`, is the localization map. The
variable `u` is a nonzerodivisor of the polynomial ring, so the localization map is injective.
The chart `t₁` is the same, with `Q` in place of the polynomial ring. Here `t₁` is a
nonzerodivisor of `Q`, because `Q` is the polynomial ring in `t₁` over
`R[u', v', t₂'] / (u' v' - t₂' c)`. This argument replaces the dimension argument of the handbook.
It works over any commutative ring.

## What is not proved

We do not prove that the four charts cover the blowup, and we do not treat the charts `v` and
`t₂`. They follow from the charts `u` and `t₁` by the symmetry `u ↔ v`, `t₁ ↔ t₂` of `P`, but we
do not carry out this transport. We state the inverse image of `Z` as the image of the function
`t₁ t₂ d`, not as a closed set. Its zero set is the zero set of `u t₁' t₂' d` and of
`t₁ t₂' d`, since the two functions differ by a power of a factor. We do not prove the
statements after Proposition 2.4.3 on regularity and on the singular locus of the charts.
-/

namespace Singularity.Algebra

open MvPolynomial

/-- The variables `u, v, t₁, t₂` of the ring `P`. -/
inductive NodeBlowupVar
  | u
  | v
  | t₁
  | t₂

/-- The variables `u, t₁', t₂'` of the polynomial ring of the chart `u`. -/
inductive NodeBlowupUVar
  | u
  | s₁
  | s₂

/-- The variables `u', v', t₂'` of the chart `t₁`. The variable `t₁` is added as `none` in
`Option NodeBlowupTVar`. -/
inductive NodeBlowupTVar
  | u
  | v
  | s₂

variable {R : Type*} [CommRing R] (c d : R)

/-- The ideal `(u v - t₁ t₂ c)`. -/
noncomputable def nodeBlowupIdeal : Ideal (MvPolynomial NodeBlowupVar R) :=
  Ideal.span {X .u * X .v - X .t₁ * X .t₂ * C c}

/-- The ring `P = R[u, v, t₁, t₂] / (u v - t₁ t₂ c)`. -/
abbrev NodeBlowupRing := MvPolynomial NodeBlowupVar R ⧸ nodeBlowupIdeal c

/-- The coordinate functions of `P`. -/
noncomputable def nodeBlowupX (i : NodeBlowupVar) : NodeBlowupRing c :=
  Ideal.Quotient.mk _ (X i)

theorem nodeBlowupX_rel :
    nodeBlowupX c .u * nodeBlowupX c .v =
      nodeBlowupX c .t₁ * nodeBlowupX c .t₂ * algebraMap R (NodeBlowupRing c) c := by
  rw [← sub_eq_zero, nodeBlowupX, nodeBlowupX, nodeBlowupX, nodeBlowupX,
    ← Ideal.Quotient.mk_algebraMap, algebraMap_eq, ← map_mul, ← map_mul, ← map_mul, ← map_sub,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span rfl

/-- A lifting lemma for maps out of `P`. -/
theorem nodeBlowup_lift_aux {B : Type*} [CommRing B] [Algebra R B]
    (f : MvPolynomial NodeBlowupVar R →ₐ[R] B)
    (hf : f (X .u * X .v - X .t₁ * X .t₂ * C c) = 0) :
    ∀ a ∈ nodeBlowupIdeal c, f a = 0 := by
  intro a ha
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
  rw [map_mul, hf, mul_zero]

/-! ### The chart `u` -/

/-- The localization `P_u`. -/
abbrev NodeBlowupLocU := Localization.Away (nodeBlowupX c .u)

/-- The fraction `a/u` in `P_u`. -/
noncomputable def nodeBlowupDivU (a : NodeBlowupRing c) : NodeBlowupLocU c :=
  algebraMap _ _ a * IsLocalization.Away.invSelf (nodeBlowupX c .u)

/-- The chart `P[I/u]` of the blowup of `I = (u, v, t₁, t₂)`: the subalgebra of `P_u` generated
by `P` and the fractions `v/u`, `t₁/u`, `t₂/u`. We view it as an `R`-subalgebra. -/
noncomputable def nodeBlowupChartU : Subalgebra R (NodeBlowupLocU c) :=
  (Algebra.adjoin (NodeBlowupRing c) {nodeBlowupDivU c (nodeBlowupX c .v),
    nodeBlowupDivU c (nodeBlowupX c .t₁), nodeBlowupDivU c (nodeBlowupX c .t₂)}).restrictScalars R

/-- The images of the variables `u, t₁', t₂'` in `P_u`. -/
noncomputable def nodeBlowupUImage : NodeBlowupUVar → NodeBlowupLocU c
  | .u => algebraMap _ _ (nodeBlowupX c .u)
  | .s₁ => nodeBlowupDivU c (nodeBlowupX c .t₁)
  | .s₂ => nodeBlowupDivU c (nodeBlowupX c .t₂)

/-- The map `R[u, t₁', t₂'] → P_u` with `t₁' ↦ t₁/u` and `t₂' ↦ t₂/u`. -/
noncomputable def nodeBlowupChartUHom :
    MvPolynomial NodeBlowupUVar R →ₐ[R] NodeBlowupLocU c :=
  aeval (nodeBlowupUImage c)

/-- The images of `u, v, t₁, t₂` in `R[u, t₁', t₂']`. -/
noncomputable def nodeBlowupUBack : NodeBlowupVar → MvPolynomial NodeBlowupUVar R
  | .u => X .u
  | .v => X .u * X .s₁ * X .s₂ * C c
  | .t₁ => X .u * X .s₁
  | .t₂ => X .u * X .s₂

/-- The map `P → R[u, t₁', t₂']` with `v ↦ u t₁' t₂' c`, `t₁ ↦ u t₁'`, `t₂ ↦ u t₂'`. -/
noncomputable def nodeBlowupUBackHom :
    NodeBlowupRing c →ₐ[R] MvPolynomial NodeBlowupUVar R :=
  Ideal.Quotient.liftₐ _ (aeval (nodeBlowupUBack c))
    (nodeBlowup_lift_aux c _ (by simp [nodeBlowupUBack]; ring))

theorem nodeBlowupUBackHom_X (i : NodeBlowupVar) :
    nodeBlowupUBackHom c (nodeBlowupX c i) = nodeBlowupUBack c i :=
  aeval_X _ i

/-- The composite `P → R[u, t₁', t₂'] → P_u` is the localization map. -/
theorem nodeBlowupChartUHom_comp :
    (nodeBlowupChartUHom c).comp (nodeBlowupUBackHom c) =
      IsScalarTower.toAlgHom R (NodeBlowupRing c) (NodeBlowupLocU c) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro i
  have h1 := IsLocalization.Away.mul_invSelf (S := NodeBlowupLocU c) (nodeBlowupX c .u)
  have h2 := congrArg (algebraMap (NodeBlowupRing c) (NodeBlowupLocU c)) (nodeBlowupX_rel c)
  simp only [map_mul] at h2
  rw [← IsScalarTower.algebraMap_apply] at h2
  change (nodeBlowupChartUHom c) (nodeBlowupUBackHom c (nodeBlowupX c i)) =
    algebraMap _ _ (nodeBlowupX c i)
  rw [nodeBlowupUBackHom_X]
  cases i with
  | u => simp [nodeBlowupUBack, nodeBlowupChartUHom, nodeBlowupUImage]
  | v =>
    simp only [nodeBlowupUBack, nodeBlowupChartUHom, nodeBlowupUImage, nodeBlowupDivU, map_mul,
      aeval_X, aeval_C]
    linear_combination (algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .v) *
      (1 + algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .u) *
        IsLocalization.Away.invSelf (nodeBlowupX c .u))) * h1 -
      (IsLocalization.Away.invSelf (S := NodeBlowupLocU c) (nodeBlowupX c .u)) ^ 2 *
        algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .u) * h2
  | t₁ =>
    simp only [nodeBlowupUBack, nodeBlowupChartUHom, nodeBlowupUImage, nodeBlowupDivU, map_mul,
      aeval_X]
    linear_combination algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .t₁) * h1
  | t₂ =>
    simp only [nodeBlowupUBack, nodeBlowupChartUHom, nodeBlowupUImage, nodeBlowupDivU, map_mul,
      aeval_X]
    linear_combination algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .t₂) * h1

theorem nodeBlowupChartUHom_back (p : NodeBlowupRing c) :
    nodeBlowupChartUHom c (nodeBlowupUBackHom c p) = algebraMap _ _ p := by
  rw [← AlgHom.comp_apply, nodeBlowupChartUHom_comp]
  rfl

variable (R) in
/-- The localization `R[u, t₁', t₂']_u`. -/
abbrev NodeBlowupPolyLocU := Localization.Away (X NodeBlowupUVar.u : MvPolynomial NodeBlowupUVar R)

/-- The map `P_u → R[u, t₁', t₂']_u`. -/
noncomputable def nodeBlowupUInv : NodeBlowupLocU c →+* NodeBlowupPolyLocU R :=
  IsLocalization.Away.lift (nodeBlowupX c .u)
    (g := (algebraMap _ (NodeBlowupPolyLocU R)).comp (nodeBlowupUBackHom c).toRingHom)
    (by
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, nodeBlowupUBackHom_X, nodeBlowupUBack]
      exact IsLocalization.Away.algebraMap_isUnit _)

theorem nodeBlowupUInv_comp :
    (nodeBlowupUInv c).comp (nodeBlowupChartUHom c).toRingHom =
      algebraMap _ (NodeBlowupPolyLocU R) := by
  have hinv : algebraMap (MvPolynomial NodeBlowupUVar R) (NodeBlowupPolyLocU R) (X .u) *
      nodeBlowupUInv c (IsLocalization.Away.invSelf (nodeBlowupX c .u)) = 1 := by
    have := congrArg (nodeBlowupUInv c)
      (IsLocalization.Away.mul_invSelf (S := NodeBlowupLocU c) (nodeBlowupX c .u))
    rwa [map_mul, map_one, nodeBlowupUInv, IsLocalization.Away.lift_eq, ← nodeBlowupUInv,
      RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, nodeBlowupUBackHom_X]
      at this
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [← algebraMap_eq, AlgHom.commutes,
      IsScalarTower.algebraMap_apply R (NodeBlowupRing c) (NodeBlowupLocU c), nodeBlowupUInv,
      IsLocalization.Away.lift_eq, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      AlgHom.commutes]
  · intro i
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      nodeBlowupChartUHom, aeval_X]
    cases i with
    | u =>
      simp only [nodeBlowupUImage, nodeBlowupUInv, IsLocalization.Away.lift_eq,
        RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, nodeBlowupUBackHom_X,
        nodeBlowupUBack]
    | s₁ =>
      simp only [nodeBlowupUImage, nodeBlowupDivU, map_mul]
      rw [nodeBlowupUInv, IsLocalization.Away.lift_eq, ← nodeBlowupUInv]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        nodeBlowupUBackHom_X, nodeBlowupUBack, map_mul]
      linear_combination
        algebraMap (MvPolynomial NodeBlowupUVar R) (NodeBlowupPolyLocU R) (X .s₁) * hinv
    | s₂ =>
      simp only [nodeBlowupUImage, nodeBlowupDivU, map_mul]
      rw [nodeBlowupUInv, IsLocalization.Away.lift_eq, ← nodeBlowupUInv]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        nodeBlowupUBackHom_X, nodeBlowupUBack, map_mul]
      linear_combination
        algebraMap (MvPolynomial NodeBlowupUVar R) (NodeBlowupPolyLocU R) (X .s₂) * hinv

theorem nodeBlowupChartUHom_injective : Function.Injective (nodeBlowupChartUHom c) := by
  have hloc : Function.Injective
      (algebraMap (MvPolynomial NodeBlowupUVar R) (NodeBlowupPolyLocU R)) := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨⟨m, n, rfl⟩, hm⟩ := (IsLocalization.map_eq_zero_iff
      (Submonoid.powers (X NodeBlowupUVar.u : MvPolynomial NodeBlowupUVar R)) _ a).mp ha
    exact (isRegular_X_pow (R := R) (n := NodeBlowupUVar.u) n).left.mul_left_eq_zero_iff.mp
      (by simpa using hm)
  intro a b hab
  apply hloc
  rw [← nodeBlowupUInv_comp c]
  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hab]

theorem nodeBlowupChartUHom_s₁ :
    nodeBlowupChartUHom c (X .s₁) = nodeBlowupDivU c (nodeBlowupX c .t₁) := by
  simp [nodeBlowupChartUHom, nodeBlowupUImage]

theorem nodeBlowupChartUHom_s₂ :
    nodeBlowupChartUHom c (X .s₂) = nodeBlowupDivU c (nodeBlowupX c .t₂) := by
  simp [nodeBlowupChartUHom, nodeBlowupUImage]

/-- In the chart `u` the fraction `v/u` is `t₁' t₂' c`. -/
theorem nodeBlowupChartUHom_divV :
    nodeBlowupChartUHom c (X .s₁ * X .s₂ * C c) = nodeBlowupDivU c (nodeBlowupX c .v) := by
  have h1 := IsLocalization.Away.mul_invSelf (S := NodeBlowupLocU c) (nodeBlowupX c .u)
  have h2 := congrArg (algebraMap (NodeBlowupRing c) (NodeBlowupLocU c)) (nodeBlowupX_rel c)
  simp only [map_mul] at h2
  rw [← IsScalarTower.algebraMap_apply] at h2
  simp only [nodeBlowupChartUHom, nodeBlowupUImage, nodeBlowupDivU, map_mul, aeval_X, aeval_C]
  linear_combination (algebraMap _ (NodeBlowupLocU c) (nodeBlowupX c .v) *
    IsLocalization.Away.invSelf (nodeBlowupX c .u)) * h1 -
    (IsLocalization.Away.invSelf (S := NodeBlowupLocU c) (nodeBlowupX c .u)) ^ 2 * h2

theorem nodeBlowupChartUHom_range :
    (nodeBlowupChartUHom c).range = nodeBlowupChartU c := by
  apply le_antisymm
  · rw [nodeBlowupChartUHom, ← Algebra.adjoin_range_eq_range_aeval, Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    rw [nodeBlowupChartU, SetLike.mem_coe, Subalgebra.mem_restrictScalars]
    cases i with
    | u => exact Subalgebra.algebraMap_mem _ _
    | s₁ => exact Algebra.subset_adjoin (by simp [nodeBlowupUImage])
    | s₂ => exact Algebra.subset_adjoin (by simp [nodeBlowupUImage])
  · intro z hz
    rw [nodeBlowupChartU, Subalgebra.mem_restrictScalars] at hz
    let S : Subalgebra (NodeBlowupRing c) (NodeBlowupLocU c) :=
      { toSubsemiring := (nodeBlowupChartUHom c).range.toSubsemiring
        algebraMap_mem' := fun p => ⟨_, nodeBlowupChartUHom_back c p⟩ }
    have hS : Algebra.adjoin (NodeBlowupRing c) {nodeBlowupDivU c (nodeBlowupX c .v),
        nodeBlowupDivU c (nodeBlowupX c .t₁), nodeBlowupDivU c (nodeBlowupX c .t₂)} ≤ S := by
      rw [Algebra.adjoin_le_iff]
      rintro _ (rfl | rfl | rfl)
      · exact ⟨_, nodeBlowupChartUHom_divV c⟩
      · exact ⟨_, nodeBlowupChartUHom_s₁ c⟩
      · exact ⟨_, nodeBlowupChartUHom_s₂ c⟩
    exact hS hz

/-- Proposition 2.4.3, part 1, chart `u`: the chart `P[I/u]` is isomorphic to the polynomial ring
`R[u, t₁', t₂']`, with `t₁' ↦ t₁/u` and `t₂' ↦ t₂/u`. -/
noncomputable def nodeBlowupChartUEquiv :
    MvPolynomial NodeBlowupUVar R ≃ₐ[R] nodeBlowupChartU c :=
  (AlgEquiv.ofInjective _ (nodeBlowupChartUHom_injective c)).trans
    (Subalgebra.equivOfEq _ _ (nodeBlowupChartUHom_range c))

theorem nodeBlowupChartUEquiv_apply (a : MvPolynomial NodeBlowupUVar R) :
    (nodeBlowupChartUEquiv c a : NodeBlowupLocU c) = nodeBlowupChartUHom c a :=
  rfl

/-- In the chart `u` we have `v = u t₁' t₂' c`. -/
theorem nodeBlowupChartUHom_v :
    nodeBlowupChartUHom c (X .u * X .s₁ * X .s₂ * C c) = algebraMap _ _ (nodeBlowupX c .v) := by
  rw [← nodeBlowupChartUHom_back, nodeBlowupUBackHom_X]
  rfl

/-- In the chart `u` we have `t₁ = u t₁'`. -/
theorem nodeBlowupChartUHom_t₁ :
    nodeBlowupChartUHom c (X .u * X .s₁) = algebraMap _ _ (nodeBlowupX c .t₁) := by
  rw [← nodeBlowupChartUHom_back, nodeBlowupUBackHom_X]
  rfl

/-- In the chart `u` we have `t₂ = u t₂'`. -/
theorem nodeBlowupChartUHom_t₂ :
    nodeBlowupChartUHom c (X .u * X .s₂) = algebraMap _ _ (nodeBlowupX c .t₂) := by
  rw [← nodeBlowupChartUHom_back, nodeBlowupUBackHom_X]
  rfl

/-- In the chart `u` the function `t₁ t₂ d` of `Z` is `u² t₁' t₂' d`. -/
theorem nodeBlowupChartUHom_Z :
    nodeBlowupChartUHom c (X .u ^ 2 * X .s₁ * X .s₂ * C d) =
      algebraMap _ _ (nodeBlowupX c .t₁ * nodeBlowupX c .t₂ *
        algebraMap R (NodeBlowupRing c) d) := by
  rw [← nodeBlowupChartUHom_back]
  congr 1
  rw [map_mul, map_mul, AlgHom.commutes, nodeBlowupUBackHom_X, nodeBlowupUBackHom_X]
  simp only [nodeBlowupUBack, algebraMap_eq]
  ring

/-! ### The chart `t₁` -/

/-- The variables `u', v', t₁, t₂'` of the chart `t₁`. Here `none` is `t₁`. -/
abbrev NodeBlowupQVar := Option NodeBlowupTVar

/-- The ideal `(u' v' - t₂' c)` of `R[u', v', t₁, t₂']`. -/
noncomputable def nodeBlowupQIdeal : Ideal (MvPolynomial NodeBlowupQVar R) :=
  Ideal.span {X (some .u) * X (some .v) - X (some .s₂) * C c}

/-- The ring `Q = R[u', v', t₁, t₂'] / (u' v' - t₂' c)`. -/
abbrev NodeBlowupQ := MvPolynomial NodeBlowupQVar R ⧸ nodeBlowupQIdeal c

/-- The coordinate functions of `Q`. -/
noncomputable def nodeBlowupQX (i : NodeBlowupQVar) : NodeBlowupQ c :=
  Ideal.Quotient.mk _ (X i)

/-- The ideal `(u' v' - t₂' c)` of `R[u', v', t₂']`. -/
noncomputable def nodeBlowupQ₀Ideal : Ideal (MvPolynomial NodeBlowupTVar R) :=
  Ideal.span {X .u * X .v - X .s₂ * C c}

/-- The ring `Q` is the polynomial ring in `t₁` over `R[u', v', t₂'] / (u' v' - t₂' c)`. -/
noncomputable def nodeBlowupQEquiv :
    NodeBlowupQ c ≃+* Polynomial (MvPolynomial NodeBlowupTVar R ⧸ nodeBlowupQ₀Ideal c) :=
  (Ideal.quotientEquiv _ ((nodeBlowupQ₀Ideal c).map Polynomial.C)
    (optionEquivLeft R NodeBlowupTVar).toRingEquiv (by
      rw [nodeBlowupQIdeal, nodeBlowupQ₀Ideal, Ideal.map_span, Ideal.map_span,
        Set.image_singleton, Set.image_singleton]
      congr 2
      simp [optionEquivLeft_X_some, optionEquivLeft_C])).trans
    (Ideal.polynomialQuotientEquivQuotientPolynomial _).symm

theorem nodeBlowupQEquiv_t₁ : nodeBlowupQEquiv c (nodeBlowupQX c none) = Polynomial.X := by
  simp [nodeBlowupQEquiv, nodeBlowupQX, optionEquivLeft_X_none]

/-- The variable `t₁` is a nonzerodivisor of `Q`. -/
theorem nodeBlowupQ_t₁_isRegular : IsRegular (nodeBlowupQX c none) := by
  have h := (Polynomial.isRegular_X (R := MvPolynomial NodeBlowupTVar R ⧸
    nodeBlowupQ₀Ideal c)).left
  have hl : IsLeftRegular (nodeBlowupQX c none) := by
    intro a b hab
    apply (nodeBlowupQEquiv c).injective
    apply h
    have := congrArg (nodeBlowupQEquiv c) hab
    simpa only [map_mul, nodeBlowupQEquiv_t₁] using this
  refine ⟨hl, ?_⟩
  intro a b hab
  apply hl
  simpa only [mul_comm] using hab

/-- The localization `P_{t₁}`. -/
abbrev NodeBlowupLocT := Localization.Away (nodeBlowupX c .t₁)

/-- The fraction `a/t₁` in `P_{t₁}`. -/
noncomputable def nodeBlowupDivT (a : NodeBlowupRing c) : NodeBlowupLocT c :=
  algebraMap _ _ a * IsLocalization.Away.invSelf (nodeBlowupX c .t₁)

/-- The chart `P[I/t₁]` of the blowup of `I = (u, v, t₁, t₂)`: the subalgebra of `P_{t₁}`
generated by `P` and the fractions `u/t₁`, `v/t₁`, `t₂/t₁`. We view it as an `R`-subalgebra. -/
noncomputable def nodeBlowupChartT : Subalgebra R (NodeBlowupLocT c) :=
  (Algebra.adjoin (NodeBlowupRing c) {nodeBlowupDivT c (nodeBlowupX c .u),
    nodeBlowupDivT c (nodeBlowupX c .v), nodeBlowupDivT c (nodeBlowupX c .t₂)}).restrictScalars R

/-- The images of the variables `u', v', t₁, t₂'` in `P_{t₁}`. -/
noncomputable def nodeBlowupTImage : NodeBlowupQVar → NodeBlowupLocT c
  | none => algebraMap _ _ (nodeBlowupX c .t₁)
  | some .u => nodeBlowupDivT c (nodeBlowupX c .u)
  | some .v => nodeBlowupDivT c (nodeBlowupX c .v)
  | some .s₂ => nodeBlowupDivT c (nodeBlowupX c .t₂)

/-- The map `Q → P_{t₁}` with `u' ↦ u/t₁`, `v' ↦ v/t₁` and `t₂' ↦ t₂/t₁`. -/
noncomputable def nodeBlowupChartTHom : NodeBlowupQ c →ₐ[R] NodeBlowupLocT c :=
  Ideal.Quotient.liftₐ _ (aeval (nodeBlowupTImage c)) (by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, mul_eq_zero_of_right]
    have h1 := IsLocalization.Away.mul_invSelf (S := NodeBlowupLocT c) (nodeBlowupX c .t₁)
    have h2 := congrArg (algebraMap (NodeBlowupRing c) (NodeBlowupLocT c)) (nodeBlowupX_rel c)
    simp only [map_mul] at h2
    rw [← IsScalarTower.algebraMap_apply] at h2
    simp only [nodeBlowupTImage, nodeBlowupDivT, map_sub, map_mul, aeval_X, aeval_C]
    linear_combination
      (IsLocalization.Away.invSelf (S := NodeBlowupLocT c) (nodeBlowupX c .t₁)) ^ 2 * h2 +
      (algebraMap _ (NodeBlowupLocT c) (nodeBlowupX c .t₂) * algebraMap R (NodeBlowupLocT c) c *
        IsLocalization.Away.invSelf (S := NodeBlowupLocT c) (nodeBlowupX c .t₁)) * h1)

theorem nodeBlowupChartTHom_X (i : NodeBlowupQVar) :
    nodeBlowupChartTHom c (nodeBlowupQX c i) = nodeBlowupTImage c i :=
  aeval_X _ i

/-- The images of `u, v, t₁, t₂` in `Q`. -/
noncomputable def nodeBlowupTBack : NodeBlowupVar → NodeBlowupQ c
  | .u => nodeBlowupQX c none * nodeBlowupQX c (some .u)
  | .v => nodeBlowupQX c none * nodeBlowupQX c (some .v)
  | .t₁ => nodeBlowupQX c none
  | .t₂ => nodeBlowupQX c none * nodeBlowupQX c (some .s₂)

theorem nodeBlowupQX_rel :
    nodeBlowupQX c (some .u) * nodeBlowupQX c (some .v) =
      nodeBlowupQX c (some .s₂) * algebraMap R (NodeBlowupQ c) c := by
  rw [← sub_eq_zero, nodeBlowupQX, nodeBlowupQX, nodeBlowupQX,
    ← Ideal.Quotient.mk_algebraMap, algebraMap_eq, ← map_mul, ← map_mul, ← map_sub,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span rfl

/-- The map `P → Q` with `u ↦ t₁ u'`, `v ↦ t₁ v'` and `t₂ ↦ t₁ t₂'`. -/
noncomputable def nodeBlowupTBackHom : NodeBlowupRing c →ₐ[R] NodeBlowupQ c :=
  Ideal.Quotient.liftₐ _ (aeval (nodeBlowupTBack c))
    (nodeBlowup_lift_aux c _ (by
      simp only [nodeBlowupTBack, map_sub, map_mul, aeval_X, aeval_C]
      linear_combination nodeBlowupQX c none ^ 2 * nodeBlowupQX_rel c))

theorem nodeBlowupTBackHom_X (i : NodeBlowupVar) :
    nodeBlowupTBackHom c (nodeBlowupX c i) = nodeBlowupTBack c i :=
  aeval_X _ i

/-- The composite `P → Q → P_{t₁}` is the localization map. -/
theorem nodeBlowupChartTHom_comp :
    (nodeBlowupChartTHom c).comp (nodeBlowupTBackHom c) =
      IsScalarTower.toAlgHom R (NodeBlowupRing c) (NodeBlowupLocT c) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro i
  have h1 := IsLocalization.Away.mul_invSelf (S := NodeBlowupLocT c) (nodeBlowupX c .t₁)
  change (nodeBlowupChartTHom c) (nodeBlowupTBackHom c (nodeBlowupX c i)) =
    algebraMap _ _ (nodeBlowupX c i)
  rw [nodeBlowupTBackHom_X]
  cases i with
  | t₁ => simp [nodeBlowupTBack, nodeBlowupChartTHom_X, nodeBlowupTImage]
  | u =>
    simp only [nodeBlowupTBack, map_mul, nodeBlowupChartTHom_X, nodeBlowupTImage, nodeBlowupDivT]
    linear_combination algebraMap _ (NodeBlowupLocT c) (nodeBlowupX c .u) * h1
  | v =>
    simp only [nodeBlowupTBack, map_mul, nodeBlowupChartTHom_X, nodeBlowupTImage, nodeBlowupDivT]
    linear_combination algebraMap _ (NodeBlowupLocT c) (nodeBlowupX c .v) * h1
  | t₂ =>
    simp only [nodeBlowupTBack, map_mul, nodeBlowupChartTHom_X, nodeBlowupTImage, nodeBlowupDivT]
    linear_combination algebraMap _ (NodeBlowupLocT c) (nodeBlowupX c .t₂) * h1

theorem nodeBlowupChartTHom_back (p : NodeBlowupRing c) :
    nodeBlowupChartTHom c (nodeBlowupTBackHom c p) = algebraMap _ _ p := by
  rw [← AlgHom.comp_apply, nodeBlowupChartTHom_comp]
  rfl

/-- The localization `Q_{t₁}`. -/
abbrev NodeBlowupQLocT := Localization.Away (nodeBlowupQX c none)

/-- The map `P_{t₁} → Q_{t₁}`. -/
noncomputable def nodeBlowupTInv : NodeBlowupLocT c →+* NodeBlowupQLocT c :=
  IsLocalization.Away.lift (nodeBlowupX c .t₁)
    (g := (algebraMap _ (NodeBlowupQLocT c)).comp (nodeBlowupTBackHom c).toRingHom)
    (by
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, nodeBlowupTBackHom_X, nodeBlowupTBack]
      exact IsLocalization.Away.algebraMap_isUnit _)

theorem nodeBlowupTInv_comp :
    (nodeBlowupTInv c).comp (nodeBlowupChartTHom c).toRingHom =
      algebraMap _ (NodeBlowupQLocT c) := by
  have hinv : algebraMap _ (NodeBlowupQLocT c) (nodeBlowupQX c none) *
      nodeBlowupTInv c (IsLocalization.Away.invSelf (nodeBlowupX c .t₁)) = 1 := by
    have := congrArg (nodeBlowupTInv c)
      (IsLocalization.Away.mul_invSelf (S := NodeBlowupLocT c) (nodeBlowupX c .t₁))
    rwa [map_mul, map_one, nodeBlowupTInv, IsLocalization.Away.lift_eq, ← nodeBlowupTInv,
      RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, nodeBlowupTBackHom_X]
      at this
  have key : ∀ i : NodeBlowupVar,
      nodeBlowupTInv c (nodeBlowupDivT c (nodeBlowupX c i)) =
        algebraMap _ (NodeBlowupQLocT c) (nodeBlowupTBack c i) *
          nodeBlowupTInv c (IsLocalization.Away.invSelf (nodeBlowupX c .t₁)) := by
    intro i
    rw [nodeBlowupDivT, map_mul, nodeBlowupTInv, IsLocalization.Away.lift_eq, ← nodeBlowupTInv,
      RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, nodeBlowupTBackHom_X]
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [← Ideal.Quotient.algebraMap_eq, ← algebraMap_eq, ← IsScalarTower.algebraMap_apply,
      AlgHom.commutes, IsScalarTower.algebraMap_apply R (NodeBlowupRing c), nodeBlowupTInv,
      IsLocalization.Away.lift_eq, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  · intro i
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    change nodeBlowupTInv c (nodeBlowupChartTHom c (nodeBlowupQX c i)) =
      algebraMap _ _ (nodeBlowupQX c i)
    rw [nodeBlowupChartTHom_X]
    rcases i with _ | _ | _ | _
    · simp only [nodeBlowupTImage, nodeBlowupTInv, IsLocalization.Away.lift_eq,
        RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, nodeBlowupTBackHom_X,
        nodeBlowupTBack]
    · rw [nodeBlowupTImage, key, nodeBlowupTBack, map_mul]
      linear_combination algebraMap _ (NodeBlowupQLocT c) (nodeBlowupQX c (some .u)) * hinv
    · rw [nodeBlowupTImage, key, nodeBlowupTBack, map_mul]
      linear_combination algebraMap _ (NodeBlowupQLocT c) (nodeBlowupQX c (some .v)) * hinv
    · rw [nodeBlowupTImage, key, nodeBlowupTBack, map_mul]
      linear_combination algebraMap _ (NodeBlowupQLocT c) (nodeBlowupQX c (some .s₂)) * hinv

theorem nodeBlowupChartTHom_injective : Function.Injective (nodeBlowupChartTHom c) := by
  have hloc : Function.Injective (algebraMap (NodeBlowupQ c) (NodeBlowupQLocT c)) := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨⟨m, n, rfl⟩, hm⟩ := (IsLocalization.map_eq_zero_iff
      (Submonoid.powers (nodeBlowupQX c none)) _ a).mp ha
    exact ((nodeBlowupQ_t₁_isRegular c).pow n).left.mul_left_eq_zero_iff.mp (by simpa using hm)
  intro a b hab
  apply hloc
  rw [← nodeBlowupTInv_comp c]
  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hab]

theorem nodeBlowupChartTHom_range :
    (nodeBlowupChartTHom c).range = nodeBlowupChartT c := by
  apply le_antisymm
  · rintro _ ⟨q, rfl⟩
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hp : nodeBlowupChartTHom c (Ideal.Quotient.mk _ p) = aeval (nodeBlowupTImage c) p :=
      rfl
    change nodeBlowupChartTHom c _ ∈ _
    rw [hp]
    suffices h : (aeval (nodeBlowupTImage c)).range ≤ nodeBlowupChartT c from h ⟨p, rfl⟩
    rw [← Algebra.adjoin_range_eq_range_aeval, Algebra.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    rw [nodeBlowupChartT, SetLike.mem_coe, Subalgebra.mem_restrictScalars]
    rcases i with _ | _ | _ | _
    · exact Subalgebra.algebraMap_mem _ _
    · exact Algebra.subset_adjoin (by simp [nodeBlowupTImage])
    · exact Algebra.subset_adjoin (by simp [nodeBlowupTImage])
    · exact Algebra.subset_adjoin (by simp [nodeBlowupTImage])
  · intro z hz
    rw [nodeBlowupChartT, Subalgebra.mem_restrictScalars] at hz
    let S : Subalgebra (NodeBlowupRing c) (NodeBlowupLocT c) :=
      { toSubsemiring := (nodeBlowupChartTHom c).range.toSubsemiring
        algebraMap_mem' := fun p => ⟨_, nodeBlowupChartTHom_back c p⟩ }
    have hS : Algebra.adjoin (NodeBlowupRing c) {nodeBlowupDivT c (nodeBlowupX c .u),
        nodeBlowupDivT c (nodeBlowupX c .v), nodeBlowupDivT c (nodeBlowupX c .t₂)} ≤ S := by
      rw [Algebra.adjoin_le_iff]
      rintro _ (rfl | rfl | rfl)
      · exact ⟨nodeBlowupQX c (some .u), by
          change nodeBlowupChartTHom c _ = _; rw [nodeBlowupChartTHom_X]; rfl⟩
      · exact ⟨nodeBlowupQX c (some .v), by
          change nodeBlowupChartTHom c _ = _; rw [nodeBlowupChartTHom_X]; rfl⟩
      · exact ⟨nodeBlowupQX c (some .s₂), by
          change nodeBlowupChartTHom c _ = _; rw [nodeBlowupChartTHom_X]; rfl⟩
    exact hS hz

/-- Proposition 2.4.3, part 2, chart `t₁`: the chart `P[I/t₁]` is isomorphic to
`Q = R[u', v', t₁, t₂'] / (u' v' - t₂' c)`, with `u' ↦ u/t₁`, `v' ↦ v/t₁` and `t₂' ↦ t₂/t₁`. -/
noncomputable def nodeBlowupChartTEquiv : NodeBlowupQ c ≃ₐ[R] nodeBlowupChartT c :=
  (AlgEquiv.ofInjective _ (nodeBlowupChartTHom_injective c)).trans
    (Subalgebra.equivOfEq _ _ (nodeBlowupChartTHom_range c))

theorem nodeBlowupChartTEquiv_apply (q : NodeBlowupQ c) :
    (nodeBlowupChartTEquiv c q : NodeBlowupLocT c) = nodeBlowupChartTHom c q :=
  rfl

/-- In the chart `t₁` we have `u = t₁ u'`. -/
theorem nodeBlowupChartTHom_u :
    nodeBlowupChartTHom c (nodeBlowupQX c none * nodeBlowupQX c (some .u)) =
      algebraMap _ _ (nodeBlowupX c .u) := by
  rw [← nodeBlowupChartTHom_back, nodeBlowupTBackHom_X]
  rfl

/-- In the chart `t₁` we have `v = t₁ v'`. -/
theorem nodeBlowupChartTHom_v :
    nodeBlowupChartTHom c (nodeBlowupQX c none * nodeBlowupQX c (some .v)) =
      algebraMap _ _ (nodeBlowupX c .v) := by
  rw [← nodeBlowupChartTHom_back, nodeBlowupTBackHom_X]
  rfl

/-- In the chart `t₁` we have `t₂ = t₁ t₂'`. -/
theorem nodeBlowupChartTHom_t₂ :
    nodeBlowupChartTHom c (nodeBlowupQX c none * nodeBlowupQX c (some .s₂)) =
      algebraMap _ _ (nodeBlowupX c .t₂) := by
  rw [← nodeBlowupChartTHom_back, nodeBlowupTBackHom_X]
  rfl

/-- In the chart `t₁` the function `t₁ t₂ d` of `Z` is `t₁² t₂' d`. -/
theorem nodeBlowupChartTHom_Z :
    nodeBlowupChartTHom c (nodeBlowupQX c none ^ 2 * nodeBlowupQX c (some .s₂) *
        algebraMap R (NodeBlowupQ c) d) =
      algebraMap _ _ (nodeBlowupX c .t₁ * nodeBlowupX c .t₂ *
        algebraMap R (NodeBlowupRing c) d) := by
  rw [← nodeBlowupChartTHom_back]
  congr 1
  rw [map_mul, map_mul, AlgHom.commutes, nodeBlowupTBackHom_X, nodeBlowupTBackHom_X]
  simp only [nodeBlowupTBack]
  ring

end Singularity.Algebra
