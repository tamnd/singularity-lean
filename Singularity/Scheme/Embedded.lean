import Singularity.Statements.Embedded
import Singularity.Algebra.CurveOnSurface

/-!
# The first facts on permissible centers and normal crossings

This file proves two facts that the handbook uses around Theorem 3.1.4 (Volume 4, Chapter 3). They are stated with the definitions of `Singularity/Statements/Embedded.lean`.

## Main results

* `isPermissible_of_stalkIdeal_eq_maximalIdeal` and `isPermissible_vanishingIdeal_singleton`: a closed point is a permissible center (node SG0000000T). The local ring of a point is a field, and each module over a field is flat.
* `isSncDivisor_of_codim_one`: a regular closed subscheme of codimension 1 in a regular scheme is a divisor with simple normal crossings, with one component at each point (node SG0000000V). The proof uses that such a subscheme is defined at each point by one member of a regular system of parameters ([Mat89, Theorem 14.2], Stacks tag 00NQ).
* `isEmbeddedResolution_id_of_codim_one`: the identity is an embedded resolution of a reduced regular closed subscheme of codimension 1 (node SG0000001C).

The hypotheses on a subscheme `X` are stated at the stalks: at each point `z` of `X`, the quotient `𝒪_{Z,z} / X_z` is regular and has dimension `dim 𝒪_{Z,z} - 1`. The ring `𝒪_{Z,z} / X_z` is the local ring of `X` at `z`.

## References

* [Mat89] H. Matsumura, *Commutative ring theory*, 1989.
* [Sta] The Stacks project authors, *The Stacks project*.
-/

open AlgebraicGeometry CategoryTheory IsLocalRing TopologicalSpace

universe u

namespace Singularity

/-! ### 1. Local algebra -/

section Local

variable {R : Type u} [CommRing R]

/-- In a regular local ring, an element `x ∈ 𝔪 \ 𝔪²` is a member of a regular system of parameters. -/
theorem exists_isRegularSystemOfParameters_mem [IsRegularLocalRing R] {x : R}
    (mem : x ∈ maximalIdeal R) (nmem : x ∉ maximalIdeal R ^ 2) :
    ∃ s : Finset R, IsRegularSystemOfParameters s ∧ x ∈ s := by
  classical
  obtain ⟨t, -, hcard, hspan⟩ := Algebra.exists_span_insert_eq_maximalIdeal mem nmem
  refine ⟨insert x t, ⟨by rw [Finset.coe_insert, hspan], ?_⟩, Finset.mem_insert_self x t⟩
  have hle : (maximalIdeal R).spanFinrank ≤ (insert x t).card := by
    rw [hspan, ← Finset.coe_insert]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (Finset.finite_toSet _)).trans_eq
      (Set.ncard_coe_finset _)
  have hle2 := Finset.card_insert_le x t
  have heq : (insert x t).card = (maximalIdeal R).spanFinrank := by omega
  rw [heq]
  exact IsRegularLocalRing.spanFinrank_maximalIdeal

/-- Let `R` be a regular local ring and let `P` be an ideal such that `R / P` is regular and `dim R / P + 1 = dim R`. Then `P` is generated by one member of a regular system of parameters ([Mat89, Theorem 14.2], Stacks tag 00NQ). -/
theorem exists_isRegularSystemOfParameters_eq_span_singleton [IsRegularLocalRing R]
    (P : Ideal R) [IsRegularLocalRing (R ⧸ P)]
    (h : ringKrullDim (R ⧸ P) + 1 = ringKrullDim R) :
    ∃ s : Finset R, IsRegularSystemOfParameters s ∧ ∃ x ∈ s, P = Ideal.span {x} := by
  obtain ⟨x, mem, nmem, hP⟩ := Algebra.exists_eq_span_singleton_of_isRegularLocalRing_quotient P h
  obtain ⟨s, hs, hxs⟩ := exists_isRegularSystemOfParameters_mem mem nmem
  exact ⟨s, hs, x, hxs, hP⟩

/-- A regular quotient of codimension 1 of a regular local ring is a divisor with simple normal crossings, with one component. -/
theorem isSncAt_of_isRegularLocalRing_quotient [IsRegularLocalRing R] (P : Ideal R)
    [IsRegularLocalRing (R ⧸ P)] (h : ringKrullDim (R ⧸ P) + 1 = ringKrullDim R) :
    IsSncAt P := by
  obtain ⟨s, hs, x, hxs, hP⟩ := exists_isRegularSystemOfParameters_eq_span_singleton P h
  exact ⟨s, hs, {x}, Finset.singleton_subset_iff.mpr hxs, by rw [Finset.prod_singleton, hP]⟩

/-- A regular quotient of codimension 1 of a regular local ring has normal crossings with the empty divisor. -/
theorem hasNormalCrossingsAt_top_of_isRegularLocalRing_quotient [IsRegularLocalRing R]
    (P : Ideal R) [IsRegularLocalRing (R ⧸ P)]
    (h : ringKrullDim (R ⧸ P) + 1 = ringKrullDim R) :
    HasNormalCrossingsAt P ⊤ := by
  obtain ⟨s, hs, x, hxs, hP⟩ := exists_isRegularSystemOfParameters_eq_span_singleton P h
  refine ⟨s, hs, {x}, Finset.singleton_subset_iff.mpr hxs, ∅, Finset.empty_subset s,
    Finset.disjoint_empty_right _, by rw [Finset.coe_singleton, hP], by simp⟩

/-- The residue field of a local ring is a regular local ring. -/
theorem isRegularLocalRing_quotient_maximalIdeal [IsLocalRing R] :
    IsRegularLocalRing (R ⧸ maximalIdeal R) := by
  let := Ideal.Quotient.field (maximalIdeal R)
  infer_instance

/-- A local ring `R / Q` is normally flat along its maximal ideal: each module over the residue field is flat. -/
theorem isNormallyFlatAt_maximalIdeal [IsLocalRing R] (Q : Ideal R) :
    IsNormallyFlatAt (maximalIdeal R) Q := by
  intro n
  let := Ideal.Quotient.field (maximalIdeal R)
  infer_instance

end Local

/-! ### 2. A closed point is a permissible center -/

section Point

variable {Z : Scheme.{u}}

/-- A closed subscheme `C` of `X` whose stalk at each of its points is the maximal ideal is a permissible center for `X`. Such a `C` is a set of closed points with the reduced structure. -/
theorem isPermissible_of_stalkIdeal_eq_maximalIdeal {X C : Z.IdealSheafData} (hXC : X ≤ C)
    (hC : ∀ z ∈ C.support, stalkIdeal C z = maximalIdeal (Z.presheaf.stalk z)) :
    IsPermissible X C := by
  refine ⟨hXC, fun z hz => ?_⟩
  rw [hC z hz]
  exact ⟨isRegularLocalRing_quotient_maximalIdeal, isNormallyFlatAt_maximalIdeal _⟩

/-- The stalk at a closed point `z` of the ideal sheaf of `z` with the reduced structure is the maximal ideal of `𝒪_{Z,z}`. -/
theorem stalkIdeal_vanishingIdeal_singleton {z : Z} (hz : IsClosed ({z} : Set Z)) :
    stalkIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{z}, hz⟩) z =
      maximalIdeal (Z.presheaf.stalk z) := by
  have hmem : z ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{z}, hz⟩).support := by
    rw [← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  refine le_antisymm (stalkIdeal_le_maximalIdeal hmem) ?_
  obtain ⟨U, hzU⟩ := exists_affineOpens_mem z
  refine le_trans ?_ (map_ideal_le_stalkIdeal _ U hzU)
  have hU : IsAffineOpen U.1 := U.2
  set p := hU.primeIdealOf ⟨z, hzU⟩ with hpdef
  have hpre : hU.fromSpec ⁻¹' ({z} : Set Z) = {p} := by
    ext q
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hq
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hq, hpdef, IsAffineOpen.fromSpec_primeIdealOf]
    · rintro rfl
      exact IsAffineOpen.fromSpec_primeIdealOf _ _
  have hp : (Scheme.IdealSheafData.vanishingIdeal ⟨{z}, hz⟩).ideal U = p.asIdeal := by
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
    refine (congrArg PrimeSpectrum.vanishingIdeal ?_).trans (PrimeSpectrum.vanishingIdeal_singleton p)
    exact hpre
  let : Algebra Γ(Z, U.1) (Z.presheaf.stalk z) := (Z.presheaf.germ U.1 z hzU).hom.toAlgebra
  have : IsLocalization.AtPrime (Z.presheaf.stalk z) p.asIdeal := hU.isLocalization_stalk ⟨z, hzU⟩
  rw [hp]
  exact (IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal (Z.presheaf.stalk z)).ge

/-- A closed point is a permissible center (node SG0000000T): let `z` be a closed point of `Z` in the closed subscheme `X`. Then `z`, with the reduced structure, is a permissible center for `X`. -/
theorem isPermissible_vanishingIdeal_singleton {X : Z.IdealSheafData} {z : Z}
    (hz : IsClosed ({z} : Set Z)) (hzX : z ∈ X.support) :
    IsPermissible X (Scheme.IdealSheafData.vanishingIdeal ⟨{z}, hz⟩) := by
  refine isPermissible_of_stalkIdeal_eq_maximalIdeal ?_ fun y hy => ?_
  · rw [← Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal]
    intro y hy
    have hyz : y = z := hy
    exact hyz ▸ hzX
  · rw [← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_vanishingIdeal] at hy
    have hyz : y = z := hy
    subst hyz
    exact stalkIdeal_vanishingIdeal_singleton hz

end Point

/-! ### 3. A regular subscheme of codimension 1 -/

section CodimOne

variable {Z : Scheme.{u}}

/-- A regular closed subscheme of codimension 1 in a regular scheme is a divisor with simple normal crossings (node SG0000000V). At each point it has at most one component, given by one member of a regular system of parameters. -/
theorem isSncDivisor_of_codim_one (hZ : IsRegularScheme Z) {D : Z.IdealSheafData}
    (hD : IsRegularCodimOne D) : IsSncDivisor D := by
  intro z
  have := hZ z
  by_cases hz : z ∈ D.support
  · have := (hD z hz).1
    exact isSncAt_of_isRegularLocalRing_quotient _ (hD z hz).2
  · rw [stalkIdeal_eq_top_of_notMem hz]
    exact isSncAt_top

/-- A regular closed subscheme of codimension 1 in a regular scheme has normal crossings with the empty divisor. -/
theorem hasNormalCrossings_top_of_codim_one (hZ : IsRegularScheme Z) {D : Z.IdealSheafData}
    (hD : IsRegularCodimOne D) : HasNormalCrossings D ⊤ := by
  intro z hz
  have := hZ z
  have := (hD z hz).1
  rw [stalkIdeal_top]
  exact hasNormalCrossingsAt_top_of_isRegularLocalRing_quotient _ (hD z hz).2

/-- The identity of a regular scheme `Z` is an embedded resolution of a reduced regular closed subscheme `X` of codimension 1, with `U = Z` and the empty exceptional divisor. The hypothesis `X.radical = X` says that `X` is reduced. -/
theorem isEmbeddedResolution_id_of_codim_one (hZ : IsRegularScheme Z) {X : Z.IdealSheafData}
    (hX : IsRegularCodimOne X) (hrad : X.radical = X) :
    IsEmbeddedResolution X (𝟙 Z) ⊤ ⊤ where
  regular := hZ
  proper := inferInstance
  compl_subset := by simp
  isIso_over := inferInstance
  support_eq := by simp [Scheme.IdealSheafData.support_top]
  snc := by
    intro z
    have := hZ z
    rw [stalkIdeal_top]
    exact isSncAt_top
  normalCrossings := by
    have h : strictTransform X (𝟙 Z) ⊤ = X := by
      have hc : (⟨closure ((𝟙 Z : Z ⟶ Z).base ⁻¹' ((X.support : Set Z) ∩ (⊤ : Z.Opens))),
          isClosed_closure⟩ : Closeds Z) = X.support := by
        ext x
        simp [X.support.isClosed.closure_eq]
      rw [strictTransform, hc, Scheme.IdealSheafData.vanishingIdeal_support, hrad]
    rw [h]
    exact hasNormalCrossings_top_of_codim_one hZ hX

end CodimOne

end Singularity
