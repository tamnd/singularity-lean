import Singularity.Surface.IdealChart

/-!
# The blowup of an ideal on one chart: isomorphism off the center and universal property

Let `R` be a commutative ring, let `I` be an ideal of `R`, let `f : R` and let `R[I/f]` be the
chart `Singularity.idealChart I f`. This file proves the affine form on one chart of parts 2 and 3
of Volume 4, Theorem 1.1.2 of the handbook. Part 1 on one chart is Lemma 1.1.3, part 3, which is
`Singularity.map_idealChart_eq_span` and `Singularity.algebraMap_mem_nonZeroDivisors_idealChart`.

* `Singularity.idealChart_eq_top_of_one_mem`: if `1 ∈ I`, then `R[I/f] = R_f`. So over an open
  set where `I` is the unit ideal, the chart is the open set `D(f)` itself.
* `Singularity.bijective_algebraMap_idealChart_of_isUnit`: if `f` is a unit of `R`, then the map
  `R → R[I/f]` is bijective.
* `Singularity.idealChartLift`: let `T` be an `R`-algebra with `I T ⊆ f T` and such that `f` is a
  nonzerodivisor of `T`. Then there is an `R`-algebra map `R[I/f] → T`.
* `Singularity.algHom_idealChart_ext`: if `f` is a nonzerodivisor of `T`, then two `R`-algebra
  maps `R[I/f] → T` are equal.
* `Singularity.existsUnique_algHom_idealChart`: this map is the only `R`-algebra map
  `R[I/f] → T`.

The file does not prove Theorem 1.1.2 on schemes. It does not glue the charts, and it does not
show that an invertible ideal `I O_T` is locally generated by the image of one generator of `I`.
-/

namespace Singularity

variable {R : Type*} [CommRing R]

/-- If `1 ∈ I`, then the chart `R[I/f]` is all of `R_f`. This is part 2 of Volume 4,
Theorem 1.1.2 of the handbook on one chart: over the open set where `I` is the unit ideal the
blowup does not change the scheme. -/
theorem idealChart_eq_top_of_one_mem {I : Ideal R} (h : (1 : R) ∈ I) (f : R) :
    idealChart I f = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hinv : IsLocalization.Away.invSelf f ∈ idealChart I f := by
    have := div_mem_idealChart (f := f) h
    rwa [map_one, one_mul] at this
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers f) x
  simp only at ha
  have hx : x = algebraMap R (Localization.Away f) a * IsLocalization.Away.invSelf f ^ n := by
    rw [← ha, map_pow, mul_assoc, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
  rw [hx]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ a) (Subalgebra.pow_mem _ hinv n)

/-- If `f` is a unit of `R`, then the map `R → R[I/f]` is bijective (Volume 4, Theorem 1.1.2,
part 2 of the handbook, on one chart). -/
theorem bijective_algebraMap_idealChart_of_isUnit (I : Ideal R) {f : R} (hf : IsUnit f) :
    Function.Bijective (algebraMap R (idealChart I f)) := by
  have hinj : Function.Injective (algebraMap R (Localization.Away f)) :=
    IsLocalization.injective (M := Submonoid.powers f) (Localization.Away f)
      (Submonoid.powers_le.2 hf.mem_nonZeroDivisors)
  refine ⟨fun a b hab => hinj (congrArg Subtype.val hab), fun x => ?_⟩
  obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers f) x.1
  simp only at ha
  have hu : IsUnit (algebraMap R (Localization.Away f) (f ^ n)) :=
    IsLocalization.map_units _ (⟨f ^ n, n, rfl⟩ : Submonoid.powers f)
  refine ⟨a * (↑hf.unit⁻¹ : R) ^ n, Subtype.val_injective (hu.mul_left_injective ?_)⟩
  simp only [Subalgebra.coe_algebraMap]
  rw [ha, ← map_mul, mul_assoc, ← mul_pow, IsUnit.val_inv_mul, one_pow, mul_one]

section Universal

variable {I : Ideal R} {f : R} {T : Type*} [CommRing T] [Algebra R T]

/-- The map `R_f → T_f`, as a map of `R`-algebras. -/
noncomputable def idealChartAwayMap (f : R) (T : Type*) [CommRing T] [Algebra R T] :
    Localization.Away f →ₐ[R] Localization.Away (algebraMap R T f) :=
  { Localization.awayMap (algebraMap R T) f with
    commutes' := fun r => by
      change Localization.awayMap (algebraMap R T) f _ = _
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]
      rfl }

/-- The map `R_f → T_f` sends `a` to the image of `a` in `T`. -/
theorem idealChartAwayMap_algebraMap (a : R) :
    idealChartAwayMap f T (algebraMap R _ a) =
      algebraMap T (Localization.Away (algebraMap R T f)) (algebraMap R T a) :=
  by rw [AlgHom.commutes]; rfl

/-- The map `R_f → T_f` sends `1/f` to the inverse of the image of `f`. -/
theorem idealChartAwayMap_invSelf_mul :
    idealChartAwayMap f T (IsLocalization.Away.invSelf f) *
      algebraMap T (Localization.Away (algebraMap R T f)) (algebraMap R T f) = 1 := by
  rw [← idealChartAwayMap_algebraMap, ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf,
    map_one]

/-- If `I T ⊆ f T`, then the image of `R[I/f]` in `T_f` is in the image of `T`. -/
theorem range_idealChartAwayMap_le (hI : I.map (algebraMap R T) ≤ Ideal.span {algebraMap R T f}) :
    ((idealChartAwayMap f T).comp (idealChart I f).val).range ≤
      (IsScalarTower.toAlgHom R T (Localization.Away (algebraMap R T f))).range := by
  rw [AlgHom.range_comp, Subalgebra.range_val, idealChart, AlgHom.map_adjoin,
    Algebra.adjoin_le_iff]
  rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 (hI (Ideal.mem_map_of_mem _ ha))
  refine ⟨c, ?_⟩
  simp only [map_mul, idealChartAwayMap_algebraMap]
  rw [← hc, map_mul, mul_assoc, mul_comm (algebraMap T _ (algebraMap R T f)),
    idealChartAwayMap_invSelf_mul, mul_one]
  rfl

/-- Let `T` be an `R`-algebra with `I T ⊆ f T`, such that `f` is a nonzerodivisor of `T`. Then
there is an `R`-algebra map `R[I/f] → T`. It sends `a/f^n` with `a ∈ I^n` to the element `t` of
`T` with `f^n t = a`. This is the existence in part 3 of Volume 4, Theorem 1.1.2 of the
handbook, on one chart. -/
noncomputable def idealChartLift
    (hI : I.map (algebraMap R T) ≤ Ideal.span {algebraMap R T f})
    (hf : algebraMap R T f ∈ nonZeroDivisors T) : idealChart I f →ₐ[R] T :=
  (AlgEquiv.ofInjective (IsScalarTower.toAlgHom R T (Localization.Away (algebraMap R T f)))
      (IsLocalization.injective (Localization.Away (algebraMap R T f))
        (Submonoid.powers_le.2 hf))).symm.toAlgHom.comp
    (((idealChartAwayMap f T).comp (idealChart I f).val).codRestrict _
      (fun x => range_idealChartAwayMap_le hI ⟨x, rfl⟩))

/-- Let `T` be an `R`-algebra such that `f` is a nonzerodivisor of `T`. Two `R`-algebra maps
`R[I/f] → T` are equal. -/
theorem algHom_idealChart_ext (hf : algebraMap R T f ∈ nonZeroDivisors T)
    (g₁ g₂ : idealChart I f →ₐ[R] T) : g₁ = g₂ := by
  have key : ∀ (y : Localization.Away f) (hy : y ∈ idealChart I f),
      g₁ ⟨y, hy⟩ = g₂ ⟨y, hy⟩ := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      have h : ∀ g : idealChart I f →ₐ[R] T,
          g ⟨_, div_mem_idealChart ha⟩ * algebraMap R T f = algebraMap R T a := by
        intro g
        rw [← g.commutes f, ← map_mul, ← g.commutes a]
        congr 1
        apply Subtype.val_injective
        simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
        rw [mul_assoc, mul_comm (IsLocalization.Away.invSelf f),
          IsLocalization.Away.mul_invSelf, mul_one]
      exact (mul_cancel_right_mem_nonZeroDivisors hf).1 ((h g₁).trans (h g₂).symm)
    | algebraMap r =>
      exact (g₁.commutes r).trans (g₂.commutes r).symm
    | add x y hx hy ihx ihy =>
      have := congrArg₂ (· + ·) ihx ihy
      rw [← map_add, ← map_add] at this
      exact this
    | mul x y hx hy ihx ihy =>
      have := congrArg₂ (· * ·) ihx ihy
      rw [← map_mul, ← map_mul] at this
      exact this
  exact AlgHom.ext fun x => key x.1 x.2

/-- The universal property of the blowup on one chart (Volume 4, Theorem 1.1.2, part 3 of the
handbook, affine form). Let `T` be an `R`-algebra with `I T ⊆ f T`, such that `f` is a
nonzerodivisor of `T`. Then there is exactly one `R`-algebra map `R[I/f] → T`. -/
theorem existsUnique_algHom_idealChart
    (hI : I.map (algebraMap R T) ≤ Ideal.span {algebraMap R T f})
    (hf : algebraMap R T f ∈ nonZeroDivisors T) :
    ∃! _ : idealChart I f →ₐ[R] T, True :=
  ⟨idealChartLift hI hf, trivial, fun g _ => algHom_idealChart_ext hf g _⟩

end Universal

end Singularity
