import Singularity.Invariant.LogJacobianFirstIntegral
import Singularity.Invariant.LogDerivations
import Singularity.Algebra.DerivationGradings
import Mathlib.RingTheory.Derivation.Lie
import Mathlib.Data.Nat.Choose.Dvd

/-!
# The ramified case of the log-Jacobian criterion

Let `R` be a local domain of characteristic `p` over `k`, with coordinates `x i` in the maximal ideal and derivations `D i` dual to them. Let `Δ` be a finite set of indices (the divisor) and let `f : R`. Suppose that the log-Jacobian ideal `derivLogJacobian D x Δ f` is principal, generated by `x i0 * D i0 f` with `i0 ∈ Δ` and `x i0 * D i0 f ≠ 0`. This file proves that there is a first integral of the form `u * x i0 * ∏ i ∈ Δ.erase i0, x i ^ a i`, with `u` a unit and `a i < p`. Each log derivation that kills `f` also kills this element, and `x i0 * D i0` multiplies it by a unit.

## Main definitions

* `Singularity.powCharDerivation`: the `p`-th power of a derivation in characteristic `p`, as a derivation.
* `Singularity.logCoeff`: the coefficient `x i` for `i ∈ Δ` and `1` for `i ∉ Δ`.
* `Singularity.criterionDerivation`: the log derivation `logCoeff x Δ i • D i - c i • x i0 • D i0` that kills `f`.

## Main results

* `Singularity.exists_first_integral_of_derivLogJacobian_eq_span`: the ramified case of the log-Jacobian criterion.
* `Singularity.exists_derivLogJacobian_eq_span_generator`: a principal log-Jacobian ideal with a nonzero generator has a generator `x i * D i f` with `i ∈ Δ` or `D i f` with `i ∉ Δ`.
* `Singularity.exists_origin_first_integral_of_derivLogJacobian_eq_span`: the criterion for the local ring of a polynomial ring at the origin.

## The proof

From the principal ideal we get coefficients `c i` with `logCoeff x Δ i * D i f = c i * (x i0 * D i0 f)`, and `c i0 = 1`. The derivations `E i = criterionDerivation D x Δ i0 c i` kill `f` and commute with each other, because their bracket kills `f` and all the coordinates but `x i0`, and a derivation with these properties is zero. In characteristic `p`, `E i ^ p = E i` for `i ∈ Δ` and `E j ^ p = 0` for `j ∉ Δ`. The `E i` with `i ∈ Δ` keep the ideal `(x i0)` and give a grading of it by `Δ → ZMod p`. A Taylor expansion along `x j` for `j ∉ Δ` removes the dependence on `x j`. Together, these give a common weight vector `η` with `(η) = (x i0)` that the `E j` with `j ∉ Δ` kill. Then `η` is `x i0` times a unit, and when we divide `η` by a monomial in the `x i` with `i ∈ Δ.erase i0`, we get an element that all the `E i` kill. Each log derivation `δ` that kills `f` is a combination of the `E i` and `x i0 * D i0`, and this gives the result.

## What is not proved

* Case 2 of the theorem, where the unit coefficient is at an index outside the divisor, is not here.
* The statement `f ∈ E^p(t)` is not here.
* The existence of a model with a principal log-Jacobian ideal in dimension 4 is open, and this file does not prove it.
* The file does not prove local uniformization.

## References

* Volume 5, Chapter 4 of the handbook, Theorem 4.4.16.
-/

open IsLocalRing Finset

namespace Singularity

section PowChar

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

/-- The general Leibniz rule for the powers of a derivation. -/
theorem derivation_pow_apply_mul_eq_sum (δ : Derivation k R R) (n : ℕ) (a b : R) :
    (δ.toLinearMap ^ n) (a * b) = ∑ ij ∈ antidiagonal n,
      n.choose ij.1 • ((δ.toLinearMap ^ ij.1) a * (δ.toLinearMap ^ ij.2) b) := by
  have hs : ∀ (i : ℕ) (y : R), (δ.toLinearMap ^ (i + 1)) y = δ ((δ.toLinearMap ^ i) y) := by
    intro i y
    rw [pow_succ', Module.End.mul_apply]
    rfl
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_antidiagonal_choose_succ_nsmul (M := R)
      (fun i j => (δ.toLinearMap ^ i) a * (δ.toLinearMap ^ j) b) n, hs, ih, map_sum]
    simp only [map_nsmul, Derivation.leibniz, smul_eq_mul, hs, smul_add, sum_add_distrib]
    congr 1
    · refine sum_congr rfl fun ij hij => ?_
      rw [n.choose_symm_of_eq_add (mem_antidiagonal.1 hij).symm, mul_comm]

/-- In characteristic `p`, the `p`-th power of a derivation obeys the Leibniz rule. -/
theorem derivation_pow_char_apply_mul (p : ℕ) [Fact p.Prime] [CharP R p]
    (δ : Derivation k R R) (a b : R) :
    (δ.toLinearMap ^ p) (a * b) = a * (δ.toLinearMap ^ p) b + (δ.toLinearMap ^ p) a * b := by
  have hp := (Fact.out : p.Prime)
  rw [derivation_pow_apply_mul_eq_sum, Finset.sum_eq_add (0, p) (p, 0)]
  · simp
  · intro h
    exact hp.ne_zero (congrArg Prod.fst h).symm
  · rintro ⟨i, j⟩ hij ⟨h0, h1⟩
    have hij' : i + j = p := mem_antidiagonal.1 hij
    have hi0 : i ≠ 0 := by
      rintro rfl
      exact h0 (by rw [zero_add] at hij'; rw [hij'])
    have hip : i < p := by
      rcases Nat.lt_or_ge i p with h | h
      · exact h
      · exfalso
        exact h1 (Prod.ext (by simp only; omega) (by simp only; omega))
    rw [nsmul_eq_mul, (CharP.cast_eq_zero_iff R p _).mpr (Nat.Prime.dvd_choose_self hp hi0 hip),
      zero_mul]
  · intro h
    exact absurd (mem_antidiagonal.2 (by simp)) h
  · intro h
    exact absurd (mem_antidiagonal.2 (by simp)) h

/-- The `p`-th power of a derivation in characteristic `p`, as a derivation. -/
noncomputable def powCharDerivation (p : ℕ) [Fact p.Prime] [CharP R p] (δ : Derivation k R R) :
    Derivation k R R :=
  Derivation.mk' (δ.toLinearMap ^ p) fun a b => by
    rw [derivation_pow_char_apply_mul, smul_eq_mul, smul_eq_mul, mul_comm b]

/-- The value of `powCharDerivation p δ` is the value of the `p`-th power of `δ`. -/
theorem powCharDerivation_apply (p : ℕ) [Fact p.Prime] [CharP R p] (δ : Derivation k R R)
    (a : R) : powCharDerivation p δ a = (δ.toLinearMap ^ p) a :=
  rfl

/-- If `δ a = a`, then each power of `δ` fixes `a`. -/
theorem derivation_pow_apply_of_eq_self (δ : Derivation k R R) {a : R} (h : δ a = a) (n : ℕ) :
    (δ.toLinearMap ^ n) a = a := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, Module.End.mul_apply]
    simp only [Derivation.coeFn_coe, h]
    exact ih

/-- If `δ a = 0`, then each nonzero power of `δ` kills `a`. -/
theorem derivation_pow_apply_of_eq_zero (δ : Derivation k R R) {a : R} (h : δ a = 0) {n : ℕ}
    (hn : n ≠ 0) : (δ.toLinearMap ^ n) a = 0 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  rw [pow_succ, Module.End.mul_apply]
  simp only [Derivation.coeFn_coe, h, map_zero]

/-- If `δ` keeps an ideal `I`, then each power of `δ` keeps `I`. -/
theorem derivation_pow_apply_mem_ideal (δ : Derivation k R R) (I : Ideal R)
    (hI : ∀ a ∈ I, δ a ∈ I) (n : ℕ) {a : R} (ha : a ∈ I) : (δ.toLinearMap ^ n) a ∈ I := by
  induction n with
  | zero => simpa using ha
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply]
    exact hI _ ih

/-- If `δ y ∈ (y)`, then `δ` keeps the ideal `(y)`. -/
theorem derivation_mem_span_singleton (δ : Derivation k R R) {y a : R}
    (hy : δ y ∈ Ideal.span {y}) (ha : a ∈ Ideal.span {y}) : δ a ∈ Ideal.span {y} := by
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
  exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy)
    (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self y))

/-- A derivation is linear over the image of `ZMod p`. -/
theorem derivation_zmodCast_mul (p : ℕ) [Fact p.Prime] (δ : Derivation k R R) (z : ZMod p)
    (b : R) : δ ((ZMod.cast z : R) * b) = ZMod.cast z * δ b := by
  rw [← ZMod.natCast_val, Derivation.leibniz, Derivation.map_natCast, smul_zero, add_zero,
    smul_eq_mul]

/-- The value of a derivation on a product of powers of elements `y l` with `δ (y l) = w l * y l`. -/
theorem derivation_prod_pow {ι : Type*} [DecidableEq ι] (δ : Derivation k R R) (s : Finset ι)
    (y : ι → R) (a : ι → ℕ) (w : ι → R) (h : ∀ l ∈ s, δ (y l) = w l * y l) :
    δ (∏ l ∈ s, y l ^ a l) = (∑ l ∈ s, (a l : R) * w l) * ∏ l ∈ s, y l ^ a l := by
  induction s using Finset.induction_on with
  | empty => simp
  | insert j s hj ih =>
    rw [prod_insert hj, sum_insert hj, Derivation.leibniz,
      ih (fun l hl => h l (mem_insert_of_mem hl)), Derivation.leibniz_pow,
      h j (mem_insert_self j s), smul_eq_mul, smul_eq_mul, nsmul_eq_mul, smul_eq_mul]
    generalize a j = n
    cases n with
    | zero => simp
    | succ n =>
      simp only [Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one]
      ring

/-- The value of a finite sum of derivations is the sum of the values. -/
theorem derivation_finsetSum_apply {ι : Type*} (s : Finset ι) (F : ι → Derivation k R R)
    (a : R) : (∑ j ∈ s, F j) a = ∑ j ∈ s, F j a := by
  rw [← Derivation.coeFnAddMonoidHom_apply, map_sum, Finset.sum_apply]
  rfl

/-- A Taylor expansion relative to a submodule. If `δ ^ p = 0`, `δ y = 1`, and `δ` and multiplication by `y` keep `S`, then each `a ∈ S` is a sum of `y ^ i * b i` with `b i ∈ S` and `δ (b i) = 0`. -/
theorem exists_taylor_of_mem_submodule (δ : Derivation k R R) (p : ℕ) [Fact p.Prime]
    [CharP R p] (hδ : δ.toLinearMap ^ p = 0) {y : R} (hy : δ y = 1) (S : Submodule k R)
    (hS : ∀ b ∈ S, δ b ∈ S) (hyS : ∀ b ∈ S, y * b ∈ S) {a : R} (ha : a ∈ S) :
    ∃ b : ℕ → R, (∀ i, b i ∈ S ∧ δ (b i) = 0) ∧ a = ∑ i ∈ range p, y ^ i * b i := by
  have hpowS : ∀ (m : ℕ) (z : R), z ∈ S → y ^ m * z ∈ S := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      intro z hz
      rw [pow_succ, mul_assoc]
      exact ih _ (hyS z hz)
  have hdS : ∀ (m : ℕ) (z : R), z ∈ S → (δ.toLinearMap ^ m) z ∈ S := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      intro z hz
      rw [pow_succ', Module.End.mul_apply]
      exact hS _ (ih z hz)
  suffices h : ∀ m ≤ p, ∀ a ∈ S, (δ.toLinearMap ^ m) a = 0 →
      ∃ b : ℕ → R, (∀ i, b i ∈ S ∧ δ (b i) = 0) ∧ a = ∑ i ∈ range m, y ^ i * b i from
    h p le_rfl a ha (by rw [hδ, LinearMap.zero_apply])
  intro m
  induction m with
  | zero =>
    intro _ a _ h0
    refine ⟨0, fun i => ⟨S.zero_mem, map_zero δ⟩, ?_⟩
    simpa using h0
  | succ m ih =>
    intro hm a ha h0
    set c := (δ.toLinearMap ^ m) a with hc
    have hc0 : δ c = 0 := by
      rw [pow_succ', Module.End.mul_apply] at h0
      exact h0
    have hcS : c ∈ S := hdS m a ha
    obtain ⟨n, hn⟩ := exists_natCast_mul_factorial_eq_one (A := R) p (m := m) (by omega)
    have hnc : δ ((n : R) * c) = 0 := by simp [Derivation.leibniz, hc0]
    have hncS : (n : R) * c ∈ S := by
      rw [← nsmul_eq_mul]
      exact S.nsmul_mem hcS n
    have h1 : (δ.toLinearMap ^ m) (a - y ^ m * ((n : R) * c)) = 0 := by
      rw [map_sub, derivation_pow_apply_mul_of_eq_zero δ _ _ hnc,
        derivation_pow_apply_pow_self δ hy, ← hc, ← mul_assoc, mul_comm (m.factorial : R),
        hn, one_mul, sub_self]
    have hS' : a - y ^ m * ((n : R) * c) ∈ S := S.sub_mem ha (hpowS m _ hncS)
    obtain ⟨b, hb, hsum⟩ := ih (by omega) _ hS' h1
    refine ⟨Function.update b m ((n : R) * c), fun i => ?_, ?_⟩
    · rcases eq_or_ne i m with rfl | hi
      · simp only [Function.update_self]
        exact ⟨hncS, hnc⟩
      · simp only [Function.update_of_ne hi]
        exact hb i
    · rw [sum_range_succ, Function.update_self]
      have h2 : ∑ i ∈ range m, y ^ i * Function.update b m ((n : R) * c) i =
          ∑ i ∈ range m, y ^ i * b i :=
        sum_congr rfl fun i hi => by
          rw [Function.update_of_ne (Nat.ne_of_lt (mem_range.mp hi))]
      rw [h2, ← hsum]
      ring

/-- In a local ring, if `h` is a sum of `y ^ i * b i` with `y` in the maximal ideal and all `b i ∈ (h)`, then `(b 0) = (h)`. -/
theorem span_taylor_coeff_zero [IsLocalRing R] {p : ℕ} {y h : R} (hy : y ∈ maximalIdeal R)
    {b : ℕ → R} (hb : ∀ i, b i ∈ Ideal.span {h}) (hp : 0 < p)
    (hsum : h = ∑ i ∈ range p, y ^ i * b i) : Ideal.span {b 0} = Ideal.span {h} := by
  obtain ⟨n, rfl⟩ : ∃ n, p = n + 1 := ⟨p - 1, by omega⟩
  choose r hr using fun i => Ideal.mem_span_singleton'.mp (hb i)
  rw [sum_range_succ'] at hsum
  have h1 : ∑ i ∈ range n, y ^ (i + 1) * b (i + 1) =
      y * (∑ i ∈ range n, y ^ i * r (i + 1)) * h := by
    rw [mul_sum, sum_mul]
    refine sum_congr rfl fun i _ => ?_
    rw [← hr]
    ring
  have h2 : b 0 = (1 - y * ∑ i ∈ range n, y ^ i * r (i + 1)) * h := by
    rw [pow_zero, one_mul, h1] at hsum
    linear_combination -hsum
  have hu : IsUnit (1 - y * ∑ i ∈ range n, y ^ i * r (i + 1)) :=
    isUnit_one_sub_self_of_mem_nonunits _ (Ideal.mul_mem_right _ _ hy)
  rw [h2, Ideal.span_singleton_mul_left_unit hu]

end PowChar

section Criterion

variable {k R ι : Type*} [CommRing k] [CommRing R] [Algebra k R] [DecidableEq ι]
  {D : ι → Derivation k R R} {x : ι → R}

/-- If a derivation is determined by its values on the coordinates, then `δ = ∑ j, δ (x j) • D j`. -/
theorem derivation_eq_sum_smul [Fintype ι] (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (δ : Derivation k R R) :
    δ = ∑ j, δ (x j) • D j := by
  refine sub_eq_zero.mp (hdet _ fun i => ?_)
  rw [Derivation.sub_apply, derivation_finsetSum_apply]
  simp [Derivation.smul_apply, hD]

/-- Let `x i0 * D i0 f ≠ 0`. A derivation that kills `f` and all the coordinates but `x i0`, and maps `x i0` into `(x i0)`, is zero. -/
theorem derivation_eq_zero_of_apply [Fintype ι] [IsDomain R]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) {i0 : ι} {f : R}
    (hne : x i0 * D i0 f ≠ 0) (δ : Derivation k R R) (h1 : ∀ j, j ≠ i0 → δ (x j) = 0)
    (h0 : δ (x i0) ∈ Ideal.span {x i0}) (hf : δ f = 0) : δ = 0 := by
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp h0
  have hδ : δ = (g * x i0) • D i0 := by
    rw [derivation_eq_sum_smul hD hdet δ, Finset.sum_eq_single i0
      (fun j _ hj => by rw [h1 j hj, zero_smul]) (fun h => absurd (mem_univ i0) h), hg]
  have hg0 : g = 0 := by
    have h2 := hf
    rw [hδ, Derivation.smul_apply, smul_eq_mul, mul_assoc] at h2
    exact (mul_eq_zero.mp h2).resolve_right hne
  rw [hδ, hg0, zero_mul, zero_smul]

/-- The coefficient `x i` for `i ∈ Δ` and `1` for `i ∉ Δ`. -/
def logCoeff (x : ι → R) (Δ : Finset ι) (i : ι) : R :=
  if i ∈ Δ then x i else 1

/-- The log derivation `logCoeff x Δ i • D i - c i • x i0 • D i0`. -/
def criterionDerivation (D : ι → Derivation k R R) (x : ι → R) (Δ : Finset ι) (i0 : ι)
    (c : ι → R) (i : ι) : Derivation k R R :=
  logCoeff x Δ i • D i - c i • x i0 • D i0

variable {Δ : Finset ι} {i0 : ι} {c : ι → R} {f : R}

/-- The value of `criterionDerivation D x Δ i0 c i`. -/
theorem criterionDerivation_apply (i : ι) (a : R) :
    criterionDerivation D x Δ i0 c i a = logCoeff x Δ i * D i a - c i * (x i0 * D i0 a) := by
  simp [criterionDerivation]

/-- The value of `criterionDerivation D x Δ i0 c i` on a coordinate `x j` with `j ≠ i0`. -/
theorem criterionDerivation_apply_of_ne (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    {i j : ι} (hj : j ≠ i0) :
    criterionDerivation D x Δ i0 c i (x j) = if i = j then logCoeff x Δ i else 0 := by
  rw [criterionDerivation_apply, hD, hD, ite_eq_right (Ne.symm hj)]
  split_ifs <;> ring

/-- The value of `criterionDerivation D x Δ i0 c i` on the coordinate `x i0`. -/
theorem criterionDerivation_apply_self (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hi0 : i0 ∈ Δ) (i : ι) :
    criterionDerivation D x Δ i0 c i (x i0) = ((if i = i0 then 1 else 0) - c i) * x i0 := by
  rw [criterionDerivation_apply, hD, hD, ite_eq_left rfl]
  split_ifs with h
  · subst h
    rw [logCoeff, ite_eq_left hi0]
    ring
  · ring

/-- The derivation `criterionDerivation D x Δ i0 c i` maps `x i0` into `(x i0)`. -/
theorem criterionDerivation_apply_mem (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hi0 : i0 ∈ Δ) (i : ι) : criterionDerivation D x Δ i0 c i (x i0) ∈ Ideal.span {x i0} := by
  rw [criterionDerivation_apply_self hD hi0]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- The derivation `criterionDerivation D x Δ i0 c i` keeps the ideal `(x i0)`. -/
theorem criterionDerivation_mem_span (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hi0 : i0 ∈ Δ) (i : ι) {a : R} (ha : a ∈ Ideal.span {x i0}) :
    criterionDerivation D x Δ i0 c i a ∈ Ideal.span {x i0} :=
  derivation_mem_span_singleton _ (criterionDerivation_apply_mem hD hi0 i) ha

/-- With the coefficients `c` from the principal ideal, `criterionDerivation D x Δ i0 c i` kills `f`. -/
theorem criterionDerivation_apply_eq_zero
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f)) (i : ι) :
    criterionDerivation D x Δ i0 c i f = 0 := by
  rw [criterionDerivation_apply, hc, sub_self]

/-- The value of `criterionDerivation D x Δ i0 c i` on `logCoeff x Δ j` with `j ≠ i0`. -/
theorem criterionDerivation_logCoeff (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    {i j : ι} (hj : j ≠ i0) :
    criterionDerivation D x Δ i0 c i (logCoeff x Δ j) = if i = j ∧ j ∈ Δ then x j else 0 := by
  by_cases hjΔ : j ∈ Δ
  · rw [show logCoeff x Δ j = x j from ite_eq_left hjΔ, criterionDerivation_apply_of_ne hD hj]
    by_cases hij : i = j
    · subst hij
      simp [logCoeff, hjΔ]
    · simp [hij]
  · rw [show logCoeff x Δ j = 1 from ite_eq_right hjΔ, Derivation.map_one_eq_zero]
    simp [hjΔ]

/-- The coefficient `c i0` is `1`. -/
theorem criterion_coeff_self [IsDomain R] (hi0 : i0 ∈ Δ) (hne : x i0 * D i0 f ≠ 0)
    (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f)) : c i0 = 1 := by
  have h := hc i0
  rw [show logCoeff x Δ i0 = x i0 from ite_eq_left hi0] at h
  exact mul_right_cancel₀ hne (h.symm.trans (one_mul _).symm)

/-- If `c i0 = 1`, then `criterionDerivation D x Δ i0 c i0` is zero. -/
theorem criterionDerivation_self_eq_zero (hi0 : i0 ∈ Δ) (hc0 : c i0 = 1) :
    criterionDerivation D x Δ i0 c i0 = 0 := by
  ext a
  rw [criterionDerivation_apply, hc0, show logCoeff x Δ i0 = x i0 from ite_eq_left hi0]
  simp

variable [Fintype ι] [IsDomain R]

/-- The derivations `criterionDerivation D x Δ i0 c i` commute with each other. -/
theorem criterionDerivation_comm (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hi0 : i0 ∈ Δ)
    (hne : x i0 * D i0 f ≠ 0) (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f))
    (i l : ι) (a : R) :
    criterionDerivation D x Δ i0 c i (criterionDerivation D x Δ i0 c l a) =
      criterionDerivation D x Δ i0 c l (criterionDerivation D x Δ i0 c i a) := by
  have hP : ⁅criterionDerivation D x Δ i0 c i, criterionDerivation D x Δ i0 c l⁆ = 0 := by
    refine derivation_eq_zero_of_apply hD hdet hne _ (fun j hj => ?_) ?_ ?_
    · rw [Derivation.commutator_apply, criterionDerivation_apply_of_ne hD hj,
        criterionDerivation_apply_of_ne hD hj]
      by_cases hl : l = j <;> by_cases hi : i = j <;>
        simp [hl, hi, criterionDerivation_logCoeff hD hj]
    · rw [Derivation.commutator_apply]
      exact Ideal.sub_mem _
        (criterionDerivation_mem_span hD hi0 i (criterionDerivation_apply_mem hD hi0 l))
        (criterionDerivation_mem_span hD hi0 l (criterionDerivation_apply_mem hD hi0 i))
    · rw [Derivation.commutator_apply, criterionDerivation_apply_eq_zero hc,
        criterionDerivation_apply_eq_zero hc, map_zero, map_zero, sub_self]
  have h := DFunLike.congr_fun hP a
  rw [Derivation.commutator_apply] at h
  exact sub_eq_zero.mp h

/-- In characteristic `p`, the `p`-th power of `criterionDerivation D x Δ i0 c i` with `i ∈ Δ` is itself. -/
theorem criterionDerivation_pow_eq_self (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hi0 : i0 ∈ Δ)
    (hne : x i0 * D i0 f ≠ 0) (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f))
    {i : ι} (hi : i ∈ Δ) :
    (criterionDerivation D x Δ i0 c i).toLinearMap ^ p =
      (criterionDerivation D x Δ i0 c i).toLinearMap := by
  have hp0 := (Fact.out : p.Prime).ne_zero
  have hP : powCharDerivation p (criterionDerivation D x Δ i0 c i) -
      criterionDerivation D x Δ i0 c i = 0 := by
    refine derivation_eq_zero_of_apply hD hdet hne _ (fun j hj => ?_) ?_ ?_
    · rw [Derivation.sub_apply, powCharDerivation_apply]
      by_cases hij : i = j
      · subst hij
        have h1 : criterionDerivation D x Δ i0 c i (x i) = x i := by
          rw [criterionDerivation_apply_of_ne hD hj, ite_eq_left rfl]
          exact ite_eq_left hi
        rw [derivation_pow_apply_of_eq_self _ h1, h1, sub_self]
      · have h1 : criterionDerivation D x Δ i0 c i (x j) = 0 := by
          rw [criterionDerivation_apply_of_ne hD hj, ite_eq_right hij]
        rw [derivation_pow_apply_of_eq_zero _ h1 hp0, h1, sub_self]
    · rw [Derivation.sub_apply, powCharDerivation_apply]
      exact Ideal.sub_mem _ (derivation_pow_apply_mem_ideal _ _
        (fun a ha => criterionDerivation_mem_span hD hi0 i ha) p
        (Ideal.mem_span_singleton_self _)) (criterionDerivation_apply_mem hD hi0 i)
    · rw [Derivation.sub_apply, powCharDerivation_apply,
        derivation_pow_apply_of_eq_zero _ (criterionDerivation_apply_eq_zero hc i) hp0,
        criterionDerivation_apply_eq_zero hc i, sub_self]
  refine LinearMap.ext fun a => ?_
  have h := DFunLike.congr_fun hP a
  rw [Derivation.sub_apply, powCharDerivation_apply] at h
  exact sub_eq_zero.mp h

/-- In characteristic `p`, the `p`-th power of `criterionDerivation D x Δ i0 c j` with `j ∉ Δ` is zero. -/
theorem criterionDerivation_pow_eq_zero (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0) (hi0 : i0 ∈ Δ)
    (hne : x i0 * D i0 f ≠ 0) (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f))
    {j : ι} (hj : j ∉ Δ) : (criterionDerivation D x Δ i0 c j).toLinearMap ^ p = 0 := by
  have hp0 := (Fact.out : p.Prime).ne_zero
  have hp2 := (Fact.out : p.Prime).two_le
  have hP : powCharDerivation p (criterionDerivation D x Δ i0 c j) = 0 := by
    refine derivation_eq_zero_of_apply hD hdet hne _ (fun l hl => ?_) ?_ ?_
    · rw [powCharDerivation_apply]
      by_cases hjl : j = l
      · subst hjl
        have h1 : criterionDerivation D x Δ i0 c j (x j) = 1 := by
          rw [criterionDerivation_apply_of_ne hD hl, ite_eq_left rfl]
          exact ite_eq_right hj
        obtain ⟨m, hm⟩ : ∃ m, p = m + 1 + 1 := ⟨p - 2, by omega⟩
        rw [hm, pow_succ, Module.End.mul_apply, pow_succ, Module.End.mul_apply]
        simp only [Derivation.coeFn_coe, h1, Derivation.map_one_eq_zero, map_zero]
      · have h1 : criterionDerivation D x Δ i0 c j (x l) = 0 := by
          rw [criterionDerivation_apply_of_ne hD hl, ite_eq_right hjl]
        rw [derivation_pow_apply_of_eq_zero _ h1 hp0]
    · rw [powCharDerivation_apply]
      exact derivation_pow_apply_mem_ideal _ _
        (fun a ha => criterionDerivation_mem_span hD hi0 j ha) p (Ideal.mem_span_singleton_self _)
    · rw [powCharDerivation_apply,
        derivation_pow_apply_of_eq_zero _ (criterionDerivation_apply_eq_zero hc j) hp0]
  exact LinearMap.ext fun a => DFunLike.congr_fun hP a

/-- There is a common weight vector `η` of the derivations `criterionDerivation D x Δ i0 c l` with `l ∈ Δ`, with `(η) = (x i0)`, that these derivations with an index outside `Δ` kill. -/
theorem exists_criterion_generator [IsLocalRing R] (p : ℕ) [Fact p.Prime] [CharP R p]
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0)
    (hx : ∀ i, x i ∈ maximalIdeal R) (hi0 : i0 ∈ Δ)
    (hne : x i0 * D i0 f ≠ 0) (hc : ∀ i, logCoeff x Δ i * D i f = c i * (x i0 * D i0 f)) :
    ∃ χ : Δ → ZMod p, ∃ η ∈ commonWeightSpace (fun l : Δ => criterionDerivation D x Δ i0 c l) χ,
      (∀ j, j ∉ Δ → criterionDerivation D x Δ i0 c j η = 0) ∧
        Ideal.span {η} = Ideal.span {x i0} := by
  set E := criterionDerivation D x Δ i0 c with hE
  obtain ⟨χ, h, hh, hspan⟩ := exists_mem_commonWeightSpace_span_eq (p := p)
    (fun l : Δ => E l) (fun l j g => criterionDerivation_comm hD hdet hi0 hne hc l j g)
    (fun l => criterionDerivation_pow_eq_self p hD hdet hi0 hne hc l.2)
    (fun l a ha => criterionDerivation_mem_span hD hi0 l ha)
  suffices H : ∀ s : Finset ι, (∀ j ∈ s, j ∉ Δ) →
      ∃ η ∈ commonWeightSpace (fun l : Δ => E l) χ, (∀ j ∈ s, E j η = 0) ∧
        Ideal.span {η} = Ideal.span {x i0} by
    obtain ⟨η, h1, h2, h3⟩ := H (univ.filter (· ∉ Δ)) (fun j hj => (mem_filter.mp hj).2)
    exact ⟨χ, η, h1, fun j hj => h2 j (mem_filter.mpr ⟨mem_univ j, hj⟩), h3⟩
  intro s
  induction s using Finset.induction_on with
  | empty => exact fun _ => ⟨h, hh, by simp, hspan.symm⟩
  | insert j s hjs ih =>
    intro hs
    obtain ⟨η, hη1, hη2, hη3⟩ := ih (fun j' hj' => hs j' (mem_insert_of_mem hj'))
    have hjΔ : j ∉ Δ := hs j (mem_insert_self j s)
    have hj0 : j ≠ i0 := fun h => hjΔ (h ▸ hi0)
    let S : Submodule k R :=
      { carrier := {a | a ∈ commonWeightSpace (fun l : Δ => E l) χ ∧ (∀ j' ∈ s, E j' a = 0) ∧
          a ∈ Ideal.span {x i0}}
        add_mem' := fun ha hb => ⟨Submodule.add_mem _ ha.1 hb.1,
          fun j' hj' => by rw [map_add, ha.2.1 j' hj', hb.2.1 j' hj', add_zero],
          Ideal.add_mem _ ha.2.2 hb.2.2⟩
        zero_mem' := ⟨Submodule.zero_mem _, fun j' _ => map_zero _, Ideal.zero_mem _⟩
        smul_mem' := fun r a ha => ⟨Submodule.smul_mem _ r ha.1,
          fun j' hj' => by rw [Derivation.map_smul, ha.2.1 j' hj', smul_zero],
          Submodule.smul_of_tower_mem _ r ha.2.2⟩ }
    have hS : ∀ b ∈ S, E j b ∈ S := by
      rintro b ⟨hb1, hb2, hb3⟩
      refine ⟨?_, fun j' hj' => ?_, criterionDerivation_mem_span hD hi0 j hb3⟩
      · rw [mem_commonWeightSpace] at hb1 ⊢
        intro l
        have hl : E l b = ZMod.cast (χ l) * b := hb1 l
        show E l (E j b) = ZMod.cast (χ l) * E j b
        rw [criterionDerivation_comm hD hdet hi0 hne hc l j, hl, derivation_zmodCast_mul]
      · rw [criterionDerivation_comm hD hdet hi0 hne hc j' j, hb2 j' hj', map_zero]
    have hyS : ∀ b ∈ S, x j * b ∈ S := by
      rintro b ⟨hb1, hb2, hb3⟩
      refine ⟨?_, fun j' hj' => ?_, Ideal.mul_mem_left _ _ hb3⟩
      · rw [mem_commonWeightSpace] at hb1 ⊢
        intro l
        have hl : E l b = ZMod.cast (χ l) * b := hb1 l
        have hl' : E l (x j) = 0 := by
          rw [criterionDerivation_apply_of_ne hD hj0,
            ite_eq_right (fun h : (l : ι) = j => hjΔ (h ▸ l.2))]
        show E l (x j * b) = ZMod.cast (χ l) * (x j * b)
        rw [Derivation.leibniz, hl, hl', smul_zero, add_zero, smul_eq_mul]
        ring
      · have hl : E j' (x j) = 0 := by
          rw [criterionDerivation_apply_of_ne hD hj0,
            ite_eq_right (fun h : j' = j => hjs (h ▸ hj'))]
        rw [Derivation.leibniz, hb2 j' hj', hl, smul_zero, smul_zero, add_zero]
    have hy : E j (x j) = 1 := by
      rw [criterionDerivation_apply_of_ne hD hj0, ite_eq_left rfl]
      exact ite_eq_right hjΔ
    have hηS : η ∈ S := ⟨hη1, hη2, hη3 ▸ Ideal.mem_span_singleton_self η⟩
    obtain ⟨b, hb, hsum⟩ := exists_taylor_of_mem_submodule (E j) p
      (criterionDerivation_pow_eq_zero p hD hdet hi0 hne hc hjΔ) hy S hS hyS hηS
    have hspan' := span_taylor_coeff_zero (hx j)
      (fun i => by rw [hη3]; exact (hb i).1.2.2) (Fact.out : p.Prime).pos hsum
    refine ⟨b 0, (hb 0).1.1, fun j' hj' => ?_, hspan'.trans hη3⟩
    rcases mem_insert.mp hj' with rfl | hj'
    · exact (hb 0).2
    · exact (hb 0).1.2.1 j' hj'

/-- The ramified case of the log-Jacobian criterion (Theorem 4.4.16, Case 1). If `x i0 * D i0 f` with `i0 ∈ Δ` generates the log-Jacobian ideal, then there is a first integral `u * x i0 * ∏ i ∈ Δ.erase i0, x i ^ a i` with `u` a unit and `a i < p`. Each log derivation that kills `f` kills it, and `x i0 * D i0` multiplies it by a unit. -/
theorem exists_first_integral_of_derivLogJacobian_eq_span [IsLocalRing R] (p : ℕ)
    [Fact p.Prime] [CharP R p] (hD : ∀ i j, D i (x j) = if i = j then 1 else 0)
    (hdet : ∀ δ : Derivation k R R, (∀ j, δ (x j) = 0) → δ = 0)
    (hx : ∀ i, x i ∈ maximalIdeal R) (hi0 : i0 ∈ Δ) (hne : x i0 * D i0 f ≠ 0)
    (hJ : derivLogJacobian D x Δ f = Ideal.span {x i0 * D i0 f}) :
    ∃ (u : R) (a : ι → ℕ), IsUnit u ∧ (∀ i, a i < p) ∧
      (∀ δ : Derivation k R R, (∀ i ∈ Δ, x i ∣ δ (x i)) → δ f = 0 →
        δ (u * x i0 * ∏ i ∈ Δ.erase i0, x i ^ a i) = 0) ∧
      ∃ v : R, IsUnit v ∧ x i0 * D i0 (u * x i0 * ∏ i ∈ Δ.erase i0, x i ^ a i) =
        v * (u * x i0 * ∏ i ∈ Δ.erase i0, x i ^ a i) := by
  have hcoef : ∀ i, ∃ ci, logCoeff x Δ i * D i f = ci * (x i0 * D i0 f) := by
    intro i
    have hmem : logCoeff x Δ i * D i f ∈ derivLogJacobian D x Δ f := by
      unfold logCoeff
      split_ifs with h
      · exact mul_mem_derivLogJacobian D x h f
      · rw [one_mul]
        exact derivation_mem_derivLogJacobian D x h f
    rw [hJ] at hmem
    obtain ⟨ci, hci⟩ := Ideal.mem_span_singleton'.mp hmem
    exact ⟨ci, hci.symm⟩
  choose c hc using hcoef
  have hc0 : c i0 = 1 := criterion_coeff_self hi0 hne hc
  set E := criterionDerivation D x Δ i0 c with hE
  obtain ⟨χ, η, hη1, hη2, hη3⟩ := exists_criterion_generator p hD hdet hx hi0 hne hc
  obtain ⟨u, hu⟩ := (Ideal.span_singleton_eq_span_singleton.mp hη3).symm
  let a : ι → ℕ := fun i => if h : i ∈ Δ then (-χ ⟨i, h⟩).val else 0
  set M := ∏ l ∈ Δ.erase i0, x l ^ a l with hM
  have hEM : ∀ i, E i M = (if i ∈ Δ.erase i0 then (a i : R) else 0) * M := by
    intro i
    rw [hM, derivation_prod_pow _ _ _ _ (fun l => if i = l then 1 else 0) (fun l hl => ?_)]
    · simp only [mul_ite, mul_one, mul_zero, sum_ite_eq]
    · rw [criterionDerivation_apply_of_ne hD (ne_of_mem_erase hl)]
      split_ifs with h
      · subst h
        rw [one_mul]
        exact ite_eq_left (mem_of_mem_erase hl)
      · rw [zero_mul]
  have hEt : ∀ i, E i (η * M) = 0 := by
    intro i
    by_cases hi : i ∈ Δ
    · by_cases hii : i = i0
      · rw [hii, hE, criterionDerivation_self_eq_zero hi0 hc0]
        rfl
      · have hw : E i η = ZMod.cast (χ ⟨i, hi⟩) * η := mem_commonWeightSpace.mp hη1 ⟨i, hi⟩
        have hai : (a i : R) = -(ZMod.cast (χ ⟨i, hi⟩) : R) := by
          simp only [a, hi, ↓reduceDIte]
          rw [ZMod.natCast_val, ZMod.cast_neg (dvd_refl p)]
        rw [Derivation.leibniz, hEM, ite_eq_left (mem_erase.mpr ⟨hii, hi⟩), hw, smul_eq_mul,
          smul_eq_mul]
        linear_combination (η * M) * hai
    · rw [Derivation.leibniz, hη2 i hi, hEM, ite_eq_right (fun h => hi (mem_of_mem_erase h)),
        zero_mul, smul_zero, smul_zero, add_zero]
  have ht : (u : R) * x i0 * M = η * M := by
    rw [← hu]
    ring
  refine ⟨u, a, u.isUnit, fun i => ?_, fun δ hδΔ hδf => ?_, ?_⟩
  · simp only [a]
    split_ifs
    · exact ZMod.val_lt _
    · exact (Fact.out : p.Prime).pos
  · have hb : ∀ i, ∃ bi, δ (x i) = bi * logCoeff x Δ i := by
      intro i
      by_cases hi : i ∈ Δ
      · obtain ⟨q, hq⟩ := hδΔ i hi
        exact ⟨q, by rw [hq, logCoeff, ite_eq_left hi, mul_comm]⟩
      · exact ⟨δ (x i), by rw [logCoeff, ite_eq_right hi, mul_one]⟩
    choose b hb using hb
    have hrep : ∀ y, δ y = ∑ i, b i * E i y + (∑ i, b i * c i) * (x i0 * D i0 y) := by
      intro y
      conv_lhs => rw [derivation_eq_sum_smul hD hdet δ]
      rw [derivation_finsetSum_apply, sum_mul, ← sum_add_distrib]
      refine sum_congr rfl fun i _ => ?_
      rw [Derivation.smul_apply, smul_eq_mul, hb, hE, criterionDerivation_apply]
      ring
    have hsum : ∑ i, b i * c i = 0 := by
      have h := hrep f
      simp only [hE, criterionDerivation_apply_eq_zero hc, mul_zero, sum_const_zero,
        zero_add, hδf] at h
      exact (mul_eq_zero.mp h.symm).resolve_right hne
    rw [ht, hrep, hsum, zero_mul, add_zero]
    exact sum_eq_zero fun i _ => by rw [hEt i, mul_zero]
  · have hD0M : D i0 M = 0 := by
      rw [hM, derivation_prod_pow (D i0) _ _ _ 0 (fun l hl => by
        rw [hD, ite_eq_right (Ne.symm (ne_of_mem_erase hl)), Pi.zero_apply, zero_mul])]
      simp
    have hunit : IsUnit ((u : R) + x i0 * D i0 u) := by
      by_contra hn
      have h1 : (u : R) + x i0 * D i0 u ∈ maximalIdeal R := hn
      have h2 : x i0 * D i0 u ∈ maximalIdeal R := Ideal.mul_mem_right _ _ (hx i0)
      have h3 := Ideal.sub_mem _ h1 h2
      rw [add_sub_cancel_right] at h3
      exact h3 u.isUnit
    have hd : D i0 ((u : R) * x i0 * M) = M * (u + x i0 * D i0 u) := by
      rw [Derivation.leibniz, hD0M, Derivation.leibniz, hD, ite_eq_left rfl]
      simp only [smul_eq_mul]
      ring
    refine ⟨((u : R) + x i0 * D i0 u) * (u⁻¹ : Rˣ), hunit.mul (Units.isUnit _), ?_⟩
    rw [hd]
    linear_combination (-((u : R) + x i0 * D i0 u) * x i0 * M) * u.inv_mul

omit [Fintype ι] [DecidableEq ι] in
/-- A principal log-Jacobian ideal with a nonzero generator has a generator `x i * D i f` with `i ∈ Δ` or `D i f` with `i ∉ Δ`. -/
theorem exists_derivLogJacobian_eq_span_generator [IsLocalRing R] {m : R} (hm : m ≠ 0)
    (hJ : derivLogJacobian D x Δ f = Ideal.span {m}) :
    ∃ i, (i ∈ Δ ∧ derivLogJacobian D x Δ f = Ideal.span {x i * D i f}) ∨
      (i ∉ Δ ∧ derivLogJacobian D x Δ f = Ideal.span {D i f}) := by
  have htop := span_eq_top_of_span_eq_span_singleton hm hJ
  obtain ⟨c, hcS, hcu⟩ : ∃ c, m * c ∈ (fun i => x i * D i f) '' (Δ : Set ι) ∪
      (fun j => D j f) '' (Δ : Set ι)ᶜ ∧ IsUnit c := by
    by_contra hcon
    push Not at hcon
    have hle : Ideal.span {c | m * c ∈ (fun i => x i * D i f) '' (Δ : Set ι) ∪
        (fun j => D j f) '' (Δ : Set ι)ᶜ} ≤ maximalIdeal R :=
      Ideal.span_le.mpr fun c hc => (mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hcon c hc))
    rw [htop] at hle
    exact (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp hle)
  rcases hcS with ⟨i, hi, he⟩ | ⟨j, hj, he⟩
  · have he' : x i * D i f = m * c := he
    exact ⟨i, Or.inl ⟨hi, by rw [he', Ideal.span_singleton_mul_right_unit hcu, hJ]⟩⟩
  · have he' : D j f = m * c := he
    exact ⟨j, Or.inr ⟨hj, by rw [he', Ideal.span_singleton_mul_right_unit hcu, hJ]⟩⟩

end Criterion

section Origin

open MvPolynomial Singularity.Algebra

variable {σ k : Type*} [Field k]

/-- A derivation of the local ring at the origin that kills all the coordinates is zero. -/
theorem originLocalRing_derivation_eq_zero
    (δ : Derivation k (OriginLocalRing σ k) (OriginLocalRing σ k))
    (h : ∀ j, δ (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X j)) = 0) : δ = 0 := by
  have hpoly : ∀ g : MvPolynomial σ k,
      δ (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) g) = 0 := fun g =>
    derivation_eq_zero_of_forall_mem_vars (D := δ.compAlgebraMap (MvPolynomial σ k))
      (fun i _ => h i)
  ext z
  obtain ⟨⟨g, s⟩, rfl⟩ := IsLocalization.mk'_surjective (originIdeal σ k).primeCompl z
  have h1 := congrArg δ (IsLocalization.mk'_spec (OriginLocalRing σ k) g s)
  rw [Derivation.leibniz, hpoly, hpoly, smul_zero, zero_add, smul_eq_mul] at h1
  exact (IsLocalization.map_units (OriginLocalRing σ k) s).mul_right_eq_zero.mp h1

/-- The coordinates are in the maximal ideal of the local ring at the origin. -/
theorem algebraMap_X_mem_maximalIdeal (i : σ) :
    algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ∈
      maximalIdeal (OriginLocalRing σ k) := by
  rw [maximalIdeal_originLocalRing]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- The ramified case of the log-Jacobian criterion for the local ring of a polynomial ring at the origin. -/
theorem exists_origin_first_integral_of_derivLogJacobian_eq_span [Fintype σ] [DecidableEq σ]
    (p : ℕ) [Fact p.Prime] [CharP k p] {Δ : Finset σ} {i0 : σ} {f : OriginLocalRing σ k}
    (hi0 : i0 ∈ Δ)
    (hne : algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) * originDerivation i0 f ≠ 0)
    (hJ : derivLogJacobian originDerivation
        (fun i => algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i)) Δ f =
      Ideal.span {algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) *
        originDerivation i0 f}) :
    ∃ (u : OriginLocalRing σ k) (a : σ → ℕ), IsUnit u ∧ (∀ i, a i < p) ∧
      (∀ δ : Derivation k (OriginLocalRing σ k) (OriginLocalRing σ k),
        (∀ i ∈ Δ, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ∣
          δ (algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i))) → δ f = 0 →
        δ (u * algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) *
          ∏ i ∈ Δ.erase i0, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i) =
            0) ∧
      ∃ v : OriginLocalRing σ k, IsUnit v ∧
        algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) * originDerivation i0
          (u * algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) *
            ∏ i ∈ Δ.erase i0, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i) =
        v * (u * algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i0) *
          ∏ i ∈ Δ.erase i0, algebraMap (MvPolynomial σ k) (OriginLocalRing σ k) (X i) ^ a i) := by
  have : CharP (OriginLocalRing σ k) p :=
    charP_of_injective_algebraMap (algebraMap k (OriginLocalRing σ k)).injective p
  exact exists_first_integral_of_derivLogJacobian_eq_span p originDerivation_X
    originLocalRing_derivation_eq_zero algebraMap_X_mem_maximalIdeal hi0 hne hJ

end Origin

