import Singularity.Invariant.LogJacobian
import Singularity.Invariant.OrderBlowup

/-!
# The log-Jacobian ideal under a point blowup

Let `k` be a commutative ring of characteristic `p`, let `g` be a polynomial in `k[x_i : i ∈ σ]`,
and let `Δ` give the divisor `E = V(∏_{i ∈ Δ} x_i)`. Look at the `x_j`-chart of the blowup of the
origin with translations `t`: `π(x_j) = x_j` and `π(x_i) = x_j (x_i + t_i)` for `i ≠ j`
(`pointChart j t`). The new divisor `Δ'` is `{j}` together with the `i ∈ Δ`, `i ≠ j`, with
`t_i = 0` (`blowupDivisor Δ j t`). This file proves the transformation law of the log-Jacobian
ideal (Volume 7, Section 3.2 of the handbook, Theorem 3.2.3).

The derivations that are tangent to `E` and that map the maximal ideal `m` into `m` give the ideal

  `Θ₀(g) = (x_i ∂_i g (i ∈ Δ), x_k ∂_l g (l ∉ Δ, k ∈ σ))`.

The chain rule gives `∂_i π(h) = x_j π(∂_i h)` for `i ≠ j` and `x_j ∂_j π(h) = π(∑_i x_i ∂_i h)`
(Lemma 3.2.2). The proof compares the generators of `π(Θ₀(g))` and of `Θ'(π(g))`, the
log-Jacobian ideal of `π(g)` for `Δ'`. The image of `Θ₀(g)` lies in `Θ'(π(g))`. In the other
direction, a generator `x_j π(∂_l g)` of `Θ'(π(g))` with `l ∈ Δ` and `t_l ≠ 0` is in the image
only after the multiplication with `x_l + t_l`. This polynomial is a unit in the power series ring,
and the handbook works there. In `k[x]` the unit `u = ∏ (x_i + t_i)` over these `l` must be kept.
So the law in `k[x]` has two inclusions:

  `π(Θ₀(g)) ⊆ Θ'(π(g))` and `u Θ'(π(g)) ⊆ π(Θ₀(g))`.

If `π(g) = x_j^p g'`, then `Θ'(π(g)) = (x_j^p) Θ'(g')` in characteristic `p`
(`logJacobian_pow_mul`), and the law takes the form of Theorem 3.2.3. The chain rule for `x_j ∂_j`
and the law use a finite set `σ` of variables.

## Main definitions

* `Singularity.logJacobianTangent Δ g`: the ideal `Θ₀(g)` of Definition 3.2.1.
* `Singularity.blowupUnit Δ j t`: the product `u` of the `x_i + t_i` over the `i ∈ Δ`, `i ≠ j`,
  with `t_i ≠ 0`.

## Main results

* `pderiv_pointChart_of_ne`, `X_mul_pderiv_pointChart`: the chain rules of Lemma 3.2.2.
* `pderiv_X_pow_mul_of_ne`, `X_mul_pderiv_X_pow_mul`: the derivations `∂_i` (`i ≠ j`) and
  `x_j ∂_j` commute with the multiplication by `x_j^p` in characteristic `p`.
* `logJacobian_cleanPart`: `Θ(g_c) = Θ(g)` for the clean part `g_c` of `g`.
* `logJacobianTangent_le`, `span_range_X_mul_logJacobian_le`: `m Θ(g) ⊆ Θ₀(g) ⊆ Θ(g)`.
* `map_pointChart_logJacobianTangent_le`, `span_mul_logJacobian_pointChart_le`: the two
  inclusions for `Θ'(π(g))`.
* `map_pointChart_logJacobianTangent_le_span_mul`, `span_mul_logJacobian_le_map_pointChart`:
  the transformation law of Theorem 3.2.3 for `π(g) = x_j^p g'`:
  `π(Θ₀(g)) ⊆ (x_j^p) Θ'(g')` and `(x_j^p u) Θ'(g') ⊆ π(Θ₀(g))`.

## References

* V. Cossart, *Polyèdre caractéristique d'une singularité*, thèse d'État, Orsay 1987.
* Q. Posva, arXiv:2405.05735, Appendix A.
* Volume 7, Section 3.2 of the handbook: Definition 3.2.1, Lemma 3.2.2 and Theorem 3.2.3.
-/

open MvPolynomial

namespace Singularity

section Defs

variable {σ k : Type*} [CommSemiring k]

/-- The log-Jacobian ideal tangent to the origin `Θ₀(g)`: the ideal generated by `x_i ∂_i g` for
`i ∈ Δ` and by `x_k ∂_l g` for `l ∉ Δ` and each `k`. These are the derivatives of `g` along the
derivations that are tangent to the divisor and that map the maximal ideal of the origin into
itself (Volume 7, Section 3.2 of the handbook, Definition 3.2.1). -/
noncomputable def logJacobianTangent (Δ : Finset σ) (g : MvPolynomial σ k) :
    Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun i => X i * pderiv i g) '' (Δ : Set σ) ∪
    (fun a : σ × σ => X a.1 * pderiv a.2 g) '' {a | a.2 ∉ Δ})

/-- The unit `u` of the transformation law: the product of `x_i + t_i` over the `i ∈ Δ` with
`i ≠ j` and `t_i ≠ 0`. These are the components of the divisor that do not pass through the
origin of the chart. The polynomial `u` is a unit in the power series ring, but not in `k[x]`. -/
noncomputable def blowupUnit [DecidableEq σ] [DecidableEq k] (Δ : Finset σ) (j : σ) (t : σ → k) :
    MvPolynomial σ k :=
  ∏ i ∈ Δ.filter (fun i => i ≠ j ∧ t i ≠ 0), (X i + C (t i))

theorem X_mul_pderiv_mem_logJacobianTangent {Δ : Finset σ} {i : σ} (hi : i ∈ Δ)
    (g : MvPolynomial σ k) : X i * pderiv i g ∈ logJacobianTangent Δ g :=
  Ideal.subset_span (Or.inl ⟨i, hi, rfl⟩)

theorem X_mul_pderiv_mem_logJacobianTangent_of_notMem {Δ : Finset σ} {l : σ} (hl : l ∉ Δ)
    (m : σ) (g : MvPolynomial σ k) : X m * pderiv l g ∈ logJacobianTangent Δ g :=
  Ideal.subset_span (Or.inr ⟨(m, l), hl, rfl⟩)

/-- Each `x_i ∂_i g` is in `Θ₀(g)`, for `i ∈ Δ` and for `i ∉ Δ`. -/
theorem X_mul_pderiv_mem_logJacobianTangent' (Δ : Finset σ) (i : σ) (g : MvPolynomial σ k) :
    X i * pderiv i g ∈ logJacobianTangent Δ g := by
  by_cases hi : i ∈ Δ
  · exact X_mul_pderiv_mem_logJacobianTangent hi g
  · exact X_mul_pderiv_mem_logJacobianTangent_of_notMem hi i g

/-- `Θ₀(g) ⊆ Θ(g)`. -/
theorem logJacobianTangent_le (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobianTangent Δ g ≤ logJacobian Δ g := by
  refine Ideal.span_le.mpr ?_
  rintro s (⟨i, hi, rfl⟩ | ⟨⟨m, l⟩, hl, rfl⟩)
  · exact X_mul_pderiv_mem_logJacobian hi g
  · exact Ideal.mul_mem_left _ _ (pderiv_mem_logJacobian hl g)

/-- `m Θ(g) ⊆ Θ₀(g)`, with `m` the ideal of the origin. -/
theorem span_range_X_mul_logJacobian_le (Δ : Finset σ) (g : MvPolynomial σ k) :
    Ideal.span (Set.range X) * logJacobian Δ g ≤ logJacobianTangent Δ g := by
  refine Ideal.mul_le.mpr fun a ha b hb => ?_
  refine Submodule.span_induction (p := fun a _ => a * b ∈ logJacobianTangent Δ g) ?_ ?_ ?_ ?_ ha
  · rintro _ ⟨m, rfl⟩
    refine Submodule.span_induction (p := fun b _ => X m * b ∈ logJacobianTangent Δ g) ?_ ?_ ?_ ?_
      hb
    · rintro s (⟨i, hi, rfl⟩ | ⟨l, hl, rfl⟩)
      · exact Ideal.mul_mem_left _ _ (X_mul_pderiv_mem_logJacobianTangent hi g)
      · exact X_mul_pderiv_mem_logJacobianTangent_of_notMem hl m g
    · rw [mul_zero]
      exact Ideal.zero_mem _
    · intro x y _ _ hx hy
      rw [mul_add]
      exact Ideal.add_mem _ hx hy
    · intro c x _ hx
      rw [smul_eq_mul, mul_left_comm]
      exact Ideal.mul_mem_left _ _ hx
  · rw [zero_mul]
    exact Ideal.zero_mem _
  · intro x y _ _ hx hy
    rw [add_mul]
    exact Ideal.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_eq_mul, mul_assoc]
    exact Ideal.mul_mem_left _ _ hx

end Defs

/-! ### The chain rules -/

section Chain

variable {σ k : Type*} [CommSemiring k] [DecidableEq σ]

/-- **Chain rule** (Volume 7, Section 3.2 of the handbook, Lemma 3.2.2): for `i ≠ j`,
`∂_i π(h) = x_j π(∂_i h)`. The variable `x_i` occurs in `π(h)` only through `π(x_i) = x_j (x_i +
t_i)`. -/
theorem pderiv_pointChart_of_ne {i j : σ} (hij : i ≠ j) (t : σ → k) (h : MvPolynomial σ k) :
    pderiv i (pointChart j t h) = X j * pointChart j t (pderiv i h) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => rw [map_add, map_add, hP, hQ, map_add, map_add, mul_add]
  | mul_X P l hP =>
    have hl : pderiv i (pointChart j t (X l)) = X j * pointChart j t (pderiv i (X l)) := by
      by_cases hlj : l = j
      · subst hlj
        rw [pointChart_X_self, pderiv_X_of_ne (Ne.symm hij), map_zero, mul_zero]
      · rw [pointChart_X_of_ne t hlj, pderiv_mul, pderiv_X_of_ne (Ne.symm hij), zero_mul, zero_add,
          map_add, pderiv_C, add_zero, pderiv_X]
        by_cases hli : l = i
        · subst hli
          simp
        · simp [hli]
    rw [map_mul, pderiv_mul, pderiv_mul, hP, hl, map_add, map_mul, map_mul]
    ring

omit [DecidableEq σ] in
/-- `∑_i x_i ∂_i (x_l) = x_l`. -/
theorem sum_X_mul_pderiv_X [Fintype σ] (l : σ) :
    ∑ i, X i * pderiv i (X l : MvPolynomial σ k) = X l := by
  rw [Finset.sum_eq_single l (fun i _ hi => by rw [pderiv_X_of_ne (Ne.symm hi), mul_zero])
    (fun h => absurd (Finset.mem_univ l) h), pderiv_X_self, mul_one]

/-- **Chain rule** (Volume 7, Section 3.2 of the handbook, Lemma 3.2.2):
`x_j ∂_j π(h) = π(∑_i x_i ∂_i h)`. -/
theorem X_mul_pderiv_pointChart [Fintype σ] (j : σ) (t : σ → k) (h : MvPolynomial σ k) :
    X j * pderiv j (pointChart j t h) = pointChart j t (∑ i, X i * pderiv i h) := by
  induction h using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ =>
    simp only [map_add, mul_add, Finset.sum_add_distrib]
    rw [hP, hQ]
  | mul_X P l hP =>
    have hl : X j * pderiv j (pointChart j t (X l)) = pointChart j t (X l) := by
      by_cases hlj : l = j
      · subst hlj
        rw [pointChart_X_self, pderiv_X_self, mul_one]
      · rw [pointChart_X_of_ne t hlj, pderiv_mul, pderiv_X_self, map_add, pderiv_C, add_zero,
          pderiv_X_of_ne hlj, mul_zero, add_zero, one_mul]
    have hs : ∑ i, X i * pderiv i (P * X l) = (∑ i, X i * pderiv i P) * X l + P * X l := by
      have h1 : ∑ i, X i * (P * pderiv i (X l)) = P * ∑ i, X i * pderiv i (X l) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by ring
      simp only [pderiv_mul, mul_add, Finset.sum_add_distrib]
      rw [h1, sum_X_mul_pderiv_X, Finset.sum_mul]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hs, map_add, map_mul (pointChart j t) (∑ i, X i * pderiv i P), map_mul (pointChart j t) P,
      pderiv_mul, ← hP, mul_add, ← mul_assoc, mul_left_comm (X j) (pointChart j t P), hl]

end Chain

/-! ### The derivations and the factor `x_j^p` -/

section Factor

variable {σ k : Type*} [CommSemiring k]

/-- For `i ≠ j`, `∂_i (x_j^n u) = x_j^n ∂_i u`. -/
theorem pderiv_X_pow_mul_of_ne {i j : σ} (hij : i ≠ j) (n : ℕ) (u : MvPolynomial σ k) :
    pderiv i (X j ^ n * u) = X j ^ n * pderiv i u := by
  rw [pderiv_mul, pderiv_pow, pderiv_X_of_ne (Ne.symm hij), mul_zero, zero_mul, zero_add]

/-- In characteristic `p`, `x_j ∂_j (x_j^p u) = x_j^p (x_j ∂_j u)`: the term `p x_j^p u` is zero
(Volume 7, Section 3.2 of the handbook, proof of Theorem 3.2.3). -/
theorem X_mul_pderiv_X_pow_mul (p : ℕ) [CharP k p] (j : σ) (u : MvPolynomial σ k) :
    X j * pderiv j (X j ^ p * u) = X j ^ p * (X j * pderiv j u) := by
  simp only [pderiv_mul, pderiv_pow, CharP.cast_eq_zero (MvPolynomial σ k) p, zero_mul, zero_add]
  rw [mul_left_comm]

/-- In characteristic `p`, `g` and its clean part have the same derivatives: each removed
monomial has all its exponents divisible by `p`, so each derivative kills it. -/
theorem pderiv_cleanPart (p : ℕ) [CharP k p] (i : σ) (g : MvPolynomial σ k) :
    pderiv i (cleanPart p g) = pderiv i g := by
  classical
  refine MvPolynomial.ext _ _ fun b => ?_
  rw [coeff_pderiv, coeff_pderiv, coeff_cleanPart]
  split_ifs with h
  · have hp : p ∣ b i + 1 := by
      have := h i
      rwa [Finsupp.add_apply, Finsupp.single_eq_same] at this
    have h0 : ((b i + 1 : ℕ) : k) = 0 := (CharP.cast_eq_zero_iff k p _).mpr hp
    rw [Nat.cast_add, Nat.cast_one] at h0
    rw [h0, zero_mul, mul_zero]
  · rfl

/-- `Θ(g_c) = Θ(g)` for the clean part `g_c` of `g`, in characteristic `p`. The field need not be
perfect. -/
theorem logJacobian_cleanPart (p : ℕ) [CharP k p] (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobian Δ (cleanPart p g) = logJacobian Δ g := by
  simp only [logJacobian, pderiv_cleanPart p]

end Factor

/-! ### The transformation law -/

section Law

variable {σ k : Type*} [CommRing k] [DecidableEq σ] [DecidableEq k] [Fintype σ]

omit [Fintype σ] in
theorem mem_blowupDivisor {Δ : Finset σ} {j : σ} {t : σ → k} {i : σ} :
    i ∈ blowupDivisor Δ j t ↔ i = j ∨ (i ∈ Δ ∧ i ≠ j ∧ t i = 0) := by
  simp [blowupDivisor, Finset.mem_insert, Finset.mem_filter]

omit [DecidableEq k] [Fintype σ] in
/-- For `m ≠ j`, `π(x_m ∂_m g) = (x_m + t_m) ∂_m π(g)`. -/
theorem pointChart_X_mul_pderiv_of_ne {m j : σ} (hmj : m ≠ j) (t : σ → k) (g : MvPolynomial σ k) :
    pointChart j t (X m * pderiv m g) = (X m + C (t m)) * pderiv m (pointChart j t g) := by
  rw [map_mul, pointChart_X_of_ne t hmj, pderiv_pointChart_of_ne hmj]
  ring

omit [DecidableEq k] in
/-- `x_j ∂_j π(g) = ∑_m π(x_m ∂_m g)`. -/
theorem X_mul_pderiv_pointChart_eq_sum (j : σ) (t : σ → k) (g : MvPolynomial σ k) :
    X j * pderiv j (pointChart j t g) = ∑ m, pointChart j t (X m * pderiv m g) := by
  rw [X_mul_pderiv_pointChart, map_sum]

/-- Each `π(x_m ∂_m g)` is in `Θ'(π(g))`. -/
theorem pointChart_X_mul_pderiv_mem (Δ : Finset σ) (j : σ) (t : σ → k) (g : MvPolynomial σ k)
    (m : σ) : pointChart j t (X m * pderiv m g) ∈ logJacobian (blowupDivisor Δ j t)
      (pointChart j t g) := by
  have hne : ∀ m, m ≠ j → pointChart j t (X m * pderiv m g) ∈
      logJacobian (blowupDivisor Δ j t) (pointChart j t g) := by
    intro m hmj
    rw [pointChart_X_mul_pderiv_of_ne hmj]
    by_cases hm : m ∈ blowupDivisor Δ j t
    · have htm : t m = 0 := by
        rcases mem_blowupDivisor.mp hm with h | ⟨-, -, h⟩
        · exact absurd h hmj
        · exact h
      rw [htm, C_0, add_zero]
      exact X_mul_pderiv_mem_logJacobian hm _
    · exact Ideal.mul_mem_left _ _ (pderiv_mem_logJacobian hm _)
  by_cases hmj : m = j
  · subst hmj
    have hj : m ∈ blowupDivisor Δ m t := mem_blowupDivisor.mpr (Or.inl rfl)
    have hsum := X_mul_pderiv_pointChart_eq_sum m t g
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ m)] at hsum
    rw [← add_sub_cancel_right (pointChart m t (X m * pderiv m g))
      (∑ l ∈ Finset.univ.erase m, pointChart m t (X l * pderiv l g)), ← hsum]
    refine Ideal.sub_mem _ (X_mul_pderiv_mem_logJacobian hj _) (Ideal.sum_mem _ fun l hl => ?_)
    exact hne l (Finset.ne_of_mem_erase hl)
  · exact hne m hmj

/-- For `l ∉ Δ`, `x_j π(∂_l g)` is in `Θ'(π(g))`. -/
theorem X_mul_pointChart_pderiv_mem {Δ : Finset σ} {l : σ} (hl : l ∉ Δ) (j : σ) (t : σ → k)
    (g : MvPolynomial σ k) :
    X j * pointChart j t (pderiv l g) ∈ logJacobian (blowupDivisor Δ j t) (pointChart j t g) := by
  by_cases hlj : l = j
  · subst hlj
    have := pointChart_X_mul_pderiv_mem Δ l t g l
    rwa [map_mul, pointChart_X_self] at this
  · have hl' : l ∉ blowupDivisor Δ j t := by
      rw [mem_blowupDivisor]
      rintro (h | ⟨h, -, -⟩)
      · exact hlj h
      · exact hl h
    rw [← pderiv_pointChart_of_ne hlj]
    exact pderiv_mem_logJacobian hl' _

omit [DecidableEq k] [Fintype σ] in
/-- The chart sends `x_m` to `x_j` times a polynomial. -/
theorem exists_pointChart_X_eq_X_mul (j : σ) (t : σ → k) (m : σ) :
    ∃ c, pointChart j t (X m) = X j * c := by
  by_cases hmj : m = j
  · subst hmj
    exact ⟨1, by rw [pointChart_X_self, mul_one]⟩
  · exact ⟨_, pointChart_X_of_ne t hmj⟩

/-- **The transformation law, first inclusion** (Volume 7, Section 3.2 of the handbook,
Theorem 3.2.3): `π(Θ₀(g)) ⊆ Θ'(π(g))`, with `Θ'` the log-Jacobian ideal for the new divisor
`Δ' = blowupDivisor Δ j t`. -/
theorem map_pointChart_logJacobianTangent_le (Δ : Finset σ) (j : σ) (t : σ → k)
    (g : MvPolynomial σ k) :
    Ideal.map (pointChart j t) (logJacobianTangent Δ g) ≤
      logJacobian (blowupDivisor Δ j t) (pointChart j t g) := by
  rw [logJacobianTangent, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨s, (⟨i, -, rfl⟩ | ⟨⟨m, l⟩, hl, rfl⟩), rfl⟩
  · exact pointChart_X_mul_pderiv_mem Δ j t g i
  · obtain ⟨c, hc⟩ := exists_pointChart_X_eq_X_mul j t m
    show pointChart j t (X m * pderiv l g) ∈ _
    rw [map_mul, hc, mul_assoc, mul_left_comm]
    exact Ideal.mul_mem_left _ _ (X_mul_pointChart_pderiv_mem hl j t g)

/-- **The transformation law, second inclusion** (Volume 7, Section 3.2 of the handbook,
Theorem 3.2.3): `u Θ'(π(g)) ⊆ π(Θ₀(g))`, with `u = blowupUnit Δ j t`. -/
theorem span_mul_logJacobian_pointChart_le (Δ : Finset σ) (j : σ) (t : σ → k)
    (g : MvPolynomial σ k) :
    Ideal.span {blowupUnit Δ j t} * logJacobian (blowupDivisor Δ j t) (pointChart j t g) ≤
      Ideal.map (pointChart j t) (logJacobianTangent Δ g) := by
  set M := Ideal.map (pointChart j t) (logJacobianTangent Δ g)
  have hM : ∀ x ∈ logJacobianTangent Δ g, pointChart j t x ∈ M :=
    fun x hx => Ideal.mem_map_of_mem _ hx
  rw [logJacobian, Ideal.span_singleton_mul_le_iff]
  intro z hz
  refine Submodule.span_induction (p := fun z _ => blowupUnit Δ j t * z ∈ M) ?_ ?_ ?_ ?_ hz
  · rintro s (⟨i, hi, rfl⟩ | ⟨l, hl, rfl⟩)
    · dsimp only
      refine Ideal.mul_mem_left _ _ ?_
      rcases mem_blowupDivisor.mp hi with rfl | ⟨hiΔ, hij, hti⟩
      · rw [X_mul_pderiv_pointChart_eq_sum]
        exact Ideal.sum_mem _ fun m _ => hM _ (X_mul_pderiv_mem_logJacobianTangent' Δ m g)
      · have := pointChart_X_mul_pderiv_of_ne hij t g
        rw [hti, C_0, add_zero] at this
        rw [← this]
        exact hM _ (X_mul_pderiv_mem_logJacobianTangent hiΔ g)
    · dsimp only
      have hl' : l ∉ blowupDivisor Δ j t := hl
      have hlj : l ≠ j := fun h => hl' (mem_blowupDivisor.mpr (Or.inl h))
      by_cases hlΔ : l ∈ Δ
      · have htl : t l ≠ 0 := fun h => hl' (mem_blowupDivisor.mpr (Or.inr ⟨hlΔ, hlj, h⟩))
        have hmem : l ∈ Δ.filter (fun i => i ≠ j ∧ t i ≠ 0) :=
          Finset.mem_filter.mpr ⟨hlΔ, hlj, htl⟩
        rw [blowupUnit, ← Finset.mul_prod_erase _ _ hmem, mul_comm (X l + C (t l)), mul_assoc,
          ← pointChart_X_mul_pderiv_of_ne hlj]
        exact Ideal.mul_mem_left _ _ (hM _ (X_mul_pderiv_mem_logJacobianTangent hlΔ g))
      · refine Ideal.mul_mem_left _ _ ?_
        rw [pderiv_pointChart_of_ne hlj, ← pointChart_X_self j t, ← map_mul]
        exact hM _ (X_mul_pderiv_mem_logJacobianTangent_of_notMem hlΔ j g)
  · rw [mul_zero]
    exact Ideal.zero_mem _
  · intro x y _ _ hx hy
    rw [mul_add]
    exact Ideal.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_eq_mul, mul_left_comm]
    exact Ideal.mul_mem_left _ _ hx

variable (p : ℕ) [CharP k p] {Δ : Finset σ} {j : σ} {t : σ → k} {g g' : MvPolynomial σ k}

omit [Fintype σ] in
/-- `Θ'(π(g)) = (x_j^p) Θ'(g')` for `π(g) = x_j^p g'`, in characteristic `p`. -/
theorem logJacobian_pointChart_eq (hg : pointChart j t g = X j ^ p * g') :
    logJacobian (blowupDivisor Δ j t) (pointChart j t g) =
      Ideal.span {X j ^ p} * logJacobian (blowupDivisor Δ j t) g' := by
  rw [hg, logJacobian_pow_mul]

/-- **The transformation law** (Volume 7, Section 3.2 of the handbook, Theorem 3.2.3, first
inclusion): if `π(g) = x_j^p g'`, then `π(Θ₀(g)) ⊆ (x_j^p) Θ'(g')`. -/
theorem map_pointChart_logJacobianTangent_le_span_mul (hg : pointChart j t g = X j ^ p * g') :
    Ideal.map (pointChart j t) (logJacobianTangent Δ g) ≤
      Ideal.span {X j ^ p} * logJacobian (blowupDivisor Δ j t) g' := by
  rw [← logJacobian_pointChart_eq p hg]
  exact map_pointChart_logJacobianTangent_le Δ j t g

/-- **The transformation law** (Volume 7, Section 3.2 of the handbook, Theorem 3.2.3, second
inclusion): if `π(g) = x_j^p g'`, then `(x_j^p u) Θ'(g') ⊆ π(Θ₀(g))`, with `u = blowupUnit Δ j t`.
In the power series ring `u` is a unit, and the two inclusions give
`Θ'(g') = x_j^(-p) π(Θ₀(g))`. -/
theorem span_mul_logJacobian_le_map_pointChart (hg : pointChart j t g = X j ^ p * g') :
    Ideal.span {X j ^ p * blowupUnit Δ j t} * logJacobian (blowupDivisor Δ j t) g' ≤
      Ideal.map (pointChart j t) (logJacobianTangent Δ g) := by
  rw [← Ideal.span_singleton_mul_span_singleton, mul_comm (Ideal.span {X j ^ p}), mul_assoc,
    ← logJacobian_pointChart_eq p hg]
  exact span_mul_logJacobian_pointChart_le Δ j t g

end Law

end Singularity
