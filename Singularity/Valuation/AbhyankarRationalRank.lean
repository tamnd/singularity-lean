import Mathlib.FieldTheory.FinTrdeg
import Singularity.Valuation.Abhyankar
import Singularity.Valuation.AbhyankarFiniteGeneration

/-!
# Theorem 2.2.2 with the rational rank

This file gives Theorem 2.2.2 of Volume 3 of the handbook in the form with the rational rank.
Let `(L/K, w)` be an extension of valued fields with `L/K` finitely generated. Let `r` be the
rational rank of `Γ_w / Γ_v` and let `s = trdeg(Lw/Kv)`. If `r + s = trdeg(L/K)`, then `Γ_w` is
generated by `Γ_v` and a finite set, and `Lw/Kv` is finitely generated.

## Main results

* `Singularity.exists_units_residues_of_rank_trdeg`: the choice step. There are units `x_i` of `L`
  with values that are independent modulo `Γ_v`, and elements `y_j` of the valuation ring of `w`
  with residues that are algebraically independent over `Kv`. The number of the `x_i` is the rank
  of `Γ_w / Γ_v`, and the number of the `y_j` is `trdeg(Lw/Kv)`.
* `Singularity.valueGroup_fg_and_residueField_fg_of_trdeg_le_rank_add`: the theorem under the
  hypothesis `trdeg(L/K) ≤ r + s`, with the rank over `ℤ`.
* `Singularity.valueGroup_fg_and_residueField_fg_of_rank_add_trdeg_eq`: the theorem under the
  hypothesis `r + s = trdeg(L/K)`, with the rank over `ℤ`.
* `Singularity.valueGroup_fg_and_residueField_fg_of_rank_rat_add_trdeg_eq`: the handbook form,
  with the rational rank `dim_ℚ (ℚ ⊗ Γ_w / Γ_v)`.

## The proof

Choose a maximal independent set of `Γ_w / Γ_v` and a transcendence basis of `Lw/Kv`. Lift each
element of the independent set to the value of a unit of `L`, and lift each element of the
transcendence basis to the valuation ring. The inequality of Abhyankar and the finite
transcendence degree of `L/K` show that both sets are finite. Then Theorem 2.2.2 in the form with
the elements (`Singularity.valueGroup_fg_and_residueField_fg_of_trdeg_le`) applies.
-/

namespace Singularity

open IsLocalRing Cardinal TensorProduct

section RationalRank

universe uL uΓ

variable {K : Type*} {L : Type uL} [Field K] [Field L] [Algebra K L] {Γ₀ : Type*}
  {Γ₁ : Type uΓ} [LinearOrderedCommGroupWithZero Γ₀] [LinearOrderedCommGroupWithZero Γ₁]
  (vK : Valuation K Γ₀) (vL : Valuation L Γ₁) [vK.HasExtension vL]

/-- The choice step of Theorem 2.2.2. There is a set `s` of `Γ_w / Γ_v` with cardinal the rank of
`Γ_w / Γ_v`, and a set `t` of `Lw` with cardinal `trdeg(Lw/Kv)`. For each `i` in `s` there is a
unit `x i` of `L`, and for each `j` in `t` there is an element `y j` of the valuation ring of `w`.
The classes of the values of the `x i` modulo `Γ_v` are independent over `ℤ`, and the residues of
the `y j` are algebraically independent over `Kv`. -/
theorem exists_units_residues_of_rank_trdeg :
    ∃ (s : Set (Additive ((vL : L →*₀ Γ₁).valueGroup.map
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup))))
      (t : Set (ResidueField vL.valuationSubring)) (x : s → Lˣ) (y : t → vL.valuationSubring),
      #s = Module.rank ℤ (Additive ((vL : L →*₀ Γ₁).valueGroup.map
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup))) ∧
      #t = Algebra.trdeg (ResidueField vK.valuationSubring) (ResidueField vL.valuationSubring) ∧
      LinearIndependent ℤ (fun i => Additive.ofMul
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
          (Units.map (vL : L →* Γ₁) (x i)))) ∧
      AlgebraicIndependent (ResidueField vK.valuationSubring)
        (fun j => residue vL.valuationSubring (y j)) := by
  set H := (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
  set M := (vL : L →*₀ Γ₁).valueGroup.map (QuotientGroup.mk' H)
  obtain ⟨s, hsc, hs⟩ := exists_set_linearIndependent ℤ (Additive M)
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis (ResidueField vK.valuationSubring)
    (ResidueField vL.valuationSubring)
  have hx : ∀ γ : s, ∃ z : Lˣ, QuotientGroup.mk' H (Units.map (vL : L →* Γ₁) z) =
      ((Additive.toMul (γ : Additive M) : M) : Γ₁ˣ ⧸ H) := by
    intro γ
    obtain ⟨g, hg, hgγ⟩ := Subgroup.mem_map.mp (Additive.toMul (γ : Additive M)).2
    have hgr : (g : Γ₁) ∈ Set.range (vL : L →*₀ Γ₁) \ {0} := by
      rw [← MonoidWithZeroHom.valueGroup_eq_range (vL : L →*₀ Γ₁)]
      exact ⟨g, hg, rfl⟩
    obtain ⟨⟨z, hz⟩, hz0⟩ := hgr
    have hz0' : z ≠ 0 := by
      rintro rfl
      exact g.ne_zero (by simpa using hz.symm)
    refine ⟨Units.mk0 z hz0', ?_⟩
    rw [← hgγ]
    congr 1
    exact Units.ext (by simpa using hz)
  choose x hx using hx
  have hy : ∀ e : t, ∃ a : vL.valuationSubring, residue _ a = e := fun e =>
    residue_surjective (R := vL.valuationSubring) (e : ResidueField vL.valuationSubring)
  choose y hy using hy
  have hs' : LinearIndependent ℤ (fun i : s => (i : Additive M)) := hs
  have ht' : AlgebraicIndependent (ResidueField vK.valuationSubring)
      (fun j : t => (j : ResidueField vL.valuationSubring)) := ht.1
  have hinj : Function.Injective (M.subtype.toAdditive.toIntLinearMap) := by
    intro a b hab
    exact Additive.toMul.injective (Subtype.ext (by simpa using hab))
  have hs'' := hs'.map' _ (LinearMap.ker_eq_bot.mpr hinj)
  refine ⟨s, t, x, y, hsc, ht.cardinalMk_eq_trdeg, ?_, ?_⟩
  · convert hs'' using 1
    funext i
    simp [hx i]
  · convert ht' using 1
    funext j
    simp [hy j]

/-- **Theorem 2.2.2 of Volume 3 of the handbook**, with the rank over `ℤ`, under the hypothesis
`trdeg(L/K) ≤ r + s`. Here `L/K` is finitely generated, `r` is the rank of `Γ_w / Γ_v` and
`s = trdeg(Lw/Kv)`. Then `Γ_w` is generated by `Γ_v` and a finite set, and `Lw/Kv` is finitely
generated. -/
theorem valueGroup_fg_and_residueField_fg_of_trdeg_le_rank_add
    (hfg : (⊤ : IntermediateField K L).FG)
    (h : lift.{uΓ} (Algebra.trdeg K L) ≤
      lift.{uL} (Module.rank ℤ (Additive ((vL : L →*₀ Γ₁).valueGroup.map
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup)))) +
      lift.{uΓ} (Algebra.trdeg (ResidueField vK.valuationSubring)
        (ResidueField vL.valuationSubring))) :
    (∃ S : Finset Γ₁ˣ, (vL : L →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure (S : Set Γ₁ˣ)) ∧
    (⊤ : IntermediateField (ResidueField vK.valuationSubring)
      (ResidueField vL.valuationSubring)).FG := by
  have : Algebra.EssFiniteType K L := IntermediateField.fg_top_iff.mp hfg
  have hfin := trdeg_lt_aleph0 K L
  have hsum := (rank_int_valueGroup_map_add_trdeg_le vK vL).trans_lt (lift_lt_aleph0.mpr hfin)
  obtain ⟨h1, h2⟩ := add_lt_aleph0_iff.mp hsum
  rw [lift_lt_aleph0] at h1 h2
  obtain ⟨s, t, x, y, hs, ht, hx, hy⟩ := exists_units_residues_of_rank_trdeg vK vL
  have : Finite s := lt_aleph0_iff_finite.mp (by rw [hs]; exact h1)
  have : Finite t := lt_aleph0_iff_finite.mp (by rw [ht]; exact h2)
  have : Fintype s := Fintype.ofFinite s
  refine valueGroup_fg_and_residueField_fg_of_trdeg_le vK vL hfg x hx y hy ?_
  rw [← lift_le.{uΓ}]
  refine h.trans (le_of_eq ?_)
  rw [← hs, ← ht, ← Nat.cast_card (α := s), ← Nat.cast_card (α := t)]
  simp only [lift_add, lift_natCast]

/-- **Theorem 2.2.2 of Volume 3 of the handbook**, with the rank over `ℤ`, under the hypothesis
`r + s = trdeg(L/K)`. -/
theorem valueGroup_fg_and_residueField_fg_of_rank_add_trdeg_eq
    (hfg : (⊤ : IntermediateField K L).FG)
    (heq : lift.{uL} (Module.rank ℤ (Additive ((vL : L →*₀ Γ₁).valueGroup.map
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup)))) +
      lift.{uΓ} (Algebra.trdeg (ResidueField vK.valuationSubring)
        (ResidueField vL.valuationSubring)) = lift.{uΓ} (Algebra.trdeg K L)) :
    (∃ S : Finset Γ₁ˣ, (vL : L →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure (S : Set Γ₁ˣ)) ∧
    (⊤ : IntermediateField (ResidueField vK.valuationSubring)
      (ResidueField vL.valuationSubring)).FG :=
  valueGroup_fg_and_residueField_fg_of_trdeg_le_rank_add vK vL hfg heq.ge

/-- **Theorem 2.2.2 of Volume 3 of the handbook**, in the form of the handbook. Let `L/K` be
finitely generated. Let `r` be the rational rank of `Γ_w / Γ_v` and let `s = trdeg(Lw/Kv)`. If
`r + s = trdeg(L/K)`, then `Γ_w` is generated by `Γ_v` and a finite set, and `Lw/Kv` is finitely
generated. -/
theorem valueGroup_fg_and_residueField_fg_of_rank_rat_add_trdeg_eq
    (hfg : (⊤ : IntermediateField K L).FG)
    (heq : lift.{uL} (Module.rank ℚ (ℚ ⊗[ℤ] Additive ((vL : L →*₀ Γ₁).valueGroup.map
        (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup)))) +
      lift.{uΓ} (Algebra.trdeg (ResidueField vK.valuationSubring)
        (ResidueField vL.valuationSubring)) = lift.{uΓ} (Algebra.trdeg K L)) :
    (∃ S : Finset Γ₁ˣ, (vL : L →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔ Subgroup.closure (S : Set Γ₁ˣ)) ∧
    (⊤ : IntermediateField (ResidueField vK.valuationSubring)
      (ResidueField vL.valuationSubring)).FG := by
  rw [(TensorProduct.isBaseChange ℤ _ ℚ).rank_eq] at heq
  exact valueGroup_fg_and_residueField_fg_of_rank_add_trdeg_eq vK vL hfg heq

end RationalRank

end Singularity
