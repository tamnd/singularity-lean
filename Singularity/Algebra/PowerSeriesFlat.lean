import Singularity.Algebra.FlatnessModPowers
import Singularity.Algebra.PowerSeriesBaseChange
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.RingTheory.MvPowerSeries.Inverse
import Mathlib.RingTheory.MvPowerSeries.Equiv

/-!
# Flatness of power series rings over a smaller field

Let `L ⊆ K` be fields and let `σ` be a finite set of variables. Put `A = L[[x]]` and
`B = K[[x]]`. This file proves that `B` is flat over `A` (Volume 1, Corollary 6.4.4). It then
proves that the Frobenius of `K[[x]]` is flat for each field `K` of characteristic `p`
(Volume 1, Proposition 6.4.5). The field `K` need not be perfect.

The proof uses the criterion `flat_of_flat_quotient_pow` with the ideal `I = (x_1, ..., x_n)`.
Let `J` be the ideal generated by the powers `x_s ^ (n + 1)`. Then `J ≤ I ^ n`. The module
`(A ⧸ J) ⊗[A] B` is free over `A ⧸ J`, with the basis `1 ⊗ b_i`, where `b` is a basis of `K`
over `L`. Thus `(A ⧸ I ^ n) ⊗[A] B` is a base change of a free module, and it is flat.

## Main declarations

* `boxPowIdeal`, `mem_boxPowIdeal_iff`: the ideal `J` and its description by coefficients.
* `boxTensorBasis`: the basis of `(A ⧸ J) ⊗[A] B` over `A ⧸ J`.
* `flat_quotient_pow_tensor`: the flatness of `(A ⧸ I ^ n) ⊗[A] B` over `A ⧸ I ^ n`.
* `flat_mvPowerSeries_of_field`: Corollary 6.4.4.
* `map_flat_of_field`: the map `MvPowerSeries.map φ` is flat for a map `φ` of fields.
* `frobenius_mvPowerSeries_flat`: Proposition 6.4.5.
-/

namespace Singularity.Algebra

open MvPowerSeries TensorProduct

section Box

variable {σ R : Type*} [CommRing R]

theorem coeff_X_pow_mul_eq (s : σ) (k : ℕ) (g : MvPowerSeries σ R) (α : σ →₀ ℕ) :
    coeff α (X s ^ k * g) = if k ≤ α s then coeff (α - Finsupp.single s k) g else 0 := by
  rw [X_pow_eq, coeff_monomial_mul, one_mul]
  simp only [Finsupp.single_le_iff]

/-- The ideal of `R[[x]]` generated by the powers `x_s ^ (m + 1)`. -/
noncomputable def boxPowIdeal (σ R : Type*) [CommRing R] (m : ℕ) : Ideal (MvPowerSeries σ R) :=
  Ideal.span (Set.range fun s : σ => (X s : MvPowerSeries σ R) ^ (m + 1))

open Classical in
/-- The quotient of `f` by `x_s ^ (m + 1)` in the decomposition of `boxPowIdeal`. -/
noncomputable def boxQuot (m : ℕ) (f : MvPowerSeries σ R) (s : σ) : MvPowerSeries σ R :=
  fun β => if h : ∃ t, m < (β + Finsupp.single s (m + 1)) t then
    (if h.choose = s then coeff (β + Finsupp.single s (m + 1)) f else 0) else 0

open Classical in
theorem coeff_boxQuot (m : ℕ) (f : MvPowerSeries σ R) (s : σ) (β : σ →₀ ℕ) :
    coeff β (boxQuot m f s) = if h : ∃ t, m < (β + Finsupp.single s (m + 1)) t then
      (if h.choose = s then coeff (β + Finsupp.single s (m + 1)) f else 0) else 0 := rfl

open Classical in
theorem coeff_X_pow_mul_boxQuot (m : ℕ) (f : MvPowerSeries σ R) (s : σ) (α : σ →₀ ℕ) :
    coeff α (X s ^ (m + 1) * boxQuot m f s) =
      if h : ∃ t, m < α t then (if m + 1 ≤ α s ∧ h.choose = s then coeff α f else 0) else 0 := by
  classical
  rw [coeff_X_pow_mul_eq]
  by_cases h1 : m + 1 ≤ α s
  · rw [if_pos h1]
    have he : α - Finsupp.single s (m + 1) + Finsupp.single s (m + 1) = α :=
      tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr h1)
    have := coeff_boxQuot m f s (α - Finsupp.single s (m + 1))
    rw [he] at this
    rw [this]
    split_ifs <;> simp_all
  · rw [if_neg h1]
    split_ifs <;> simp_all

theorem eq_sum_X_pow_mul_boxQuot [Fintype σ] (m : ℕ) (f : MvPowerSeries σ R)
    (hf : ∀ α : σ →₀ ℕ, (∀ s, α s ≤ m) → coeff α f = 0) :
    f = ∑ s, X s ^ (m + 1) * boxQuot m f s := by
  classical
  ext α
  rw [map_sum]
  simp_rw [coeff_X_pow_mul_boxQuot]
  by_cases hα : ∃ t, m < α t
  · simp only [dif_pos hα]
    rw [Finset.sum_eq_single hα.choose]
    · rw [if_pos ⟨hα.choose_spec, rfl⟩]
    · intro s _ hs
      rw [if_neg]
      rintro ⟨_, h⟩
      exact hs h.symm
    · intro h
      exact absurd (Finset.mem_univ _) h
  · simp only [dif_neg hα, Finset.sum_const_zero]
    push_neg at hα
    exact hf α hα

theorem mem_boxPowIdeal_iff [Fintype σ] (m : ℕ) (f : MvPowerSeries σ R) :
    f ∈ boxPowIdeal σ R m ↔ ∀ α : σ →₀ ℕ, (∀ s, α s ≤ m) → coeff α f = 0 := by
  constructor
  · intro hf α hα
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hf
    rw [map_sum]
    refine Finset.sum_eq_zero fun s _ => ?_
    rw [smul_eq_mul, mul_comm, coeff_X_pow_mul_eq, if_neg]
    have := hα s
    omega
  · intro hf
    rw [eq_sum_X_pow_mul_boxQuot m f hf]
    exact Ideal.sum_mem _ fun s _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨s, rfl⟩)

end Box

section Field

variable (σ : Type*) [Fintype σ] (L K : Type*) [Field L] [Field K] [Algebra L K]

local notation "A" => MvPowerSeries σ L
local notation "B" => MvPowerSeries σ K

theorem box_coeff_eq_zero_of_mem_smul_top (m : ℕ) {x : B}
    (hx : x ∈ boxPowIdeal σ L m • (⊤ : Submodule A B)) :
    ∀ α : σ →₀ ℕ, (∀ s, α s ≤ m) → coeff α x = 0 := by
  refine (mem_boxPowIdeal_iff m x).mp ?_
  refine Submodule.smul_induction_on hx (fun a ha y _ => ?_) (fun x y hx hy => Ideal.add_mem _ hx hy)
  · rw [smul_mvPowerSeries_def]
    refine Ideal.mul_mem_right _ _ ((mem_boxPowIdeal_iff m _).mpr fun α hα => ?_)
    rw [coeff_map, (mem_boxPowIdeal_iff m a).mp ha α hα, map_zero]

theorem mem_smul_top_of_box_coeff_eq_zero (m : ℕ) {x : B}
    (hx : ∀ α : σ →₀ ℕ, (∀ s, α s ≤ m) → coeff α x = 0) :
    x ∈ boxPowIdeal σ L m • (⊤ : Submodule A B) := by
  rw [eq_sum_X_pow_mul_boxQuot m x hx]
  refine Submodule.sum_mem _ fun s _ => ?_
  have : (X s ^ (m + 1) : B) * boxQuot m x s = (X s ^ (m + 1) : A) • boxQuot m x s := by
    rw [smul_mvPowerSeries_def, map_pow, map_X]
  rw [this]
  exact Submodule.smul_mem_smul (Ideal.subset_span ⟨s, rfl⟩) Submodule.mem_top

omit [Fintype σ] in
theorem one_tmul_smul (m : ℕ) (a : A) (y : B) :
    (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] (a • y) =
      Ideal.Quotient.mk (boxPowIdeal σ L m) a • ((1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] y) := by
  rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul']
  congr 1

theorem one_tmul_eq_zero_iff (m : ℕ) (y : B) :
    (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] y = 0 ↔
      ∀ α : σ →₀ ℕ, (∀ s, α s ≤ m) → coeff α y = 0 := by
  rw [← (quotTensorEquivQuotSMul B (boxPowIdeal σ L m)).map_eq_zero_iff,
    quotTensorEquivQuotSMul_mk_one_tmul, Submodule.Quotient.mk_eq_zero]
  exact ⟨box_coeff_eq_zero_of_mem_smul_top σ L K m, mem_smul_top_of_box_coeff_eq_zero σ L K m⟩

/-- The family `1 ⊗ b_i` of `(A ⧸ J) ⊗[A] B`, for the basis `b` of `K` over `L`. -/
noncomputable def boxTensorFamily (m : ℕ) :
    Module.Basis.ofVectorSpaceIndex L K → (A ⧸ boxPowIdeal σ L m) ⊗[A] B :=
  fun i => (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] C (Module.Basis.ofVectorSpace L K i)

theorem linearIndependent_boxTensorFamily (m : ℕ) :
    LinearIndependent (A ⧸ boxPowIdeal σ L m) (boxTensorFamily σ L K m) := by
  classical
  set b := Module.Basis.ofVectorSpace L K
  rw [linearIndependent_iff']
  intro s g hg i hi
  choose a ha using fun j => Ideal.Quotient.mk_surjective (I := boxPowIdeal σ L m) (g j)
  have key : ∑ j ∈ s, g j • boxTensorFamily σ L K m j =
      (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] (∑ j ∈ s, a j • (C (b j) : B)) := by
    rw [TensorProduct.tmul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [one_tmul_smul, ha]
    rfl
  rw [key, one_tmul_eq_zero_iff] at hg
  have hc : ∀ α : σ →₀ ℕ, (∀ t, α t ≤ m) → ∀ j ∈ s, coeff α (a j) = 0 := by
    intro α hα
    have h := hg α hα
    rw [map_sum] at h
    have h' : ∑ j ∈ s, coeff α (a j) • b j = 0 := by
      rw [← h]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [smul_mvPowerSeries_def, coeff_mul_C, coeff_map, Algebra.smul_def]
    exact (linearIndependent_iff'.mp b.linearIndependent) s _ h'
  rw [← ha i, Ideal.Quotient.eq_zero_iff_mem, mem_boxPowIdeal_iff]
  exact fun α hα => hc α hα i hi

theorem span_boxTensorFamily (m : ℕ) :
    ⊤ ≤ Submodule.span (A ⧸ boxPowIdeal σ L m) (Set.range (boxTensorFamily σ L K m)) := by
  classical
  set b := Module.Basis.ofVectorSpace L K
  set P := Submodule.span (A ⧸ boxPowIdeal σ L m) (Set.range (boxTensorFamily σ L K m))
  have hC : ∀ k : K, (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] (C k : B) ∈ P := by
    intro k
    rw [← b.linearCombination_repr k, Finsupp.linearCombination_apply, Finsupp.sum, map_sum,
      TensorProduct.tmul_sum]
    refine Submodule.sum_mem _ fun i _ => ?_
    have : (C (b.repr k i • b i) : B) = (C (b.repr k i) : A) • (C (b i) : B) := by
      rw [smul_mvPowerSeries_def, map_C, ← map_mul, Algebra.smul_def]
    rw [this, one_tmul_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hmon : ∀ (β : σ →₀ ℕ) (k : K),
      (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] (monomial β k : B) ∈ P := by
    intro β k
    have : (monomial β k : B) = (monomial β 1 : A) • (C k : B) := by
      rw [smul_mvPowerSeries_def, map_monomial, map_one]
      ext α
      rw [coeff_mul_C, coeff_monomial, coeff_monomial]
      split_ifs <;> simp
    rw [this, one_tmul_smul]
    exact Submodule.smul_mem _ _ (hC k)
  have hone : ∀ y : B, (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] y ∈ P := by
    intro y
    set c : σ →₀ ℕ := Finsupp.equivFunOnFinite.symm fun _ => m
    set t : B := ∑ β ∈ Finset.Iic c, monomial β (coeff β y)
    have hbox : ∀ α : σ →₀ ℕ, α ∈ Finset.Iic c ↔ ∀ s, α s ≤ m := by
      intro α
      rw [Finset.mem_Iic, Finsupp.le_def]
      rfl
    have hzero : (1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] (y - t) = 0 := by
      rw [one_tmul_eq_zero_iff]
      intro α hα
      rw [map_sub, map_sum]
      simp_rw [coeff_monomial]
      rw [Finset.sum_ite_eq, if_pos ((hbox α).mpr hα), sub_self]
    have hy : y = t + (y - t) := by abel
    rw [hy, TensorProduct.tmul_add, hzero, add_zero, TensorProduct.tmul_sum]
    exact Submodule.sum_mem _ fun β _ => hmon β _
  rintro z -
  induction z using TensorProduct.induction_on with
  | zero => exact Submodule.zero_mem _
  | tmul r y =>
    have : r ⊗ₜ[A] y = r • ((1 : A ⧸ boxPowIdeal σ L m) ⊗ₜ[A] y) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem _ _ (hone y)
  | add x y hx hy => exact Submodule.add_mem _ hx hy

/-- The family `1 ⊗ b_i` is a basis of `(A ⧸ J) ⊗[A] B` over `A ⧸ J`. -/
noncomputable def boxTensorBasis (m : ℕ) :
    Module.Basis (Module.Basis.ofVectorSpaceIndex L K) (A ⧸ boxPowIdeal σ L m)
      ((A ⧸ boxPowIdeal σ L m) ⊗[A] B) :=
  Module.Basis.mk (linearIndependent_boxTensorFamily σ L K m) (span_boxTensorFamily σ L K m)

omit [Fintype σ] in
theorem boxPowIdeal_le_pow (n : ℕ) :
    boxPowIdeal σ L n ≤ Ideal.span (Set.range (X : σ → A)) ^ n := by
  rw [boxPowIdeal, Ideal.span_le]
  rintro _ ⟨s, rfl⟩
  show X s ^ (n + 1) ∈ _
  rw [pow_succ]
  exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self s)) n)

theorem flat_quotient_pow_tensor (n : ℕ) :
    Module.Flat (A ⧸ Ideal.span (Set.range (X : σ → A)) ^ n)
      ((A ⧸ Ideal.span (Set.range (X : σ → A)) ^ n) ⊗[A] B) := by
  set I := Ideal.span (Set.range (X : σ → A))
  set J := boxPowIdeal σ L n
  have hle : J ≤ I ^ n := boxPowIdeal_le_pow σ L n
  let _ : Algebra (A ⧸ J) (A ⧸ I ^ n) := (Ideal.Quotient.factor hle).toAlgebra
  have : IsScalarTower A (A ⧸ J) (A ⧸ I ^ n) :=
    ⟨fun a x y => by
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      show Ideal.Quotient.mk (I ^ n) (a * x * y) = Ideal.Quotient.mk (I ^ n) (a * (x * y))
      rw [mul_assoc]⟩
  have : Module.Free (A ⧸ J) ((A ⧸ J) ⊗[A] B) := Module.Free.of_basis (boxTensorBasis σ L K n)
  exact Module.Flat.of_linearEquiv
    (AlgebraTensorModule.cancelBaseChange A (A ⧸ J) (A ⧸ I ^ n) (A ⧸ I ^ n) B).symm

omit [Fintype σ] in
theorem map_span_X_le_jacobson :
    (Ideal.span (Set.range (X : σ → A))).map (algebraMap A B) ≤ Ideal.jacobson ⊥ := by
  rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨s, rfl⟩, rfl⟩
  rw [SetLike.mem_coe, MvPowerSeries.algebraMap_apply'', map_X, IsLocalRing.mem_maximalIdeal,
    mem_nonunits_iff]
  intro h
  have := h.map (constantCoeff (σ := σ) (R := K))
  rw [constantCoeff_X] at this
  exact not_isUnit_zero this

/-- Volume 1, Corollary 6.4.4 of the handbook: for fields `L ⊆ K`, the ring `K[[x_1, ..., x_n]]` is flat over `L[[x_1, ..., x_n]]`. -/
theorem flat_mvPowerSeries_of_field : Module.Flat A B :=
  flat_of_flat_quotient_pow (Ideal.span (Set.range (X : σ → A))) (map_span_X_le_jacobson σ L K)
    (flat_quotient_pow_tensor σ L K)

end Field

section Map

variable (σ : Type*) [Fintype σ]

/-- For a map `φ` of fields, the map `MvPowerSeries.map φ` is flat. -/
theorem map_flat_of_field {L K : Type*} [Field L] [Field K] (φ : L →+* K) :
    (MvPowerSeries.map (σ := σ) φ).Flat := by
  let := φ.toAlgebra
  have e : MvPowerSeries.map (σ := σ) φ = algebraMap (MvPowerSeries σ L) (MvPowerSeries σ K) := by
    ext f
    rfl
  rw [e]
  exact RingHom.flat_algebraMap_iff.mpr (flat_mvPowerSeries_of_field σ L K)

variable {K : Type*} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p] [DecidableEq σ]

attribute [local instance] charP_mvPowerSeries

/-- Volume 1, Proposition 6.4.5 of the handbook: for each field `K` of characteristic `p`, the Frobenius of `K[[x_1, ..., x_n]]` is flat. -/
theorem frobenius_mvPowerSeries_flat : (frobenius (MvPowerSeries σ K) p).Flat := by
  rw [frobenius_mvPowerSeries_eq_comp]
  exact RingHom.Flat.comp
    (expand_finite_and_flat (σ := σ) (K := K) p (Fact.out : p.Prime).ne_zero).2
    (map_flat_of_field σ (frobenius K p))

end Map

end Singularity.Algebra
