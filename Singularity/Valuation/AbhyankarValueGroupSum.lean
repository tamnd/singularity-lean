import Singularity.Valuation.AbhyankarEquality

/-!
# The value group in Lemma 2.2.1

This file completes the value group part of Volume 3, Lemma 2.2.1 of the handbook. Let `(L/K, w)` be an extension of valued fields, let `x_1, ..., x_r` be units of `L` with values `γ_i = w(x_i)` that are independent over `ℤ` modulo the value group of `K`, and let `y_1, ..., y_s` be elements of the valuation ring of `L` with residues that are algebraically independent over the residue field of `K`. Let `F = K(x, y)`. The value groups are subgroups of `Γ₁ˣ`.

* `Singularity.valueGroup_adjoin_eq`: the value group of `F` is the value group of `K` times the subgroup generated by the `γ_i`.
* `Singularity.linearIndependent_and_disjoint_valueGroup`: the `γ_i` are independent over `ℤ`, and the subgroup that they generate meets the value group of `K` only in `1`.
* `Singularity.valuation_adjoin_unique`: the integers `a_i` and the value `vL(c)` in a product `vL(c) ∏ γ_i^{a_i}` are unique.

Together these give `Γ_{w_0} = Γ_v ⊕ ℤγ_1 ⊕ ⋯ ⊕ ℤγ_r`. The residue field part is in `Singularity/Valuation/AbhyankarResidue.lean`.
-/

namespace Singularity

open MvPolynomial

section AbhyankarValueGroup

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {Γ₀ Γ₁ : Type*}
  [LinearOrderedCommGroupWithZero Γ₀] [LinearOrderedCommGroupWithZero Γ₁]
  (vK : Valuation K Γ₀) (vL : Valuation L Γ₁) [vK.HasExtension vL]

/-- A unit `y` of `Γ₁` is in the value group of the restriction of `vL` to a subfield `F` if and
only if `y` is the value of a nonzero element of `F`. -/
theorem mem_valueGroup_comap_intermediateField_iff (F : IntermediateField K L) (y : Γ₁ˣ) :
    y ∈ (vL.comap (algebraMap F L) : F →*₀ Γ₁).valueGroup ↔
      ∃ z ∈ F, vL z = y := by
  rw [← SetLike.mem_coe, ← MonoidWithZeroHom.valueMonoid_eq_valueGroup',
    SetLike.mem_coe, MonoidWithZeroHom.mem_valueMonoid_iff]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨a, a.2, by simpa using ha⟩
  · rintro ⟨z, hz, h⟩
    exact ⟨⟨z, hz⟩, by simpa using h⟩

/-- The value group of `K` is the value group of the restriction of `vL` to `K`, as a subgroup of
`Γ₁ˣ`. A unit `y` is in it if and only if `y` is the value of an element of `K`. -/
theorem mem_valueGroup_comap_algebraMap_iff (y : Γ₁ˣ) :
    y ∈ (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ↔
      ∃ c : K, vL (algebraMap K L c) = y := by
  rw [← SetLike.mem_coe, ← MonoidWithZeroHom.valueMonoid_eq_valueGroup',
    SetLike.mem_coe, MonoidWithZeroHom.mem_valueMonoid_iff]
  constructor
  · rintro ⟨a, ha⟩
    exact ⟨a, by simpa using ha⟩
  · rintro ⟨c, h⟩
    exact ⟨c, by simpa using h⟩

/-- The directness in Volume 3, Lemma 2.2.1 of the handbook. The values `γ_i = w(x_i)` are
independent over `ℤ`, and the subgroup that they generate meets the value group of `K` only in
`1`. -/
theorem linearIndependent_and_disjoint_valueGroup {ι : Type*} (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i))))) :
    LinearIndependent ℤ (fun i => Additive.ofMul (Units.map (vL : L →* Γ₁) (x i))) ∧
      Disjoint (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Subgroup.closure (Set.range fun i => Units.map (vL : L →* Γ₁) (x i))) := by
  classical
  set H := (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
  set γ : ι → Γ₁ˣ := fun i => Units.map (vL : L →* Γ₁) (x i) with hγ
  set π : Γ₁ˣ →* Γ₁ˣ ⧸ H := QuotientGroup.mk' H
  refine ⟨?_, ?_⟩
  · exact LinearIndependent.of_comp (MonoidHom.toAdditive π).toIntLinearMap hx
  · rw [Subgroup.disjoint_def]
    intro y hyH hyC
    obtain ⟨a, rfl⟩ := Subgroup.mem_closure_range_iff.mp hyC
    have h1 : π (a.prod fun i n => γ i ^ n) = 1 := (QuotientGroup.eq_one_iff _).mpr hyH
    have h2 : π (a.prod fun i n => γ i ^ n) = a.prod fun i n => π (γ i) ^ n := by
      rw [map_finsuppProd]
      simp [map_zpow]
    have h3 : Finsupp.linearCombination ℤ (fun i => Additive.ofMul (π (γ i))) a = 0 := by
      have := congrArg Additive.ofMul (h2.symm.trans h1)
      simpa [Finsupp.linearCombination_apply, Finsupp.prod, Finsupp.sum, ofMul_prod,
        ofMul_zpow] using this
    have ha : a = 0 := hx (h3.trans (map_zero _).symm)
    simp [ha]

/-- The value group part of Volume 3, Lemma 2.2.1 of the handbook, as an equality of subgroups of
`Γ₁ˣ`. Let `F = K(x, y)`. Then the value group of `F` is the value group of `K` times the
subgroup generated by the values `γ_i = w(x_i)`. With
`Singularity.linearIndependent_and_disjoint_valueGroup`, this is
`Γ_{w_0} = Γ_v ⊕ ℤγ_1 ⊕ ⋯ ⊕ ℤγ_r`. -/
theorem valueGroup_adjoin_eq {ι κ : Type*} (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    (y : κ → vL.valuationSubring)
    (hy : AlgebraicIndependent (IsLocalRing.ResidueField vK.valuationSubring)
      (fun j => IsLocalRing.residue _ (y j)))
    (F : IntermediateField K L)
    (hF : F = IntermediateField.adjoin K
      (Set.range (Sum.elim (fun i => (x i : L)) (fun j => (y j : L))))) :
    (vL.comap (algebraMap F L) : F →*₀ Γ₁).valueGroup =
      (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup ⊔
        Subgroup.closure (Set.range fun i => Units.map (vL : L →* Γ₁) (x i)) := by
  classical
  set γ : ι → Γ₁ˣ := fun i => Units.map (vL : L →* Γ₁) (x i) with hγ
  have hxF : ∀ i, (x i : L) ∈ F := fun i => by
    rw [hF]
    exact IntermediateField.subset_adjoin _ _ ⟨Sum.inl i, rfl⟩
  have hprod : ∀ a : ι →₀ ℕ, ((a.prod fun i n => x i ^ n : Lˣ) : L) =
      a.prod fun i n => (x i : L) ^ n := by
    intro a
    simp [Finsupp.prod, Units.coe_prod]
  have hmapprod : ∀ a : ι →₀ ℕ, Units.map (vL : L →* Γ₁) (a.prod fun i n => x i ^ n) =
      a.prod fun i n => γ i ^ n := by
    intro a
    rw [map_finsuppProd]
    simp [hγ, map_pow]
  have hmemC : ∀ a : ι →₀ ℕ,
      (a.prod fun i n => γ i ^ n) ∈ Subgroup.closure (Set.range γ) := by
    intro a
    rw [Finsupp.prod]
    exact Subgroup.prod_mem _ fun i _ =>
      Subgroup.pow_mem _ (Subgroup.subset_closure (Set.mem_range_self i)) _
  apply le_antisymm
  · intro u hu
    obtain ⟨z, hzF, hzu⟩ := (mem_valueGroup_comap_intermediateField_iff vL F u).mp hu
    have hz0 : z ≠ 0 := by
      intro h
      rw [h, map_zero] at hzu
      exact u.ne_zero hzu.symm
    rw [hF] at hzF
    obtain ⟨c, a, b, h⟩ := exists_valuation_eq_of_mem_adjoin vK vL x hx y hy hzF hz0
    set cu : Γ₁ˣ := Units.map (vL : L →* Γ₁) (Units.map (algebraMap K L : K →* L) c)
    have hu' : u * (b.prod fun i n => γ i ^ n) = cu * (a.prod fun i n => γ i ^ n) := by
      rw [← hmapprod a, ← hmapprod b]
      ext
      simp only [Units.val_mul, Units.coe_map, MonoidHom.coe_ofClass, cu]
      rw [hprod a, hprod b, ← hzu]
      simpa using h
    have hcu : cu ∈ (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup :=
      (mem_valueGroup_comap_algebraMap_iff vL cu).mpr ⟨c, by simp [cu]⟩
    have : u = cu * ((a.prod fun i n => γ i ^ n) * (b.prod fun i n => γ i ^ n)⁻¹) := by
      rw [← mul_assoc, ← hu', mul_inv_cancel_right]
    rw [this]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hcu)
      (Subgroup.mem_sup_right (Subgroup.mul_mem _ (hmemC a) (Subgroup.inv_mem _ (hmemC b))))
  · refine sup_le ?_ ?_
    · intro u hu
      obtain ⟨c, hc⟩ := (mem_valueGroup_comap_algebraMap_iff vL u).mp hu
      exact (mem_valueGroup_comap_intermediateField_iff vL F u).mpr
        ⟨algebraMap K L c, F.algebraMap_mem c, hc⟩
    · rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact (mem_valueGroup_comap_intermediateField_iff vL F _).mpr
        ⟨x i, hxF i, by simp [hγ]⟩

/-- The uniqueness in Volume 3, Lemma 2.2.1 of the handbook. If `vL(c) ∏ γ_i^{a_i}` equals
`vL(c') ∏ γ_i^{b_i}` with `c, c'` nonzero in `K` and `a, b ∈ ℤ^(ι)`, then `a = b` and
`vL(c) = vL(c')`. -/
theorem valuation_adjoin_unique {ι : Type*} (x : ι → Lˣ)
    (hx : LinearIndependent ℤ (fun i => Additive.ofMul
      (QuotientGroup.mk' (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup
        (Units.map (vL : L →* Γ₁) (x i)))))
    {c c' : K} (hc : c ≠ 0) (hc' : c' ≠ 0) {a b : ι →₀ ℤ}
    (h : vL (algebraMap K L c) * ((a.prod fun i n => Units.map (vL : L →* Γ₁) (x i) ^ n :
        Γ₁ˣ) : Γ₁) =
      vL (algebraMap K L c') * ((b.prod fun i n => Units.map (vL : L →* Γ₁) (x i) ^ n :
        Γ₁ˣ) : Γ₁)) :
    a = b ∧ vL (algebraMap K L c) = vL (algebraMap K L c') := by
  classical
  obtain ⟨hli, hdisj⟩ := linearIndependent_and_disjoint_valueGroup vL x hx
  set γ : ι → Γ₁ˣ := fun i => Units.map (vL : L →* Γ₁) (x i) with hγ
  have hne : ∀ d : K, d ≠ 0 → vL (algebraMap K L d) ≠ 0 := fun d hd =>
    (Valuation.ne_zero_iff vL).mpr ((map_ne_zero (algebraMap K L)).mpr hd)
  set u : Γ₁ˣ := Units.mk0 _ (hne c hc)
  set u' : Γ₁ˣ := Units.mk0 _ (hne c' hc')
  have hU : u * (a.prod fun i n => γ i ^ n) = u' * (b.prod fun i n => γ i ^ n) := by
    ext
    simpa [u, u'] using h
  have hH : u'⁻¹ * u ∈ (vL.comap (algebraMap K L) : K →*₀ Γ₁).valueGroup :=
    Subgroup.mul_mem _ (Subgroup.inv_mem _
      ((mem_valueGroup_comap_algebraMap_iff vL u').mpr ⟨c', rfl⟩))
      ((mem_valueGroup_comap_algebraMap_iff vL u).mpr ⟨c, rfl⟩)
  have heq : u'⁻¹ * u = (b.prod fun i n => γ i ^ n) * (a.prod fun i n => γ i ^ n)⁻¹ := by
    rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, ← hU, mul_inv_cancel_right]
  have hC : u'⁻¹ * u ∈ Subgroup.closure (Set.range γ) := by
    rw [heq]
    exact Subgroup.mul_mem _ (Subgroup.mem_closure_range_iff.mpr ⟨b, rfl⟩)
      (Subgroup.inv_mem _ (Subgroup.mem_closure_range_iff.mpr ⟨a, rfl⟩))
  have h1 : u'⁻¹ * u = 1 := (Subgroup.disjoint_def.mp hdisj) hH hC
  have huu : u = u' := by
    rw [inv_mul_eq_one] at h1
    exact h1.symm
  refine ⟨?_, by simpa [u, u'] using congrArg Units.val huu⟩
  have hab : (a.prod fun i n => γ i ^ n) = b.prod fun i n => γ i ^ n := by
    rw [huu] at hU
    exact mul_left_cancel hU
  have hlc : Finsupp.linearCombination ℤ (fun i => Additive.ofMul (γ i)) a =
      Finsupp.linearCombination ℤ (fun i => Additive.ofMul (γ i)) b := by
    have := congrArg Additive.ofMul hab
    simpa [Finsupp.linearCombination_apply, Finsupp.prod, Finsupp.sum, ofMul_prod,
      ofMul_zpow] using this
  exact hli hlc

end AbhyankarValueGroup

end Singularity
