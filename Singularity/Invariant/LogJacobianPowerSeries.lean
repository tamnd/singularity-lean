import Singularity.Invariant.LogJacobian
import Mathlib.RingTheory.MvPowerSeries.Derivative

/-!
# The log-Jacobian ideal in the power series ring

Let `k` be a commutative ring of characteristic `p`, and let `R = k[[x_i : i ∈ σ]]` be the ring of
power series. Research note 03 works in `R`. The library defines the log-Jacobian ideal `Θ(g)`
in the polynomial ring `k[x]` (`logJacobian`). This file defines it in `R`, with the formal partial
derivatives `MvPowerSeries.pderiv` of Mathlib:

  `Θ(g) = (x_i ∂_i g (i ∈ Δ), ∂_j g (j ∉ Δ))` for `g ∈ R` (`logJacobianSeries`).

Part 2 of Lemma 3.6 of research note 03 says that `Θ(u^p g) = Θ(g)` for each unit `u` of `R`. The
library has this for a polynomial `u` with a nonzero constant term, in the local ring of `k[x]` at
the origin (`map_logJacobian_pow_mul_of_constantCoeff_ne_zero`). This file proves it in `R` for
each unit `u` of `R` (`logJacobianSeries_pow_mul_of_isUnit`). Over a field, the units of `R` are
the power series with a nonzero constant term (`logJacobianSeries_pow_mul_of_constantCoeff_ne_zero`).

The proof. Each partial derivative of `u^p` is `p u^(p-1) ∂_i u = 0`. So the Leibniz rule gives
`D(u^p g) = u^p D(g)` for each of the derivations `x_i ∂_i` and `∂_j`, and
`Θ(u^p g) = (u^p) Θ(g)` (`logJacobianSeries_pow_mul`). If `u` is a unit, then `(u^p) = R`.

The file also proves part 1 of Lemma 3.6 in `R` (`logJacobianSeries_add_pow`), and the comparison
with `k[x]`: for a polynomial `g`, the ideal `Θ(g)` of `R` is generated by the image of the ideal
`Θ(g)` of `k[x]` (`logJacobianSeries_coe`). So for each unit `u` of `R` and each polynomial `g`,
`Θ(u^p g)` is generated by the image of the ideal `Θ(g)` of `k[x]`
(`logJacobianSeries_pow_mul_coe_of_isUnit`).

## Main definitions

* `Singularity.logJacobianSeries Δ g`: the log-Jacobian ideal `Θ(g)` of a power series `g`.

## Main results

* `logJacobianSeries_mul_of_pderiv_eq_zero`: `Θ(u g) = (u) Θ(g)` if each `∂_i u` is `0`.
* `logJacobianSeries_add_pow`: `Θ(g + h^p) = Θ(g)` (Lemma 3.6, part 1).
* `logJacobianSeries_pow_mul`: `Θ(u^p g) = (u^p) Θ(g)`.
* `logJacobianSeries_pow_mul_of_isUnit`, `logJacobianSeries_pow_mul_of_constantCoeff_ne_zero`:
  `Θ(u^p g) = Θ(g)` for a unit `u` of `R` (Lemma 3.6, part 2).
* `logJacobianSeries_coe`: `Θ(g) R` is the image of `Θ(g)` for a polynomial `g`.
* `logJacobianSeries_pow_mul_coe_of_isUnit`: `Θ(u^p g) R` is the image of `Θ(g)` for a unit `u`
  of `R` and a polynomial `g`.

## References

* Research note 03, Section 3.3: Definition 3.5 and Lemma 3.6, parts 1 and 2.
* Volume 7, Section 3.1 of the handbook.
-/

open MvPowerSeries

namespace Singularity

section Defs

variable {σ k : Type*} [CommSemiring k]

/-- The log-Jacobian ideal `Θ(g)` of a power series `g` along the divisor
`E = V(∏_{i ∈ Δ} x_i)`: the ideal of `k[[x]]` generated by `x_i ∂_i g` for `i ∈ Δ` and by `∂_j g`
for `j ∉ Δ` (research note 03, Definition 3.5). -/
noncomputable def logJacobianSeries (Δ : Finset σ) (g : MvPowerSeries σ k) :
    Ideal (MvPowerSeries σ k) :=
  Ideal.span ((fun i => X i * MvPowerSeries.pderiv i g) '' (Δ : Set σ) ∪
    (fun j => MvPowerSeries.pderiv j g) '' (Δ : Set σ)ᶜ)

theorem X_mul_pderiv_mem_logJacobianSeries {Δ : Finset σ} {i : σ} (hi : i ∈ Δ)
    (g : MvPowerSeries σ k) : X i * MvPowerSeries.pderiv i g ∈ logJacobianSeries Δ g :=
  Ideal.subset_span (Or.inl ⟨i, hi, rfl⟩)

theorem pderiv_mem_logJacobianSeries {Δ : Finset σ} {j : σ} (hj : j ∉ Δ)
    (g : MvPowerSeries σ k) : MvPowerSeries.pderiv j g ∈ logJacobianSeries Δ g :=
  Ideal.subset_span (Or.inr ⟨j, hj, rfl⟩)

/-- If all the partial derivatives of `u` vanish, then `Θ(u g) = (u) Θ(g)`. -/
theorem logJacobianSeries_mul_of_pderiv_eq_zero (Δ : Finset σ) {u : MvPowerSeries σ k}
    (hu : ∀ i, MvPowerSeries.pderiv i u = 0) (g : MvPowerSeries σ k) :
    logJacobianSeries Δ (u * g) = Ideal.span {u} * logJacobianSeries Δ g := by
  rw [logJacobianSeries, logJacobianSeries, Ideal.span_mul_span, Set.singleton_mul,
    Set.image_union, Set.image_image, Set.image_image]
  congr 2
  · refine Set.image_congr fun i _ => ?_
    show X i * MvPowerSeries.pderiv i (u * g) = u * (X i * MvPowerSeries.pderiv i g)
    rw [Derivation.leibniz, hu i, smul_zero, add_zero, smul_eq_mul, mul_left_comm]
  · refine Set.image_congr fun j _ => ?_
    show MvPowerSeries.pderiv j (u * g) = u * MvPowerSeries.pderiv j g
    rw [Derivation.leibniz, hu j, smul_zero, add_zero, smul_eq_mul]

/-- **The comparison with `k[x]`.** For a polynomial `g`, the ideal `Θ(g)` of `k[[x]]` is
generated by the image of the ideal `Θ(g)` of `k[x]`. -/
theorem logJacobianSeries_coe (Δ : Finset σ) (g : MvPolynomial σ k) :
    logJacobianSeries Δ (g : MvPowerSeries σ k) =
      Ideal.map (MvPolynomial.coeToMvPowerSeries.ringHom (σ := σ) (R := k))
        (logJacobian Δ g) := by
  rw [logJacobian, Ideal.map_span, logJacobianSeries, Set.image_union, Set.image_image,
    Set.image_image]
  congr 2
  · refine Set.image_congr fun i _ => ?_
    rw [MvPolynomial.coeToMvPowerSeries.ringHom_apply, MvPolynomial.coe_mul, MvPolynomial.coe_X,
      MvPowerSeries.pderiv_coe]
  · refine Set.image_congr fun j _ => ?_
    rw [MvPolynomial.coeToMvPowerSeries.ringHom_apply, MvPowerSeries.pderiv_coe]

end Defs

section CharP

variable {σ k : Type*} [CommSemiring k] (p : ℕ) [CharP k p]

/-- The cast of `p` is `0` in `k[[x]]` if it is `0` in `k`. -/
theorem natCast_eq_zero_mvPowerSeries : (p : MvPowerSeries σ k) = 0 := by
  rw [← map_natCast (MvPowerSeries.C : k →+* MvPowerSeries σ k), CharP.cast_eq_zero, map_zero]

/-- Each partial derivative of a `p`-th power is `0`. -/
theorem pderiv_pow_char (i : σ) (h : MvPowerSeries σ k) :
    MvPowerSeries.pderiv i (h ^ p) = 0 := by
  rw [MvPowerSeries.pderiv_pow, natCast_eq_zero_mvPowerSeries p, zero_mul, zero_mul]

/-- **Invariance under the choice of `z`** (research note 03, Lemma 3.6, part 1):
`Θ(g + h^p) = Θ(g)` in `k[[x]]`. -/
theorem logJacobianSeries_add_pow (Δ : Finset σ) (g h : MvPowerSeries σ k) :
    logJacobianSeries Δ (g + h ^ p) = logJacobianSeries Δ g := by
  have hD : ∀ i, MvPowerSeries.pderiv i (g + h ^ p) = MvPowerSeries.pderiv i g := fun i => by
    rw [map_add, pderiv_pow_char p, add_zero]
  simp only [logJacobianSeries, hD]

/-- `Θ(u^p g) = (u^p) Θ(g)` in `k[[x]]`. -/
theorem logJacobianSeries_pow_mul (Δ : Finset σ) (u g : MvPowerSeries σ k) :
    logJacobianSeries Δ (u ^ p * g) = Ideal.span {u ^ p} * logJacobianSeries Δ g :=
  logJacobianSeries_mul_of_pderiv_eq_zero Δ (fun i => pderiv_pow_char p i u) g

/-- **`Θ(u^p g) = Θ(g)` for a unit `u`** (research note 03, Lemma 3.6, part 2). For each unit `u`
of the power series ring `k[[x]]` and each power series `g`, `Θ(u^p g) = Θ(g)`. -/
theorem logJacobianSeries_pow_mul_of_isUnit (Δ : Finset σ) {u : MvPowerSeries σ k}
    (hu : IsUnit u) (g : MvPowerSeries σ k) :
    logJacobianSeries Δ (u ^ p * g) = logJacobianSeries Δ g := by
  rw [logJacobianSeries_pow_mul p Δ u g, Ideal.span_singleton_eq_top.mpr (hu.pow p),
    Ideal.top_mul]

/-- **`Θ(u^p g) = Θ(g)` for a unit `u` and a polynomial `g`.** For each unit `u` of `k[[x]]` and
each polynomial `g`, the ideal `Θ(u^p g)` of `k[[x]]` is generated by the image of the ideal
`Θ(g)` of `k[x]`. -/
theorem logJacobianSeries_pow_mul_coe_of_isUnit (Δ : Finset σ) {u : MvPowerSeries σ k}
    (hu : IsUnit u) (g : MvPolynomial σ k) :
    logJacobianSeries Δ (u ^ p * (g : MvPowerSeries σ k)) =
      Ideal.map (MvPolynomial.coeToMvPowerSeries.ringHom (σ := σ) (R := k))
        (logJacobian Δ g) := by
  rw [logJacobianSeries_pow_mul_of_isUnit p Δ hu, logJacobianSeries_coe]

end CharP

section Field

variable {σ k : Type*} [Field k] (p : ℕ) [CharP k p]

/-- **`Θ(u^p g) = Θ(g)` over a field** (research note 03, Lemma 3.6, part 2). For each power series
`u` with a nonzero constant term and each power series `g`, `Θ(u^p g) = Θ(g)`. -/
theorem logJacobianSeries_pow_mul_of_constantCoeff_ne_zero (Δ : Finset σ)
    {u : MvPowerSeries σ k} (hu : constantCoeff u ≠ 0) (g : MvPowerSeries σ k) :
    logJacobianSeries Δ (u ^ p * g) = logJacobianSeries Δ g :=
  logJacobianSeries_pow_mul_of_isUnit p Δ
    (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr hu)) g

end Field

end Singularity
