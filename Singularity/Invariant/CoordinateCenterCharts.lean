import Singularity.Invariant.RestrictionMaximalContact

/-!
# Blowups of coordinate centers in the chart model

This file proves cores of results of Volume 2 of the handbook in the affine chart model. The
ambient space is the affine space with coordinates `x_i`. The centers are coordinate subspaces
`Z = V(x_i : i ∈ S)`, and a blowup is seen in one chart at a time: the `x_c`-chart, `c ∈ S`, is
the map `chartSubst S c`. A sequence of blowups is a list of chart steps.

## Main declarations

* `chartSubst_injective`, `map_chartCenterIdeal_chartSubst`, `chartSubst_monomial`:
  Lemma 2.2.2 in one chart. The chart map is injective, so it is birational. The center pulls
  back to the principal ideal `(y_c)`, the exceptional divisor. Monomials go to monomials.
* `centerChartTransformIdeal_span`, `IsChartSeqOfOrder`, `chartSeqTransform`, `chartSeqMap`,
  `map_chartSeqMap_eq`: Definition 2.2.3 in the chart model. The transform of `(I, m)` is
  generated by the transforms of generators. Along a sequence of order at least `m`, the
  pullback of `I` is the exceptional factor times the last transform.
* `coefficientIdeal`, `le_idealOrd_iff_le_idealOrd_restrict_coefficientIdeal`,
  `map_hyperplaneRestrict_transform_coefficientIdeal`: Theorem 3.2.4 at the origin and for one
  chart of one blowup.
* `maximalContact_coefficientIdeal`: Corollary 3.2.5 at the origin.
* `map_markedTransform`: Lemma 3.3.2 for one ring map, for example a localization `D(u)`.
* `centerChartTransformIdeal_singleton`: Lemma 3.3.4, the blowup of `(x_l)` divides by `x_l^m`.
* `centerChartTransformIdeal_singleton_eq_top`,
  `idealOrd_centerChartTransformIdeal_singleton_lt`: Theorem 3.3.5 for `H = V(x_h)`.
* `centerChartTransformIdeal_span_monomial`, `principal_monomial_orderReduction`: Theorem 3.3.6
  for a principal monomial ideal and one blowup.
* `le_idealOrd_sup_pow_iff`, `centerChartTransformIdeal_sup_pow`: Theorem 3.3.10, the order and
  the transform of `N^m + I^s`.
* `exists_map_chartSeqMap_eq_span_monomial`: Theorem 3.3.11 in the chart model.
* `principalization_chartCenterIdeal_pow`: Theorems 1.1.5 to 1.1.7 for `I = I_Z^n`.
* `map_centerChartTransformIdeal`: Theorem 1.1.8 (4), change of the base ring, in one chart.
* `chartCenterIdeal_ne_span_singleton`: Theorem 1.2.1, the key fact. A coordinate center of
  codimension at least `2` is not principal.

## What is not proved

* No schemes, no gluing of charts, no smooth varieties and no snc divisors. All results are in
  one affine chart, with coordinate centers only.
* Lemma 2.2.2: properness, and the statement that the exceptional divisor is a smooth
  hypersurface, are not proved. Only injectivity of the chart map and the pullback of the center
  are proved.
* Theorem 3.2.4 and Corollary 3.2.5 are proved at the origin only, not at every point, and the
  transform statement for one blowup in one chart with `c ≠ h`. The sequence version is not
  proved.
* Lemma 3.3.2 is proved for one ring map, not for an open cover. Lemma 3.3.4 is proved only for
  the first blowup of a coordinate hyperplane.
* Theorem 3.3.5 is proved only for the coordinate hypersurface `V(x_h)` with `x_h^m ∈ I`.
* Theorem 3.3.6 is proved only for a principal monomial ideal and one blowup. The induction on
  the order and the general case are not proved.
* Theorem 3.3.10 is proved for the order at the origin and for one chart transform. The
  descent of the order along the whole sequence is not proved.
* Theorem 3.3.11 is proved in the chart model only. The global divisor `G` is not built.
* Theorems 1.1.3 and 1.1.4 (resolution and embedded resolution) are not proved. Theorems 1.1.5
  to 1.1.7 are proved only for the ideal `I_Z^n` of a coordinate center, with one blowup. Of
  Theorem 1.1.8 only part (4), base change, is proved, in one chart.
* Theorem 1.2.1 is not proved in general. Only the fact that a coordinate center of codimension
  at least `2` is not principal, and becomes principal after one blowup, is proved.
-/

open MvPolynomial

namespace Singularity

/-! ### The charts of the blowup of a coordinate center (Lemma 2.2.2) -/

section Charts

variable {σ R : Type*} [CommRing R] [DecidableEq σ]

/-- The exponent of the image of `x^d` in the `x_c`-chart of the blowup of `(x_i : i ∈ S)`:
the exponent of `x_c` grows by `∑_{i ∈ S, i ≠ c} d_i`, and the other exponents stay. -/
noncomputable def centerChartExponent (S : Finset σ) (c : σ) (d : σ →₀ ℕ) : σ →₀ ℕ :=
  d + Finsupp.single c (∑ i ∈ S.erase c, d i)

theorem centerChartExponent_add (S : Finset σ) (c : σ) (d e : σ →₀ ℕ) :
    centerChartExponent S c (d + e) = centerChartExponent S c d + centerChartExponent S c e := by
  ext j
  simp only [centerChartExponent, Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_add]
  ring

theorem centerChartExponent_injective (S : Finset σ) (c : σ) :
    Function.Injective (centerChartExponent S c) := by
  intro d e hde
  have hne : ∀ j, j ≠ c → d j = e j := by
    intro j hj
    have := congrArg (fun f : σ →₀ ℕ => f j) hde
    simpa [centerChartExponent, Finsupp.single_apply, Ne.symm hj] using this
  have hsum : ∑ i ∈ S.erase c, d i = ∑ i ∈ S.erase c, e i :=
    Finset.sum_congr rfl fun i hi => hne i (Finset.ne_of_mem_erase hi)
  ext j
  by_cases hj : j = c
  · subst hj
    have := congrArg (fun f : σ →₀ ℕ => f j) hde
    simp only [centerChartExponent, Finsupp.add_apply, Finsupp.single_eq_same, hsum] at this
    omega
  · exact hne j hj

theorem chartImage_eq_monomial (S : Finset σ) (c i : σ) :
    chartImage (R := R) S c i =
      monomial (centerChartExponent S c (Finsupp.single i 1)) 1 := by
  have hs : ∑ l ∈ S.erase c, (Finsupp.single i 1 : σ →₀ ℕ) l = if i ∈ S.erase c then 1 else 0 := by
    simp [Finsupp.single_apply]
  rw [centerChartExponent, hs, chartImage]
  split_ifs
  · rw [← one_mul (1 : R), ← monomial_mul_monomial]
    rfl
  · rw [Finsupp.single_zero, add_zero]
    rfl

theorem centerChartExponent_nsmul (S : Finset σ) (c : σ) (n : ℕ) (d : σ →₀ ℕ) :
    centerChartExponent S c (n • d) = n • centerChartExponent S c d := by
  induction n with
  | zero => simp [centerChartExponent]
  | succ n ih => rw [succ_nsmul, centerChartExponent_add, ih, succ_nsmul]

/-- The chart map sends monomials to monomials. -/
theorem chartSubst_monomial_one (S : Finset σ) (c : σ) (d : σ →₀ ℕ) :
    chartSubst S c (monomial d (1 : R)) = monomial (centerChartExponent S c d) 1 := by
  induction d using Finsupp.induction with
  | zero =>
    have h0 : centerChartExponent S c (0 : σ →₀ ℕ) = 0 := by simp [centerChartExponent]
    rw [h0, monomial_zero', C_1, map_one]
  | single_add i n d _ _ ih =>
    have h1 : monomial (Finsupp.single i n + d) (1 : R) = X i ^ n * monomial d 1 := by
      rw [X_pow_eq_monomial, monomial_mul_monomial, one_mul]
    rw [h1, map_mul, map_pow, chartSubst_X, chartImage_eq_monomial, monomial_pow, one_pow, ih,
      monomial_mul_monomial, one_mul, centerChartExponent_add, ← centerChartExponent_nsmul,
      Finsupp.smul_single_one]

theorem chartSubst_monomial (S : Finset σ) (c : σ) (d : σ →₀ ℕ) (a : R) :
    chartSubst S c (monomial d a) = monomial (centerChartExponent S c d) a := by
  rw [show monomial d a = C a * monomial d 1 by rw [C_mul_monomial, mul_one], map_mul,
    algHom_C, algebraMap_eq, chartSubst_monomial_one, C_mul_monomial, mul_one]

/-- The coefficient of `π f` at the exponent `E(d)` is the coefficient of `f` at `d`. -/
theorem coeff_chartSubst (S : Finset σ) (c : σ) (f : MvPolynomial σ R) (d : σ →₀ ℕ) :
    (chartSubst S c f).coeff (centerChartExponent S c d) = f.coeff d := by
  conv_lhs => rw [f.as_sum, map_sum]
  simp only [chartSubst_monomial, coeff_sum, coeff_monomial,
    (centerChartExponent_injective S c).eq_iff]
  rw [Finset.sum_eq_single d (fun e _ he => by simp [he]) (fun hd => by
    simpa using notMem_support_iff.mp hd)]
  simp

/-- **Lemma 2.2.2, birationality in the chart model.** The chart map `π` is injective. -/
theorem chartSubst_injective (S : Finset σ) (c : σ) :
    Function.Injective (chartSubst (R := R) S c) := by
  intro f g hfg
  ext d
  rw [← coeff_chartSubst S c f d, ← coeff_chartSubst S c g d, hfg]

/-- **Lemma 2.2.2, the exceptional divisor in the chart model.** For `c ∈ S`, the ideal of the
center pulls back to `(y_c)`, so `F ∩ U_c = (y_c = 0)`. -/
theorem map_chartCenterIdeal_chartSubst {S : Finset σ} {c : σ} (hc : c ∈ S) :
    (chartCenterIdeal S).map (chartSubst (R := R) S c) = Ideal.span {X c} := by
  apply le_antisymm
  · rw [chartCenterIdeal, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_span_singleton, chartSubst_X, chartImage]
    split_ifs with h
    · exact Dvd.intro_left _ rfl
    · have : i = c := by
        by_contra hne
        exact h (Finset.mem_erase.mpr ⟨hne, hi⟩)
      rw [this]
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    have hX : chartSubst (R := R) S c (X c) = X c := by
      exact chartSubst_X_self S c
    rw [← hX]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨c, hc, rfl⟩)

/-- The powers of the ideal of the center pull back to the powers of `(y_c)`. -/
theorem map_chartCenterIdeal_pow_chartSubst {S : Finset σ} {c : σ} (hc : c ∈ S) (n : ℕ) :
    (chartCenterIdeal S ^ n).map (chartSubst (R := R) S c) = Ideal.span {X c ^ n} := by
  rw [Ideal.map_pow, map_chartCenterIdeal_chartSubst hc, Ideal.span_singleton_pow]

/-- The blowup of a coordinate hyperplane `(x_l)` is the identity in its only chart. -/
theorem chartSubst_singleton_self (l : σ) :
    chartSubst (R := R) {l} l = AlgHom.id R (MvPolynomial σ R) := by
  refine MvPolynomial.algHom_ext fun i => ?_
  rw [chartSubst_X, chartImage, AlgHom.id_apply]
  simp

end Charts

/-! ### Transforms: generators, sequences, and base change (Definition 2.2.3) -/

section Transform

variable {σ R : Type*} [CommRing R] [DecidableEq σ]

/-- **Definition 2.2.3 (2), the generators.** If `I` is generated by `T` and `I ⊆ I_Z^m`, then
the transform of `(I, m)` in the `x_c`-chart is generated by the `g` with `π f = y_c^m g`,
`f ∈ T`. -/
theorem centerChartTransformIdeal_span [IsDomain R] {S : Finset σ} {c : σ} {m : ℕ}
    {T : Set (MvPolynomial σ R)} (hT : Ideal.span T ≤ chartCenterIdeal S ^ m) :
    centerChartTransformIdeal S c m (Ideal.span T) =
      Ideal.span {g | ∃ f ∈ T, chartSubst S c f = X c ^ m * g} := by
  apply markedTransform_eq_of_map_eq (X_ne_zero c)
  rw [Ideal.map_span, Ideal.span_mul_span]
  congr 1
  ext y
  constructor
  · rintro ⟨f, hf, rfl⟩
    obtain ⟨g, hg⟩ := exists_chartSubst_eq_X_pow_mul (c := c) (hT (Ideal.subset_span hf))
    exact Set.mem_mul.mpr ⟨_, rfl, g, ⟨f, hf, hg⟩, hg.symm⟩
  · intro hy
    obtain ⟨a, ha, g, ⟨f, hf, hg⟩, rfl⟩ := Set.mem_mul.mp hy
    rw [Set.mem_singleton_iff] at ha
    exact ⟨f, hf, by rw [ha, hg]⟩

/-- The ideal generated by the image under the composite `g ∘ f` of two algebra maps. -/
theorem map_algHom_comp {A : Type*} [CommRing A] [Algebra R A] (f g : A →ₐ[R] A) (I : Ideal A) :
    I.map (g.comp f) = (I.map f).map g := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact Ideal.mem_map_of_mem g (Ideal.mem_map_of_mem f hx)
  · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, Ideal.mem_comap, ← AlgHom.comp_apply]
    exact Ideal.mem_map_of_mem _ hx

theorem map_algHom_id {A : Type*} [CommRing A] [Algebra R A] (I : Ideal A) :
    I.map (AlgHom.id R A) = I := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simpa using hx
  · intro x hx
    simpa using Ideal.mem_map_of_mem (AlgHom.id R A) hx

/-- The transform of `(I, m)` along a list of chart steps `(S_i, c_i)`: first the transform in
the `x_(c_0)`-chart of the blowup of `(x_i : i ∈ S_0)`, then the next step, and so on. -/
noncomputable def chartSeqTransform (m : ℕ) :
    List (Finset σ × σ) → Ideal (MvPolynomial σ R) → Ideal (MvPolynomial σ R)
  | [], I => I
  | p :: l, I => chartSeqTransform m l (centerChartTransformIdeal p.1 p.2 m I)

/-- The composite chart map `Π^*` of a list of chart steps: the pullback of functions from the
first space to the last chart. -/
noncomputable def chartSeqMap :
    List (Finset σ × σ) → MvPolynomial σ R →ₐ[R] MvPolynomial σ R
  | [] => AlgHom.id R _
  | p :: l => (chartSeqMap l).comp (chartSubst p.1 p.2)

/-- **Definition 2.2.3 (3) in the chart model.** A list of chart steps is a blowup sequence of
order at least `m` for `(I, m)` if at each step the current transform lies in `I_(Z_i)^m`. -/
def IsChartSeqOfOrder (m : ℕ) :
    List (Finset σ × σ) → Ideal (MvPolynomial σ R) → Prop
  | [], _ => True
  | p :: l, I => I ≤ chartCenterIdeal p.1 ^ m ∧
      IsChartSeqOfOrder m l (centerChartTransformIdeal p.1 p.2 m I)

/-- The exceptional factor of a chart sequence: the pullback to the last chart of the product
of the `m`th powers of the equations of the exceptional divisors. -/
noncomputable def chartSeqFactor (m : ℕ) : List (Finset σ × σ) → MvPolynomial σ R
  | [] => 1
  | p :: l => chartSeqMap l (X p.2 ^ m) * chartSeqFactor m l

/-- **Definition 2.2.3 (3), the pullback formula.** Along a chart sequence of order at least
`m`, the pullback `Π^* I` is the exceptional factor times the last transform `I_r`. -/
theorem map_chartSeqMap_eq [IsDomain R] {m : ℕ} :
    ∀ (l : List (Finset σ × σ)) (I : Ideal (MvPolynomial σ R)), IsChartSeqOfOrder m l I →
      I.map (chartSeqMap l) = Ideal.span {chartSeqFactor m l} * chartSeqTransform m l I
  | [], I, _ => by
    simp only [chartSeqMap, chartSeqFactor, chartSeqTransform, Ideal.span_singleton_one,
      Ideal.top_mul]
    exact map_algHom_id I
  | p :: l, I, h => by
    have h1 := map_eq_span_mul_markedTransform (map_chartSubst_le_span (c := p.2) h.1)
    have ih := map_chartSeqMap_eq l _ h.2
    rw [chartSeqMap, map_algHom_comp]
    change (I.map (chartSubst p.1 p.2)).map (chartSeqMap l) = _
    rw [h1, Ideal.map_mul, Ideal.map_span, Set.image_singleton]
    change _ * (centerChartTransformIdeal p.1 p.2 m I).map (chartSeqMap l) = _
    rw [ih, ← mul_assoc, Ideal.span_singleton_mul_span_singleton]
    rfl

/-- Along a chart sequence of order at least `m`, the pullback `Π^* I` lies in the last
transform. This is the inclusion `Π_i^* I ⊆ I_i` of the proof of Theorem 3.3.11. -/
theorem map_chartSeqMap_le [IsDomain R] {m : ℕ} {l : List (Finset σ × σ)}
    {I : Ideal (MvPolynomial σ R)} (h : IsChartSeqOfOrder m l I) :
    I.map (chartSeqMap l) ≤ chartSeqTransform m l I := by
  rw [map_chartSeqMap_eq l I h]
  exact Ideal.mul_le.mpr fun _ _ _ hb => Ideal.mul_mem_left _ _ hb

/-- The composite chart map sends monomials to monomials. -/
theorem exists_chartSeqMap_monomial :
    ∀ (l : List (Finset σ × σ)) (d : σ →₀ ℕ),
      ∃ e, chartSeqMap l (monomial d (1 : R)) = monomial e 1
  | [], d => ⟨d, rfl⟩
  | p :: l, d => by
    obtain ⟨e, he⟩ := exists_chartSeqMap_monomial l (centerChartExponent p.1 p.2 d)
    refine ⟨e, ?_⟩
    rw [chartSeqMap, AlgHom.comp_apply, chartSubst_monomial_one, he]

/-- The exceptional factor of a chart sequence is a monomial. -/
theorem exists_chartSeqFactor_eq_monomial (m : ℕ) :
    ∀ l : List (Finset σ × σ), ∃ e, chartSeqFactor (R := R) m l = monomial e 1
  | [] => ⟨0, by rw [chartSeqFactor, monomial_zero', C_1]⟩
  | p :: l => by
    obtain ⟨e₁, he₁⟩ := exists_chartSeqMap_monomial (R := R) l (Finsupp.single p.2 m)
    obtain ⟨e₂, he₂⟩ := exists_chartSeqFactor_eq_monomial m l
    refine ⟨e₁ + e₂, ?_⟩
    rw [chartSeqFactor, X_pow_eq_monomial, he₁, he₂, monomial_mul_monomial, one_mul]

/-! ### Base change of the transform (Lemma 3.3.2 and Theorem 1.1.8 (4)) -/

omit [DecidableEq σ] in
/-- The transform commutes with a ring map `ψ` to a domain with `ψ x ≠ 0`. This covers the
restriction to an open set `D(u)` of the chart and the change of the base field. -/
theorem map_markedTransform {P Q Q' : Type*} [CommRing P] [CommRing Q] [CommRing Q']
    [IsDomain Q'] (φ : P →+* Q) (ψ : Q →+* Q') {x : Q} (hx : ψ x ≠ 0) {m : ℕ} {I : Ideal P}
    (h : I.map φ ≤ Ideal.span {x ^ m}) :
    (markedTransform φ x m I).map ψ = markedTransform (ψ.comp φ) (ψ x) m I := by
  symm
  apply markedTransform_eq_of_map_eq hx
  rw [← Ideal.map_map, map_eq_span_mul_markedTransform h, Ideal.map_mul, Ideal.map_span,
    Set.image_singleton, map_pow]

omit [DecidableEq σ] in
/-- After a ring map `ψ` with `ψ x ≠ 0`, the divisibility condition still holds. -/
theorem map_comp_le_span {P Q Q' : Type*} [CommRing P] [CommRing Q] [CommRing Q']
    (φ : P →+* Q) (ψ : Q →+* Q') {x : Q} {m : ℕ} {I : Ideal P}
    (h : I.map φ ≤ Ideal.span {x ^ m}) : I.map (ψ.comp φ) ≤ Ideal.span {ψ x ^ m} := by
  rw [← Ideal.map_map]
  refine (Ideal.map_mono h).trans ?_
  rw [Ideal.map_span, Set.image_singleton, map_pow]

/-- The chart map commutes with a change of the coefficient ring. -/
theorem map_comp_chartSubst {R' : Type*} [CommRing R'] (f : R →+* R') (S : Finset σ) (c : σ) :
    (MvPolynomial.map f).comp (chartSubst (R := R) S c).toRingHom =
      (chartSubst (R := R') S c).toRingHom.comp (MvPolynomial.map f) := by
  refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
  · simp [chartSubst]
  · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, map_X, chartSubst_X, chartImage]
    split_ifs <;> simp

/-- **Theorem 1.1.8 (4), change of the base ring, for one chart.** Let `f : R → R'` be a ring
map to a domain, and let `I ⊆ I_Z^m`. Then the transform of `(I, m)` in the `x_c`-chart,
extended to `R'`, is the transform of the extension of `I`. -/
theorem map_centerChartTransformIdeal {R' : Type*} [CommRing R'] [IsDomain R'] (f : R →+* R')
    {S : Finset σ} {c : σ} {m : ℕ} {I : Ideal (MvPolynomial σ R)}
    (h : I ≤ chartCenterIdeal S ^ m) :
    (centerChartTransformIdeal S c m I).map (MvPolynomial.map f) =
      centerChartTransformIdeal S c m (I.map (MvPolynomial.map f)) := by
  have hx : MvPolynomial.map f (X c : MvPolynomial σ R) ≠ 0 := by
    rw [map_X]; exact X_ne_zero c
  have e := map_markedTransform (chartSubst (R := R) S c).toRingHom (MvPolynomial.map f) hx
    (map_chartSubst_le_span h)
  change (markedTransform (chartSubst (R := R) S c).toRingHom (X c) m I).map _ = _
  rw [e, map_comp_chartSubst, map_X]
  unfold centerChartTransformIdeal markedTransform
  rw [← Ideal.map_map]
  rfl

end Transform

/-! ### The coefficient ideal and its restriction (Theorem 3.2.4 and Corollary 3.2.5) -/

section Coefficient

variable {σ R : Type*} [CommRing R]

/-- The coefficient ideal `C(I) = ∑_{l < m} D^l(I)^(m!/(m-l))` of `(I, m)`, with the mark `m!`
(Volume 2, Definition 3.2.1 of the handbook, on the affine space). -/
noncomputable def coefficientIdeal (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    Ideal (MvPolynomial σ R) :=
  ⨆ l : Fin m, (derivIdeal^[l] I) ^ (m.factorial / (m - l))

variable [DecidableEq σ]

/-- Restriction to `S = V(x_h)` commutes with the sums and the powers in `C(I)`. -/
theorem map_hyperplaneRestrict_coefficientIdeal (h : σ) (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    (coefficientIdeal m I).map (hyperplaneRestrict h) =
      ⨆ l : Fin m, ((derivIdeal^[l] I).map (hyperplaneRestrict h)) ^ (m.factorial / (m - l)) := by
  rw [coefficientIdeal, Ideal.map_iSup]
  exact iSup_congr fun l => Ideal.map_pow _ _ _

/-- **Theorem 3.2.4, the displayed equality at the origin, for `i = 0`.** Let `k` have
characteristic `0` and let `S = V(x_h)`. Then `I` has order at least `m` at the origin if and only
if `C_S(I) = C(I)|_S` has order at least `m!` there. So the origin lies in
`S ∩ cosupp(I, m)` if and only if it lies in `cosupp(C_S(I), m!)`. -/
theorem le_idealOrd_iff_le_idealOrd_restrict_coefficientIdeal {k : Type*} [Field k] [CharZero k]
    (h : σ) (m : ℕ) (I : Ideal (MvPolynomial σ k)) :
    (m : ℕ∞) ≤ idealOrd I ↔
      (m.factorial : ℕ∞) ≤ idealOrd ((coefficientIdeal m I).map (hyperplaneRestrict h)) := by
  rw [map_hyperplaneRestrict_coefficientIdeal,
    le_idealOrd_iSup_pow_iff (fun l : Fin m => (derivIdeal^[l] I).map (hyperplaneRestrict h))
      (fun l => m - l) (Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero m))
      (fun l => Nat.dvd_factorial (by omega) (Nat.sub_le _ _)),
    le_idealOrd_iff_restrict_derivIdeal_iterate h m I]
  exact ⟨fun H l => H l l.2, fun H j hj => H ⟨j, hj⟩⟩

/-- **Theorem 3.2.4, the transform of `C_S(I)` for one blowup, in one chart.** Let the center be
`(x_i : i ∈ T)` with `I ⊆ I_Z^m`, and take the `x_c`-chart with `c ≠ h`. The restriction to
`S' = V(y_h)` of the transform of `(C(I), m!)` is the transform of `(C_S(I), m!)` under the
blowup of `S` along `(x_i : i ∈ T, i ≠ h)`. -/
theorem map_hyperplaneRestrict_transform_coefficientIdeal [IsDomain R] {T : Finset σ}
    {c h : σ} (hc : c ≠ h) {m : ℕ} {I : Ideal (MvPolynomial σ R)}
    (hI : I ≤ chartCenterIdeal T ^ m) :
    (centerChartTransformIdeal T c m.factorial (coefficientIdeal m I)).map
        (hyperplaneRestrict h) =
      centerChartTransformIdeal (T.erase h) c m.factorial
        ((coefficientIdeal m I).map (hyperplaneRestrict h)) := by
  have hdvd : ∀ l : Fin m, m - l ∣ m.factorial :=
    fun l => Nat.dvd_factorial (by omega) (Nat.sub_le _ _)
  have hB : ∀ l : Fin m, (derivIdeal^[l] I).map (hyperplaneRestrict h) ≤
      chartCenterIdeal (T.erase h) ^ (m - l) :=
    fun l => map_hyperplaneRestrict_le (derivIdeal_iterate_le_chartCenterIdeal_pow hI l)
  rw [map_hyperplaneRestrict_coefficientIdeal,
    centerChartTransformIdeal_iSup_pow (T.erase h) c _ (fun l : Fin m => m - l) hdvd hB,
    coefficientIdeal, centerChartTransformIdeal_coeffIdeal T c hI, Ideal.map_iSup]
  refine iSup_congr fun l => ?_
  rw [Ideal.map_pow,
    map_hyperplaneRestrict_centerChartTransformIdeal hc
      (derivIdeal_iterate_le_chartCenterIdeal_pow hI l)]

/-- **Corollary 3.2.5 at the origin, for `i = 0`.** Let `k` have characteristic `0`, let
`m ≥ 1`, and let `H = V(x_h)` be a hypersurface of maximal contact, in the sense that
`x_h ∈ D^(m-1)(I)`. Then each point of order at least `m` lies on `H`, and the origin has order
at least `m` for `I` if and only if it has order at least `m!` for `C_H(I)`. -/
theorem maximalContact_coefficientIdeal {k : Type*} [Field k] [CharZero k] {m : ℕ} (hm : 1 ≤ m)
    {I : Ideal (MvPolynomial σ k)} {h : σ} (hH : X h ∈ derivIdeal^[m - 1] I) :
    (∀ a : σ → k, (∀ f ∈ I, (m : ℕ∞) ≤ ordAtPoint a f) → a h = 0) ∧
      ((m : ℕ∞) ≤ idealOrd I ↔
        (m.factorial : ℕ∞) ≤ idealOrd ((coefficientIdeal m I).map (hyperplaneRestrict h))) :=
  ⟨fun _ ha => eq_zero_of_X_mem_derivIdeal_iterate hm hH ha,
    le_idealOrd_iff_le_idealOrd_restrict_coefficientIdeal h m I⟩

end Coefficient

/-! ### Order reduction in the chart model (Section 3.3) -/

section OrderReduction

variable {σ R : Type*} [CommRing R] [DecidableEq σ]

omit [DecidableEq σ] in
theorem chartCenterIdeal_singleton (l : σ) :
    chartCenterIdeal (R := R) {l} = Ideal.span {X l} := by
  rw [chartCenterIdeal, Finset.coe_singleton, Set.image_singleton]

/-- **Lemma 3.3.4, the first blowup.** The blowup of a coordinate hyperplane `(x_l)` is the
identity. If `I = (x_l^a) N` and `m ≤ a`, then the transform of `(I, m)` is `(x_l^(a-m)) N`. -/
theorem centerChartTransformIdeal_singleton [IsDomain R] (l : σ) {a m : ℕ} (hm : m ≤ a)
    (N : Ideal (MvPolynomial σ R)) :
    centerChartTransformIdeal {l} l m (Ideal.span {X l ^ a} * N) =
      Ideal.span {X l ^ (a - m)} * N := by
  apply markedTransform_eq_of_map_eq (X_ne_zero l)
  rw [chartSubst_singleton_self, map_algHom_id, ← mul_assoc,
    Ideal.span_singleton_mul_span_singleton, ← pow_add, Nat.add_sub_cancel' hm]

/-- **Theorem 3.3.5, the last blowup, for a coordinate hypersurface.** Let `H = V(x_h)` and
`I ⊆ (x_h)^m` with `x_h^m ∈ I`, so that `cosupp(I, m) = H`. The blowup of `H` is allowed, and the
transform of `(I, m)` is the unit ideal. So its maximal order is `0 < m`. -/
theorem centerChartTransformIdeal_singleton_eq_top [IsDomain R] {h : σ} {m : ℕ}
    {I : Ideal (MvPolynomial σ R)} (hI : X h ^ m ∈ I) :
    centerChartTransformIdeal {h} h m I = ⊤ := by
  rw [Ideal.eq_top_iff_one, centerChartTransformIdeal, mem_markedTransform, mul_one,
    chartSubst_singleton_self, map_algHom_id]
  exact hI

/-- **Theorem 3.3.5, the coordinate case, with orders.** Over a field, if `x_h^m ∈ I ⊆ (x_h)^m`
with `m ≥ 1`, then the blowup of `H = V(x_h)` has order at least `m` for `(I, m)` and the order
at the origin drops below `m`. -/
theorem idealOrd_centerChartTransformIdeal_singleton_lt {k : Type*} [Field k] {h : σ} {m : ℕ}
    (hm : 1 ≤ m) {I : Ideal (MvPolynomial σ k)} (hle : I ≤ Ideal.span {X h} ^ m)
    (hI : X h ^ m ∈ I) :
    I ≤ chartCenterIdeal {h} ^ m ∧ idealOrd (centerChartTransformIdeal {h} h m I) < m := by
  refine ⟨by rwa [chartCenterIdeal_singleton], ?_⟩
  rw [centerChartTransformIdeal_singleton_eq_top hI]
  refine lt_of_le_of_lt (idealOrd_le_ord (Submodule.mem_top (x := 1))) ?_
  rw [ord_one]
  exact_mod_cast hm

/-- **The monomial transform (Theorem 3.3.8 and Theorem 3.3.10, the monomial case), in one
chart.** Let `c ∈ S` and `m ≤ ∑_{i ∈ S} d_i`. Then the transform of `(x^d, m)` in the
`x_c`-chart is `(x^(E(d) - m e_c))`. The new exponent of `x_c` is `∑_{i ∈ S} d_i - m`. -/
theorem centerChartTransformIdeal_span_monomial [IsDomain R] {S : Finset σ} {c : σ}
    (hc : c ∈ S) {m : ℕ} {d : σ →₀ ℕ} (hd : m ≤ ∑ i ∈ S, d i) :
    centerChartTransformIdeal S c m (Ideal.span {monomial d (1 : R)}) =
      Ideal.span {monomial (centerChartExponent S c d - Finsupp.single c m) 1} := by
  apply markedTransform_eq_of_map_eq (X_ne_zero c)
  have hc' : centerChartExponent S c d c = ∑ i ∈ S, d i := by
    simp [centerChartExponent, Finset.add_sum_erase S d hc]
  have hle : Finsupp.single c m ≤ centerChartExponent S c d := by
    rw [Finsupp.single_le_iff, hc']
    exact hd
  rw [Ideal.map_span, Set.image_singleton, chartSubst_monomial_one,
    Ideal.span_singleton_mul_span_singleton, X_pow_eq_monomial, monomial_mul_monomial, one_mul,
    add_tsub_cancel_of_le hle]

/-- **Theorem 3.3.6 for a principal monomial ideal, one blowup.** Let `m = ∑_i d_i` be the order
of `x^d` at the origin and let `S = supp d`. The center `V(x_i : i ∈ S)` is allowed for
`((x^d), m)`, and in the `x_c`-chart, `c ∈ S`, the transform is `(x^d')` with `d' = d - d_c e_c`,
of order `m - d_c < m` at the origin. -/
theorem principal_monomial_orderReduction {k : Type*} [Field k] {d : σ →₀ ℕ} {c : σ}
    (hc : c ∈ d.support) :
    Ideal.span {monomial d (1 : k)} ≤ chartCenterIdeal d.support ^ d.degree ∧
      centerChartTransformIdeal d.support c d.degree (Ideal.span {monomial d (1 : k)}) =
        Ideal.span {monomial (d.erase c) 1} ∧
      idealOrd (centerChartTransformIdeal d.support c d.degree
        (Ideal.span {monomial d (1 : k)})) < d.degree := by
  have hdeg : d.degree = ∑ i ∈ d.support, d i := Finsupp.degree_apply d
  have hE : centerChartExponent d.support c d - Finsupp.single c d.degree = d.erase c := by
    ext j
    by_cases hj : j = c
    · subst hj
      simp [centerChartExponent, hdeg, ← Finset.add_sum_erase d.support d hc]
    · simp [centerChartExponent, Ne.symm hj, Finsupp.erase_ne hj]
  have heq := centerChartTransformIdeal_span_monomial (R := k) hc (le_of_eq hdeg)
  rw [hE] at heq
  refine ⟨?_, heq, ?_⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, monomial_eq, C_1, one_mul,
      Finsupp.prod, hdeg, ← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i hi =>
      Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_image_of_mem X (Finset.mem_coe.mpr hi))) _
  · rw [heq, idealOrd_span_singleton, ord_monomial one_ne_zero]
    have hsplit : (d.erase c).degree + d c = d.degree := by
      conv_rhs => rw [← Finsupp.erase_add_single c d]
      rw [map_add, Finsupp.degree_single]
    have hpos : 0 < d c := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hc)
    exact_mod_cast (by omega : (d.erase c).degree < d.degree)

omit [DecidableEq σ] in
/-- **Theorem 3.3.10, the order of `J = N^m + I^s` at the origin.** Let `m, s ≥ 1`. Then `J` has
order at least `ms` at the origin if and only if `N` has order at least `s` and `I` has order at
least `m` there. -/
theorem le_idealOrd_sup_pow_iff {k : Type*} [Field k] {m s : ℕ} (hm : 1 ≤ m) (hs : 1 ≤ s)
    (N I : Ideal (MvPolynomial σ k)) :
    ((m * s : ℕ) : ℕ∞) ≤ idealOrd (N ^ m ⊔ I ^ s) ↔
      (s : ℕ∞) ≤ idealOrd N ∧ (m : ℕ∞) ≤ idealOrd I := by
  have key := le_idealOrd_iSup_pow_iff (fun b : Bool => if b then N else I)
    (fun b => if b then s else m) (N := m * s) (Nat.one_le_iff_ne_zero.mpr (by positivity))
    (fun b => by cases b <;> simp)
  rw [iSup_bool_eq] at key
  simp only [ite_true, Bool.false_eq_true, ite_false, Nat.mul_div_cancel _ (by omega : 0 < s),
    Nat.mul_div_cancel_left _ (by omega : 0 < m), Bool.forall_bool] at key
  rw [key, and_comm]

/-- **Theorem 3.3.10, the transform of `J = N^m + I^s`, in one chart.** If `N ⊆ I_Z^s` and
`I ⊆ I_Z^m`, then the transform of `(N^m + I^s, ms)` is `N'^m + I'^s`, where `N'` is the
transform of `(N, s)` and `I'` is the transform of `(I, m)`. -/
theorem centerChartTransformIdeal_sup_pow [IsDomain R] {S : Finset σ} (c : σ) {m s : ℕ}
    {N I : Ideal (MvPolynomial σ R)} (hN : N ≤ chartCenterIdeal S ^ s)
    (hI : I ≤ chartCenterIdeal S ^ m) (hm : 0 < m) (hs : 0 < s) :
    centerChartTransformIdeal S c (m * s) (N ^ m ⊔ I ^ s) =
      centerChartTransformIdeal S c s N ^ m ⊔ centerChartTransformIdeal S c m I ^ s := by
  have key := centerChartTransformIdeal_iSup_pow S c (fun b : Bool => if b then N else I)
    (fun b => if b then s else m) (N := m * s) (fun b => by cases b <;> simp)
    (fun b => by cases b <;> simpa)
  rw [iSup_bool_eq, iSup_bool_eq] at key
  simpa only [ite_true, Bool.false_eq_true, ite_false, Nat.mul_div_cancel _ hs,
    Nat.mul_div_cancel_left _ hm] using key

/-- **Theorem 3.3.11 in the chart model.** Along a chart sequence of order at least `1` for
`(I, 1)` whose last transform is the unit ideal, the pullback `Π^* I` is generated by one
monomial. This is `Π^* I = O(-G)` with `G` supported on the exceptional divisors. -/
theorem exists_map_chartSeqMap_eq_span_monomial [IsDomain R] {l : List (Finset σ × σ)}
    {I : Ideal (MvPolynomial σ R)} (h : IsChartSeqOfOrder 1 l I)
    (htop : chartSeqTransform 1 l I = ⊤) :
    ∃ e, I.map (chartSeqMap l) = Ideal.span {monomial e 1} := by
  obtain ⟨e, he⟩ := exists_chartSeqFactor_eq_monomial (R := R) 1 l
  exact ⟨e, by rw [map_chartSeqMap_eq l I h, htop, Ideal.mul_top, he]⟩

end OrderReduction

/-! ### The statements for a power of a coordinate ideal (Theorems 1.1.5 to 1.1.7 and 1.2.1) -/

section Statements

variable {σ R : Type*} [CommRing R] [DecidableEq σ]

/-- **Theorems 1.1.5 to 1.1.7 for `I = I_Z^n`, a power of a coordinate ideal, in one chart.**
The blowup of `Z = V(x_i : i ∈ S)` is a chart sequence of order at least `n` for `(I_Z^n, n)`, its
center is the cosupport of `I_Z^n`, the transform is the unit ideal, and in the `x_c`-chart
the pullback is `(y_c^n)`, the ideal of the divisor `nF`. -/
theorem principalization_chartCenterIdeal_pow [IsDomain R] {S : Finset σ} {c : σ} (hc : c ∈ S)
    (n : ℕ) :
    IsChartSeqOfOrder n [(S, c)] (chartCenterIdeal (R := R) S ^ n) ∧
      chartSeqTransform n [(S, c)] (chartCenterIdeal (R := R) S ^ n) = ⊤ ∧
      (chartCenterIdeal (R := R) S ^ n).map (chartSeqMap [(S, c)]) =
        Ideal.span {monomial (Finsupp.single c n) 1} := by
  have hmap : (chartCenterIdeal (R := R) S ^ n).map (chartSeqMap [(S, c)]) =
      Ideal.span {X c ^ n} := by
    rw [chartSeqMap, map_algHom_comp, chartSeqMap, map_algHom_id]
    exact map_chartCenterIdeal_pow_chartSubst hc n
  refine ⟨⟨le_rfl, trivial⟩, ?_, by rw [hmap, X_pow_eq_monomial]⟩
  change markedTransform (chartSubst S c) (X c) n _ = ⊤
  rw [Ideal.eq_top_iff_one, mem_markedTransform, mul_one, map_chartCenterIdeal_pow_chartSubst hc]
  exact Ideal.mem_span_singleton_self _

omit [DecidableEq σ] in
/-- **Theorem 1.2.1, the key fact in the chart model.** Over a domain, the ideal of a coordinate
subspace of codimension at least `2` is not principal. So a principalization must blow up a
center that meets it, while one blowup makes it principal in each chart
(`map_chartCenterIdeal_chartSubst`). -/
theorem chartCenterIdeal_ne_span_singleton [IsDomain R] {S : Finset σ} {i j : σ} (hi : i ∈ S)
    (hj : j ∈ S) (hij : i ≠ j) (g : MvPolynomial σ R) :
    chartCenterIdeal S ≠ Ideal.span {g} := by
  intro hg
  have hXi : X i ∈ Ideal.span {g} := hg ▸ Ideal.subset_span ⟨i, hi, rfl⟩
  have hXj : X j ∈ Ideal.span {g} := hg ▸ Ideal.subset_span ⟨j, hj, rfl⟩
  rw [Ideal.mem_span_singleton] at hXi hXj
  have hgmem : g ∈ chartCenterIdeal (R := R) S := hg ▸ Ideal.mem_span_singleton_self g
  have hgnu : ¬ IsUnit g := by
    intro hu
    have hle : chartCenterIdeal (R := R) S ≤ idealOfVars σ R := by
      rw [chartCenterIdeal, Ideal.span_le]
      rintro _ ⟨l, _, rfl⟩
      exact mem_idealOfVars_iff.mpr (by simp)
    have h0 := mem_idealOfVars_iff.mp (hle hgmem)
    have := hu.map (constantCoeff (σ := σ) (R := R))
    rw [h0] at this
    exact not_isUnit_zero this
  obtain ⟨a, ha⟩ := hXi
  have hirr := (X_prime (σ := σ) (R := R) (i := i)).irreducible
  rcases hirr.isUnit_or_isUnit ha with hu | hu
  · exact hgnu hu
  · have hdvd : (X i : MvPolynomial σ R) ∣ X j := by
      obtain ⟨b, hb⟩ := hXj
      refine ⟨hu.unit⁻¹ * b, ?_⟩
      rw [hb, ha, mul_assoc, ← mul_assoc a, mul_comm a, IsUnit.val_inv_mul hu, one_mul]
    exact hij (X_dvd_X.mp hdvd)

end Statements

end Singularity
